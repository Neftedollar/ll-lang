module AspnetTodo.Main

-- Domain types + pure business logic for the ASP.NET TODO demo.
-- ll-lang compiles this module to C# (class `AspnetTodo_Main`).
-- The ASP.NET minimal API wiring lives in ../Program.cs, which
-- imports this module's static members and serves them as HTTP routes.

-- Todo item: id, title, completion flag.
-- C# codegen emits a sealed record `MkTodo(long _0, string _1, bool _2)`.
-- Program.cs reads the fields positionally (_0, _1, _2) for JSON output.
Todo = MkTodo Int Str Bool

-- Greeting endpoint payload (GET /hello).
greeting() = "Hello from ll-lang"

-- Factory used by POST /todos.
mk_todo(id Int)(title Str) = MkTodo id title false

-- Initial list served by GET /todos. Demonstrates that ll-lang
-- constructs the seed data; Program.cs merely forwards it.
initial_todos() =
  [ MkTodo 1 "Write ll-lang" true
    MkTodo 2 "Wire up ASP.NET minimal API" true
    MkTodo 3 "Ship #152 demo" false
  ]
