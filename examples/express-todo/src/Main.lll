module ExpressTodo.Main

-- ---------------------------------------------------------------------------
-- Express-style TODO API, written entirely in ll-lang.
--
-- FFI is configured per-project via `[platform.typescript.externals]` in
-- `lll.toml`. Each external declared here maps to a JS expression that the
-- TypeScript codegen splices in at compile time, so no hand-written shim
-- is needed.
-- ---------------------------------------------------------------------------

opaque ExpressApp
opaque Req
opaque Res

external expressApp() ExpressApp
external appGet(app ExpressApp)(path Str)(handler Req -> Res -> Int) Int
external resSend(res Res)(body Str) Int
external appListen(app ExpressApp)(port Int) Int

main() =
  app = expressApp()
  _ = appGet app "/hello" (\req res. resSend res "Hello from ll-lang")
  _ = appGet app "/health" (\req res. resSend res "ok")
  _ = appListen app 3000
  0
