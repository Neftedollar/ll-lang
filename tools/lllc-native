#!/usr/bin/env bash
# tools/lllc-native <file.lll> [output-binary]
#
# Canonical user-facing command for the native-binary pipeline.
# Compiles a .lll source file to a native executable via LLVM.
#
# Usage:
#   tools/lllc-native hello.lll           # -> ./hello
#   tools/lllc-native hello.lll ./out     # -> ./out
#
# Thin launcher: delegates to tools/llvm-build.sh, which runs the
# four-stage pipeline (lllc -> IR patch -> runtime make -> clang link).
#
# Requires: dotnet (.NET 10 SDK), python3, clang, make.
exec "$(dirname "$0")/llvm-build.sh" "$@"
