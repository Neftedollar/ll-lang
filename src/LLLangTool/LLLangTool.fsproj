<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!-- FS3261 is currently too noisy on .NET/F# preview nullability interop. -->
    <NoWarn>$(NoWarn);FS3261</NoWarn>
    <AssemblyName>lllc</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Mcp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FsMcp.Core" Version="1.0.0" />
    <PackageReference Include="FsMcp.Server" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LLLangCompiler\LLLangCompiler.fsproj" />
  </ItemGroup>
</Project>
