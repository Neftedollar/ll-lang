(* ============================================================
   ll-lang Grammar — EBNF Reference
   File extension: .lll
   Encoding: UTF-8, ASCII-only operators
   Indentation: significant (2 or 4 spaces, consistent per file)
   Comments: -- to end of line
   ============================================================ *)

(* --- Whitespace & Comments ---------------------------------- *)
WS      ::= (' ' | '\t')+
NEWLINE ::= '\n' | '\r\n'
COMMENT ::= '--' [^\n]*
INDENT  ::= synthetic token — emitted when indentation increases
DEDENT  ::= synthetic token — emitted when indentation decreases

(* --- Keywords ----------------------------------------------- *)
KW ::= "fn" | "let" | "type" | "tag" | "unit"
     | "trait" | "impl" | "import" | "export" | "module"
     | "if" | "then" | "else" | "true" | "false"

(* --- Identifiers -------------------------------------------- *)
(* value identifiers: lowercase start *)
IDENT  ::= [a-z_][a-zA-Z0-9_]*

(* type/constructor/module identifiers: uppercase start *)
TYPEID ::= [A-Z][a-zA-Z0-9_]*

(* --- Literals ----------------------------------------------- *)
INT_LIT   ::= [0-9]+
FLOAT_LIT ::= [0-9]+ '.' [0-9]+
STR_LIT   ::= '"' ( [^"\\] | '\\' . )* '"'
BOOL_LIT  ::= "true" | "false"

(* --- Operators & Punctuation -------------------------------- *)
OP_PIPE    ::= "->"
OP_LAMBDA  ::= "\"
OP_DOT     ::= "."
OP_COMMA   ::= ","
OP_COLON   ::= ":"
OP_EQ      ::= "="
OP_ARROW   ::= "->"       (* same as pipe — context disambiguates *)
OP_BAR     ::= "|"
OP_LBRACK  ::= "["
OP_RBRACK  ::= "]"
OP_LPAREN  ::= "("
OP_RPAREN  ::= ")"
OP_PLUS    ::= "+"
OP_MINUS   ::= "-"
OP_STAR    ::= "*"
OP_SLASH   ::= "/"
OP_CARET   ::= "^"
OP_LT      ::= "<"
OP_GT      ::= ">"
OP_LE      ::= "<="
OP_GE      ::= ">="
OP_EQ2     ::= "=="
OP_NEQ     ::= "!="

(* ============================================================
   Expressions
   ============================================================ *)

expr ::= let-expr
       | lambda-expr
       | if-expr
       | match-expr
       | pipe-expr
       | arith-expr

(* pipe: left-associative, lowest precedence after if/match *)
pipe-expr ::= arith-expr (OP_PIPE arith-expr)*

(* arithmetic: standard precedence *)
arith-expr  ::= cmp-expr ((OP_PLUS | OP_MINUS) cmp-expr)*
cmp-expr    ::= app-expr ((OP_LT | OP_GT | OP_LE | OP_GE | OP_EQ2 | OP_NEQ) app-expr)*
app-expr    ::= atom (OP_LPAREN expr OP_RPAREN)*   (* curried application *)
atom        ::= tagged-lit
              | literal
              | IDENT
              | list-lit
              | tuple-lit
              | OP_LPAREN expr OP_RPAREN            (* grouping — human mode *)

(* literals *)
literal     ::= INT_LIT | FLOAT_LIT | STR_LIT | BOOL_LIT

(* tagged literal: value[Tag] *)
tagged-lit  ::= atom OP_LBRACK TYPEID OP_RBRACK

(* collections *)
list-lit    ::= OP_LBRACK expr* OP_RBRACK          (* space-separated elements *)
tuple-lit   ::= expr OP_COMMA expr (OP_COMMA expr)* (* comma = tuple *)

(* let binding *)
let-expr    ::= "let" IDENT "=" expr

(* lambda *)
lambda-expr ::= OP_LAMBDA IDENT+ OP_DOT expr

(* conditional *)
if-expr     ::= "if" expr "then" expr "else" expr

(* pattern match: each branch on own line, indented *)
match-expr  ::= INDENT (OP_BAR pattern OP_ARROW expr NEWLINE)+ DEDENT

pattern     ::= TYPEID pattern*    (* constructor pattern *)
              | IDENT               (* variable binding *)
              | literal             (* literal match *)
              | OP_UNDERSCORE       (* wildcard *)
