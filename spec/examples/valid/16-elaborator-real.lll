module Examples.ElaboratorReal

-- Phase 7.6a + 7.6b: early slices of the ll-lang **elaborator**
-- written in ll-lang itself. The front-end half (Phases 7.1..7.5e)
-- now produces a `List[Decl]` AST inside `15-moduleparser-real.lll`,
-- and Phase 7.6 starts walking that AST with the same semantic passes
-- the F# host elaborator runs in `src/LLLangCompiler/Elaborator.fs`.
--
-- Phase 7.6a shipped **name resolution** / free-variable check —
-- `E002 UnboundVar <name>` for every `EVar name` whose name isn't in
-- scope. Phase 7.6b adds **constructor-coverage exhaustiveness** —
-- `E003 NonExhaustiveMatch <type> missing <ctor>` for every top-level
-- clause-sugar fn whose body is a `match` on a named sum type that
-- doesn't cover every constructor and doesn't carry a catch-all arm.
--
-- Pipeline: Decl list -> collect top-level names into `Env` AND
-- collect `DType` bodies into a `typeToCtors` map -> `checkDecl` each
-- fn body, extending `Env` with the fn's params before walking
-- `body`, AND walk each `DFn` one more time for the exhaustiveness
-- check. `checkExpr env body` recurses through the expression,
-- threading the local scope via explicit extension on `ELet` / `ELam`
-- / `EMatch` arm pattern binders. Every `EVar name` that isn't in the
-- current env accumulates one error string. Every clause-sugar fn
-- whose last param type is a known sum type and whose `EMatch` arms
-- don't cover every ctor (and don't carry a catch-all) accumulates
-- one `E003` string per missing ctor.
--
-- Deliberately minimal ("slice A + B"):
--   * Minimal local AST (not reusing the full `Decl` shape from
--     `15-moduleparser-real.lll`) — `DFn` / `DLet` / `DType` (ctors
--     only) / `DTag`, plus `EInt` / `EStr` / `EVar` / `EAdd` / `EApp`
--     / `ELet` / `ELam` / `EIf` / `EMatch` expression forms, plus
--     `PInt` / `PVar` / `PWild` / `PNil` / `PCons` / `PCon` patterns.
--   * No type checking (E001 — Phase 7.6c).
--   * No tag / unit checks (E004 / E005 — Phase 7.6+).
--   * Exhaustiveness only detects **missing constructors** on a
--     top-level clause-sugar `EMatch` over the last fn param. Nested
--     matches and value-position `match ... with` expressions are
--     skipped — mirrors the scope limitation the F# host elaborator
--     uses at `Elaborator.fs` line 503 area.
--   * No builtin env — the test input only references names the user
--     declares locally, so the env starts empty. Wiring into the real
--     `builtinEnv` lives in a later integration slice.
--   * No source positions — errors are emitted as `E002 UnboundVar
--     <name>` / `E003 NonExhaustiveMatch <type> missing <ctor>` (no
--     `line:col` prefix). Position tracking on AST nodes is a
--     separate Phase 7.6+ item.
--   * Input module AST is **hardcoded** in `main` — reading a real
--     `.lll` file through the parser and elaborating the result is
--     the Phase 7.6 integration tick, not this slice.
--
-- Runtime output, for the hardcoded test module:
--   E002 UnboundVar undefinedName
--   E002 UnboundVar otherMissing
--   E003 NonExhaustiveMatch Shape missing Empty

-- ---------- Types -------------------------------------------------------

-- Minimal expression AST for this slice. `EVar name` is the only leaf
-- the elaborator actually checks against the env; every other leaf
-- (`EInt`, `EStr`) carries no identifier. Recursive arms recurse into
-- sub-expressions exactly as the F# host elaborator's `typeOf` does.
-- `EMatch` stores match arms as two parallel lists (same trick as
-- `15-moduleparser-real.lll`) to sidestep the codegen limitation that
-- prevents mutually-recursive user type decls.
Pat =
  | PInt Int
  | PVar Str
  | PWild
  | PNil
  | PCons Pat Pat
  | PCon Str

Expr =
  | EInt Int
  | EStr Str
  | EVar Str
  | EAdd Expr Expr
  | EApp Expr Expr
  | ELet Str Expr Expr
  | ELam Str Expr
  | EIf Expr Expr Expr
  | EMatch Expr List[Pat] List[Expr]

-- Minimal decl AST. `DFn name params lastTy body` — `params` is the
-- flat list of parameter names (no per-param types in this slice),
-- and `lastTy` is the **type name** of the fn's last curried param
-- (empty string `""` if the fn has no declared type on its last
-- param). The exhaustiveness check uses `lastTy` to look up the
-- scrutinee's ctors — mirroring the F# host elaborator's "clause
-- sugar scrutinizes the LAST curried param" rule in
-- `Elaborator.fs` line 517 area. Full E001 type checking, including
-- every param's type, is Phase 7.6c. `DLet` / `DTag` introduce a
-- single name into the top-level env and have no effect on name
-- resolution beyond that (the RHS of a `DLet` is not walked in this
-- slice — module-level `let`s with free vars on the RHS can surface
-- in a later tick). `DType name ctors` introduces every constructor
-- name into the env; the type name itself doesn't become a value
-- binder, matching the F# host elaborator's behaviour.
Decl =
  | DFn Str List[Str] Str Expr
  | DLet Str Expr
  | DType Str List[Str]
  | DTag Str

-- Name-resolution env: just a `List[Str]` of declared names. No types,
-- no source positions — this slice cares only about "is this name
-- defined?". Wrapped in `MkEnv` so future slices can carry richer data
-- (per-name types, scope depth, etc.) without changing the surface.
Env = MkEnv List[Str]

-- ---------- Env helpers -------------------------------------------------

-- Linear scan over the name list. Short-circuits on first match via a
-- `listFold` accumulator carrying the running `found?` flag. `==` on
-- `Str` is the polymorphic equality the builtin env injects as
-- `a -> a -> Bool`; on strings it's the same as F#'s `=` on strings.
envHas(env Env)(name Str) =
  match env
    | MkEnv xs ->
      listFold (\acc x. if acc
        true
      else if x == name
        true
      else false) false xs

envAdd(env Env)(name Str) =
  match env
    | MkEnv xs -> MkEnv (listAppend xs [name])

-- Fold a list of names into an env, extending one binder at a time.
-- Used for fn params, for collected top-level decl names, and for
-- pattern binders introduced inside match arms.
envAddAll(env Env)(names List[Str]) =
  listFold (\acc n. envAdd acc n) env names

-- ---------- Pattern binders ---------------------------------------------

-- Collect every `PVar` binder introduced by a pattern. Wildcards, nil,
-- int-literal patterns, and 0-arity ctor patterns don't bind anything.
-- `PCons h t` binds whatever the head and tail patterns bind, left-to-
-- right. Mirrors the F# host elaborator's local `patVars` helper.
-- `PCon name` in this slice is a 0-arity ctor tag — argument patterns
-- are not modelled yet (the F# host `PCon(name, argPats)` carries an
-- arg-pat list that binders would recurse into).
patBinders(p Pat) =
  | PInt _ -> []
  | PWild -> []
  | PNil -> []
  | PVar name -> [name]
  | PCons h t -> listAppend (patBinders h) (patBinders t)
  | PCon _ -> []

-- ---------- Expression walker ------------------------------------------

-- Walk `e` under `env`, returning the list of `E002 UnboundVar <name>`
-- error strings produced by every `EVar name` not in `env` plus any
-- errors produced by sub-expressions. The only arms that actually
-- flag are `EVar`; every compound arm recurses and concatenates its
-- children's error lists. `ELet` / `ELam` / `EMatch` extend the local
-- env for their body sub-expression(s) before recursing.
checkExpr(env Env)(e Expr) =
  | EInt _ -> []
  | EStr _ -> []
  | EVar name ->
    if envHas env name
      []
    else
      msg = "E002 UnboundVar " + name
      [msg]
  | EAdd l r -> listAppend (checkExpr env l) (checkExpr env r)
  | EApp f x -> listAppend (checkExpr env f) (checkExpr env x)
  | ELet name rhs body ->
    rhsErrs = checkExpr env rhs
    env2 = envAdd env name
    bodyErrs = checkExpr env2 body
    listAppend rhsErrs bodyErrs
  | ELam param body ->
    env2 = envAdd env param
    checkExpr env2 body
  | EIf cnd thn els ->
    ce = checkExpr env cnd
    te = checkExpr env thn
    ee = checkExpr env els
    listAppend (listAppend ce te) ee
  | EMatch scrut pats bodies ->
    scrutErrs = checkExpr env scrut
    armErrs = checkArms env pats bodies
    listAppend scrutErrs armErrs

-- Walk the two parallel arm lists in lockstep. For each arm, extend
-- the scrutinee env with every binder the pattern introduces,
-- walk the body expression under the extended env. Pattern binders
-- are only visible inside their own arm body, not across arms.
checkArms(env Env)(pats List[Pat])(bodies List[Expr]) =
  match pats
    | p :: ps ->
      match bodies
        | b :: bs ->
          armEnv = envAddAll env (patBinders p)
          armErrs = checkExpr armEnv b
          restErrs = checkArms env ps bs
          listAppend armErrs restErrs
        | _ -> []
    | _ -> []

-- ---------- Decl walker --------------------------------------------------

-- Walk a single decl under the top-level `env`. `DFn` extends `env`
-- with its own params (fn params are locals, not top-level names)
-- then walks `body`. `DLet` / `DType` / `DTag` have no body to walk
-- in this slice — their effect on name resolution is entirely in the
-- collection pass below. (A richer slice would also walk `DLet`'s RHS,
-- but since module-level lets in the F# host elaborator only carry
-- literals, int / str / tagged literals etc., skipping them here is
-- safe — any free var there would surface in whichever `fn body` ends
-- up using the `let`-bound name.)
checkDecl(env Env)(d Decl) =
  | DFn _ params _ body ->
    bodyEnv = envAddAll env params
    checkExpr bodyEnv body
  | DLet _ _ -> []
  | DType _ _ -> []
  | DTag _ -> []

-- Walk every decl and concatenate all error lists. Each decl is
-- checked under the **same** top-level env — fn params don't leak
-- out, because `checkDecl` extends a local env for the duration of
-- one decl only.
checkDecls(env Env)(decls List[Decl]) =
  | d :: rest -> listAppend (checkDecl env d) (checkDecls env rest)
  | _ -> []

-- ---------- Collector ----------------------------------------------------

-- Collect the single top-level name each decl introduces into the env.
-- For `DFn` / `DLet` / `DTag` that's one name each; for `DType` that's
-- every ctor name (the type name itself isn't a value, matching the
-- F# host elaborator). The same ctor-as-value rule means a match arm
-- body like `| _ -> Some x` looks up `Some` in the env and finds it
-- via the `DType` collect pass.
collectDecl(env Env)(d Decl) =
  | DFn name _ _ _ -> envAdd env name
  | DLet name _ -> envAdd env name
  | DType _ ctors -> envAddAll env ctors
  | DTag name -> envAdd env name

collectDecls(env Env)(decls List[Decl]) =
  | d :: rest -> collectDecls (collectDecl env d) rest
  | _ -> env

-- ---------- Type -> ctor index ------------------------------------------

-- Second collect pass: build a `List[TypeCtors]` indexed by type name
-- so the exhaustiveness check can answer "what ctors does type T
-- have?". Only `DType` decls contribute; every other decl leaves the
-- index untouched. Mirrors the F# host elaborator's `typeToCtors`
-- local at `Elaborator.fs` line 505 area, minus the real `Map`.
TypeCtors = MkTypeCtors Str List[Str]

collectTypes(decls List[Decl]) =
  | d :: rest ->
    match d
      | DType name ctors ->
        listAppend [MkTypeCtors name ctors] (collectTypes rest)
      | _ -> collectTypes rest
  | _ -> []

-- Linear lookup: returns the ctor list for the given type name, or
-- the empty list if the name isn't a declared sum type. The empty-
-- list sentinel is safe for exhaustiveness because a fn whose last
-- param type isn't in the index is one the check should skip anyway.
lookupCtors(types List[TypeCtors])(name Str) =
  match types
    | MkTypeCtors n cs :: rest ->
      if n == name
        cs
      else lookupCtors rest name
    | _ -> []

-- ---------- Exhaustiveness check ----------------------------------------

-- A pattern counts as "catch-all relative to a sum type" if it's
-- `PWild`, `PVar`, or `PCons` — the F# host elaborator uses the same
-- list at `Elaborator.fs` line 532 area (plus `PTuple`, which this
-- slice's AST doesn't have yet). `PInt` / `PNil` / `PCon` are NOT
-- catch-alls — `PInt` and `PNil` match specific literals, `PCon`
-- identifies one named constructor.
patIsCatchAll(p Pat) =
  | PWild -> true
  | PVar _ -> true
  | PCons _ _ -> true
  | _ -> false

-- Walk the arm pattern list and return `true` if any pattern would
-- unconditionally match a residual scrutinee value. The F# host
-- elaborator short-circuits its exhaustiveness check when any branch
-- is a catch-all; the ll-lang mirror does the same.
armsHaveCatchAll(pats List[Pat]) =
  listFold (\acc p. if acc
    true
  else patIsCatchAll p) false pats

-- Collect every named constructor mentioned in `PCon name` arms of
-- the match. PWild / PVar / PCons / PInt / PNil contribute nothing —
-- they're either catch-alls (handled separately) or literal patterns
-- irrelevant to sum-type coverage.
coveredCtors(pats List[Pat]) =
  | PCon name :: rest -> listAppend [name] (coveredCtors rest)
  | _ :: rest -> coveredCtors rest
  | _ -> []

-- For a given `required` ctor list and `covered` ctor list, return
-- one `E003 NonExhaustiveMatch <type> missing <ctor>` message per
-- required ctor that isn't in `covered`. Mirrors the F# host
-- elaborator's `for c in requiredCtors do if not (List.contains c
-- coveredCtors) then yield e003 ...` loop at `Elaborator.fs` line
-- 544 area.
missingCtorErrs(ty Str)(required List[Str])(covered List[Str]) =
  match required
    | c :: rest ->
      tail = missingCtorErrs ty rest covered
      isCovered = listFold (\acc x. if acc
        true
      else if x == c
        true
      else false) false covered
      if isCovered
        tail
      else
        msg = "E003 NonExhaustiveMatch " + ty + " missing " + c
        listAppend [msg] tail
    | _ -> []

-- Run the exhaustiveness check over a single fn decl. Non-DFn decls
-- are skipped. DFn is checked only if its body is a top-level
-- `EMatch` AND its last param type name is a key in `typeToCtors`.
-- If any arm pattern is a catch-all, the whole fn is skipped. Else
-- we diff `required` vs `covered` and emit one `E003` per missing
-- ctor. Nested matches, `match ... with` value-position matches, and
-- fns whose last param isn't a named sum type all produce zero
-- errors — the check is deliberately narrow to mirror the F# host
-- elaborator's scope limitation.
exhaustivenessDecl(types List[TypeCtors])(d Decl) =
  match d
    | DFn _ _ lastTy body ->
      if strLen lastTy == 0
        []
      else
        required = lookupCtors types lastTy
        if listIsEmpty required
          []
        else
          match body
            | EMatch _ pats _ ->
              if armsHaveCatchAll pats
                []
              else
                covered = coveredCtors pats
                missingCtorErrs lastTy required covered
            | _ -> []
    | _ -> []

-- Walk every decl and concatenate all exhaustiveness errors.
exhaustivenessCheck(types List[TypeCtors])(decls List[Decl]) =
  | d :: rest ->
    listAppend (exhaustivenessDecl types d) (exhaustivenessCheck types rest)
  | _ -> []

-- ---------- Top-level elaborator entry ----------------------------------

-- Elaborate a whole decl list: first collect every top-level name into
-- a fresh empty env AND a `typeToCtors` index, then run the name-
-- resolution pass (`checkDecls`) and the exhaustiveness pass
-- (`exhaustivenessCheck`) under those two indices and concatenate the
-- error lists. Mirrors the F# host elaborator's multi-pass
-- `collectDecls` -> `checkDecls` -> `exhaustivenessCheck` shape in
-- `src/LLLangCompiler/Elaborator.fs`.
elaborate(decls List[Decl]) =
  env0 = MkEnv []
  env = collectDecls env0 decls
  types = collectTypes decls
  nameErrs = checkDecls env decls
  exhErrs = exhaustivenessCheck types decls
  listAppend nameErrs exhErrs

-- ---------- Pretty printer for error list -------------------------------

-- Render the error list as one message per line. Empty list prints a
-- single `ok` sentinel so the runtime test can tell a clean elaborate
-- apart from an elaborate that printed nothing at all.
showErrs(errs List[Str]) =
  if listIsEmpty errs
    "ok"
  else listFold (\acc s. if strLen acc == 0
    s
  else acc + "\n" + s) "" errs

-- ---------- Hardcoded test module ---------------------------------------

-- A small module with six fns, one let, two types, and one tag. The
-- name-resolution pass flags two unbound vars in `bad`; the
-- exhaustiveness pass flags one missing ctor in `shapeBad`. The
-- other fns exercise the quiet paths — `add`/`useCtor` are clean
-- name-resolution-wise; `shapeGood` is a fully exhaustive match over
-- `Shape`; `shapeWild` is a partial match but has a `_` catch-all,
-- so exhaustiveness skips it.
--
-- Equivalent surface syntax:
--   tag UserId
--   type Maybe = Some | None
--   type Shape = Circle | Rect | Empty
--   let answer = 42
--   fn add(a b) = a + b
--   fn bad(x) = undefinedName + otherMissing
--   fn useCtor(y) =
--     match y
--       | 0 -> Some
--       | _ -> None
--   fn shapeGood(s Shape) =
--     | Circle -> 1
--     | Rect -> 2
--     | Empty -> 3
--   fn shapeBad(s Shape) =
--     | Circle -> 1
--     | Rect -> 2
--   fn shapeWild(s Shape) =
--     | Circle -> 1
--     | _ -> 0
--
-- `bad` emits two E002 lines; `shapeBad` emits one E003 line
-- (`missing Empty`). `shapeGood` covers all three Shape ctors;
-- `shapeWild` has a catch-all arm so the exhaustiveness pass skips it.
-- `useCtor`'s last param type is empty (`""`), so exhaustiveness
-- skips it too — matching the F# host elaborator's "only check fns
-- whose last param is a named sum type" scope limitation.
--
-- Note: each decl is `let`-bound on its own line before the decl list
-- is assembled. Space-separated list literals `[e1 e2 e3]` don't play
-- well with multi-argument ctor applications (`[DFn "a" ps body DLet
-- ...]` would parse as one nested EApp chain, not three elements),
-- so each decl gets its own name and the final list is just variable
-- refs joined by spaces.
-- Hardcoded test module. Takes a dummy `Int` param (ignored) because
-- zero-arg fn invocation at call-site in ll-lang is surface-awkward
-- — easier to accept one ignored `Int` and call it as `testModule 0`
-- from `main`.
testModule(u Int) =
  -- `add(a b) = a + b` — two untyped params, both referenced in the body.
  addParams = ["a" "b"]
  addBody = EAdd (EVar "a") (EVar "b")
  addFn = DFn "add" addParams "" addBody
  -- `bad(x) = undefinedName + otherMissing` — two free vars, both flagged.
  badParams = ["x"]
  badLhs = EVar "undefinedName"
  badRhs = EVar "otherMissing"
  badBody = EAdd badLhs badRhs
  badFn = DFn "bad" badParams "" badBody
  -- `useCtor(y) = match y with | 0 -> Some | _ -> None` — the ctor
  -- refs `Some` / `None` are resolved via the collected type decl.
  -- Pattern + body elements are each let-bound individually because
  -- list literals `[PInt 0 PWild]` would otherwise parse as a single
  -- curried ctor application (TypeId-starting list elements invoke
  -- `parseApp` which greedily consumes subsequent atoms, see Parser.fs
  -- line 112-116). Last-param type is empty so exhaustiveness skips.
  useCtorParams = ["y"]
  useCtorPat0 = PInt 0
  useCtorPat1 = PWild
  useCtorPats = [useCtorPat0 useCtorPat1]
  useCtorBody0 = EVar "Some"
  useCtorBody1 = EVar "None"
  useCtorBodies = [useCtorBody0 useCtorBody1]
  useCtorScrut = EVar "y"
  useCtorBody = EMatch useCtorScrut useCtorPats useCtorBodies
  useCtorFn = DFn "useCtor" useCtorParams "" useCtorBody
  -- `shapeGood(s Shape) = | Circle -> 1 | Rect -> 2 | Empty -> 3` —
  -- covers every Shape ctor, so no E003. Each pattern is `PCon
  -- <ctorName>` (zero-arity); the body is `EInt n` for each arm.
  -- Scrutinee `EVar "s"` is the clause-sugar implicit last-param ref.
  shapeParams = ["s"]
  shapeGoodPat0 = PCon "Circle"
  shapeGoodPat1 = PCon "Rect"
  shapeGoodPat2 = PCon "Empty"
  shapeGoodPats = [shapeGoodPat0 shapeGoodPat1 shapeGoodPat2]
  shapeGoodBody0 = EInt 1
  shapeGoodBody1 = EInt 2
  shapeGoodBody2 = EInt 3
  shapeGoodBodies = [shapeGoodBody0 shapeGoodBody1 shapeGoodBody2]
  shapeScrut = EVar "s"
  shapeGoodBody = EMatch shapeScrut shapeGoodPats shapeGoodBodies
  shapeGoodFn = DFn "shapeGood" shapeParams "Shape" shapeGoodBody
  -- `shapeBad(s Shape) = | Circle -> 1 | Rect -> 2` — missing Empty,
  -- triggers one E003 for `missing Empty`. Same scrutinee, same
  -- last-param type.
  shapeBadPat0 = PCon "Circle"
  shapeBadPat1 = PCon "Rect"
  shapeBadPats = [shapeBadPat0 shapeBadPat1]
  shapeBadBody0 = EInt 1
  shapeBadBody1 = EInt 2
  shapeBadBodies = [shapeBadBody0 shapeBadBody1]
  shapeBadBody = EMatch shapeScrut shapeBadPats shapeBadBodies
  shapeBadFn = DFn "shapeBad" shapeParams "Shape" shapeBadBody
  -- `shapeWild(s Shape) = | Circle -> 1 | _ -> 0` — catch-all PWild,
  -- so exhaustiveness skips the whole fn even though `Rect` / `Empty`
  -- aren't named. Mirrors the F# host elaborator's catch-all bailout.
  shapeWildPat0 = PCon "Circle"
  shapeWildPat1 = PWild
  shapeWildPats = [shapeWildPat0 shapeWildPat1]
  shapeWildBody0 = EInt 1
  shapeWildBody1 = EInt 0
  shapeWildBodies = [shapeWildBody0 shapeWildBody1]
  shapeWildBody = EMatch shapeScrut shapeWildPats shapeWildBodies
  shapeWildFn = DFn "shapeWild" shapeParams "Shape" shapeWildBody
  -- Non-fn decls: a tag, two types with ctors, a let. None contain
  -- sub-expressions that need walking in this slice.
  tagDecl = DTag "UserId"
  maybeCtors = ["Some" "None"]
  maybeDecl = DType "Maybe" maybeCtors
  shapeCtors = ["Circle" "Rect" "Empty"]
  shapeDecl = DType "Shape" shapeCtors
  letDecl = DLet "answer" (EInt 42)
  -- Assemble the final decl list. All elements are lowercase idents
  -- (`tagDecl`, `addFn`, ...) so `parseTagged` is used per element
  -- and each one is a single atom, not a curried application.
  [tagDecl maybeDecl shapeDecl letDecl addFn badFn useCtorFn shapeGoodFn shapeBadFn shapeWildFn]

-- ---------- Driver -------------------------------------------------------

main() =
  decls = testModule 0
  errs = elaborate decls
  printfn (showErrs errs)
