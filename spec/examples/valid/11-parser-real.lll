module Examples.RealParser

-- Phase 7.2: a real recursive-descent arithmetic expression parser written
-- in ll-lang itself. Second self-hosting milestone after 09-lexer-real.lll.
--
-- Grammar:
--   expr   = term (('+' | '-') term)*
--   term   = factor (('*' | '/') factor)*
--   factor = int | '(' expr ')'
--
-- Classical precedence, left-associative. The pretty printer wraps every
-- binary node in parens so the output is unambiguous: `1 + 2 * 3` prints as
-- `(1 + (2 * 3))`.
--
-- Things this exercises that 09-lexer-real did not:
--   1. Mutually recursive parseExpr / parseExprTail / parseTerm / parseTermTail
--      / parseFactor — a real 5-way mutual recursion group.
--   2. Tuple-literal return values + destructuring via `let (e, rest) = ...`
--      (the natural shape now that surface tuple literals exist).
--   3. Maybe unwrap for `strToInt` via match-as-expression inside a `let`.
--   4. Recursive AST walks (show) alongside recursive input walks (parse).

type Maybe A = Some A | None

type Token =
  | TNum Int
  | TPlus
  | TMinus
  | TStar
  | TSlash
  | TLParen
  | TRParen
  | TEnd

type Expr =
  | ENum Int
  | EAdd Expr Expr
  | ESub Expr Expr
  | EMul Expr Expr
  | EDiv Expr Expr

-- ---------- Mini-lexer ---------------------------------------------------

-- Collect a run of digit chars. Returns (digits, leftover) as a tuple.
fn takeDigits(cs List[Char]) =
  | c :: rest ->
    if charIsDigit c
      let (ds, leftover) = takeDigits rest
      (c :: ds, leftover)
    else ([], cs)
  | _ -> ([], [])

-- Unwrap `strToInt` Maybe into a raw Int; a malformed digit run falls back
-- to 0. The lexer only calls this on strings that are already all-digits,
-- so the `None` branch is defensive.
fn parseIntStr(s Str) Int =
  match strToInt s with
    | Some n -> n
    | None -> 0

fn consTok(t Token)(ts List[Token]) List[Token] = t :: ts

-- Main tokenizer loop. Skips whitespace, recognises digit runs as TNum,
-- and maps single-char operators / parens to their token constructors.
fn lexChars(cs List[Char]) List[Token] =
  | c :: rest ->
    if charIsSpace c
      lexChars rest
    else if charIsDigit c
      let (ds, leftover) = takeDigits cs
      let n = parseIntStr (strFromChars ds)
      consTok (TNum n) (lexChars leftover)
    else if c == '+'
      consTok TPlus (lexChars rest)
    else if c == '-'
      consTok TMinus (lexChars rest)
    else if c == '*'
      consTok TStar (lexChars rest)
    else if c == '/'
      consTok TSlash (lexChars rest)
    else if c == '('
      consTok TLParen (lexChars rest)
    else if c == ')'
      consTok TRParen (lexChars rest)
    else lexChars rest
  | _ -> [TEnd]

fn tokenize(src Str) List[Token] = lexChars (strChars src)

-- ---------- Recursive-descent parser ------------------------------------

-- Five mutually recursive fns. Each returns a (Expr, List[Token]) tuple
-- — the parsed sub-expression and the remaining input. Left-associative
-- binary operators are expressed via tail helpers that take the
-- already-parsed left-hand side as their first curried argument.

fn parseExpr(toks List[Token]) =
  let (e, rest) = parseTerm toks
  parseExprTail e rest

fn parseExprTail(lhs Expr)(toks List[Token]) =
  | TPlus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (EAdd lhs r) rest2
  | TMinus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (ESub lhs r) rest2
  | _ -> (lhs, toks)

fn parseTerm(toks List[Token]) =
  let (e, rest) = parseFactor toks
  parseTermTail e rest

fn parseTermTail(lhs Expr)(toks List[Token]) =
  | TStar :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EMul lhs r) rest2
  | TSlash :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EDiv lhs r) rest2
  | _ -> (lhs, toks)

fn parseFactor(toks List[Token]) =
  | TNum n :: rest -> (ENum n, rest)
  | TLParen :: rest ->
    let (e, rest2) = parseExpr rest
    match rest2 with
      | TRParen :: rest3 -> (e, rest3)
      | _ -> (e, rest2)
  | _ -> (ENum 0, toks)

-- ---------- Pretty printer ----------------------------------------------

-- Recursive walk over Expr producing a fully-parenthesised S-expression-ish
-- string. Each binary node prints as `(L op R)`; leaves as their integer
-- form. This makes precedence and associativity visually obvious and lets
-- the runtime test string-match the result.
fn show(e Expr) Str =
  | ENum n -> intToStr n
  | EAdd l r -> strConcat (strConcat (strConcat (strConcat "(" (show l)) " + ") (show r)) ")"
  | ESub l r -> strConcat (strConcat (strConcat (strConcat "(" (show l)) " - ") (show r)) ")"
  | EMul l r -> strConcat (strConcat (strConcat (strConcat "(" (show l)) " * ") (show r)) ")"
  | EDiv l r -> strConcat (strConcat (strConcat (strConcat "(" (show l)) " / ") (show r)) ")"

-- ---------- Driver -------------------------------------------------------

fn main() =
  let toks = tokenize "1 + 2 * 3"
  let (e, _) = parseExpr toks
  printfn (show e)
