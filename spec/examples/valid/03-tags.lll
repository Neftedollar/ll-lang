module Examples.Tags

Maybe A = Some A | None
Result A E = Ok A | Err E

-- declare tags
tag UserId
tag Email
tag m
tag s
tag kg

-- tagged values
let uid = "user-42"[UserId]

-- functions with tagged params
getUser(id Str[UserId]) = Some "alice"
sendEmail(to Str[Email]) = to

-- unit algebra — return type inferred
speed(d Float[m])(t Float[s]) = d / t
-- compiler infers: Float[m/s]

-- phantom types
tag Validated
tag Raw

Email[state] = Str

validate(s Str) =
  if s != ""
    Ok s
  else Err "empty"
