module Examples.Tags

-- declare tags
tag UserId
tag Email
tag m
tag s
tag kg

-- tagged values
let uid = "user-42"[UserId]
let dist = 5.0[m]
let time = 2.0[s]

-- functions with tagged params
fn getUser(id Str[UserId]) Maybe[Str] = Some "alice"
fn sendEmail(to Str[Email]) = to

-- unit algebra — return type inferred
fn speed(d Float[m])(t Float[s]) = d / t
-- compiler infers: Float[m/s]

-- phantom types
tag Validated
tag Raw

type Email[state] = Str

fn validate(s Str) Result[Email[Validated] Str] =
  if len s > 0 then Ok s
  else Err "empty"
