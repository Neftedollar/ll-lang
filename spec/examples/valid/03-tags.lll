module Examples.Tags

type Maybe A = Some A | None
type Result A E = Ok A | Err E

-- declare tags
tag UserId
tag Email
tag m
tag s
tag kg

-- tagged values
let uid = "user-42"[UserId]

-- functions with tagged params
fn getUser(id Str[UserId]) = Some "alice"
fn sendEmail(to Str[Email]) = to

-- unit algebra — return type inferred
fn speed(d Float[m])(t Float[s]) = d / t
-- compiler infers: Float[m/s]

-- phantom types
tag Validated
tag Raw

type Email[state] = Str

fn validate(s Str) =
  if s != ""
    Ok s
  else Err "empty"
