module Examples.CodegenReal

-- Phase 7.8a+b: F# codegen written in ll-lang itself. After Phase 7.7
-- closed out the HM middle of self-hosting (18-hminfer-real.lll:
-- TypeExpr / Subst / unify / Env / inferExpr over EInt / EStr / EBool
-- / EVar / EAdd / EApp / ELam / ELet / EIf / EMatch), this file
-- starts the **back end**: a tiny `TExpr` / `TDecl` AST — a stand-in
-- for the host's TypedAST — plus a `showTExpr` family of walkers
-- that emit F# source strings, mirroring the F# host's
-- `src/LLLangCompiler/Codegen.fs` `emitExpr` / `emitDecl`.
--
-- After this slice lands, all four compiler stages have ll-lang
-- representations (lex / parse / elaborate / HM-infer / codegen), so
-- the next umbrella (`bootstrap/compiler.lll`) can stitch them into a
-- single end-to-end program.
--
-- Phase 7.8a scope ("slice A"):
--   * `TExpr` = TEInt / TEStr / TEVar / TEAdd / TEApp / TELet.
--   * `TDecl` = TDFn Str List[Str] TExpr.
--   * Expression emission:
--       TEInt n        -> "<n>L"         (F# int64 literal)
--       TEStr s        -> "\"<s>\""      (no escaping — test strings
--                                         are simple ASCII)
--       TEVar x        -> "<x>"
--       TEAdd a b      -> "(<a> + <b>)"
--       TEApp f x      -> "(<f> <x>)"
--       TELet n e1 e2  -> "(let <n> = <e1> in <e2>)"
--     `TDFn` empty-params -> `let <name> = <body>`;
--     non-empty         -> `let <name> p1 p2 ... = <body>`.
--
-- Phase 7.8b scope ("slice B" — control-flow expression shapes):
--   * `TExpr` gains `TELam Str TExpr`, `TEIf TExpr TExpr TExpr`, and
--     `TEMatch TExpr List[Pat] List[TExpr]` — parallel pat/body lists
--     mirroring 18-hminfer-real.lll's `EMatch` encoding so the
--     pipeline's ll-lang side uses the same shape top to bottom.
--   * New `Pat` ADT: `PInt Int | PVar Str | PWild` — the same three
--     pattern shapes 18-hminfer-real.lll's HM inference supports.
--   * New emission arms:
--       TELam x body       -> "(fun <x> -> <body>)"
--       TEIf c t e         -> "(if <c> then <t> else <e>)"
--       TEMatch scr ps bs  -> "(match <scr> with | <p1> -> <b1> | <p2> -> <b2>)"
--     The match form joins all arms on a single line — same trick as
--     the host's `TEMatchOf` arm in `Codegen.fs` line 201 area — to
--     dodge F# offside-rule trouble when the match sits inside a
--     parent expression.
--   * Pattern emission:
--       PInt n -> "<n>L"
--       PVar x -> "<x>"
--       PWild  -> "_"
--
-- Phase 7.8c scope ("slice C" — sum-type declaration emission):
--   * `TDecl` gains a second variant:
--       TDType Str List[Str] List[Ctor]
--     which pairs with the new `Ctor = MkCtor Str List[TypeArg]` ADT
--     and the single-segment `TypeArg = TAName Str | TAVar Str` ADT.
--   * New emission helpers:
--       showTypeParam : Str -> Str       -- "'A"
--       showTypeArg   : TypeArg -> Str   -- primitive + type-var map
--       showCtorArgs  : List[TypeArg] -> Str  -- " * "-joined arg body
--       showCtor      : Ctor -> Str           -- one arm line
--       showCtors     : List[Ctor] -> Str     -- newline-joined arms
--       showTypeParams: List[Str] -> Str      -- "<'A, 'B>" header seg
--       showTypeDecl  : Str -> List[Str] -> List[Ctor] -> Str
--   * Multi-line emission is safe because type decls sit at module
--     level — F# accepts left-anchored `| ctor` lines without any
--     offside-rule fuss.
--   * Primitive name mapping mirrors `emitType` in `Codegen.fs` line
--     51 area: Int -> int64 / Str -> string / Bool -> bool; every
--     other name passes through as-is.
--
-- Phase 7.8d scope ("slice D" — F# module header + stdlib prelude block):
--   * New `Module = MkModule Str List[TDecl]` ADT pairing a dotted
--     module path with the list of decls that belong in it — a
--     stand-in for the host's `TypedModule`.
--   * New `fsharpPrelude : Int -> Str` helper emitting a minimal
--     5-binding subset of the host's `fsharpPreludeCore` (listMap,
--     listLen, strLen, strConcat, print) wrapped in the canonical
--     `// --- ll-lang stdlib prelude (auto-generated) ---` /
--     `// --- end prelude ---` banner. Takes a dummy `Int` arg
--     because ll-lang's surface doesn't yet accept `fn name ()`
--     as a call expression.
--   * New `showModule : Module -> Str` walker (plus a
--     `showModuleBody` split helper) that emits the full F# file
--     shape: `module <path>` header, blank line, prelude block,
--     blank line, decls rendered via `showDecl` and joined with
--     blank-line separators.
--   * New `joinBlocks : List[Str] -> Str` blank-line-joined fold
--     (same shape as `joinLines` but with `"\n\n"` separator).
--   * `main` now builds a single `MkModule "Examples.Generated" ...`
--     value instead of printing each decl individually, and
--     `printfn`s its `showModule` rendering.
--
-- Out of scope (later slices in the Phase 7.8 umbrella):
--   * Multi-line match emission and constructor-application / tagged-
--     type (`TECon`) emission — a later slice.
--   * Mutual-recursion grouping (`let rec ... and ...`) and
--     `[<EntryPoint>]` on `main` — Phase 7.8e.
--   * Record (`TBRecord`) and wrapped (`TBWrapped`) type bodies — only
--     sum bodies are supported in 7.8c.
--   * Parametric type applications in ctor args (`Some (Maybe A)`) —
--     only flat TAName / TAVar single-segment args are supported.
--   * Conditional Maybe/Result prelude sections — the host's
--     `assemblePrelude` emits these only when the user declares the
--     corresponding types. This slice's flat 5-line subset has no
--     user-type dependencies so it's always safe to emit.
--   * Full ~30-binding `fsharpPreludeCore` (math / char / file IO /
--     stringly helpers) — out of scope for this minimum-viable slice;
--     will land alongside `bootstrap/compiler.lll` in Phase 7.9+.
--   * Real `TypeScheme`-carrying TypedAST — this slice just walks a
--     plain `TExpr`/`TDecl` without touching type info.
--   * Consuming the output of `18-hminfer-real.lll` — integration is
--     a separate tick after both sides stabilise.
--   * Keyword-safe ident rewriting (`safeIdent` in Codegen.fs) —
--     every hardcoded test name is already a non-keyword.
--
-- Hardcoded test plan in `main`: seven `TDFn`s + three `TDType`s.
--   TDFn "inc"      ["x"] (TEAdd (TEVar "x") (TEInt 1))          -- 7.8a
--   TDFn "greet"    []    (TEStr "hello")                         -- 7.8a
--   TDFn "addOne"   ["x"] (TELet "y" (TEAdd (TEVar "x") (TEInt 1)) (TEVar "y"))  -- 7.8a
--   TDFn "callInc"  ["x"] (TEApp (TEVar "inc") (TEVar "x"))       -- 7.8a
--   TDFn "choose"   ["b"] (TEIf (TEVar "b") (TEInt 1) (TEInt 2))  -- 7.8b
--   TDFn "double"   []    (TELam "x" (TEAdd (TEVar "x") (TEVar "x")))  -- 7.8b
--   TDFn "classify" ["x"] (TEMatch (TEVar "x") [PInt 0, PWild] [TEStr "zero", TEStr "other"])  -- 7.8b
--   TDType "Maybe" ["A"] [MkCtor "Some" [TAVar "A"], MkCtor "None" []]  -- 7.8c
--   TDType "Shape" []    [MkCtor "Circle" [], MkCtor "Rect" [TAName "Int", TAName "Int"], MkCtor "Empty" []]  -- 7.8c
--   TDType "Pair"  ["A" "B"] [MkCtor "MkPair" [TAVar "A", TAVar "B"]]  -- 7.8c
--
-- Expected stdout (Phase 7.8d: wrapped in a full F# module shell with
-- `module` header + stdlib prelude block, then types + fns):
--   module Examples.Generated
--
--   // --- ll-lang stdlib prelude (auto-generated) ---
--   let listMap f xs = List.map f xs
--   let listLen (xs: 'a list) : int64 = int64 (List.length xs)
--   let strLen (s: string) : int64 = int64 s.Length
--   let strConcat (a: string) (b: string) = a + b
--   let print (s: string) = System.Console.Write(s)
--   // --- end prelude ---
--
--   type Maybe<'A> =
--       | Some of 'A
--       | None
--
--   type Shape =
--       | Circle
--       | Rect of int64 * int64
--       | Empty
--
--   type Pair<'A, 'B> =
--       | MkPair of 'A * 'B
--
--   let inc x = (x + 1L)
--
--   let greet = "hello"
--
--   let addOne x = (let y = (x + 1L) in y)
--
--   let callInc x = (inc x)
--
--   let choose b = (if b then 1L else 2L)
--
--   let double = (fun x -> (x + x))
--
--   let classify x = (match x with | 0L -> "zero" | _ -> "other")

-- ---------- Maybe -------------------------------------------------------

-- Local `Maybe` kept only so the codegen prelude wires the Maybe-
-- dependent stdlib helpers (same reason as `18-hminfer-real.lll`).
-- Nothing in this file actually uses `Some` / `None` at runtime.
type Maybe A = Some A | None

-- ---------- Pat ---------------------------------------------------------

-- Minimal pattern AST for `TEMatch`. Same three-shape restriction as
-- `18-hminfer-real.lll`'s `Pat` type so the HM-infer side and this
-- codegen side can eventually share one definition once the pipeline
-- stitches them together. Constructor / nested patterns land in a
-- later slice only if the self-host compiler needs them.
type Pat =
  | PInt Int
  | PVar Str
  | PWild

-- ---------- TExpr -------------------------------------------------------

-- Typed-expression AST. Mirrors a slice of the F# host's
-- `LLLang.TypedAST.TypedExpr` minus every variant this phase doesn't
-- emit. Each constructor is the `TE`-prefixed cousin of a surface
-- `Expr` variant — the "T" in the name is a nod to the host's typed
-- AST but carries no actual type info. A later slice grows the
-- `TypeScheme` payload once the pipeline starts consuming real
-- inferred output.
--
-- Phase 7.8a shapes: TEInt / TEStr / TEVar / TEAdd / TEApp / TELet.
-- Phase 7.8b shapes: TELam / TEIf / TEMatch — the three control-flow
-- expression forms `18-hminfer-real.lll`'s HM inference already
-- handles on the front-end side. `TEMatch` uses parallel pat/body
-- lists (`List[Pat]` and `List[TExpr]`) so it matches the encoding
-- 18-hminfer-real.lll picked for `EMatch Expr List[Pat] List[Expr]`.
type TExpr =
  | TEInt Int
  | TEStr Str
  | TEVar Str
  | TEAdd TExpr TExpr
  | TEApp TExpr TExpr
  | TELet Str TExpr TExpr
  | TELam Str TExpr
  | TEIf TExpr TExpr TExpr
  | TEMatch TExpr List[Pat] List[TExpr]

-- ---------- Type-argument + constructor AST (Phase 7.8c) ----------------

-- `TypeArg` is the single-segment type reference this slice emits inside
-- a ctor's `of` arg-list. `TAName` covers primitive / ADT names (`Int`,
-- `Str`, `Bool`, `Shape`, ...); `TAVar` covers single-letter type
-- parameters (`A`, `B`, ...) — matching the host's `TyName` /
-- `isTypeParamName` split in `Codegen.fs` line 46-60 area. Parametric
-- applications (`Maybe A`) and function types are deliberately out of
-- scope for 7.8c — the test cases only need flat ctor arg lists.
type TypeArg =
  | TAName Str
  | TAVar Str

-- A single ADT constructor: name + ordered list of `TypeArg`s. Mirrors
-- the host's `TBSum` branch pair `(con, args)` in `Codegen.fs` line 252
-- area. Zero-arg ctors (`None`, `Circle`, `Empty`) pass an empty list.
type Ctor = MkCtor Str List[TypeArg]

-- ---------- TDecl -------------------------------------------------------

-- Typed top-level declaration. Two shapes:
--   * `TDFn name params body` — a function decl, same as Phase 7.8a.
--   * `TDType name typeParams ctors` — a sum-type decl. `typeParams` is
--     a `List[Str]` of single-letter type parameter names (empty for
--     monomorphic types like `Shape`), and `ctors` is a `List[Ctor]`.
--     Only sum bodies are supported; records and wrapped types stay out
--     of scope for Phase 7.8c.
-- The host's `TypedDecl.TDFn` carries a `TypedFnSig` and a `TypeScheme`;
-- this slice still drops both. A later slice adds them back.
type TDecl =
  | TDFn Str List[Str] TExpr
  | TDType Str List[Str] List[Ctor]

-- ---------- Module (Phase 7.8d) -----------------------------------------

-- A full F# output unit: dotted module path + the list of decls that
-- belong in it. Mirrors the host's `TypedModule` pairing of `Path` and
-- `Decls`, minus every type-scheme / import / tag field this slice
-- doesn't need. `showModule` walks this value to emit a complete F#
-- source file: `module <path>` header, blank line, stdlib prelude
-- block, blank line, then each decl rendered via `showDecl` and
-- separated by blank lines. Phase 7.8d keeps the prelude unconditional
-- (no Maybe/Result dependency tracking) and skips the `[<EntryPoint>]`
-- attribute and `let rec ... and ...` grouping — those land in Phase
-- 7.8e.
type Module = MkModule Str List[TDecl]

-- ---------- Expression emission -----------------------------------------

-- Walk a `TExpr` and produce its F# source rendering. Mirrors the F#
-- host's `emitExpr` in `src/LLLangCompiler/Codegen.fs` line 123 area.
-- The arms stay shallow — every non-leaf recursive case is split into
-- its own helper so `match` nesting never goes two levels deep. Same
-- trick as `18-hminfer-real.lll`'s `unify` / `inferExpr` spines use.
fn showTExpr(e TExpr) Str =
  match e with
    | TEInt n -> showInt n
    | TEStr s -> showStr s
    | TEVar x -> x
    | TEAdd a b -> showAdd a b
    | TEApp f a -> showApp f a
    | TELet n e1 e2 -> showLet n e1 e2
    | TELam x body -> showLam x body
    | TEIf c t e -> showIf c t e
    | TEMatch scr ps bs -> showMatch scr ps bs

-- `TEInt n` -> `"<n>L"` (F# `int64` literal). Uses the stdlib's
-- `intToStr` builtin and suffixes `L` because ll-lang's `Int` maps to
-- F# `int64` in the host codegen.
fn showInt(n Int) Str =
  strConcat (intToStr n) "L"

-- `TEStr s` -> `"\"<s>\""` (raw, no escape handling). The hardcoded
-- test strings below (`"hello"`) contain no embedded quotes or
-- backslashes, so the simplest possible emission works. Slice B adds
-- real escape handling when user-authored strings start appearing.
fn showStr(s Str) Str =
  strConcat "\"" (strConcat s "\"")

-- `TEAdd a b` -> `"(<a> + <b>)"`. Parens are unconditional — mirrors
-- the host's `emitExpr` `binaryOp` arm which also always parenthesises
-- to dodge F# operator-precedence ambiguity.
fn showAdd(a TExpr)(b TExpr) Str =
  strConcat "(" (strConcat (showTExpr a) (strConcat " + " (strConcat (showTExpr b) ")")))

-- `TEApp f a` -> `"(<f> <a>)"`. Host's `emitExpr` wraps every
-- application in parens too, for the same reason — curried apps are
-- left-associative in F# but left-leaning chains like `f a b c` would
-- need extra context tracking to drop them safely. Parens are free.
fn showApp(f TExpr)(a TExpr) Str =
  strConcat "(" (strConcat (showTExpr f) (strConcat " " (strConcat (showTExpr a) ")")))

-- `TELet n e1 e2` -> `"(let <n> = <e1> in <e2>)"` — the host's
-- offside-safe inline form from `Codegen.fs` line 162 area. A
-- multi-line let-in would need indentation tracking that this slice
-- doesn't bother with; inline form costs long lines but works in any
-- expression position.
fn showLet(n Str)(e1 TExpr)(e2 TExpr) Str =
  strConcat "(let " (strConcat n (strConcat " = " (strConcat (showTExpr e1) (strConcat " in " (strConcat (showTExpr e2) ")")))))

-- `TELam x body` -> `"(fun <x> -> <body>)"`. Single-param lambda
-- only — `18-hminfer-real.lll`'s `ELam Str Expr` also takes a single
-- param and curries via nested lambdas, so this matches. The host's
-- `TELam` arm in `Codegen.fs` line 158 area joins a param list with
-- spaces; this slice's single-param form is a strict subset.
fn showLam(x Str)(body TExpr) Str =
  strConcat "(fun " (strConcat x (strConcat " -> " (strConcat (showTExpr body) ")")))

-- `TEIf c t e` -> `"(if <c> then <t> else <e>)"`. Unconditionally
-- parenthesised, same as the host's `emitExpr` `TEIf` arm in
-- `Codegen.fs` line 180 area, so the if-expression embeds cleanly in
-- any parent expression position without offside-rule surprises.
fn showIf(c TExpr)(t TExpr)(e TExpr) Str =
  strConcat "(if " (strConcat (showTExpr c) (strConcat " then " (strConcat (showTExpr t) (strConcat " else " (strConcat (showTExpr e) ")")))))

-- `TEMatch scr ps bs` -> `"(match <scr> with <arms>)"`. Arms are
-- emitted on a **single line** joined by spaces — mirrors the host's
-- `TEMatchOf` arm in `Codegen.fs` line 201 area. Multi-line match
-- emission would need indentation tracking this slice doesn't bother
-- with; single-line form works in any expression position at the
-- cost of long lines. The parallel `ps`/`bs` lists are walked in
-- lockstep by `showArms`, same trick as `18-hminfer-real.lll`'s
-- `inferMatchBranches`.
fn showMatch(scr TExpr)(ps List[Pat])(bs List[TExpr]) Str =
  strConcat "(match " (strConcat (showTExpr scr) (strConcat " with " (strConcat (showArms ps bs) ")")))

-- ---------- Pattern + arm emission --------------------------------------

-- Render a `Pat` as its F# source form. Mirrors the host's
-- `emitPattern` in `Codegen.fs` line 105 area for the three shapes
-- this slice handles:
--   PInt n -> "<n>L" (F# int64 literal — reuses `showInt`)
--   PVar x -> "<x>"
--   PWild  -> "_"
fn showPat(p Pat) Str =
  match p with
    | PInt n -> showInt n
    | PVar x -> x
    | PWild -> "_"

-- Fold parallel `ps`/`bs` lists into a single-line arms string like
-- `"| <p1> -> <b1> | <p2> -> <b2>"`. Walks both lists in lockstep —
-- same pattern as `18-hminfer-real.lll`'s `inferMatchBranches`. When
-- either list runs out, emit nothing more (robust against stray tail
-- mismatches; inference already rules those out at the front-end).
fn showArms(ps List[Pat])(bs List[TExpr]) Str =
  match ps with
    | p :: prest -> showArmsCons p prest bs
    | _ -> ""

-- Tail-helper: consumed one head from `ps`, now peel a matching head
-- from `bs` and glue in `"| <p> -> <b>"` plus the recursive rest.
-- Split out of `showArms` so each `match` stays one level deep.
fn showArmsCons(p Pat)(prest List[Pat])(bs List[TExpr]) Str =
  match bs with
    | b :: brest ->
      let head = strConcat "| " (strConcat (showPat p) (strConcat " -> " (showTExpr b))) in
      let rest = showArms prest brest in
      if strLen rest == 0 then head else strConcat head (strConcat " " rest)
    | _ -> ""

-- ---------- Parameter-list emission -------------------------------------

-- Render a `List[Str]` of param names as space-separated idents. Used
-- by `showDecl` for the non-empty-param branch. Empty list returns the
-- empty string; `showDecl`'s own match keeps the empty case out of the
-- caller path anyway but defending here costs nothing.
fn showParams(ps List[Str]) Str =
  match ps with
    | p :: rest -> showParamsTail p rest
    | _ -> ""

-- Tail-helper: we've already consumed one head, now glue the rest on
-- with single-space separators. Split out of `showParams` so the outer
-- function's `match` stays one level deep (same trick as the rest of
-- the file).
fn showParamsTail(first Str)(rest List[Str]) Str =
  match rest with
    | p :: more -> strConcat first (strConcat " " (showParamsTail p more))
    | _ -> first

-- ---------- Type-argument + constructor emission ------------------------

-- Render a type parameter name as its F# form — `A` -> `'A`. Mirrors
-- the host's `emitTypeParams` in `Codegen.fs` line 67 area (which
-- produces `'A` for every `TPBare` param). Only single-letter params
-- are emitted in this slice.
fn showTypeParam(p Str) Str =
  strConcat "'" p

-- Render a single `TypeArg` as its F# type string. `TAName` covers the
-- primitive name mapping (`Int` -> `int64`, `Str` -> `string`, `Bool`
-- -> `bool`; every other name passes through as-is for user ADTs like
-- `Shape`). `TAVar` prefixes with `'` so `A` becomes `'A`. Mirrors
-- `emitType` in `Codegen.fs` line 51 area, minus `Float` / `Unit` /
-- `Char` / `TyApp` / `TyFn` which this slice doesn't exercise.
fn showTypeArg(a TypeArg) Str =
  match a with
    | TAName n -> showTypeArgName n
    | TAVar v -> showTypeParam v

-- Primitive-name mapping helper: `Int` -> `int64`, `Str` -> `string`,
-- `Bool` -> `bool`; anything else passes through verbatim (user-
-- defined ADTs emit as their bare F# name). Split from `showTypeArg`
-- so the outer match stays one level deep.
fn showTypeArgName(n Str) Str =
  if n == "Int" then "int64"
  else if n == "Str" then "string"
  else if n == "Bool" then "bool"
  else n

-- Join a ctor's `List[TypeArg]` into the `of T1 * T2 * ...` arg-tuple
-- body (without the leading `of `). Mirrors the host's
-- `args |> List.map emitType |> String.concat " * "` in `Codegen.fs`
-- line 256 area. Empty list returns the empty string — callers that
-- care about the empty vs non-empty distinction (`showCtor`) branch
-- before calling this helper.
fn showCtorArgs(args List[TypeArg]) Str =
  match args with
    | a :: rest -> showCtorArgsTail (showTypeArg a) rest
    | _ -> ""

-- Tail-helper: we've already rendered one head, now glue the rest on
-- with ` * ` separators. Same shape as `showParamsTail`.
fn showCtorArgsTail(acc Str)(rest List[TypeArg]) Str =
  match rest with
    | a :: more -> showCtorArgsTail (strConcat acc (strConcat " * " (showTypeArg a))) more
    | _ -> acc

-- Render a single `Ctor` as one indented arm line — `"    | Name"` for
-- zero-arg ctors, `"    | Name of T1 * T2"` otherwise. Mirrors the
-- host's `TBSum` arm emission in `Codegen.fs` line 252 area.
fn showCtor(c Ctor) Str =
  match c with
    | MkCtor name args -> showCtorBody name args

-- Split helper so `showCtor`'s outer match stays one level deep. Zero-
-- arg ctors skip the `of ...` segment entirely.
fn showCtorBody(name Str)(args List[TypeArg]) Str =
  match args with
    | _ :: _ ->
      let argStr = showCtorArgs args in
      strConcat "    | " (strConcat name (strConcat " of " argStr))
    | _ ->
      strConcat "    | " name

-- Fold a `List[Ctor]` into a single newline-joined string. Each arm
-- occupies its own indented line — `showCtor` supplies the `    | `
-- prefix, so the joiner only needs `\n`.
fn showCtors(cs List[Ctor]) Str =
  match cs with
    | c :: rest -> showCtorsTail (showCtor c) rest
    | _ -> ""

-- Tail-helper: one head already rendered, glue the rest on with `\n`
-- separators. Mirrors `showCtorArgsTail` / `showParamsTail`.
fn showCtorsTail(acc Str)(rest List[Ctor]) Str =
  match rest with
    | c :: more -> showCtorsTail (strConcat acc (strConcat "\n" (showCtor c))) more
    | _ -> acc

-- Render the `<'A, 'B>` segment of a type header. Empty list returns
-- the empty string (so `Shape` emits `type Shape = ...` with no `<>`);
-- non-empty lists get the full `<'A, 'B>` form. Mirrors
-- `emitTypeParams` in `Codegen.fs` line 67 area.
fn showTypeParams(ps List[Str]) Str =
  match ps with
    | p :: rest -> strConcat "<" (strConcat (showTypeParamsBody p rest) ">")
    | _ -> ""

-- Tail-helper: consumed one head, glue the rest on with `", "`
-- separators. Split out of `showTypeParams` so each `match` stays one
-- level deep.
fn showTypeParamsBody(first Str)(rest List[Str]) Str =
  match rest with
    | p :: more -> strConcat (showTypeParam first) (strConcat ", " (showTypeParamsBody p more))
    | _ -> showTypeParam first

-- ---------- Declaration emission ----------------------------------------

-- Walk a `TDecl` and produce its F# source rendering. Dispatches on
-- the two variants: `TDFn` hits `showFnDecl` (same behavior as Phase
-- 7.8a/b); `TDType` hits `showTypeDecl` (new in Phase 7.8c). Mirrors
-- the F# host's `emitDecl` in `src/LLLangCompiler/Codegen.fs` line 244
-- area, minus the mutual-recursion grouping, `main` entry-point, and
-- the `TBRecord` / `TBWrapped` / `TBTrait` / `TDImpl` arms.
fn showDecl(d TDecl) Str =
  match d with
    | TDFn name ps body -> showFnDecl name ps body
    | TDType name tps ctors -> showTypeDecl name tps ctors

-- Helper: the zero-params branch drops the param segment entirely.
-- Non-empty params get a leading space + `showParams`. Split from
-- `showDecl` so the outer match stays shallow.
fn showFnDecl(name Str)(ps List[Str])(body TExpr) Str =
  match ps with
    | _ :: _ ->
      let paramStr = showParams ps in
      strConcat "let " (strConcat name (strConcat " " (strConcat paramStr (strConcat " = " (showTExpr body)))))
    | _ ->
      strConcat "let " (strConcat name (strConcat " = " (showTExpr body)))

-- Emit a sum-type decl as multi-line F# source. Shape:
--   `type <name><typeParams> =\n    | <ctor1>\n    | <ctor2> ...`
-- Mirrors the host's `TDType` + `TBSum` arm in `Codegen.fs` line 247
-- area. Multi-line form is fine here because type decls live at module
-- level — F# has no offside-rule trouble between sibling `| ctor`
-- lines once they're left-anchored. Phase 7.8d+ adds records and
-- wrapped types; this slice only handles sum bodies.
fn showTypeDecl(name Str)(tps List[Str])(ctors List[Ctor]) Str =
  let paramStr = showTypeParams tps in
  let arms = showCtors ctors in
  strConcat "type " (strConcat name (strConcat paramStr (strConcat " =\n" arms)))

-- ---------- Line joiner -------------------------------------------------

-- Fold a `List[Str]` of emitted lines into a single newline-joined
-- string — same helper as `18-hminfer-real.lll`'s `joinLines`. Needed
-- because `fn main` has a single-expression body and ll-lang has no
-- statement sequencing, so all four emitted decls have to funnel into
-- a single `printfn` argument.
fn joinLines(xs List[Str]) Str =
  listFold (\acc s. if strLen acc == 0 then s else strConcat (strConcat acc "\n") s) "" xs

-- Blank-line-joined variant: walks a `List[Str]` of already-emitted
-- source blocks and glues them with `"\n\n"` separators. Used by
-- `showModule` so the header, prelude block, and per-decl renderings
-- all sit on their own F# source "paragraph". Same shape as
-- `joinLines`, just a different separator.
fn joinBlocks(xs List[Str]) Str =
  listFold (\acc s. if strLen acc == 0 then s else strConcat (strConcat acc "\n\n") s) "" xs

-- ---------- F# stdlib prelude (Phase 7.8d) ------------------------------

-- Minimal 5-line subset of the host's `fsharpPreludeCore` in
-- `src/LLLangCompiler/Codegen.fs` line 380 area. The host prelude
-- exposes ~30 bindings; this slice picks just enough to demonstrate
-- the shape (listMap, listLen, strLen, strConcat, print). Phase 7.8e+
-- grows this out to the full ~30-line core plus conditional
-- Maybe/Result sections. Building it by `joinLines`-folding a
-- hardcoded line list avoids needing multi-line string literals —
-- same trick as every other string-assembly helper in this file.
--
-- Lines rendered (in order):
--   // --- ll-lang stdlib prelude (auto-generated) ---
--   let listMap f xs = List.map f xs
--   let listLen (xs: 'a list) : int64 = int64 (List.length xs)
--   let strLen (s: string) : int64 = int64 s.Length
--   let strConcat (a: string) (b: string) = a + b
--   let print (s: string) = System.Console.Write(s)
--   // --- end prelude ---
--
-- Implemented as a single-param fn taking an ignored `Int` (instead
-- of a zero-param `()` fn) because the module parser doesn't yet
-- accept `fnName ()` as an expression — callers pass `0` and the
-- body discards it.
fn fsharpPrelude(_ignored Int) Str =
  let l1 = "// --- ll-lang stdlib prelude (auto-generated) ---" in
  let l2 = "let listMap f xs = List.map f xs" in
  let l3 = "let listLen (xs: 'a list) : int64 = int64 (List.length xs)" in
  let l4 = "let strLen (s: string) : int64 = int64 s.Length" in
  let l5 = "let strConcat (a: string) (b: string) = a + b" in
  let l6 = "let print (s: string) = System.Console.Write(s)" in
  let l7 = "// --- end prelude ---" in
  let preludeLines = [l1 l2 l3 l4 l5 l6 l7] in
  joinLines preludeLines

-- ---------- Module emission (Phase 7.8d) --------------------------------

-- Walk a `Module` and render a full F# source file: header, blank line,
-- prelude, blank line, decls separated by blank lines. Mirrors the F#
-- host's `emitModule` in `src/LLLangCompiler/Codegen.fs` line 454 area,
-- minus the mutual-recursion grouping (7.8e), conditional prelude
-- (host's `assemblePrelude`), and type-decl-first reordering (host
-- emits types before the prelude so the prelude can reference user
-- Maybe/Result ctors — this slice just walks decls in their declared
-- order because the minimal prelude has no user-type dependencies).
fn showModule(m Module) Str =
  match m with
    | MkModule path decls -> showModuleBody path decls

-- Split helper so `showModule`'s outer match stays one level deep.
-- Emits `module <path>`, then the prelude block, then every decl
-- rendered via `showDecl`, all glued with blank-line separators.
fn showModuleBody(path Str)(decls List[TDecl]) Str =
  let header = strConcat "module " path in
  let prelude = fsharpPrelude 0 in
  let declLines = listMap showDecl decls in
  let declBlock = joinBlocks declLines in
  let parts = [header prelude declBlock] in
  joinBlocks parts

-- ---------- main --------------------------------------------------------

fn main() =
  -- Seven hardcoded `TDecl`s, each exercising one supported TExpr
  -- shape. Phase 7.8a: `inc` covers TEAdd + TEVar + TEInt; `greet`
  -- covers TEStr and the empty-params branch; `addOne` covers TELet;
  -- `callInc` covers TEApp. Phase 7.8b: `choose` covers TEIf;
  -- `double` covers TELam (bound as a top-level value, not as a
  -- function param); `classify` covers TEMatch with PInt / PWild
  -- branches. See the header block for the expected emission.
  let d1 = TDFn "inc"     ["x"] (TEAdd (TEVar "x") (TEInt 1)) in
  let d2 = TDFn "greet"   []    (TEStr "hello") in
  let d3 = TDFn "addOne"  ["x"] (TELet "y" (TEAdd (TEVar "x") (TEInt 1)) (TEVar "y")) in
  let d4 = TDFn "callInc" ["x"] (TEApp (TEVar "inc") (TEVar "x")) in
  -- Phase 7.8b: TEIf / TELam / TEMatch.
  let d5 = TDFn "choose"  ["b"] (TEIf (TEVar "b") (TEInt 1) (TEInt 2)) in
  let d6 = TDFn "double"  []    (TELam "x" (TEAdd (TEVar "x") (TEVar "x"))) in
  -- TEMatch parallel-list construction: list-literal elements that
  -- start with a TypeId ctor app have to be let-bound individually
  -- so the parser doesn't treat `[PInt 0 PWild]` as a single curried
  -- ctor application. Same workaround `18-hminfer-real.lll`'s t18
  -- match case (line 955 area) uses.
  let classifyPat1 = PInt 0 in
  let classifyPat2 = PWild in
  let classifyPats = [classifyPat1 classifyPat2] in
  let classifyBody1 = TEStr "zero" in
  let classifyBody2 = TEStr "other" in
  let classifyBodies = [classifyBody1 classifyBody2] in
  let classifyExpr = TEMatch (TEVar "x") classifyPats classifyBodies in
  let d7 = TDFn "classify" ["x"] classifyExpr in
  -- Phase 7.8c: three TDType sum-type decls exercising every
  -- `showTypeDecl` sub-case.
  --   `Maybe` — parametric (`<'A>`), mixes an arg-bearing ctor (`Some
  --     of 'A`) with a nullary ctor (`None`).
  --   `Shape` — monomorphic (no `<>`), mixes nullary (`Circle`,
  --     `Empty`) with a multi-arg ctor (`Rect of int64 * int64`) to
  --     exercise the `" * "` join in `showCtorArgs`.
  --   `Pair`  — two-type-param header (`<'A, 'B>`) with a single
  --     multi-arg ctor to exercise the `", "` join in
  --     `showTypeParamsBody` as well as the `TAVar` arm of
  --     `showTypeArg`.
  -- The list-literal construction for `ctors` needs the same let-bind-
  -- each-element workaround as the `classifyPats` list above: list-
  -- literal elements that start with a `TypeId` ctor app (e.g.
  -- `MkCtor ...`) parse as a single curried app when written inline,
  -- so each `MkCtor` call is let-bound individually before being
  -- stitched into the outer `[...]` literal. Same workaround applies
  -- to the inner `TAVar` / `TAName` element lists.
  let maybeArg1 = TAVar "A" in
  let maybeSomeArgs = [maybeArg1] in
  let maybeSome = MkCtor "Some" maybeSomeArgs in
  let maybeNone = MkCtor "None" [] in
  let maybeCtors = [maybeSome maybeNone] in
  let d8 = TDType "Maybe" ["A"] maybeCtors in
  let rectArg1 = TAName "Int" in
  let rectArg2 = TAName "Int" in
  let rectArgs = [rectArg1 rectArg2] in
  let shapeCircle = MkCtor "Circle" [] in
  let shapeRect = MkCtor "Rect" rectArgs in
  let shapeEmpty = MkCtor "Empty" [] in
  let shapeCtors = [shapeCircle shapeRect shapeEmpty] in
  let d9 = TDType "Shape" [] shapeCtors in
  let pairArg1 = TAVar "A" in
  let pairArg2 = TAVar "B" in
  let pairArgs = [pairArg1 pairArg2] in
  let pairMk = MkCtor "MkPair" pairArgs in
  let pairCtors = [pairMk] in
  let d10 = TDType "Pair" ["A" "B"] pairCtors in
  -- Phase 7.8d: wrap the ten decls in a `Module` value and render via
  -- `showModule`, which prepends the `module Examples.Generated`
  -- header and the F# stdlib prelude block before walking the decls.
  -- Types come before fns in the list so the output mirrors the
  -- host's `emitModule` layout (types first, prelude next, fns last).
  -- This slice doesn't bother splitting the decl list by kind inside
  -- `showModule`; it just trusts the caller to order them correctly.
  -- Phase 7.8e+ may add a kind-aware sort once mutual-recursion
  -- grouping lands.
  let allDecls = [d8 d9 d10 d1 d2 d3 d4 d5 d6 d7] in
  let m = MkModule "Examples.Generated" allDecls in
  printfn (showModule m)
