module Example.OperatorsPrecedence

Maybe = Some Int | None

inc(x Int) Int = x + 1
dbl(x Int) Int = x * 2
toSome(x Int) Maybe = Some x

pipeChain(x Int) Int =
  x |> inc |> dbl

legacyPipeAlias(x Int) Int =
  x -> inc -> dbl

bindChain(m Maybe) Maybe =
  m >>= toSome >>= toSome

seqChain(a Maybe)(b Maybe)(c Maybe) Maybe =
  a >> b >> c

choiceChain(a Maybe)(b Maybe)(c Maybe) Maybe =
  a <|> b <|> c

mixed(x Int)(alt Maybe) Maybe =
  x |> toSome >>= toSome <|> alt

sample = mixed 1 None
