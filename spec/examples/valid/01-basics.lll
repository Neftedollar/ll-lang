module Examples.Basics

-- constants
let pi = 3.14159
let greeting = "hello"

-- simple functions
add(a Int)(b Int) = a + b
double(x Int) = x * 2

-- inferred return type
square(x Int) = x * x

-- multi-branch if
clamp(x Int)(lo Int)(hi Int) =
  if x < lo
    lo
  else if x > hi
    hi
  else x

-- lambda
let triple = \x. x * 3

-- let binding
example =
  y = double 5
  y + 1
