module Examples.Basics

-- constants
let pi = 3.14159
let greeting = "hello"

-- simple functions
fn add(a Int)(b Int) Int = a + b
fn double(x Int) = x * 2

-- inferred return type
fn square(x Int) = x * x

-- multi-branch if
fn clamp(x Int)(lo Int)(hi Int) Int =
  if x < lo
    lo
  else if x > hi
    hi
  else x

-- lambda
let triple = \x. x * 3

-- let binding
fn example =
  let y = double 5
  y + 1
