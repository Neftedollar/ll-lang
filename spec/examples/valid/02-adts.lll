module Examples.ADTs

-- product type
Point = x Float, y Float

-- sum type
Shape = Circle Float | Rect Float Float | Empty

-- parametric
Maybe A = Some A | None
Result A E = Ok A | Err E

-- pattern match (exhaustive)
area(s Shape) =
  | Circle r -> 3.14159 * r * r
  | Rect w h -> w * h
  | Empty -> 0.0

-- Maybe usage
safeDivide(a Float)(b Float) =
  if b == 0.0
    None
  else Some (a / b)

-- Result usage
parseAge(s Str) =
  if s == ""
    Err "empty input"
  else Ok 42
