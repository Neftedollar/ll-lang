module Examples.FnParser

-- Phase 7.3b: a real recursive-descent **fn-declaration** parser written in
-- ll-lang itself. Fourth self-hosting milestone after 09-lexer-real.lll,
-- 11-parser-real.lll, and 12-typeparser-real.lll. Together they cover
-- lexing, expression parsing, type-declaration parsing, and (this slice)
-- fn-declaration parsing — four of the five pieces of the eventual
-- ll-lang-in-ll-lang front end.
--
-- Grammar (single-line form only):
--   fnDecl = 'fn' lower param* typeName? '=' expr
--   param  = '(' lower typeName ')'       (* each curried param is its own group *)
--         |  '(' ')'                      (* nullary marker, produces no params *)
--   expr   = term (('+' | '-') term)*
--   term   = factor (('*' | '/') factor)*
--   factor = int | lower | '(' expr ')'
--
-- The body expression is a strict subset of 11-parser-real.lll's grammar:
-- no `if`, no `let`, no `match`, no lambdas. That's Phase 7.3c's job. What
-- this slice cares about is: fn keyword + name + curried param groups +
-- optional return type + `=` + a simple arithmetic body.
--
-- The pretty-printer normalises each decl to:
--   fn <name> (<p1>: <T1>) (<p2>: <T2>) -> <RetOrQMark> = <bodyExpr>
-- Missing return types print as `?`. Arithmetic sub-trees are fully
-- parenthesised, leaves print as int literals or bare names. The runtime
-- test string-matches each of the four decls in the driver input.

type Maybe A = Some A | None

type Token =
  | TKwFn
  | TLower Str
  | TUpper Str
  | TNum Int
  | TLParen
  | TRParen
  | TEq
  | TPlus
  | TMinus
  | TStar
  | TSlash
  | TNewline
  | TEnd

type TypeRef = TR Str

type Param = MkParam Str TypeRef

type Expr =
  | ENum Int
  | EVar Str
  | EAdd Expr Expr
  | ESub Expr Expr
  | EMul Expr Expr
  | EDiv Expr Expr

type FnDecl = MkFn Str List[Param] Maybe[TypeRef] Expr

-- ---------- Char predicates ---------------------------------------------

fn isUpperChar(c Char) Bool =
  let n = charToInt c
  if n < 65 then false
  else if n > 90 then false
  else true

fn isLowerChar(c Char) Bool =
  let n = charToInt c
  if n < 97 then false
  else if n > 122 then false
  else true

fn isIdStart(c Char) Bool =
  if isUpperChar c then true else isLowerChar c

fn isIdCont(c Char) Bool =
  if isIdStart c then true else charIsDigit c

-- ---------- Lexer --------------------------------------------------------

-- Greedy take/drop while predicate, shared shape with earlier milestones.
fn takeWhilePred(p)(cs List[Char]) List[Char] =
  | c :: rest -> if p c then listAppend [c] (takeWhilePred p rest) else []
  | _ -> []

fn dropWhilePred(p)(cs List[Char]) List[Char] =
  | c :: rest -> if p c then dropWhilePred p rest else cs
  | _ -> []

-- Unwrap Maybe Int from strToInt; malformed digit runs fall back to 0
-- (the lexer only calls this on strings that are already all-digits).
fn parseIntStr(s Str) Int =
  match strToInt s with
    | Some n -> n
    | None -> 0

-- Classify an identifier string. `fn` is the keyword; uppercase-start
-- becomes TUpper (used for type names); everything else is TLower.
fn classifyIdent(s Str) Token =
  match s with
    | "fn" -> TKwFn
    | _ ->
      let cs = strChars s
      match cs with
        | c :: _ -> if isUpperChar c then TUpper s else TLower s
        | _ -> TLower s

fn lexId(cs List[Char]) List[Token] =
  let idChars = takeWhilePred isIdCont cs
  let leftover = dropWhilePred isIdCont cs
  let tok = classifyIdent (strFromChars idChars)
  listAppend [tok] (lexChars leftover)

-- Phase 7.3b-fixes bug 1: `[TNum (...)]` is now a single-element list with
-- the ctor already applied, so the `let tok = ... in` helper has been
-- inlined into the final listAppend call.
fn lexNum(cs List[Char]) List[Token] =
  let digits = takeWhilePred charIsDigit cs
  let leftover = dropWhilePred charIsDigit cs
  listAppend [TNum (parseIntStr (strFromChars digits))] (lexChars leftover)

fn lexChars(cs List[Char]) List[Token] =
  | c :: rest ->
    if c == '\n' then listAppend [TNewline] (lexChars rest)
    else if charIsSpace c then lexChars rest
    else if isIdStart c then lexId cs
    else if charIsDigit c then lexNum cs
    else if c == '(' then listAppend [TLParen] (lexChars rest)
    else if c == ')' then listAppend [TRParen] (lexChars rest)
    else if c == '=' then listAppend [TEq] (lexChars rest)
    else if c == '+' then listAppend [TPlus] (lexChars rest)
    else if c == '-' then listAppend [TMinus] (lexChars rest)
    else if c == '*' then listAppend [TStar] (lexChars rest)
    else if c == '/' then listAppend [TSlash] (lexChars rest)
    else lexChars rest
  | _ -> [TEnd]

fn tokenize(src Str) List[Token] = lexChars (strChars src)

-- ---------- Recursive-descent parser ------------------------------------

-- Skip leading newlines so blank lines between decls are invisible.
fn skipNewlines(toks List[Token]) List[Token] =
  | TNewline :: rest -> skipNewlines rest
  | _ -> toks

-- Top-level driver. Walks the token stream one fn at a time until TEnd.
fn parseFnDecls(toks List[Token]) List[FnDecl] =
  parseDeclsClean (skipNewlines toks)

fn parseDeclsClean(toks List[Token]) List[FnDecl] =
  | TKwFn :: _ -> consDecl (parseFnDecl toks)
  | _ -> []

fn consDecl(pair) List[FnDecl] =
  let (d, rest) = pair
  d :: parseFnDecls rest

-- Single fn decl: 'fn' lower param* typeName? '=' expr
fn parseFnDecl(toks List[Token]) =
  | TKwFn :: TLower name :: rest ->
    let (prms, rest2) = parseParamGroups rest
    let (retTy, rest3) = parseReturnType rest2
    let rest4 = match rest3 with
      | TEq :: r -> r
      | _ -> rest3
   
    let (body, rest5) = parseExpr rest4
    (MkFn name prms retTy body, rest5)
  | _ -> (MkFn "?" [] None (ENum 0), toks)

-- Zero or more param groups. `()` means "no params" and produces [];
-- `(name Type)` contributes a single MkParam to the running list.
fn parseParamGroups(toks List[Token]) =
  | TLParen :: TRParen :: rest -> ([], rest)
  | TLParen :: TLower pname :: TUpper tname :: TRParen :: rest ->
    let (ps, rest2) = parseParamGroups rest
    (MkParam pname (TR tname) :: ps, rest2)
  | _ -> ([], toks)

-- Optional return type: a TUpper just before `=` becomes Some (TR name),
-- anything else (most commonly the `=` token itself) becomes None.
fn parseReturnType(toks List[Token]) =
  | TUpper tname :: rest -> (Some (TR tname), rest)
  | _ -> (None, toks)

-- ---------- Expression parser (subset of 11-parser-real.lll) -----------

-- Five-way mutual recursion. Same shape as the arithmetic parser, but
-- parseFactor also accepts TLower as a variable reference.
fn parseExpr(toks List[Token]) =
  let (e, rest) = parseTerm toks
  parseExprTail e rest

fn parseExprTail(lhs Expr)(toks List[Token]) =
  | TPlus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (EAdd lhs r) rest2
  | TMinus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (ESub lhs r) rest2
  | _ -> (lhs, toks)

fn parseTerm(toks List[Token]) =
  let (e, rest) = parseFactor toks
  parseTermTail e rest

fn parseTermTail(lhs Expr)(toks List[Token]) =
  | TStar :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EMul lhs r) rest2
  | TSlash :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EDiv lhs r) rest2
  | _ -> (lhs, toks)

fn parseFactor(toks List[Token]) =
  | TNum n :: rest -> (ENum n, rest)
  | TLower s :: rest -> (EVar s, rest)
  | TLParen :: rest ->
    let (e, rest2) = parseExpr rest
    match rest2 with
      | TRParen :: rest3 -> (e, rest3)
      | _ -> (e, rest2)
  | _ -> (ENum 0, toks)

-- ---------- Pretty printer ----------------------------------------------

-- Body expression: leaves print bare, binary nodes fully parenthesised.
fn showExpr(e Expr) Str =
  | ENum n -> intToStr n
  | EVar s -> s
  | EAdd l r -> strConcat (strConcat (strConcat (strConcat "(" (showExpr l)) " + ") (showExpr r)) ")"
  | ESub l r -> strConcat (strConcat (strConcat (strConcat "(" (showExpr l)) " - ") (showExpr r)) ")"
  | EMul l r -> strConcat (strConcat (strConcat (strConcat "(" (showExpr l)) " * ") (showExpr r)) ")"
  | EDiv l r -> strConcat (strConcat (strConcat (strConcat "(" (showExpr l)) " / ") (showExpr r)) ")"

fn showTypeRef(t TypeRef) Str =
  | TR s -> s

fn showParam(p Param) Str =
  | MkParam n t -> strConcat (strConcat (strConcat "(" n) ": ") (strConcat (showTypeRef t) ")")

-- Render the curried param list as ` (a: Int) (b: Int)` with a leading
-- space on every group, or ` ()` when there are no params at all. That
-- matches the `fn answer ()` shape from the driver.
fn showParams(ps List[Param]) Str =
  if listIsEmpty ps then " ()"
  else listFold (\acc p. strConcat (strConcat acc " ") (showParam p)) "" ps

fn showReturn(r Maybe[TypeRef]) Str =
  match r with
    | Some t -> showTypeRef t
    | None -> "?"

fn showDecl(d FnDecl) Str =
  | MkFn name prms ret body ->
    let headPart = strConcat (strConcat "fn " name) (showParams prms)
    let arrowPart = strConcat (strConcat headPart " -> ") (showReturn ret)
    strConcat (strConcat arrowPart " = ") (showExpr body)

fn show(ds List[FnDecl]) Str =
  listFold (\acc d. if strLen acc == 0 then showDecl d else strConcat (strConcat acc "\n") (showDecl d)) "" ds

-- ---------- Driver -------------------------------------------------------

fn main() =
  let src = "fn add(a Int)(b Int) Int = a + b\nfn double(x Int) = x * 2\nfn const(a Int)(b Int) Int = a\nfn answer() Int = 42"
  let toks = tokenize src
  let decls = parseFnDecls toks
  printfn (show decls)
