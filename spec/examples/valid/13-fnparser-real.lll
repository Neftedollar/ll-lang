module Examples.FnParser

-- Phase 7.3b: a real recursive-descent **fn-declaration** parser written in
-- ll-lang itself. Fourth self-hosting milestone after 09-lexer-real.lll,
-- 11-parser-real.lll, and 12-typeparser-real.lll. Together they cover
-- lexing, expression parsing, type-declaration parsing, and (this slice)
-- fn-declaration parsing — four of the five pieces of the eventual
-- ll-lang-in-ll-lang front end.
--
-- Grammar (single-line form only):
--   fnDecl = 'fn' lower param* typeName? '=' expr
--   param  = '(' lower typeName ')'       (* each curried param is its own group *)
--         |  '(' ')'                      (* nullary marker, produces no params *)
--   expr   = term (('+' | '-') term)*
--   term   = factor (('*' | '/') factor)*
--   factor = int | lower | '(' expr ')'
--
-- The body expression is a strict subset of 11-parser-real.lll's grammar:
-- no `if`, no `let`, no `match`, no lambdas. That's Phase 7.3c's job. What
-- this slice cares about is: fn keyword + name + curried param groups +
-- optional return type + `=` + a simple arithmetic body.
--
-- The pretty-printer normalises each decl to:
--   fn <name> (<p1>: <T1>) (<p2>: <T2>) -> <RetOrQMark> = <bodyExpr>
-- Missing return types print as `?`. Arithmetic sub-trees are fully
-- parenthesised, leaves print as int literals or bare names. The runtime
-- test string-matches each of the four decls in the driver input.

Maybe A = Some A | None

Token =
  | TLower Str
  | TUpper Str
  | TNum Int
  | TLParen
  | TRParen
  | TEq
  | TPlus
  | TMinus
  | TStar
  | TSlash
  | TNewline
  | TEnd

TypeRef = TR Str

Param = MkParam Str TypeRef

Expr =
  | ENum Int
  | EVar Str
  | EAdd Expr Expr
  | ESub Expr Expr
  | EMul Expr Expr
  | EDiv Expr Expr

FnDecl = MkFn Str List[Param] Maybe[TypeRef] Expr

-- ---------- Char predicates ---------------------------------------------

isUpperChar(c Char) =
  n = charToInt c
  if n < 65
    false
  else if n > 90
    false
  else true

isLowerChar(c Char) =
  n = charToInt c
  if n < 97
    false
  else if n > 122
    false
  else true

isIdStart(c Char) =
  if isUpperChar c
    true
  else isLowerChar c

isIdCont(c Char) =
  if isIdStart c
    true
  else charIsDigit c

-- ---------- Lexer --------------------------------------------------------

-- Greedy take/drop while predicate, shared shape with earlier milestones.
takeWhilePred(p)(cs List[Char]) =
  | c :: rest ->
    if p c
      listAppend [c] (takeWhilePred p rest)
    else []
  | _ -> []

dropWhilePred(p)(cs List[Char]) =
  | c :: rest ->
    if p c
      dropWhilePred p rest
    else cs
  | _ -> []

-- Unwrap Maybe Int from strToInt; malformed digit runs fall back to 0
-- (the lexer only calls this on strings that are already all-digits).
parseIntStr(s Str) =
  match strToInt s
    | Some n -> n
    | None -> 0

-- Classify an identifier string. `fn` is the keyword; uppercase-start
-- becomes TUpper (used for type names); everything else is TLower.
classifyIdent(s Str) =
  match s
    | _ ->
      cs = strChars s
      match cs
        | c :: _ ->
          if isUpperChar c
            TUpper s
          else TLower s
        | _ -> TLower s

lexId(cs List[Char]) =
  idChars = takeWhilePred isIdCont cs
  leftover = dropWhilePred isIdCont cs
  tok = classifyIdent (strFromChars idChars)
  listAppend [tok] (lexChars leftover)

-- Phase 7.3b-fixes bug 1: `[TNum (...)]` is now a single-element list with
-- the ctor already applied, so the `let tok = ... in` helper has been
-- inlined into the final listAppend call.
lexNum(cs List[Char]) =
  digits = takeWhilePred charIsDigit cs
  leftover = dropWhilePred charIsDigit cs
  listAppend [TNum (parseIntStr (strFromChars digits))] (lexChars leftover)

lexChars(cs List[Char]) =
  | c :: rest ->
    if c == '\n'
      listAppend [TNewline] (lexChars rest)
    else if charIsSpace c
      lexChars rest
    else if isIdStart c
      lexId cs
    else if charIsDigit c
      lexNum cs
    else if c == '('
      listAppend [TLParen] (lexChars rest)
    else if c == ')'
      listAppend [TRParen] (lexChars rest)
    else if c == '='
      listAppend [TEq] (lexChars rest)
    else if c == '+'
      listAppend [TPlus] (lexChars rest)
    else if c == '-'
      listAppend [TMinus] (lexChars rest)
    else if c == '*'
      listAppend [TStar] (lexChars rest)
    else if c == '/'
      listAppend [TSlash] (lexChars rest)
    else lexChars rest
  | _ -> [TEnd]

tokenize(src Str) = lexChars (strChars src)

-- ---------- Recursive-descent parser ------------------------------------

-- Skip leading newlines so blank lines between decls are invisible.
skipNewlines(toks List[Token]) =
  | TNewline :: rest -> skipNewlines rest
  | _ -> toks

-- Top-level driver. Walks the token stream one fn at a time until TEnd.
parseFnDecls(toks List[Token]) =
  parseDeclsClean (skipNewlines toks)

parseDeclsClean(toks List[Token]) =
  | TLower _ :: _ -> consDecl (parseFnDecl toks)
  | _ -> []

consDecl(pair) =
  let (d, rest) = pair
  d :: parseFnDecls rest

-- Single fn decl: 'fn' lower param* typeName? '=' expr
parseFnDecl(toks List[Token]) =
  | TLower name :: rest ->
    let (prms, rest2) = parseParamGroups rest
    let (retTy, rest3) = parseReturnType rest2
    rest4 = match rest3
      | TEq :: r -> r
      | _ -> rest3
   
    let (body, rest5) = parseExpr rest4
    (MkFn name prms retTy body, rest5)
  | _ -> (MkFn "?" [] None (ENum 0), toks)

-- Zero or more param groups. `()` means "no params" and produces [];
-- `(name Type)` contributes a single MkParam to the running list.
parseParamGroups(toks List[Token]) =
  | TLParen :: TRParen :: rest -> ([], rest)
  | TLParen :: TLower pname :: TUpper tname :: TRParen :: rest ->
    let (ps, rest2) = parseParamGroups rest
    (MkParam pname (TR tname) :: ps, rest2)
  | _ -> ([], toks)

-- Optional return type: a TUpper just before `=` becomes Some (TR name),
-- anything else (most commonly the `=` token itself) becomes None.
parseReturnType(toks List[Token]) =
  | TUpper tname :: rest -> (Some (TR tname), rest)
  | _ -> (None, toks)

-- ---------- Expression parser (subset of 11-parser-real.lll) -----------

-- Five-way mutual recursion. Same shape as the arithmetic parser, but
-- parseFactor also accepts TLower as a variable reference.
parseExpr(toks List[Token]) =
  let (e, rest) = parseTerm toks
  parseExprTail e rest

parseExprTail(lhs Expr)(toks List[Token]) =
  | TPlus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (EAdd lhs r) rest2
  | TMinus :: rest ->
    let (r, rest2) = parseTerm rest
    parseExprTail (ESub lhs r) rest2
  | _ -> (lhs, toks)

parseTerm(toks List[Token]) =
  let (e, rest) = parseFactor toks
  parseTermTail e rest

parseTermTail(lhs Expr)(toks List[Token]) =
  | TStar :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EMul lhs r) rest2
  | TSlash :: rest ->
    let (r, rest2) = parseFactor rest
    parseTermTail (EDiv lhs r) rest2
  | _ -> (lhs, toks)

parseFactor(toks List[Token]) =
  | TNum n :: rest -> (ENum n, rest)
  | TLower s :: rest -> (EVar s, rest)
  | TLParen :: rest ->
    let (e, rest2) = parseExpr rest
    match rest2
      | TRParen :: rest3 -> (e, rest3)
      | _ -> (e, rest2)
  | _ -> (ENum 0, toks)

-- ---------- Pretty printer ----------------------------------------------

-- Body expression: leaves print bare, binary nodes fully parenthesised.
showExpr(e Expr) =
  | ENum n -> intToStr n
  | EVar s -> s
  | EAdd l r -> "(" + showExpr l + " + " + showExpr r + ")"
  | ESub l r -> "(" + showExpr l + " - " + showExpr r + ")"
  | EMul l r -> "(" + showExpr l + " * " + showExpr r + ")"
  | EDiv l r -> "(" + showExpr l + " / " + showExpr r + ")"

showTypeRef(t TypeRef) =
  | TR s -> s

showParam(p Param) =
  | MkParam n t -> "(" + n + ": " + showTypeRef t + ")"

-- Render the curried param list as ` (a: Int) (b: Int)` with a leading
-- space on every group, or ` ()` when there are no params at all. That
-- matches the `fn answer ()` shape from the driver.
showParams(ps List[Param]) =
  if listIsEmpty ps
    " ()"
  else listFold (\acc p. acc + " " + showParam p) "" ps

showReturn(r Maybe[TypeRef]) =
  match r
    | Some t -> showTypeRef t
    | None -> "?"

showDecl(d FnDecl) =
  | MkFn name prms ret body ->
    headPart = name + showParams prms
    arrowPart = headPart + " -> " + showReturn ret
    arrowPart + " = " + showExpr body

show(ds List[FnDecl]) =
  listFold (\acc d. if strLen acc == 0
    showDecl d
  else acc + "\n" + showDecl d) "" ds

-- ---------- Driver -------------------------------------------------------

main() =
  src = "add(a Int)(b Int) Int = a + b\ndouble(x Int) = x * 2\nconst(a Int)(b Int) Int = a\nanswer() Int = 42"
  toks = tokenize src
  decls = parseFnDecls toks
  printfn (show decls)
