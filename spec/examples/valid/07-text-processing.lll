module Examples.TextProcessing

-- Phase 6.5: exercise the extended stdlib (Char + str/list extras).
-- Counts the number of digit chars in a string.

fn countDigits(s Str) Int =
  listFold (\acc. \c. if charIsDigit c
    acc + 1
  else acc) 0 (strChars s)

fn main() =
  printfn (intToStr (countDigits "abc123def45"))
