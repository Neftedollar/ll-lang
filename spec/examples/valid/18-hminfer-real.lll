module Examples.HMInferReal

-- Phase 7.7a: the first slice of **Hindley-Milner inference written in
-- ll-lang itself**. After Phase 7.6 closed out the front-end half of
-- self-hosting (lex / parse / elaborate, all in ll-lang), this file
-- starts the H-M middle: a minimal `TypeExpr`, an association-list
-- `Subst`, and a position-agnostic `unify` mirroring the F# host's
-- `HMInfer.unify` in `src/LLLangCompiler/HMInfer.fs` line 63 area.
--
-- Scope ("slice A" — keep tight):
--   * `TypeExpr` = TyName / TyVar / TyFn (no `TyApp`, no `TyTagged`).
--   * `Subst` as two parallel lists `List[Str]` + `List[TypeExpr]`.
--     Tuples-in-list have surface-syntax friction in ll-lang, so two
--     parallel lists is the cleanest fit (same trick as
--     `16-elaborator-real.lll` for `EMatch` arms).
--   * `Maybe[Subst]` for the unify result. `None` = mismatch, `Some s`
--     = success. No `Result[Subst, LLError]` yet — error codes /
--     positions land in a later slice once `inferExpr` needs them.
--   * `applyType` walks `TyVar v -> lookup, TyFn a b -> recurse,
--     TyName _ -> as-is`. **No occurs check** — Phase 7.7b.
--   * No `composeSubst`: this slice's `unify TyFn TyFn` arm reuses
--     the head subst directly without composing the tail. Composition
--     only matters once the inferred type contains chains across
--     multiple binders, which only `inferExpr` (Phase 7.7b) needs.
--   * **No `inferExpr`** — proving `unify` works is the tighter slice.
--     The full algorithm-W loop with env / fresh / state threading
--     is Phase 7.7b. The `Expr` type and a hint at the algorithm-W
--     entry stub exist in the doc strings only.
--
-- Out of scope (later slices in the Phase 7.7 umbrella):
--   * Let-generalization, polymorphism, type schemes
--   * `ELam` / `EIf` / `EMatch` / `ELet` / `EApp` inference
--   * Trait dispatch
--   * Occurs check (`OccursCheck` E008) — Phase 7.7b
--   * Tagged types (`TyTagged`) and unit-mismatch errors
--   * Record types
--
-- Hardcoded test plan in `main`:
--   t1: unify Int Int                    -> ok
--   t2: unify Int Str                    -> mismatch
--   t3: unify a Int                      -> ok bound a
--   t4: unify (Int -> Str) (Int -> Str)  -> ok
--   t5: unify (Int -> Str) (Int -> Bool) -> mismatch
--
-- Expected stdout (one line per test, joined into a single `printfn`
-- call because `fn main` has a single expression body and ll-lang has
-- no statement-sequence syntax — see the `joinLines` helper):
--   t1 unify Int Int ok
--   t2 unify Int Str mismatch
--   t3 unify a Int ok bound a
--   t4 unify (Int -> Str) (Int -> Str) ok
--   t5 unify (Int -> Str) (Int -> Bool) mismatch

-- ---------- Maybe -------------------------------------------------------

-- Local `Maybe` so the codegen prelude wires the Maybe-dependent helpers
-- (`listHead` / `listTail` / `maybeMap` / ...). This file uses
-- `Some` / `None` directly for env / subst lookups, not via stdlib.
type Maybe A = Some A | None

-- ---------- Outcome (Phase 7.7d) ----------------------------------------

-- Success / error carrier for `unify` and `inferExpr`. Phase 7.7b/7.7c
-- used a `TyName "ERROR"` sentinel to keep the driver printfn-only; 7.7d
-- replaces that with a proper Result-like type so the runtime-visible
-- error messages match the F# host's E001/E008 shape.
--
-- Named `Outcome` (not `Result`) so the codegen prelude doesn't try to
-- emit its `resultMap` / `resultBind` / `resultMapErr` bindings — those
-- assume a two-param `type Result A E = Ok A | Err E`, and we only need
-- a one-param error-is-always-Str carrier here.
--   * `OkR a`    — success with payload `a`
--   * `ErrR msg` — failure carrying a human-readable diagnostic string
type Outcome A = OkR A | ErrR Str

-- ---------- TypeExpr ----------------------------------------------------

-- Minimal type-expression AST. Mirrors the F# host's
-- `LLLang.AST.TypeExpr` minus `TyApp` and `TyTagged`.
--   * `TyName n`  — concrete nominal type: `TyName "Int"`,
--     `TyName "Str"`, `TyName "Bool"`. The host distinguishes
--     `TyName` from `TyVar` by the leading character; here we just
--     rely on the constructor tag.
--   * `TyVar v`   — type variable. The host uses `$0`, `$1`, ... for
--     flexible (unification) vars and bare lowercase letters for rigid
--     vars. This slice doesn't distinguish flex vs rigid — every
--     `TyVar` is treated as flexible / bindable.
--   * `TyFn a r`  — arrow type. Right-associative in surface syntax;
--     this AST is just two pointers, no associativity to worry about.
type TypeExpr =
  | TyName Str
  | TyVar Str
  | TyFn TypeExpr TypeExpr

-- ---------- Expr (placeholder for Phase 7.7b) ---------------------------

-- The expression AST that the next slice's `inferExpr` will walk.
-- Listed here as a doc-only stub so the file can be diffed against the
-- F# host side-by-side in 7.7b. `inferExpr env e` will then return
-- `(TypeExpr, Subst)` (or `Result[(TypeExpr, Subst), LLError]` once
-- errors land).
--
-- type Expr =
--   | EInt Int
--   | EStr Str
--   | EBool Bool
--   | EVar Str
--   | EAdd Expr Expr
--   | EApp Expr Expr

-- ---------- Subst -------------------------------------------------------

-- Substitution as two parallel lists: `keys` is a `List[Str]` of var
-- names, `vals` is a `List[TypeExpr]` of the types they bind to. Looked
-- up by linear scan in `lookupSubst`. Same parallel-list trick as
-- `16-elaborator-real.lll`'s `EMatch` arms — sidesteps the codegen
-- limitation that prevents tuples in `List[(Str, TypeExpr)]`.
type Subst = MkSubst List[Str] List[TypeExpr]

-- Zero-arg fns in ll-lang require a dummy parameter at the call site
-- (see `16-elaborator-real.lll` line 426 area for the same trick).
-- Pass any `Int` — it's ignored.
fn emptySubst(u Int) Subst = MkSubst [] []

fn singletonSubst(name Str)(t TypeExpr) Subst =
  MkSubst [name] [t]

-- Linear lookup over the parallel key/val lists. Walks both in lockstep
-- and returns `Some t` when the head key matches `name`, else recurses
-- into the tails. Returns `None` when either list is empty.
fn lookupSubst(s Subst)(name Str) Maybe[TypeExpr] =
  match s with
    | MkSubst keys vals ->
      lookupSubstLists keys vals name

fn lookupSubstLists(keys List[Str])(vals List[TypeExpr])(name Str) Maybe[TypeExpr] =
  match keys with
    | k :: ks ->
      match vals with
        | v :: vs ->
          if k == name then Some v
          else lookupSubstLists ks vs name
        | _ -> None
    | _ -> None

-- Walk a `TypeExpr` replacing every `TyVar v` whose name is bound in
-- `s` with the bound type. `TyName` is left as-is; `TyFn` recurses into
-- both children. Mirrors the F# host's `Types.applyType` in
-- `src/LLLangCompiler/Types.fs` line 26 area, minus the chain-following
-- recursive call (single-level lookup is enough for this slice because
-- the only binder we ever produce is `var -> non-var` from
-- `singletonSubst`).
fn applyType(s Subst)(t TypeExpr) TypeExpr =
  match t with
    | TyName _ -> t
    | TyVar v ->
      match lookupSubst s v with
        | Some bound -> bound
        | None -> t
    | TyFn a r -> TyFn (applyType s a) (applyType s r)

-- ---------- Occurs check (Phase 7.7d) -----------------------------------

-- Does `v` appear anywhere inside `t`? Used by `unify` before binding a
-- flex var to a non-trivial type so `unify a (TyFn a Int)` emits E008
-- instead of silently building a circular substitution. Mirrors the
-- F# host's `occurs` in `src/LLLangCompiler/HMInfer.fs` line 52 area.
fn occursIn(v Str)(t TypeExpr) Bool =
  match t with
    | TyName _ -> false
    | TyVar x -> x == v
    | TyFn a b -> if occursIn v a then true else occursIn v b

-- ---------- Unify -------------------------------------------------------

-- Position-agnostic unifier returning `Result Subst`. `ErrR msg` carries
-- a stringified diagnostic (either `E001 TypeMismatch` or
-- `E008 InfiniteType`); `OkR s` is the principal substitution. Cases
-- mirror the F# host's `unify` arm-by-arm:
--
--   * `TyName a` vs `TyName b`     — Ok empty if equal, else E001
--   * `TyVar a`  vs `TyVar b`      — Ok empty if same name, else bind
--                                    `a := TyVar b`
--   * `TyVar a`  vs t (non-var)    — occurs check, then Ok (a := t)
--   * t (non-var) vs `TyVar a`     — symmetric
--   * `TyFn a1 r1` vs `TyFn a2 r2` — unify args, then unify results
--                                    under that subst, compose
--   * anything else                — E001
--
-- Phase 7.7d notes:
--   * Occurs check fires when binding `TyVar v` to a type that
--     textually contains `v` — prevents infinite loops like
--     `unify a (TyFn a Int)`.
--   * Return type is `Result Subst` (was `Maybe Subst` in 7.7a-c), so
--     `inferExpr` can distinguish successes from mismatches without
--     the `TyName "ERROR"` sentinel.
--
-- Implementation note: ll-lang's match indentation rules make
-- multi-level nested `match t1 with | ... -> match t2 with | ...`
-- ambiguous (the inner match's last arm bleeds into the outer one).
-- Each `t1` arm is split into its own helper to keep matches one
-- level deep.
fn unify(t1 TypeExpr)(t2 TypeExpr) Outcome[Subst] =
  match t1 with
    | TyName a -> unifyName a t2
    | TyVar a -> unifyVar a t2
    | TyFn a1 r1 -> unifyFn a1 r1 t2

-- `TyName a` vs t2: equal name -> empty subst, var on the right -> bind,
-- anything else -> E001.
fn unifyName(a Str)(t2 TypeExpr) Outcome[Subst] =
  match t2 with
    | TyName b -> if a == b then OkR (emptySubst 0) else ErrR (strConcat (strConcat "E001 TypeMismatch " a) (strConcat " vs " b))
    | TyVar v -> OkR (singletonSubst v (TyName a))
    | _ -> ErrR (strConcat "E001 TypeMismatch TyName " a)

-- `TyVar a` vs t2: same var name -> empty subst; otherwise occurs-check
-- then bind `a := t2`. The `TyVar b` (different name) arm skips the
-- occurs check because `b != a` and a single TyVar can't contain `a`.
fn unifyVar(a Str)(t2 TypeExpr) Outcome[Subst] =
  match t2 with
    | TyVar b -> if a == b then OkR (emptySubst 0) else OkR (singletonSubst a t2)
    | _ ->
      if occursIn a t2 then ErrR (strConcat (strConcat "E008 InfiniteType " a) (strConcat " in " (showType t2)))
      else OkR (singletonSubst a t2)

-- `TyFn a1 r1` vs t2: only succeeds against another `TyFn`. Unifies
-- arg types first, applies the resulting subst to both result types,
-- then unifies the substituted results. Errors propagate via `ErrR`.
fn unifyFn(a1 TypeExpr)(r1 TypeExpr)(t2 TypeExpr) Outcome[Subst] =
  match t2 with
    | TyFn a2 r2 ->
      match unify a1 a2 with
        | OkR s1 ->
          let r1b = applyType s1 r1
          let r2b = applyType s1 r2
          unifyResults s1 r1b r2b
        | ErrR m -> ErrR m
    | _ -> ErrR "E001 TypeMismatch TyFn vs non-fn"

-- Helper for the inner `match unify ... with` of `unifyFn`. Composes the
-- head-side subst with the result-side subst so `inferExpr` sees every
-- bind accumulated during `TyFn` unification.
fn unifyResults(s1 Subst)(r1b TypeExpr)(r2b TypeExpr) Outcome[Subst] =
  match unify r1b r2b with
    | OkR s2 -> OkR (composeSubst s1 s2)
    | ErrR m -> ErrR m

-- ---------- composeSubst (Phase 7.7b) -----------------------------------

-- Dumb substitution composition: just concatenate the two parallel-list
-- substs head-to-tail. Mirrors the F# host's `Subst.compose` in
-- `src/LLLangCompiler/Types.fs` but WITHOUT the "apply s1 to s2's vals"
-- step — good enough for this slice because we only unify monomorphic
-- types (no polymorphism, no chained bindings). The head subst's keys
-- end up first in the resulting lists so a later `lookupSubst` finds
-- them ahead of any conflicting entry from the tail.
fn composeSubst(s1 Subst)(s2 Subst) Subst =
  match s1 with
    | MkSubst k1 v1 -> composeWith k1 v1 s2

fn composeWith(k1 List[Str])(v1 List[TypeExpr])(s2 Subst) Subst =
  match s2 with
    | MkSubst k2 v2 -> MkSubst (listAppend k1 k2) (listAppend v1 v2)

-- ---------- Pretty-printers ---------------------------------------------

-- Render a TypeExpr in a readable surface form. `TyVar v` prints the
-- raw name (`a`, `b`, `$0`); `TyName n` prints the name; `TyFn a r`
-- prints `(a -> r)` with explicit parens (no precedence handling
-- needed at this scale).
fn showType(t TypeExpr) Str =
  match t with
    | TyName n -> n
    | TyVar v -> v
    | TyFn a r ->
      let inner = strConcat (strConcat (showType a) " -> ") (showType r)
      strConcat (strConcat "(" inner) ")"

-- Return the first key in a `Subst` (for the `t3` "ok bound a" line).
-- Returns the empty string if the subst is empty — the test cases that
-- print this never bind more than one var, so a one-key peek is enough.
fn substFirstKey(s Subst) Str =
  match s with
    | MkSubst keys _ ->
      match keys with
        | k :: _ -> k
        | _ -> ""

-- ---------- Test driver -------------------------------------------------

-- Run a single labelled `unify` test and produce one stdout line. The
-- label is the test number, the two types are stringified, and the
-- result tail is one of:
--   * "ok"              — unify returned `OkR s` and `s` is empty
--   * "ok bound <k>"    — unify returned `OkR s` with `s` non-empty
--   * "mismatch"        — unify returned `ErrR` with an E001 message
--   * "infinite"        — unify returned `ErrR` with an E008 message
-- Phase 7.7d upgrade: the old "mismatch" branch now fans out on the
-- `ErrR` message prefix so the E008 (occurs check) line for t17 is
-- distinguishable from the E001 (type mismatch) lines for t2/t5.
fn runTest(label Str)(t1 TypeExpr)(t2 TypeExpr) Str =
  let header = strConcat (strConcat (strConcat (strConcat label " unify ") (showType t1)) " ") (showType t2)
  match unify t1 t2 with
    | OkR s ->
      let key = substFirstKey s
      if strLen key == 0 then strConcat header " ok"
      else strConcat (strConcat header " ok bound ") key
    | ErrR m ->
      if strContains "E008" m then strConcat header " infinite"
      else strConcat header " mismatch"

-- Join a list of strings with newline separators. Used to fold the five
-- test result lines into a single `printfn` argument because ll-lang's
-- `fn main = body` body is a single expression — there's no statement
-- sequencing.
fn joinLines(xs List[Str]) Str =
  listFold (\acc s. if strLen acc == 0 then s else strConcat (strConcat acc "\n") s) "" xs

-- ---------- TypeScheme / Env (Phase 7.7b, schemes in 7.7d) --------------

-- Polymorphic type scheme: `MkScheme vars body` represents
-- `∀ vars. body`. A monomorphic type has `vars = []`. Added in 7.7d to
-- enable let-generalization (`let id = \x. x in id 5` now types at
-- `Int` because `id` is generalized to `∀ a. a -> a` and instantiated
-- fresh at the use site).
type TypeScheme = MkScheme List[Str] TypeExpr

-- Typing environment: parallel `List[Str]` names + `List[TypeScheme]`
-- schemes. Same parallel-list trick as `Subst`. Before 7.7d this stored
-- raw `TypeExpr` — now it stores schemes so `ELet` can generalize.
type Env = MkEnv List[Str] List[TypeScheme]

-- Zero-arg constructor pattern: dummy `Int` param at the call site
-- (`emptyEnv 0`), same trick as `emptySubst`.
fn emptyEnv(u Int) Env = MkEnv [] []

-- Wrap a raw `TypeExpr` as a monomorphic scheme (no quantifiers). Used
-- by lambda-param / match-PVar binders where the binder type is a
-- fresh unification variable that must NOT be generalized (HM's
-- "value restriction" proxy).
fn mono(t TypeExpr) TypeScheme = MkScheme [] t

-- Extend an env with a new monomorphic binding. New entries go at the
-- head so `envLookup` finds the most recently bound name first
-- (classic lexical shadowing).
fn envExtend(e Env)(name Str)(t TypeExpr) Env =
  match e with
    | MkEnv ks vs -> MkEnv (name :: ks) (mono t :: vs)

-- Extend an env with a polymorphic scheme. Used only by `inferLet`
-- after `generalize` produces the scheme for the bound `e1`.
fn envExtendScheme(e Env)(name Str)(sch TypeScheme) Env =
  match e with
    | MkEnv ks vs -> MkEnv (name :: ks) (sch :: vs)

-- Linear lookup, same shape as `lookupSubst` / `lookupSubstLists`.
-- Returns `Some scheme`; callers instantiate fresh at the use site.
fn envLookup(e Env)(name Str) Maybe[TypeScheme] =
  match e with
    | MkEnv ks vs -> envLookupLists ks vs name

fn envLookupLists(keys List[Str])(vals List[TypeScheme])(name Str) Maybe[TypeScheme] =
  match keys with
    | k :: ks ->
      match vals with
        | v :: vs ->
          if k == name then Some v
          else envLookupLists ks vs name
        | _ -> None
    | _ -> None

-- Walk an `Env`'s scheme list and apply `s` to every scheme's body.
-- Mirrors `Types.applyEnv`. Quantified vars in each scheme are removed
-- from the substitution's domain before applying (so `∀ a. a -> a`
-- doesn't get `a` substituted if `a` happens to be in `s`).
fn applyEnv(s Subst)(e Env) Env =
  match e with
    | MkEnv ks vs -> MkEnv ks (applySchemeList s vs)

fn applySchemeList(s Subst)(schs List[TypeScheme]) List[TypeScheme] =
  match schs with
    | sc :: rest -> applyScheme s sc :: applySchemeList s rest
    | _ -> []

fn applyScheme(s Subst)(sch TypeScheme) TypeScheme =
  match sch with
    | MkScheme vars body ->
      let sRestricted = substRemoveAll s vars
      MkScheme vars (applyType sRestricted body)

-- Remove a list of keys from a `Subst`. Used by `applyScheme` so
-- quantified vars in a scheme shadow the subst.
fn substRemoveAll(s Subst)(ks List[Str]) Subst =
  match ks with
    | k :: rest -> substRemoveAll (substRemove s k) rest
    | _ -> s

fn substRemove(s Subst)(name Str) Subst =
  match s with
    | MkSubst keys vals -> substRemoveLists keys vals name

fn substRemoveLists(keys List[Str])(vals List[TypeExpr])(name Str) Subst =
  match keys with
    | k :: ks ->
      match vals with
        | v :: vs ->
          if k == name then MkSubst ks vs
          else
            match substRemoveLists ks vs name with
              | MkSubst ks2 vs2 -> MkSubst (k :: ks2) (v :: vs2)
        | _ -> MkSubst [] []
    | _ -> MkSubst [] []

-- Map `applyType s` over a list of `TypeExpr`. Written as an explicit
-- recursive walk rather than `listMap` because the corpus file doesn't
-- declare the stdlib `listMap` dependency and the recursive form is
-- the same cost as hauling in the builtin.
fn applyTypeList(s Subst)(ts List[TypeExpr]) List[TypeExpr] =
  match ts with
    | t :: rest -> applyType s t :: applyTypeList s rest
    | _ -> []

-- ---------- ftv / generalize / instantiate (Phase 7.7d) -----------------

-- String-list membership. Used by `ftvEnv` / `generalize` to compute
-- list differences. Written out rather than routed through stdlib's
-- `listContains` to keep the file dependency-closed.
fn listContainsStr(x Str)(xs List[Str]) Bool =
  match xs with
    | y :: rest -> if x == y then true else listContainsStr x rest
    | _ -> false

-- List difference: xs minus ys. Preserves order of xs.
fn listDiffStr(xs List[Str])(ys List[Str]) List[Str] =
  match xs with
    | x :: rest ->
      if listContainsStr x ys then listDiffStr rest ys
      else x :: listDiffStr rest ys
    | _ -> []

-- Deduplicate a string list, keeping first occurrences.
fn listDedupStr(xs List[Str]) List[Str] =
  match xs with
    | x :: rest ->
      let tail = listDedupStr rest
      if listContainsStr x tail then tail else x :: tail
    | _ -> []

-- Free type variables of a `TypeExpr`. All `TyVar` names are treated as
-- free (this slice doesn't distinguish flex `$0` from rigid `a`; every
-- TyVar is bindable). Results may contain duplicates — caller dedups.
fn ftvType(t TypeExpr) List[Str] =
  match t with
    | TyName _ -> []
    | TyVar v -> [v]
    | TyFn a b -> listAppend (ftvType a) (ftvType b)

-- Free type variables of a `TypeScheme`: ftv(body) minus the
-- quantified vars.
fn ftvScheme(sch TypeScheme) List[Str] =
  match sch with
    | MkScheme vars body -> listDiffStr (ftvType body) vars

-- Free type variables of an `Env`: union of `ftvScheme` over every
-- binding. Walks the scheme list directly because the parallel-list
-- Env doesn't expose a value iterator.
fn ftvEnv(e Env) List[Str] =
  match e with
    | MkEnv _ vs -> ftvSchemeList vs

fn ftvSchemeList(schs List[TypeScheme]) List[Str] =
  match schs with
    | sc :: rest -> listAppend (ftvScheme sc) (ftvSchemeList rest)
    | _ -> []

-- `generalize env t`: produce `MkScheme (ftv(t) - ftv(env)) t`. Quant
-- order is first-seen in the body walk.
fn generalize(e Env)(t TypeExpr) TypeScheme =
  let tFtv = listDedupStr (ftvType t)
  let envFtv = ftvEnv e
  let quant = listDiffStr tFtv envFtv
  MkScheme quant t

-- `instantiate n sch`: allocate a fresh unification var for each
-- quantifier, substitute into the scheme body, return the instantiated
-- type and the updated fresh counter.
fn instantiate(n Int)(sch TypeScheme) =
  match sch with
    | MkScheme vars body ->
      let (subst, n1) = freshSubstFor vars n
      (applyType subst body, n1)

-- Build a `Subst` that maps each `vars[i]` to a fresh `$n+i`. Threads
-- the counter and returns `(subst, newCounter)`.
fn freshSubstFor(vars List[Str])(n Int) =
  match vars with
    | v :: rest ->
      let (fresh, n1) = freshVar n
      let (tailSubst, n2) = freshSubstFor rest n1
      match tailSubst with
        | MkSubst ks vs -> (MkSubst (v :: ks) (fresh :: vs), n2)
    | _ -> (emptySubst 0, n)

-- ---------- Expr AST (Phase 7.7b) ---------------------------------------

-- The tiny expression AST that `inferExpr` walks. Deliberately smaller
-- than the F# host's `AST.Expr` — no `ELam` / `ELet` / `EIf` / `EMatch`
-- yet; those land in 7.7c onwards with let-generalization, polymorphism,
-- and type schemes. The header's doc-only stub promised exactly this
-- shape.
-- Phase 7.7c adds `ELam` (lambda), `ELet` (let-in, mono-bound — no
-- generalization yet), and `EIf` (if-then-else). `inferExpr` grows
-- three new arms mirroring the F# host's `ELam` / `ELet(_, _, Some _)`
-- / `EIf` cases in `src/LLLangCompiler/HMInfer.fs` line 260 / 276 /
-- 315 area. Each new arm is still split into its own helper to keep
-- `match` nesting one level deep.
-- ---------- Pat (Phase 7.7d) --------------------------------------------

-- Minimal pattern AST for `EMatch`. Same three-shape restriction as the
-- F# host's pattern-matcher arms this slice targets:
--   * `PInt n`  — literal integer (forces scrutinee to `Int`)
--   * `PVar x`  — bind scrutinee to `x` in the branch's extended env
--   * `PWild`   — ignore
-- No constructor patterns, no nested patterns — those land in a later
-- slice if/when the self-host compiler needs them.
type Pat =
  | PInt Int
  | PVar Str
  | PWild

type Expr =
  | EInt Int
  | EStr Str
  | EBool Bool
  | EVar Str
  | EAdd Expr Expr
  | EApp Expr Expr
  | ELam Str Expr
  | ELet Str Expr Expr
  | EIf Expr Expr Expr
  | EMatch Expr List[Pat] List[Expr]

-- ---------- Fresh var generator (Phase 7.7b) ----------------------------

-- Thread an `Int` counter through inference. Each call consumes `n` and
-- returns `(TyVar "$n", n + 1)`. Mirrors the F# host's `freshVar` in
-- `src/LLLangCompiler/Types.fs` (which uses a mutable ref cell; we stay
-- purely functional by threading the counter explicitly).
fn freshVar(n Int) =
  (TyVar (strConcat "$" (intToStr n)), n + 1)

-- ---------- InferResult carrier (Phase 7.7b) ----------------------------

-- `inferExpr` returns three things at once: the inferred type, the
-- substitution collected during inference, and the new fresh counter.
-- A tiny three-field ADT sidesteps the no-tuple-construction-in-return
-- workaround that plagued earlier slices.
type InferResult = MkInferResult TypeExpr Subst Int

-- ---------- inferExpr (Phase 7.7b, refactored in 7.7d) ------------------

-- Walk an `Expr` and produce a `Result InferResult`. Mirrors (a slice of)
-- the F# host's `HMInfer.inferExpr` in `src/LLLangCompiler/HMInfer.fs`
-- line 172 area. Each arm is split into its own helper to keep `match`
-- nesting one level deep — the same trick as `unify` uses, for the
-- same reason.
--
--   * `EInt _`  -> OkR (TyName "Int")
--   * `EStr _`  -> OkR (TyName "Str")
--   * `EBool _` -> OkR (TyName "Bool")
--   * `EVar name` -> env lookup, E002 on miss
--   * `EAdd l r`  -> infer l, infer r, unify both with `Int`
--   * `EApp f a`  -> infer f, infer a, fresh β, unify tf with `(ta -> β)`
--   * `ELam x b`  -> fresh α, extend env, infer b, return `(α -> τb)`
--   * `ELet x e1 e2` -> infer e1, extend env, infer e2
--   * `EIf c t e` -> unify c with `Bool`, infer branches, unify them
--
-- Phase 7.7d: return type is `Result InferResult` (was raw InferResult
-- with `TyName "ERROR"` sentinel) so callers see real error messages.
fn inferExpr(env Env)(n Int)(e Expr) Outcome[InferResult] =
  match e with
    | EInt _ -> OkR (MkInferResult (TyName "Int") (emptySubst 0) n)
    | EStr _ -> OkR (MkInferResult (TyName "Str") (emptySubst 0) n)
    | EBool _ -> OkR (MkInferResult (TyName "Bool") (emptySubst 0) n)
    | EVar name -> inferVar env n name
    | EAdd l r -> inferAdd env n l r
    | EApp f a -> inferApp env n f a
    | ELam name body -> inferLam env n name body
    | ELet name e1 e2 -> inferLet env n name e1 e2
    | EIf cond thn els -> inferIf env n cond thn els
    | EMatch scr pats bodies -> inferMatch env n scr pats bodies

-- `EVar`: env lookup then instantiate the scheme with fresh vars.
-- Phase 7.7d change: lookup returns `Maybe[TypeScheme]`, not
-- `Maybe[TypeExpr]`; `instantiate` replaces each quantifier with a
-- fresh flex var so polymorphic bindings (`let id = \x. x in ...`)
-- get fresh use-site types.
fn inferVar(env Env)(n Int)(name Str) Outcome[InferResult] =
  match envLookup env name with
    | Some sch ->
      let (t, n1) = instantiate n sch
      OkR (MkInferResult t (emptySubst 0) n1)
    | _ -> ErrR (strConcat "E002 UnboundVar " name)

-- `EAdd`: destructure the left-hand result, pass to `inferAddR`.
fn inferAdd(env Env)(n Int)(l Expr)(r Expr) Outcome[InferResult] =
  match inferExpr env n l with
    | OkR lRes -> inferAddL env lRes r
    | ErrR m -> ErrR m

fn inferAddL(env Env)(lRes InferResult)(r Expr) Outcome[InferResult] =
  match lRes with
    | MkInferResult tl sl nl -> inferAddR env nl sl tl r

-- Right-hand half of `EAdd`: recurse and thread errors.
fn inferAddR(env Env)(n Int)(sl Subst)(tl TypeExpr)(r Expr) Outcome[InferResult] =
  match inferExpr env n r with
    | OkR rRes -> inferAddRR sl tl rRes
    | ErrR m -> ErrR m

fn inferAddRR(sl Subst)(tl TypeExpr)(rRes InferResult) Outcome[InferResult] =
  match rRes with
    | MkInferResult tr sr nr -> inferAddUnify sl sr tl tr nr

-- Unify left operand with `Int`; on success dispatch; on failure ErrR.
fn inferAddUnify(sl Subst)(sr Subst)(tl TypeExpr)(tr TypeExpr)(n Int) Outcome[InferResult] =
  match unify tl (TyName "Int") with
    | OkR s3 -> inferAddUnify2 sl sr s3 tr n
    | ErrR m -> ErrR m

-- Unify right operand with `Int`; on success return `Int` under the
-- composed subst; on failure ErrR.
fn inferAddUnify2(sl Subst)(sr Subst)(s3 Subst)(tr TypeExpr)(n Int) Outcome[InferResult] =
  match unify tr (TyName "Int") with
    | OkR s4 ->
      let s12 = composeSubst sl sr
      let s123 = composeSubst s12 s3
      let sAll = composeSubst s123 s4
      OkR (MkInferResult (TyName "Int") sAll n)
    | ErrR m -> ErrR m

-- `EApp`: destructure the function result, pass to `inferAppArg`.
fn inferApp(env Env)(n Int)(f Expr)(a Expr) Outcome[InferResult] =
  match inferExpr env n f with
    | OkR fRes -> inferAppF env fRes a
    | ErrR m -> ErrR m

fn inferAppF(env Env)(fRes InferResult)(a Expr) Outcome[InferResult] =
  match fRes with
    | MkInferResult tf sf nf -> inferAppArg env nf sf tf a

-- Argument half of `EApp`: destructure the arg result, pass to
-- `inferAppFresh`.
fn inferAppArg(env Env)(n Int)(sf Subst)(tf TypeExpr)(a Expr) Outcome[InferResult] =
  match inferExpr env n a with
    | OkR aRes -> inferAppA sf tf aRes
    | ErrR m -> ErrR m

fn inferAppA(sf Subst)(tf TypeExpr)(aRes InferResult) Outcome[InferResult] =
  match aRes with
    | MkInferResult ta sa na -> inferAppFresh sf sa tf ta na

-- Fresh-var + unify half of `EApp`: allocate a fresh result type,
-- unify the (substituted) function type against `TyFn ta beta`, and
-- return the substituted `beta` as the result type.
fn inferAppFresh(sf Subst)(sa Subst)(tf TypeExpr)(ta TypeExpr)(n Int) Outcome[InferResult] =
  let (beta, n1) = freshVar n
  let tfApplied = applyType sa tf
  match unify tfApplied (TyFn ta beta) with
    | OkR s3 ->
      let s12 = composeSubst sf sa
      let sAll = composeSubst s12 s3
      let retTy = applyType sAll beta
      OkR (MkInferResult retTy sAll n1)
    | ErrR m -> ErrR m

-- ---------- ELam / ELet / EIf inference (Phase 7.7c) --------------------

-- `ELam name body`: allocate a fresh `α` for the param, extend the env
-- with `(name : α)`, infer the body under the extended env, and return
-- `TyFn (applyType sBody α) τbody` under `sBody`. Mirrors the F# host's
-- `ELam` arm in `src/LLLangCompiler/HMInfer.fs` line 260 area (minus
-- the multi-param curry — this slice only supports single-param
-- lambdas, which is all `\x. x`, `\x. x + 1`, etc. need).
fn inferLam(env Env)(n Int)(name Str)(body Expr) Outcome[InferResult] =
  let (alpha, n1) = freshVar n
  let env2 = envExtend env name alpha
  match inferExpr env2 n1 body with
    | OkR bRes -> OkR (inferLamOk alpha bRes)
    | ErrR m -> ErrR m

fn inferLamOk(alpha TypeExpr)(bRes InferResult) InferResult =
  match bRes with
    | MkInferResult tBody sBody nBody ->
      let paramTy = applyType sBody alpha
      MkInferResult (TyFn paramTy tBody) sBody nBody

-- `ELet name e1 e2`: infer `e1`, generalize τ1 over vars not free in
-- the env-after-s1, extend the env with the scheme, infer `e2`, return
-- `τ2` under `compose s2 s1`. Phase 7.7d: the `generalize` call enables
-- polymorphic let-bound identifiers — `let id = \x. x in id 5` now
-- types at `Int` because `id`'s scheme is `∀ $0. $0 -> $0` and gets
-- instantiated to `$1 -> $1` at the use site.
fn inferLet(env Env)(n Int)(name Str)(e1 Expr)(e2 Expr) Outcome[InferResult] =
  match inferExpr env n e1 with
    | OkR r1 -> inferLetOk env name r1 e2
    | ErrR m -> ErrR m

fn inferLetOk(env Env)(name Str)(r1 InferResult)(e2 Expr) Outcome[InferResult] =
  match r1 with
    | MkInferResult t1 s1 n1 -> inferLetBody env s1 n1 name t1 e2

-- Body half of `ELet`: applies `s1` to the env, generalizes the bound
-- type against that env, extends with the resulting scheme, recurses
-- into `e2`, and composes the subst.
fn inferLetBody(env Env)(s1 Subst)(n Int)(name Str)(t1 TypeExpr)(e2 Expr) Outcome[InferResult] =
  let env2 = applyEnv s1 env
  let sch = generalize env2 t1
  let env3 = envExtendScheme env2 name sch
  match inferExpr env3 n e2 with
    | OkR r2 -> OkR (inferLetCompose s1 r2)
    | ErrR m -> ErrR m

fn inferLetCompose(s1 Subst)(r2 InferResult) InferResult =
  match r2 with
    | MkInferResult t2 s2 n2 ->
      let sAll = composeSubst s1 s2
      MkInferResult t2 sAll n2

-- `EIf cond thn els`: infer `cond`, unify it with `TyName "Bool"`, infer
-- both branches under the updated env, unify the two branch types, and
-- return the unified branch type under the composed subst.
fn inferIf(env Env)(n Int)(cond Expr)(thn Expr)(els Expr) Outcome[InferResult] =
  match inferExpr env n cond with
    | OkR r -> inferIfCond env r thn els
    | ErrR m -> ErrR m

fn inferIfCond(env Env)(r InferResult)(thn Expr)(els Expr) Outcome[InferResult] =
  match r with
    | MkInferResult tc sc nc -> inferIfCondBool env sc nc tc thn els

-- Unify the condition type with `Bool`; on success dispatch to
-- `inferIfThen`, on failure ErrR.
fn inferIfCondBool(env Env)(sc Subst)(n Int)(tc TypeExpr)(thn Expr)(els Expr) Outcome[InferResult] =
  match unify tc (TyName "Bool") with
    | OkR scb ->
      let s1 = composeSubst sc scb
      inferIfThen env s1 n thn els
    | ErrR m -> ErrR m

-- Infer the `then` branch under the env with the head subst applied.
fn inferIfThen(env Env)(s1 Subst)(n Int)(thn Expr)(els Expr) Outcome[InferResult] =
  let env1 = applyEnv s1 env
  match inferExpr env1 n thn with
    | OkR r -> inferIfThenOk env1 s1 r els
    | ErrR m -> ErrR m

fn inferIfThenOk(env1 Env)(s1 Subst)(r InferResult)(els Expr) Outcome[InferResult] =
  match r with
    | MkInferResult tt st nt -> inferIfElse env1 s1 st nt tt els

-- Infer the `else` branch under the env with the head subst + then-
-- subst applied, then dispatch to the final branch-unify step.
fn inferIfElse(env Env)(s1 Subst)(st Subst)(n Int)(tt TypeExpr)(els Expr) Outcome[InferResult] =
  let s12 = composeSubst s1 st
  let env2 = applyEnv st env
  match inferExpr env2 n els with
    | OkR r -> inferIfElseOk s12 tt r
    | ErrR m -> ErrR m

fn inferIfElseOk(s12 Subst)(tt TypeExpr)(r InferResult) Outcome[InferResult] =
  match r with
    | MkInferResult te se ne -> inferIfUnify s12 se tt te ne

-- Unify the two branch types; on success return the substituted then-
-- type under the composed subst, on failure ErrR.
fn inferIfUnify(s12 Subst)(se Subst)(tt TypeExpr)(te TypeExpr)(n Int) Outcome[InferResult] =
  match unify tt te with
    | OkR sbr ->
      let s123 = composeSubst s12 se
      let sAll = composeSubst s123 sbr
      let retTy = applyType sAll tt
      OkR (MkInferResult retTy sAll n)
    | ErrR m -> ErrR m

-- ---------- EMatch inference (Phase 7.7d) -------------------------------

-- `EMatch scrut pats bodies`: parallel-list branches (same trick as
-- `Subst` / `Env` / `16-elaborator-real.lll`). Algorithm:
--   1. Infer scrutinee -> tScrut / sScrut
--   2. Fresh β for the result type
--   3. Walk pats/bodies in lockstep:
--      - Derive patTy (PInt -> Int, PVar -> fresh α + env extend, PWild -> fresh)
--      - Unify patTy with current (substituted) tScrut
--      - Infer body under the extended, substituted env
--      - Unify body type with β under the running subst
--   4. Return `applyType sFinal β` under `sFinal`.
--
-- Mirrors the F# host's `EMatchOf` / `EMatch` arms in
-- `src/LLLangCompiler/HMInfer.fs` line 376 area — simplified because
-- this slice has no exhaustiveness check and no nested patterns.
fn inferMatch(env Env)(n Int)(scr Expr)(pats List[Pat])(bodies List[Expr]) Outcome[InferResult] =
  match inferExpr env n scr with
    | OkR r -> inferMatchScrut env r pats bodies
    | ErrR m -> ErrR m

fn inferMatchScrut(env Env)(r InferResult)(pats List[Pat])(bodies List[Expr]) Outcome[InferResult] =
  match r with
    | MkInferResult tScrut sScrut nScrut ->
      let (beta, n1) = freshVar nScrut
      let env1 = applyEnv sScrut env
      inferMatchBranches env1 sScrut n1 tScrut beta pats bodies

-- Walk parallel `pats` / `bodies` lists in lockstep. Accumulates the
-- running subst in `sAcc` and the inferred-so-far branch type in `beta`.
-- Empty lists -> return the substituted `beta` as the result.
fn inferMatchBranches(env Env)(sAcc Subst)(n Int)(tScrut TypeExpr)(beta TypeExpr)(pats List[Pat])(bodies List[Expr]) Outcome[InferResult] =
  match pats with
    | p :: ps ->
      match bodies with
        | b :: bs ->
          match inferMatchBranch env sAcc n tScrut beta p b with
            | OkR r -> inferMatchBranchNext env tScrut r ps bs
            | ErrR m -> ErrR m
        | _ ->
          let retTy = applyType sAcc beta
          OkR (MkInferResult retTy sAcc n)
    | _ ->
      let retTy = applyType sAcc beta
      OkR (MkInferResult retTy sAcc n)

fn inferMatchBranchNext(env Env)(tScrut TypeExpr)(r InferResult)(ps List[Pat])(bs List[Expr]) Outcome[InferResult] =
  match r with
    | MkInferResult betaNew sNew nNew ->
      let envNew = applyEnv sNew env
      let tScrutNew = applyType sNew tScrut
      inferMatchBranches envNew sNew nNew tScrutNew betaNew ps bs

-- Infer a single (pat, body) branch: derive patTy, unify with tScrut,
-- extend env if PVar, infer body, unify with beta, compose everything.
fn inferMatchBranch(env Env)(sAcc Subst)(n Int)(tScrut TypeExpr)(beta TypeExpr)(p Pat)(body Expr) Outcome[InferResult] =
  match p with
    | PInt _ -> inferMatchBranchUnify env sAcc n tScrut beta (TyName "Int") env body
    | PVar x ->
      let (alpha, n1) = freshVar n
      let envExt = envExtend env x alpha
      inferMatchBranchUnify envExt sAcc n1 tScrut beta alpha envExt body
    | PWild ->
      let (alpha, n1) = freshVar n
      inferMatchBranchUnify env sAcc n1 tScrut beta alpha env body

-- After deriving `patTy`, unify it with the running scrutinee type, infer
-- the body under `envBody`, then unify the body type with `beta`.
-- Returns `MkInferResult newBeta sAll n` on success.
fn inferMatchBranchUnify(env Env)(sAcc Subst)(n Int)(tScrut TypeExpr)(beta TypeExpr)(patTy TypeExpr)(envBody Env)(body Expr) Outcome[InferResult] =
  match unify patTy tScrut with
    | OkR sPat ->
      let sAcc2 = composeSubst sAcc sPat
      let envBody1 = applyEnv sPat envBody
      inferMatchBranchBody sAcc2 beta envBody1 n body
    | ErrR m -> ErrR m

fn inferMatchBranchBody(sAcc Subst)(beta TypeExpr)(envBody Env)(n Int)(body Expr) Outcome[InferResult] =
  match inferExpr envBody n body with
    | OkR r -> inferMatchBranchJoin sAcc beta r
    | ErrR m -> ErrR m

fn inferMatchBranchJoin(sAcc Subst)(beta TypeExpr)(r InferResult) Outcome[InferResult] =
  match r with
    | MkInferResult tBody sBody nBody ->
      let sAccBody = composeSubst sAcc sBody
      let betaApplied = applyType sAccBody beta
      let tBodyApplied = applyType sAccBody tBody
      match unify betaApplied tBodyApplied with
        | OkR sJoin ->
          let sAll = composeSubst sAccBody sJoin
          let newBeta = applyType sAll beta
          OkR (MkInferResult newBeta sAll nBody)
        | ErrR m -> ErrR m

-- ---------- Inference test driver (Phase 7.7b) --------------------------

-- Run a single labelled `inferExpr` test and produce one stdout line.
-- `desc` is a hand-written surface rendering of the expression (the
-- `Expr` AST has no `showExpr` helper in this file — the cases are
-- hardcoded in `main` so a literal description is cheaper than a
-- walker). Output shape:
--   * success: `"<label> infer <desc> : <type>"`
--   * failure: `"<label> infer <desc> : ERROR <msg>"`
-- Phase 7.7d: errors now report the real diagnostic from `ErrR`
-- (`E001 TypeMismatch ...`, `E002 UnboundVar ...`, `E008 InfiniteType
-- ...`) instead of the old `TyName "ERROR"` sentinel.
fn runInferTest(label Str)(desc Str)(env Env)(e Expr) Str =
  let header = strConcat (strConcat (strConcat label " infer ") desc) " : "
  match inferExpr env 0 e with
    | OkR r ->
      match r with
        | MkInferResult t _ _ -> strConcat header (showType t)
    | ErrR m -> strConcat (strConcat header "ERROR ") m

-- ---------- main --------------------------------------------------------

fn main() =
  -- Concrete leaf types reused across the cases.
  let tyInt = TyName "Int"
  let tyStr = TyName "Str"
  let tyBool = TyName "Bool"
  let tyVarA = TyVar "a"
  let intToStrFn = TyFn tyInt tyStr
  let intToStrFn2 = TyFn tyInt tyStr
  let intToBoolFn = TyFn tyInt tyBool
  let intToIntFn = TyFn tyInt tyInt
  -- Five hardcoded unify cases — see header for full plan.
  let line1 = runTest "t1" tyInt tyInt
  let line2 = runTest "t2" tyInt tyStr
  let line3 = runTest "t3" tyVarA tyInt
  let line4 = runTest "t4" intToStrFn intToStrFn2
  let line5 = runTest "t5" intToBoolFn intToStrFn
  -- Phase 7.7b inference cases. Env for t8-t10 binds `x : Int` and
  -- `double : Int -> Int`; t6 / t7 use `emptyEnv` because their
  -- expressions are closed.
  let envXInt = envExtend (emptyEnv 0) "x" tyInt
  let envDouble = envExtend (emptyEnv 0) "double" intToIntFn
  let line6 = runInferTest "t6" "42" (emptyEnv 0) (EInt 42)
  let line7 = runInferTest "t7" "(1 + 2)" (emptyEnv 0) (EAdd (EInt 1) (EInt 2))
  let line8 = runInferTest "t8" "x in env" envXInt (EVar "x")
  let line9 = runInferTest "t9" "(double 5) in env" envDouble (EApp (EVar "double") (EInt 5))
  let line10 = runInferTest "t10" "(double \"x\") in env" envDouble (EApp (EVar "double") (EStr "x"))
  -- Phase 7.7c inference cases: ELam / ELet / EIf. All closed, so the
  -- env is empty. Expressions hand-built from the Expr AST (no surface
  -- lambda / let / if parser in this file); the description string is
  -- the surface rendering for human-readable stdout.
  let identFn = ELam "x" (EVar "x")
  let addOneFn = ELam "x" (EAdd (EVar "x") (EInt 1))
  let letExpr = ELet "x" (EInt 5) (EAdd (EVar "x") (EInt 1))
  let ifIntExpr = EIf (EBool true) (EInt 1) (EInt 2)
  let ifBadExpr = EIf (EBool true) (EInt 1) (EStr "x")
  let line11 = runInferTest "t11" "(\\x. x)" (emptyEnv 0) identFn
  let line12 = runInferTest "t12" "(\\x. x + 1)" (emptyEnv 0) addOneFn
  let line13 = runInferTest "t13" "(let x = 5 in x + 1)" (emptyEnv 0) letExpr
  let line14 = runInferTest "t14" "(if true then 1 else 2)" (emptyEnv 0) ifIntExpr
  let line15 = runInferTest "t15" "(if true then 1 else \"x\")" (emptyEnv 0) ifBadExpr
  -- Phase 7.7d cases: occurs check + EMatch inference.
  -- t16: higher-order lambda (\f. \x. f x) — demonstrates the unify
  -- chain correctly infers `($1 -> $2) -> $1 -> $2` without let-gen.
  let hoLam = ELam "f" (ELam "x" (EApp (EVar "f") (EVar "x")))
  -- t17: occurs check fires on `unify a (a -> Int)` — E008 InfiniteType.
  let tyAFn = TyFn tyVarA tyInt
  -- t18: match 1 with 0 -> "zero" | _ -> "other" -> Str.
  -- List literal elements are let-bound individually because bracketed
  -- TypeId-starting atoms like `[PInt 0 PWild]` would otherwise parse as
  -- a single curried ctor app (same trick as 16-elaborator-real.lll
  -- line 446 area).
  let matchScrut1 = EInt 1
  let matchPat18a = PInt 0
  let matchPat18b = PWild
  let matchPats18 = [matchPat18a matchPat18b]
  let matchBody18a = EStr "zero"
  let matchBody18b = EStr "other"
  let matchBodies18 = [matchBody18a matchBody18b]
  let matchStrExpr = EMatch matchScrut1 matchPats18 matchBodies18
  -- t19: match 1 with 0 -> "zero" | 1 -> 42 -> E001 (branch mismatch)
  let matchPat19a = PInt 0
  let matchPat19b = PInt 1
  let matchPats19 = [matchPat19a matchPat19b]
  let matchBody19a = EStr "zero"
  let matchBody19b = EInt 42
  let matchBodies19 = [matchBody19a matchBody19b]
  let matchBadExpr = EMatch matchScrut1 matchPats19 matchBodies19
  -- t20: match 1 with x -> x + 1 -> Int (PVar extends env with `x : Int`)
  let matchPat20 = PVar "x"
  let matchPats20 = [matchPat20]
  let matchBody20 = EAdd (EVar "x") (EInt 1)
  let matchBodies20 = [matchBody20]
  let matchBindExpr = EMatch matchScrut1 matchPats20 matchBodies20
  let line16 = runInferTest "t16" "(\\f. \\x. f x)" (emptyEnv 0) hoLam
  let line17 = runTest "t17" tyVarA tyAFn
  let line18 = runInferTest "t18" "(match 1 | 0 -> \"zero\" | _ -> \"other\")" (emptyEnv 0) matchStrExpr
  let line19 = runInferTest "t19" "(match 1 | 0 -> \"zero\" | 1 -> 42)" (emptyEnv 0) matchBadExpr
  let line20 = runInferTest "t20" "(match 1 | x -> x + 1)" (emptyEnv 0) matchBindExpr
  -- t21: `let id = \x. x in id 5` -> Int.
  -- Works with or without let-gen — included here as the basic
  -- let-bound lambda case. The deeper test is t22 below.
  let letIdExpr = ELet "id" (ELam "x" (EVar "x")) (EApp (EVar "id") (EInt 5))
  -- t22: `let id = \x. x in if true then id 1 else id "hi"` — requires
  -- let-gen to type-check. Without generalization the first use pins
  -- `id : Int -> Int`, the second use then hits an E001 on `id "hi"`.
  -- With let-gen, each use instantiates a fresh scheme variable, so
  -- the if's then-branch types at Int and the else-branch at Str; the
  -- outer `EIf` then fails (deliberately) at branch-unify with the
  -- real E001 — that's different from the "id pinned at Int -> Int"
  -- error and serves as the let-gen demo. We split this into t22a and
  -- t22b: t22a uses `id 5` (monomorphic use) and t22b uses both
  -- `id 5` and `id "hi"` concatenated via a separate let binding that
  -- type-checks only under let-gen.
  --   t22: `let id = \x. x in let i = id 5 in id "hi"` -> Str
  -- With let-gen: id has scheme `∀ $0. $0 -> $0`. `id 5` instantiates
  -- to `Int -> Int`, so `i : Int`. `id "hi"` instantiates fresh to
  -- `Str -> Str`, so the whole expression types at `Str`. Without
  -- let-gen, `id 5` pins id to `Int -> Int`, and `id "hi"` then
  -- fails E001 at the second use.
  let letIdUseInt = EApp (EVar "id") (EInt 5)
  let letIdUseStr = EApp (EVar "id") (EStr "hi")
  let letIdInner = ELet "i" letIdUseInt letIdUseStr
  let letIdPoly = ELet "id" (ELam "x" (EVar "x")) letIdInner
  let line21 = runInferTest "t21" "(let id = \\x. x in id 5)" (emptyEnv 0) letIdExpr
  let line22 = runInferTest "t22" "(let id = \\x. x in let i = id 5 in id \"hi\")" (emptyEnv 0) letIdPoly
  let lines = [line1 line2 line3 line4 line5 line6 line7 line8 line9 line10 line11 line12 line13 line14 line15 line16 line17 line18 line19 line20 line21 line22]
  printfn (joinLines lines)
