module Examples.HMInferReal

-- Phase 7.7a: the first slice of **Hindley-Milner inference written in
-- ll-lang itself**. After Phase 7.6 closed out the front-end half of
-- self-hosting (lex / parse / elaborate, all in ll-lang), this file
-- starts the H-M middle: a minimal `TypeExpr`, an association-list
-- `Subst`, and a position-agnostic `unify` mirroring the F# host's
-- `HMInfer.unify` in `src/LLLangCompiler/HMInfer.fs` line 63 area.
--
-- Scope ("slice A" — keep tight):
--   * `TypeExpr` = TyName / TyVar / TyFn (no `TyApp`, no `TyTagged`).
--   * `Subst` as two parallel lists `List[Str]` + `List[TypeExpr]`.
--     Tuples-in-list have surface-syntax friction in ll-lang, so two
--     parallel lists is the cleanest fit (same trick as
--     `16-elaborator-real.lll` for `EMatch` arms).
--   * `Maybe[Subst]` for the unify result. `None` = mismatch, `Some s`
--     = success. No `Result[Subst, LLError]` yet — error codes /
--     positions land in a later slice once `inferExpr` needs them.
--   * `applyType` walks `TyVar v -> lookup, TyFn a b -> recurse,
--     TyName _ -> as-is`. **No occurs check** — Phase 7.7b.
--   * No `composeSubst`: this slice's `unify TyFn TyFn` arm reuses
--     the head subst directly without composing the tail. Composition
--     only matters once the inferred type contains chains across
--     multiple binders, which only `inferExpr` (Phase 7.7b) needs.
--   * **No `inferExpr`** — proving `unify` works is the tighter slice.
--     The full algorithm-W loop with env / fresh / state threading
--     is Phase 7.7b. The `Expr` type and a hint at the algorithm-W
--     entry stub exist in the doc strings only.
--
-- Out of scope (later slices in the Phase 7.7 umbrella):
--   * Let-generalization, polymorphism, type schemes
--   * `ELam` / `EIf` / `EMatch` / `ELet` / `EApp` inference
--   * Trait dispatch
--   * Occurs check (`OccursCheck` E008) — Phase 7.7b
--   * Tagged types (`TyTagged`) and unit-mismatch errors
--   * Record types
--
-- Hardcoded test plan in `main`:
--   t1: unify Int Int                    -> ok
--   t2: unify Int Str                    -> mismatch
--   t3: unify a Int                      -> ok bound a
--   t4: unify (Int -> Str) (Int -> Str)  -> ok
--   t5: unify (Int -> Str) (Int -> Bool) -> mismatch
--
-- Expected stdout (one line per test, joined into a single `printfn`
-- call because `fn main` has a single expression body and ll-lang has
-- no statement-sequence syntax — see the `joinLines` helper):
--   t1 unify Int Int ok
--   t2 unify Int Str mismatch
--   t3 unify a Int ok bound a
--   t4 unify (Int -> Str) (Int -> Str) ok
--   t5 unify (Int -> Str) (Int -> Bool) mismatch

-- ---------- Maybe -------------------------------------------------------

-- Local `Maybe` so the codegen prelude wires the Maybe-dependent helpers
-- (`listHead` / `listTail` / `maybeMap` / ...). This file uses
-- `Some` / `None` directly for the `unify` result, not via stdlib.
type Maybe A = Some A | None

-- ---------- TypeExpr ----------------------------------------------------

-- Minimal type-expression AST. Mirrors the F# host's
-- `LLLang.AST.TypeExpr` minus `TyApp` and `TyTagged`.
--   * `TyName n`  — concrete nominal type: `TyName "Int"`,
--     `TyName "Str"`, `TyName "Bool"`. The host distinguishes
--     `TyName` from `TyVar` by the leading character; here we just
--     rely on the constructor tag.
--   * `TyVar v`   — type variable. The host uses `$0`, `$1`, ... for
--     flexible (unification) vars and bare lowercase letters for rigid
--     vars. This slice doesn't distinguish flex vs rigid — every
--     `TyVar` is treated as flexible / bindable.
--   * `TyFn a r`  — arrow type. Right-associative in surface syntax;
--     this AST is just two pointers, no associativity to worry about.
type TypeExpr =
  | TyName Str
  | TyVar Str
  | TyFn TypeExpr TypeExpr

-- ---------- Expr (placeholder for Phase 7.7b) ---------------------------

-- The expression AST that the next slice's `inferExpr` will walk.
-- Listed here as a doc-only stub so the file can be diffed against the
-- F# host side-by-side in 7.7b. `inferExpr env e` will then return
-- `(TypeExpr, Subst)` (or `Result[(TypeExpr, Subst), LLError]` once
-- errors land).
--
-- type Expr =
--   | EInt Int
--   | EStr Str
--   | EBool Bool
--   | EVar Str
--   | EAdd Expr Expr
--   | EApp Expr Expr

-- ---------- Subst -------------------------------------------------------

-- Substitution as two parallel lists: `keys` is a `List[Str]` of var
-- names, `vals` is a `List[TypeExpr]` of the types they bind to. Looked
-- up by linear scan in `lookupSubst`. Same parallel-list trick as
-- `16-elaborator-real.lll`'s `EMatch` arms — sidesteps the codegen
-- limitation that prevents tuples in `List[(Str, TypeExpr)]`.
type Subst = MkSubst List[Str] List[TypeExpr]

-- Zero-arg fns in ll-lang require a dummy parameter at the call site
-- (see `16-elaborator-real.lll` line 426 area for the same trick).
-- Pass any `Int` — it's ignored.
fn emptySubst(u Int) Subst = MkSubst [] []

fn singletonSubst(name Str)(t TypeExpr) Subst =
  MkSubst [name] [t]

-- Linear lookup over the parallel key/val lists. Walks both in lockstep
-- and returns `Some t` when the head key matches `name`, else recurses
-- into the tails. Returns `None` when either list is empty.
fn lookupSubst(s Subst)(name Str) Maybe[TypeExpr] =
  match s with
    | MkSubst keys vals ->
      lookupSubstLists keys vals name

fn lookupSubstLists(keys List[Str])(vals List[TypeExpr])(name Str) Maybe[TypeExpr] =
  match keys with
    | k :: ks ->
      match vals with
        | v :: vs ->
          if k == name then Some v
          else lookupSubstLists ks vs name
        | _ -> None
    | _ -> None

-- Walk a `TypeExpr` replacing every `TyVar v` whose name is bound in
-- `s` with the bound type. `TyName` is left as-is; `TyFn` recurses into
-- both children. Mirrors the F# host's `Types.applyType` in
-- `src/LLLangCompiler/Types.fs` line 26 area, minus the chain-following
-- recursive call (single-level lookup is enough for this slice because
-- the only binder we ever produce is `var -> non-var` from
-- `singletonSubst`).
fn applyType(s Subst)(t TypeExpr) TypeExpr =
  match t with
    | TyName _ -> t
    | TyVar v ->
      match lookupSubst s v with
        | Some bound -> bound
        | None -> t
    | TyFn a r -> TyFn (applyType s a) (applyType s r)

-- ---------- Unify -------------------------------------------------------

-- Position-agnostic unifier returning `Maybe[Subst]`. `None` is a
-- mismatch (the F# host's `e001 TypeMismatch`); `Some s` is the
-- principal substitution. Cases mirror the F# host's `unify` arm-by-arm:
--
--   * `TyName a` vs `TyName b`     — Ok empty if equal, else None
--   * `TyVar a`  vs `TyVar b`      — Ok empty if same name, else bind
--                                    `a := TyVar b`
--   * `TyVar a`  vs t (non-var)    — Ok (a := t)
--   * t (non-var) vs `TyVar b`     — symmetric: Ok (b := t)
--   * `TyFn a1 r1` vs `TyFn a2 r2` — unify args, then unify results
--                                    under that subst, return the head
--                                    subst (no full compose — see
--                                    header)
--   * anything else                — None
--
-- Deliberately no occurs check. Phase 7.7b will add it; for the
-- five hardcoded test cases below it never fires.
--
-- Implementation note: ll-lang's match indentation rules make
-- multi-level nested `match t1 with | ... -> match t2 with | ...`
-- ambiguous (the inner match's last arm bleeds into the outer one).
-- Each `t1` arm is split into its own helper to keep matches one
-- level deep.
fn unify(t1 TypeExpr)(t2 TypeExpr) Maybe[Subst] =
  match t1 with
    | TyName a -> unifyName a t2
    | TyVar a -> unifyVar a t2
    | TyFn a1 r1 -> unifyFn a1 r1 t2

-- `TyName a` vs t2: equal name -> empty subst, var on the right -> bind,
-- anything else -> mismatch. The first-arg type carries just the name
-- string so callers don't reconstruct `TyName a` for the bind case.
fn unifyName(a Str)(t2 TypeExpr) Maybe[Subst] =
  match t2 with
    | TyName b -> if a == b then Some (emptySubst 0) else None
    | TyVar v -> Some (singletonSubst v (TyName a))
    | _ -> None

-- `TyVar a` vs t2: same var name -> empty subst, anything else -> bind
-- `a := t2`. The "anything else" arm covers `TyVar b` (different name),
-- `TyName _`, and `TyFn _ _`. No occurs check yet.
fn unifyVar(a Str)(t2 TypeExpr) Maybe[Subst] =
  match t2 with
    | TyVar b -> if a == b then Some (emptySubst 0) else Some (singletonSubst a t2)
    | _ -> Some (singletonSubst a t2)

-- `TyFn a1 r1` vs t2: only succeeds against another `TyFn`. Unifies
-- arg types first, applies the resulting subst to both result types,
-- then unifies the substituted results. The returned subst is the head
-- subst (no compose) — sufficient for this slice's tests because none
-- of them produce a non-empty arg subst that the result subst would
-- need to be threaded through.
fn unifyFn(a1 TypeExpr)(r1 TypeExpr)(t2 TypeExpr) Maybe[Subst] =
  match t2 with
    | TyFn a2 r2 ->
      match unify a1 a2 with
        | Some s1 ->
          let r1b = applyType s1 r1 in
          let r2b = applyType s1 r2 in
          unifyResults s1 r1b r2b
        | _ -> None
    | _ -> None

-- Helper to keep `unifyFn`'s nested `match unify ... with | Some s1 ->
-- match unify r1b r2b with | Some _ ->` from going three matches deep.
-- In Phase 7.7b this now threads the result-side subst back into the
-- head subst via `composeSubst` so `inferExpr` (below) sees every bind
-- accumulated during `TyFn` unification — e.g. the `$0 -> Int` bind
-- that falls out of `unify (TyFn Int Int) (TyFn Int $0)` for the
-- `EApp double (EInt 5)` test. The five Phase 7.7a `unify` tests are
-- unaffected because their result substs are all empty.
fn unifyResults(s1 Subst)(r1b TypeExpr)(r2b TypeExpr) Maybe[Subst] =
  match unify r1b r2b with
    | Some s2 -> Some (composeSubst s1 s2)
    | _ -> None

-- ---------- composeSubst (Phase 7.7b) -----------------------------------

-- Dumb substitution composition: just concatenate the two parallel-list
-- substs head-to-tail. Mirrors the F# host's `Subst.compose` in
-- `src/LLLangCompiler/Types.fs` but WITHOUT the "apply s1 to s2's vals"
-- step — good enough for this slice because we only unify monomorphic
-- types (no polymorphism, no chained bindings). The head subst's keys
-- end up first in the resulting lists so a later `lookupSubst` finds
-- them ahead of any conflicting entry from the tail.
fn composeSubst(s1 Subst)(s2 Subst) Subst =
  match s1 with
    | MkSubst k1 v1 -> composeWith k1 v1 s2

fn composeWith(k1 List[Str])(v1 List[TypeExpr])(s2 Subst) Subst =
  match s2 with
    | MkSubst k2 v2 -> MkSubst (listAppend k1 k2) (listAppend v1 v2)

-- ---------- Pretty-printers ---------------------------------------------

-- Render a TypeExpr in a readable surface form. `TyVar v` prints the
-- raw name (`a`, `b`, `$0`); `TyName n` prints the name; `TyFn a r`
-- prints `(a -> r)` with explicit parens (no precedence handling
-- needed at this scale).
fn showType(t TypeExpr) Str =
  match t with
    | TyName n -> n
    | TyVar v -> v
    | TyFn a r ->
      let inner = strConcat (strConcat (showType a) " -> ") (showType r) in
      strConcat (strConcat "(" inner) ")"

-- Return the first key in a `Subst` (for the `t3` "ok bound a" line).
-- Returns the empty string if the subst is empty — the test cases that
-- print this never bind more than one var, so a one-key peek is enough.
fn substFirstKey(s Subst) Str =
  match s with
    | MkSubst keys _ ->
      match keys with
        | k :: _ -> k
        | _ -> ""

-- ---------- Test driver -------------------------------------------------

-- Run a single labelled `unify` test and produce one stdout line. The
-- label is the test number, the two types are stringified, and the
-- result tail is one of:
--   * "ok"            — unify returned `Some s` and `s` is empty
--   * "ok bound <k>"  — unify returned `Some s` with `s` non-empty
--   * "mismatch"      — unify returned `None`
fn runTest(label Str)(t1 TypeExpr)(t2 TypeExpr) Str =
  let header = strConcat (strConcat (strConcat (strConcat label " unify ") (showType t1)) " ") (showType t2) in
  match unify t1 t2 with
    | Some s ->
      let key = substFirstKey s in
      if strLen key == 0 then strConcat header " ok"
      else strConcat (strConcat header " ok bound ") key
    | _ -> strConcat header " mismatch"

-- Join a list of strings with newline separators. Used to fold the five
-- test result lines into a single `printfn` argument because ll-lang's
-- `fn main = body` body is a single expression — there's no statement
-- sequencing.
fn joinLines(xs List[Str]) Str =
  listFold (\acc s. if strLen acc == 0 then s else strConcat (strConcat acc "\n") s) "" xs

-- ---------- Env (Phase 7.7b) --------------------------------------------

-- Typing environment: parallel `List[Str]` names + `List[TypeExpr]`
-- types, exactly mirroring `Subst`. Same rationale too — tuples-in-list
-- have surface-syntax friction, so two parallel lists it is.
type Env = MkEnv List[Str] List[TypeExpr]

-- Zero-arg constructor pattern: dummy `Int` param at the call site
-- (`emptyEnv 0`), same trick as `emptySubst`.
fn emptyEnv(u Int) Env = MkEnv [] []

-- Extend an env with a new binding. New entries go at the head so
-- `envLookup` finds the most recently bound name first (classic
-- lexical shadowing).
fn envExtend(e Env)(name Str)(t TypeExpr) Env =
  match e with
    | MkEnv ks vs -> MkEnv (name :: ks) (t :: vs)

-- Linear lookup, same shape as `lookupSubst` / `lookupSubstLists`.
fn envLookup(e Env)(name Str) Maybe[TypeExpr] =
  match e with
    | MkEnv ks vs -> envLookupLists ks vs name

fn envLookupLists(keys List[Str])(vals List[TypeExpr])(name Str) Maybe[TypeExpr] =
  match keys with
    | k :: ks ->
      match vals with
        | v :: vs ->
          if k == name then Some v
          else envLookupLists ks vs name
        | _ -> None
    | _ -> None

-- Walk an `Env`'s value list and apply `s` to every binding's type.
-- Mirrors the F# host's `applyEnv` in `src/LLLangCompiler/Types.fs`.
-- Phase 7.7c uses it in the `ELet` and `EIf` arms so bindings emitted
-- while inferring earlier sub-expressions are visible to later ones.
-- Mono-typed only — no `applyScheme` / quantified-var skipping; the
-- existing `Env` stores raw `TypeExpr` not `TypeScheme`.
fn applyEnv(s Subst)(e Env) Env =
  match e with
    | MkEnv ks vs -> MkEnv ks (applyTypeList s vs)

-- Map `applyType s` over a list of `TypeExpr`. Written as an explicit
-- recursive walk rather than `listMap` because the corpus file doesn't
-- declare the stdlib `listMap` dependency and the recursive form is
-- the same cost as hauling in the builtin.
fn applyTypeList(s Subst)(ts List[TypeExpr]) List[TypeExpr] =
  match ts with
    | t :: rest -> applyType s t :: applyTypeList s rest
    | _ -> []

-- ---------- Expr AST (Phase 7.7b) ---------------------------------------

-- The tiny expression AST that `inferExpr` walks. Deliberately smaller
-- than the F# host's `AST.Expr` — no `ELam` / `ELet` / `EIf` / `EMatch`
-- yet; those land in 7.7c onwards with let-generalization, polymorphism,
-- and type schemes. The header's doc-only stub promised exactly this
-- shape.
-- Phase 7.7c adds `ELam` (lambda), `ELet` (let-in, mono-bound — no
-- generalization yet), and `EIf` (if-then-else). `inferExpr` grows
-- three new arms mirroring the F# host's `ELam` / `ELet(_, _, Some _)`
-- / `EIf` cases in `src/LLLangCompiler/HMInfer.fs` line 260 / 276 /
-- 315 area. Each new arm is still split into its own helper to keep
-- `match` nesting one level deep.
type Expr =
  | EInt Int
  | EStr Str
  | EBool Bool
  | EVar Str
  | EAdd Expr Expr
  | EApp Expr Expr
  | ELam Str Expr
  | ELet Str Expr Expr
  | EIf Expr Expr Expr

-- ---------- Fresh var generator (Phase 7.7b) ----------------------------

-- Thread an `Int` counter through inference. Each call consumes `n` and
-- returns `(TyVar "$n", n + 1)`. Mirrors the F# host's `freshVar` in
-- `src/LLLangCompiler/Types.fs` (which uses a mutable ref cell; we stay
-- purely functional by threading the counter explicitly).
fn freshVar(n Int) =
  (TyVar (strConcat "$" (intToStr n)), n + 1)

-- ---------- InferResult carrier (Phase 7.7b) ----------------------------

-- `inferExpr` returns three things at once: the inferred type, the
-- substitution collected during inference, and the new fresh counter.
-- A tiny three-field ADT sidesteps the no-tuple-construction-in-return
-- workaround that plagued earlier slices.
type InferResult = MkInferResult TypeExpr Subst Int

-- ---------- inferExpr (Phase 7.7b) --------------------------------------

-- Walk an `Expr` and produce an `InferResult`. Mirrors (a tiny slice of)
-- the F# host's `HMInfer.inferExpr` in `src/LLLangCompiler/HMInfer.fs`
-- line 172 area. Each arm is split into its own helper to keep `match`
-- nesting one level deep — the same trick as `unify` uses, for the
-- same reason.
--
--   * `EInt _`  -> `(TyName "Int",  empty, n)`
--   * `EStr _`  -> `(TyName "Str",  empty, n)`
--   * `EBool _` -> `(TyName "Bool", empty, n)`
--   * `EVar name` -> lookup in env; missing = `(TyName "ERROR", empty, n)`.
--     (The F# host emits `E002 UnboundVar`; this slice simplifies to a
--     sentinel type so the test driver stays printfn-only.)
--   * `EAdd l r` -> infer l, infer r, unify both with `TyName "Int"`,
--     result `TyName "Int"` under the composed subst.
--   * `EApp f a` -> infer f, infer a, fresh β, unify `applyType s_a τf`
--     with `TyFn(τa, β)`, result `applyType s β` under the composed
--     subst. On unify failure, return the ERROR sentinel so t10 has a
--     deterministic output.
--
-- No occurs check, no polymorphism, no let-generalization — those land
-- in 7.7c onwards.
fn inferExpr(env Env)(n Int)(e Expr) InferResult =
  match e with
    | EInt _ -> MkInferResult (TyName "Int") (emptySubst 0) n
    | EStr _ -> MkInferResult (TyName "Str") (emptySubst 0) n
    | EBool _ -> MkInferResult (TyName "Bool") (emptySubst 0) n
    | EVar name -> inferVar env n name
    | EAdd l r -> inferAdd env n l r
    | EApp f a -> inferApp env n f a
    | ELam name body -> inferLam env n name body
    | ELet name e1 e2 -> inferLet env n name e1 e2
    | EIf cond thn els -> inferIf env n cond thn els

-- `EVar`: env lookup, ERROR sentinel on miss.
fn inferVar(env Env)(n Int)(name Str) InferResult =
  match envLookup env name with
    | Some t -> MkInferResult t (emptySubst 0) n
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n

-- `EAdd`: destructure the left-hand result, pass to `inferAddR`.
fn inferAdd(env Env)(n Int)(l Expr)(r Expr) InferResult =
  match inferExpr env n l with
    | MkInferResult tl sl nl -> inferAddR env nl sl tl r

-- Right-hand half of `EAdd`: destructure the right-hand result, pass
-- to `inferAddUnify`.
fn inferAddR(env Env)(n Int)(sl Subst)(tl TypeExpr)(r Expr) InferResult =
  match inferExpr env n r with
    | MkInferResult tr sr nr -> inferAddUnify sl sr tl tr nr

-- Unify the left operand with `Int`; on success dispatch to
-- `inferAddUnify2`, on failure produce the ERROR sentinel.
fn inferAddUnify(sl Subst)(sr Subst)(tl TypeExpr)(tr TypeExpr)(n Int) InferResult =
  match unify tl (TyName "Int") with
    | Some s3 -> inferAddUnify2 sl sr s3 tr n
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n

-- Unify the right operand with `Int`; on success return `Int` under the
-- composed subst; on failure the ERROR sentinel.
fn inferAddUnify2(sl Subst)(sr Subst)(s3 Subst)(tr TypeExpr)(n Int) InferResult =
  match unify tr (TyName "Int") with
    | Some s4 ->
      let s12 = composeSubst sl sr in
      let s123 = composeSubst s12 s3 in
      let sAll = composeSubst s123 s4 in
      MkInferResult (TyName "Int") sAll n
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n

-- `EApp`: destructure the function result, pass to `inferAppArg`.
fn inferApp(env Env)(n Int)(f Expr)(a Expr) InferResult =
  match inferExpr env n f with
    | MkInferResult tf sf nf -> inferAppArg env nf sf tf a

-- Argument half of `EApp`: destructure the arg result, pass to
-- `inferAppFresh`.
fn inferAppArg(env Env)(n Int)(sf Subst)(tf TypeExpr)(a Expr) InferResult =
  match inferExpr env n a with
    | MkInferResult ta sa na -> inferAppFresh sf sa tf ta na

-- Fresh-var + unify half of `EApp`: allocate a fresh result type,
-- unify the (substituted) function type against `TyFn ta beta`, and
-- return the substituted `beta` as the result type. On unify failure
-- return the ERROR sentinel so t10 is deterministic.
fn inferAppFresh(sf Subst)(sa Subst)(tf TypeExpr)(ta TypeExpr)(n Int) InferResult =
  let (beta, n1) = freshVar n in
  let tfApplied = applyType sa tf in
  match unify tfApplied (TyFn ta beta) with
    | Some s3 ->
      let s12 = composeSubst sf sa in
      let sAll = composeSubst s12 s3 in
      let retTy = applyType sAll beta in
      MkInferResult retTy sAll n1
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n1

-- ---------- ELam / ELet / EIf inference (Phase 7.7c) --------------------

-- `ELam name body`: allocate a fresh `α` for the param, extend the env
-- with `(name : α)`, infer the body under the extended env, and return
-- `TyFn (applyType sBody α) τbody` under `sBody`. Mirrors the F# host's
-- `ELam` arm in `src/LLLangCompiler/HMInfer.fs` line 260 area (minus
-- the multi-param curry — this slice only supports single-param
-- lambdas, which is all `\x. x`, `\x. x + 1`, etc. need).
fn inferLam(env Env)(n Int)(name Str)(body Expr) InferResult =
  let (alpha, n1) = freshVar n in
  let env2 = envExtend env name alpha in
  match inferExpr env2 n1 body with
    | MkInferResult tBody sBody nBody ->
      let paramTy = applyType sBody alpha in
      MkInferResult (TyFn paramTy tBody) sBody nBody

-- `ELet name e1 e2`: infer `e1`, extend the env with `(name : τ1)` under
-- the resulting subst, infer `e2`, return `τ2` under `compose s2 s1`.
-- NO let-generalization — `name` is bound to the raw monomorphic
-- `τ1`, so `let id = \x. x in (id 5, id "a")`-style polymorphism
-- doesn't work yet. That lands in Phase 7.7d alongside type schemes.
fn inferLet(env Env)(n Int)(name Str)(e1 Expr)(e2 Expr) InferResult =
  match inferExpr env n e1 with
    | MkInferResult t1 s1 n1 -> inferLetBody env s1 n1 name t1 e2

-- Body half of `ELet`: extends the env with the (applied) binding and
-- recurses into `e2`, then composes the subst. Split out because the
-- outer `inferLet` match already eats one level of `match` nesting.
fn inferLetBody(env Env)(s1 Subst)(n Int)(name Str)(t1 TypeExpr)(e2 Expr) InferResult =
  let env2 = applyEnv s1 env in
  let env3 = envExtend env2 name t1 in
  match inferExpr env3 n e2 with
    | MkInferResult t2 s2 n2 ->
      let sAll = composeSubst s1 s2 in
      MkInferResult t2 sAll n2

-- `EIf cond thn els`: infer `cond`, unify it with `TyName "Bool"`, infer
-- both branches under the updated env, unify the two branch types, and
-- return the unified branch type under the composed subst. On any
-- unify failure (cond not `Bool`, or branches don't agree) return the
-- ERROR sentinel so the test driver stays deterministic.
fn inferIf(env Env)(n Int)(cond Expr)(thn Expr)(els Expr) InferResult =
  match inferExpr env n cond with
    | MkInferResult tc sc nc -> inferIfCondBool env sc nc tc thn els

-- Unify the condition type with `Bool`; on success dispatch to
-- `inferIfThen`, on failure produce the ERROR sentinel. Split into
-- its own helper so the `match unify with | Some scb -> match
-- inferExpr ...` chain stays one level deep.
fn inferIfCondBool(env Env)(sc Subst)(n Int)(tc TypeExpr)(thn Expr)(els Expr) InferResult =
  match unify tc (TyName "Bool") with
    | Some scb ->
      let s1 = composeSubst sc scb in
      inferIfThen env s1 n thn els
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n

-- Infer the `then` branch under the env with the head subst applied.
fn inferIfThen(env Env)(s1 Subst)(n Int)(thn Expr)(els Expr) InferResult =
  let env1 = applyEnv s1 env in
  match inferExpr env1 n thn with
    | MkInferResult tt st nt -> inferIfElse env1 s1 st nt tt els

-- Infer the `else` branch under the env with the head subst + then-
-- subst applied, then dispatch to the final branch-unify step.
fn inferIfElse(env Env)(s1 Subst)(st Subst)(n Int)(tt TypeExpr)(els Expr) InferResult =
  let s12 = composeSubst s1 st in
  let env2 = applyEnv st env in
  match inferExpr env2 n els with
    | MkInferResult te se ne -> inferIfUnify s12 se tt te ne

-- Unify the two branch types; on success return the substituted then-
-- type under the composed subst, on failure the ERROR sentinel.
fn inferIfUnify(s12 Subst)(se Subst)(tt TypeExpr)(te TypeExpr)(n Int) InferResult =
  match unify tt te with
    | Some sbr ->
      let s123 = composeSubst s12 se in
      let sAll = composeSubst s123 sbr in
      let retTy = applyType sAll tt in
      MkInferResult retTy sAll n
    | _ -> MkInferResult (TyName "ERROR") (emptySubst 0) n

-- ---------- Inference test driver (Phase 7.7b) --------------------------

-- Run a single labelled `inferExpr` test and produce one stdout line.
-- `desc` is a hand-written surface rendering of the expression (the
-- `Expr` AST has no `showExpr` helper in this file — the five cases
-- are hardcoded in `main` so a literal description is cheaper than a
-- walker). Output shape: `"<label> infer <desc> : <type>"`.
fn runInferTest(label Str)(desc Str)(env Env)(e Expr) Str =
  match inferExpr env 0 e with
    | MkInferResult t _ _ ->
      let header = strConcat (strConcat (strConcat label " infer ") desc) " : " in
      strConcat header (showType t)

-- ---------- main --------------------------------------------------------

fn main() =
  -- Concrete leaf types reused across the cases.
  let tyInt = TyName "Int" in
  let tyStr = TyName "Str" in
  let tyBool = TyName "Bool" in
  let tyVarA = TyVar "a" in
  let intToStrFn = TyFn tyInt tyStr in
  let intToStrFn2 = TyFn tyInt tyStr in
  let intToBoolFn = TyFn tyInt tyBool in
  let intToIntFn = TyFn tyInt tyInt in
  -- Five hardcoded unify cases — see header for full plan.
  let line1 = runTest "t1" tyInt tyInt in
  let line2 = runTest "t2" tyInt tyStr in
  let line3 = runTest "t3" tyVarA tyInt in
  let line4 = runTest "t4" intToStrFn intToStrFn2 in
  let line5 = runTest "t5" intToBoolFn intToStrFn in
  -- Phase 7.7b inference cases. Env for t8-t10 binds `x : Int` and
  -- `double : Int -> Int`; t6 / t7 use `emptyEnv` because their
  -- expressions are closed.
  let envXInt = envExtend (emptyEnv 0) "x" tyInt in
  let envDouble = envExtend (emptyEnv 0) "double" intToIntFn in
  let line6 = runInferTest "t6" "42" (emptyEnv 0) (EInt 42) in
  let line7 = runInferTest "t7" "(1 + 2)" (emptyEnv 0) (EAdd (EInt 1) (EInt 2)) in
  let line8 = runInferTest "t8" "x in env" envXInt (EVar "x") in
  let line9 = runInferTest "t9" "(double 5) in env" envDouble (EApp (EVar "double") (EInt 5)) in
  let line10 = runInferTest "t10" "(double \"x\") in env" envDouble (EApp (EVar "double") (EStr "x")) in
  -- Phase 7.7c inference cases: ELam / ELet / EIf. All closed, so the
  -- env is empty. Expressions hand-built from the Expr AST (no surface
  -- lambda / let / if parser in this file); the description string is
  -- the surface rendering for human-readable stdout.
  let identFn = ELam "x" (EVar "x") in
  let addOneFn = ELam "x" (EAdd (EVar "x") (EInt 1)) in
  let letExpr = ELet "x" (EInt 5) (EAdd (EVar "x") (EInt 1)) in
  let ifIntExpr = EIf (EBool true) (EInt 1) (EInt 2) in
  let ifBadExpr = EIf (EBool true) (EInt 1) (EStr "x") in
  let line11 = runInferTest "t11" "(\\x. x)" (emptyEnv 0) identFn in
  let line12 = runInferTest "t12" "(\\x. x + 1)" (emptyEnv 0) addOneFn in
  let line13 = runInferTest "t13" "(let x = 5 in x + 1)" (emptyEnv 0) letExpr in
  let line14 = runInferTest "t14" "(if true then 1 else 2)" (emptyEnv 0) ifIntExpr in
  let line15 = runInferTest "t15" "(if true then 1 else \"x\")" (emptyEnv 0) ifBadExpr in
  let lines = [line1 line2 line3 line4 line5 line6 line7 line8 line9 line10 line11 line12 line13 line14 line15] in
  printfn (joinLines lines)
