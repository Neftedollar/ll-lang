module LlvmMaybe

Maybe A = Some A | None

safeDiv(a Int)(b Int) Maybe[Int] =
  if b == 0
    None
  else
    Some (a / b)

show(m Maybe[Int]) Str =
  match m
    | Some v -> intToStr v
    | None -> "div-by-zero"

main() =
  r1 = printfn (show (safeDiv 10 2))
  r2 = printfn (show (safeDiv 7 0))
  r2
