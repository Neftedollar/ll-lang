module Examples.MonadChains

-- ============================================================
-- Monadic composition with Maybe + Result chains.
--
-- Pipeline: parse a string as Int (Maybe) → validate positive
-- (Result) → double → square.  Each step short-circuits on
-- failure, so the pipeline expresses "success path only" code
-- with error handling falling out for free.
--
-- Uses: strToInt (builtin Str -> Maybe[Int]), maybeBind,
-- maybeMap, resultBind, resultMap, maybeWithDefault.
-- ============================================================

import Std.Monad

-- Step 1: turn Maybe[Int] from strToInt into Result[Int][Str]
-- with a human-readable error message.
parseToResult(s Str) =
  match strToInt s
    | Some n -> Ok n
    | None   -> Err "not a number"

-- Step 2: reject non-positive integers (returns Result[Int][Str]).
validatePositive(n Int) =
  if n > 0
    Ok n
  else Err "must be positive"

-- Step 3: pure transforms lifted into Result via resultMap.
doubleIt(n Int) = n * 2
squareIt(n Int) = n * n

-- Full pipeline: parse → validate → double → square.
-- Returns Result[Int][Str].  Failures at any step propagate the Err.
pipeline(s Str) =
  step1 = parseToResult s
  step2 = resultBind step1 validatePositive
  step3 = resultMap doubleIt step2
  resultMap squareIt step3

-- Render the final Result for display.
showResult(r Result[Int][Str]) =
  match r
    | Ok n  -> strConcat "Ok=" (intToStr n)
    | Err e -> strConcat "Err=" e

checkBool(label Str)(ok Bool) =
  if ok
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " label)

main =
  -- ── Success path: "5" → 5 → 10 → 100 ──────────────────────
  good = pipeline "5"
  _ = checkBool "1 happy path squared" (showResult good == "Ok=100")

  -- ── Parse failure: "xyz" stops at step 1 ──────────────────
  bad1 = pipeline "xyz"
  _ = checkBool "2 parse failure" (showResult bad1 == "Err=not a number")

  -- ── Validation failure: "0" parses but fails positivity ───
  bad2 = pipeline "0"
  _ = checkBool "3 validation failure" (showResult bad2 == "Err=must be positive")

  -- ── Negative input: "-7" parses but fails positivity ──────
  bad3 = pipeline "-7"
  _ = checkBool "4 negative rejected" (showResult bad3 == "Err=must be positive")

  -- ── Raw Maybe chain (no Result wrapping) ──────────────────
  -- Demonstrates maybeMap composition: parse then double.
  doubled = maybeMap doubleIt (strToInt "21")
  _ = checkBool "5 maybeMap parse+double" (maybeWithDefault 0 doubled == 42)

  -- ── maybeBind short-circuits on None ──────────────────────
  none = maybeBind (strToInt "not-int") (\n. Some (n + 1))
  _ = checkBool "6 maybeBind on None" (maybeWithDefault 99 none == 99)

  printfn "Done"
