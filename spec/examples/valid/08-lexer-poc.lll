module Examples.LexerPoC

-- Phase 6.5: tiny char-classifying "lexer" written in ll-lang itself.
-- Demonstrates the new char/string stdlib. Each input character is mapped
-- to a one-character Token; we then render the tokens as a comma-joined
-- string. Multi-character grouping (real lexing) is a Phase 7 task — see
-- the language gaps surfaced in the report.

type Token = TIdent Str | TNum Str | TLParen | TRParen | TPlus | TSpace | TUnknown

fn classify(c Char) =
  if charIsDigit c
    TNum (strFromChars [c])
  else if charIsAlpha c
    TIdent (strFromChars [c])
  else if charIsSpace c
    TSpace
  else if c == '('
    TLParen
  else if c == ')'
    TRParen
  else if c == '+'
    TPlus
  else TUnknown

fn tokenName(t Token) =
  | TIdent s -> strConcat "id:" s
  | TNum n -> strConcat "n:" n
  | TLParen -> "("
  | TRParen -> ")"
  | TPlus -> "+"
  | TSpace -> "_"
  | TUnknown -> "?"

fn joinTokens(toks List[Token]) =
  listFold (\acc. \t. if strLen acc == 0
    tokenName t
  else strConcat (strConcat acc ",") (tokenName t)) "" toks

fn main() =
  let toks = listMap classify (strChars "ab 12 (x+y)")
  printfn (joinTokens toks)
