module Examples.MonadModule

import Std.Monad

-- ============================================================
-- Std.Monad cross-type monadic patterns.
--
-- ll-lang has no higher-kinded types, so there is no single
-- `Monad` typeclass.  Instead, each monadic type exposes
-- functions following a shared naming convention:
--
--   * pure : A -> M[A]              wrap a value
--   * map  : (A -> B) -> M[A] -> M[B]
--   * bind : M[A] -> (A -> M[B]) -> M[B]
--
-- Concrete names per monad:
--   Maybe : Some       / maybeMap  / maybeBind
--   Result: Ok         / resultMap / resultBind
--   List  : listPure   / listMap   / listBind
--   State : statePure  / stateMap  / stateBind
--
-- This example exercises the List and State names from
-- Std.Monad, and shows the shared shape across the family.
-- ============================================================

-- Render a List[Int] as a comma-joined string.
showIntList(xs List[Int]) =
  strs = listMap intToStr xs
  listFold (\acc s. strConcat acc (strConcat "," s)) "" strs

-- List bind helper: expand x into [x; x+10].
expand(x Int) =
  y = x + 10
  [x; y]

-- Small helper used in the "pure+bind parity" final assertions.
pairOf(x Int) =
  y = x + 1
  [x; y]

-- List bind helper: keep only values strictly greater than 2.
keepGt2(x Int) =
  if x > 2
    [x]
  else []

-- Named State-monad step: increment the counter and return the
-- previous value (classic fetch-and-add).
fetchAndAdd(dummy Int) =
  stateBind (stateGet 0) (\n. stateBind (statePut (n + 1)) (\ignored. statePure n))

checkBool(label Str)(ok Bool) =
  if ok
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " label)

main =
  -- ── 1. listPure: wrap a single value ──────────────────────
  single = listPure 42
  _ = checkBool "1 listPure" (showIntList single == ",42")

  -- ── 2. listBind expands each element (flatMap) ────────────
  expanded = listBind expand [1; 2; 3]
  -- (listBind takes f first, then the list)
  _ = checkBool "2 listBind expand" (showIntList expanded == ",1,11,2,12,3,13")

  -- ── 3. listBind with empty result filters ─────────────────
  filtered = listBind keepGt2 [1; 2; 3; 4; 5]
  _ = checkBool "3 listBind filter >2" (showIntList filtered == ",3,4,5")

  -- ── 4. Compose listBind twice: expand then filter ─────────
  step1 = listBind expand [1; 2]
  step2 = listBind keepGt2 step1
  _ = checkBool "4 listBind composition" (showIntList step2 == ",11,12")

  -- ── 5. listBind + listPure round-trip (identity) ──────────
  roundTrip = listBind listPure [7; 8; 9]
  _ = checkBool "5 bind+pure identity" (showIntList roundTrip == ",7,8,9")

  -- ── 6. State pure evaluates to the wrapped value ──────────
  v6 = stateEval (statePure 100) 0
  _ = checkBool "6 statePure" (v6 == 100)

  -- ── 7. stateBind chain: counter increments in sequence ────
  -- Run fetchAndAdd three times; each returns the old counter
  -- and bumps it by one.  Starting state is 0, so the final
  -- result is the third fetch = 2, and final state = 3.
  prog7 = stateBind (fetchAndAdd 0) (\a. stateBind (fetchAndAdd 0) (\b. stateBind (fetchAndAdd 0) (\c. statePure (a + b + c))))
  sum7 = stateEval prog7 0
  _ = checkBool "7 stateBind counter chain (0+1+2=3)" (sum7 == 3)

  -- ── 8. stateExec returns the final state ──────────────────
  final8 = stateExec prog7 0
  _ = checkBool "8 stateExec final counter = 3" (final8 == 3)

  -- ── 9. stateMap transforms the result, state unchanged ────
  mapped = stateEval (stateMap (\x. x * 10) (statePure 5)) 0
  _ = checkBool "9 stateMap = 50" (mapped == 50)

  -- ── 10. Naming convention parity: every monad has pure/bind
  -- Demonstrated by exercising the same pattern shape.
  byListPure   = listBind pairOf (listPure 1)
  byStatePure  = stateEval (stateBind (statePure 1) (\x. statePure (x + 1))) 0
  _ = checkBool "10 pure+bind parity" (showIntList byListPure == ",1,2")
  _ = checkBool "11 state pure+bind" (byStatePure == 2)

  printfn "Done"
