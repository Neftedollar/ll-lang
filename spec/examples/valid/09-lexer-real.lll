module Examples.RealLexer

-- Phase 7.1: a real ll-lang lexer written in ll-lang itself.
--
-- Strictly more than 08-lexer-poc.lll: groups multi-char identifiers and
-- multi-digit integers, recognises a small set of keywords and operators,
-- and emits a flat List Token. Phase 7.1.5 simplified the original
-- listHead/listTail-with-Maybe wrapper helpers down to direct `c :: rest`
-- cons patterns and inline `match` expressions.
--
-- This is the first step toward Phase 7 self-hosting: prove the language
-- can express its own lexer in idiomatic ll-lang.

type Token = TIdent Str | TInt Str | TLet | TFn | TIf | TElse | TPlus | TMinus | TStar | TSlash | TEq | TLt | TGt | TLParen | TRParen | TUnknown Str

-- Char predicates
fn isIdStart(c Char) Bool = charIsAlpha c
fn isIdCont(c Char) Bool = if charIsAlpha c
  true
else charIsDigit c

-- Greedy take/drop while predicate, written directly on cons cells.
fn takeWhilePred(p)(cs List[Char]) List[Char] =
  | c :: rest ->
    if p c
      listAppend [c] (takeWhilePred p rest)
    else []
  | _ -> []

fn dropWhilePred(p)(cs List[Char]) List[Char] =
  | c :: rest ->
    if p c
      dropWhilePred p rest
    else cs
  | _ -> []

-- Classify an identifier string as a keyword or generic identifier,
-- using a match-as-expression on the string.
fn keywordOrIdent(s Str) Token =
  match s with
    | "let" -> TLet
    | "fn" -> TFn
    | "if" -> TIf
    | "else" -> TElse
    | _ -> TIdent s

-- Lex an identifier (already verified the head char is alpha): collect the
-- identifier prefix, classify it as a keyword or `TIdent`, and continue.
fn lexId(cs List[Char]) List[Token] =
  let idChars = takeWhilePred isIdCont cs
  let leftover = dropWhilePred isIdCont cs
  let tok = keywordOrIdent (strFromChars idChars)
  listAppend [tok] (lexChars leftover)

-- Lex a multi-digit integer (already verified the head char is a digit).
-- Phase 7.3b-fixes bug 1: `[TInt (...)]` is now a single-element list with
-- the ctor already applied, so the `let tok = ... in` helper has been
-- inlined into the final listAppend call.
fn lexNum(cs List[Char]) List[Token] =
  let digits = takeWhilePred charIsDigit cs
  let leftover = dropWhilePred charIsDigit cs
  listAppend [TInt (strFromChars digits)] (lexChars leftover)

-- Lex a single-char operator / punctuation token via inline match.
fn lexOp(c Char)(rest List[Char]) List[Token] =
  let tok = match c with
    | '+' -> TPlus
    | '-' -> TMinus
    | '*' -> TStar
    | '/' -> TSlash
    | '=' -> TEq
    | '<' -> TLt
    | '>' -> TGt
    | '(' -> TLParen
    | ')' -> TRParen
    | _ -> TUnknown (strFromChars [c])
  listAppend [tok] (lexChars rest)

-- Main lexer loop on a list of chars. Cons-pattern destructures the
-- input directly; the empty case returns an empty token list.
fn lexChars(cs List[Char]) List[Token] =
  | c :: rest ->
    if charIsSpace c
      lexChars rest
    else if isIdStart c
      lexId cs
    else if charIsDigit c
      lexNum cs
    else lexOp c rest
  | _ -> []

fn tokenize(src Str) List[Token] = lexChars (strChars src)

-- Render a token as a short tag for the demo output.
fn tokenName(t Token) Str =
  | TIdent s -> strConcat "id:" s
  | TInt s -> strConcat "int:" s
  | TLet -> "kw:let"
  | TFn -> "kw:fn"
  | TIf -> "kw:if"
  | TElse -> "kw:else"
  | TPlus -> "+"
  | TMinus -> "-"
  | TStar -> "*"
  | TSlash -> "/"
  | TEq -> "="
  | TLt -> "<"
  | TGt -> ">"
  | TLParen -> "("
  | TRParen -> ")"
  | TUnknown s -> strConcat "?:" s

fn joinNames(ts List[Token]) Str =
  listFold (\acc t. if strLen acc == 0
    tokenName t
  else strConcat (strConcat acc " ") (tokenName t)) "" ts

fn main() =
  let src = "fn add(a)(b) = a + b"
  let toks = tokenize src
  printfn (joinNames toks)
