module Examples.RealLexer

-- Phase 7.1: a real ll-lang lexer written in ll-lang itself.
--
-- Strictly more than 08-lexer-poc.lll: groups multi-char identifiers and
-- multi-digit integers, recognises a small set of keywords and operators,
-- and emits a flat List Token. The traditional `c :: rest` cons-pattern is
-- not yet supported by the parser, so we deconstruct the input list with
-- listHead / listTail (returning Maybe) and small wrapper helpers.
--
-- This is the first step toward Phase 7 self-hosting: prove the language
-- can express its own lexer in idiomatic ll-lang.

type Maybe A = Some A | None

type Token = TIdent Str | TInt Str | TLet | TFn | TIf | TThen | TElse | TPlus | TMinus | TStar | TSlash | TEq | TLt | TGt | TLParen | TRParen | TUnknown Str

-- Maybe deconstruction helpers (no list cons patterns yet)
fn unwrapCharOrSpace(mc Maybe[Char]) Char =
  | Some c -> c
  | None -> ' '

fn unwrapTailOrEmpty(mt Maybe[List[Char]]) List[Char] =
  | Some t -> t
  | None -> []

fn headChar(cs List[Char]) Char = unwrapCharOrSpace (listHead cs)
fn tailChars(cs List[Char]) List[Char] = unwrapTailOrEmpty (listTail cs)

-- Char predicates
fn isIdStart(c Char) Bool = charIsAlpha c
fn isIdCont(c Char) Bool = if charIsAlpha c then true else charIsDigit c

-- Greedy take/drop while predicate. We compute the prefix and the leftover
-- as two passes; this is the only way to thread state through a list
-- without tuple destructuring on let-bindings.
fn takeWhilePred(p)(cs List[Char]) List[Char] =
  if listIsEmpty cs then []
  else
    let c = headChar cs in
    if p c then listAppend [c] (takeWhilePred p (tailChars cs))
    else []

fn dropWhilePred(p)(cs List[Char]) List[Char] =
  if listIsEmpty cs then []
  else
    let c = headChar cs in
    if p c then dropWhilePred p (tailChars cs)
    else cs

-- Classify an identifier string as a keyword or generic identifier.
fn keywordOrIdent(s Str) Token =
  if s == "let" then TLet
  else if s == "fn" then TFn
  else if s == "if" then TIf
  else if s == "then" then TThen
  else if s == "else" then TElse
  else TIdent s

-- Prepend a single token to a list. We can't write the more idiomatic
-- `listAppend [TPlus] xs` directly because the parser misinterprets a
-- bracketed type-constructor that immediately follows another atom as a
-- tagged literal (`atom[Tag]`). Wrapping the cons in this helper sidesteps
-- the ambiguity: inside `pre`, the bracketed expression contains the
-- lowercase variable `t`, which is unambiguous.
fn pre(t Token)(ts List[Token]) List[Token] = listAppend [t] ts

-- Lex an identifier (already verified the head char is alpha): collect the
-- identifier prefix, classify it as a keyword or `TIdent`, and continue.
fn lexId(cs List[Char]) List[Token] =
  let idChars = takeWhilePred isIdCont cs in
  let leftover = dropWhilePred isIdCont cs in
  pre (keywordOrIdent (strFromChars idChars)) (lexChars leftover)

-- Lex a multi-digit integer (already verified the head char is a digit).
fn lexNum(cs List[Char]) List[Token] =
  let digits = takeWhilePred charIsDigit cs in
  let leftover = dropWhilePred charIsDigit cs in
  pre (TInt (strFromChars digits)) (lexChars leftover)

-- Lex a single-char operator / punctuation token.
fn lexOp(c Char)(rest List[Char]) List[Token] =
  if c == '+' then pre TPlus (lexChars rest)
  else if c == '-' then pre TMinus (lexChars rest)
  else if c == '*' then pre TStar (lexChars rest)
  else if c == '/' then pre TSlash (lexChars rest)
  else if c == '=' then pre TEq (lexChars rest)
  else if c == '<' then pre TLt (lexChars rest)
  else if c == '>' then pre TGt (lexChars rest)
  else if c == '(' then pre TLParen (lexChars rest)
  else if c == ')' then pre TRParen (lexChars rest)
  else pre (TUnknown (strFromChars [c])) (lexChars rest)

-- Main lexer loop on a list of chars. Returns a List Token.
fn lexChars(cs List[Char]) List[Token] =
  if listIsEmpty cs then []
  else
    let c = headChar cs in
    if charIsSpace c then lexChars (tailChars cs)
    else if isIdStart c then lexId cs
    else if charIsDigit c then lexNum cs
    else lexOp c (tailChars cs)

fn tokenize(src Str) List[Token] = lexChars (strChars src)

-- Render a token as a short tag for the demo output.
fn tokenName(t Token) Str =
  | TIdent s -> strConcat "id:" s
  | TInt s -> strConcat "int:" s
  | TLet -> "kw:let"
  | TFn -> "kw:fn"
  | TIf -> "kw:if"
  | TThen -> "kw:then"
  | TElse -> "kw:else"
  | TPlus -> "+"
  | TMinus -> "-"
  | TStar -> "*"
  | TSlash -> "/"
  | TEq -> "="
  | TLt -> "<"
  | TGt -> ">"
  | TLParen -> "("
  | TRParen -> ")"
  | TUnknown s -> strConcat "?:" s

fn joinNames(ts List[Token]) Str =
  listFold (\acc t. if strLen acc == 0 then tokenName t else strConcat (strConcat acc " ") (tokenName t)) "" ts

fn main() =
  let src = "fn add(a)(b) = a + b" in
  let toks = tokenize src in
  printfn (joinNames toks)
