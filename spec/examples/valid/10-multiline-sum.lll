module Examples.MultilineSum

-- Phase 7.1.6: multi-line sum type declaration with indented `|` arms.
-- Both single-line and multi-line forms produce the same TBSum AST.
Token =
  | TIdent Str
  | TNum Str
  | TLParen
  | TRParen

show(t Token) =
  | TIdent s -> strConcat "id:" s
  | TNum s -> strConcat "num:" s
  | TLParen -> "("
  | TRParen -> ")"

main() =
  printfn (show (TIdent "foo"))
