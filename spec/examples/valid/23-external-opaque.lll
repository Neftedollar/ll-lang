module Examples.ExternalOpaque

-- Demonstrates external declarations and opaque types.
--
-- 'external' wraps a platform-native function (no ll-lang body).
--   The Platform SDK provides the actual implementation for each target.
--   Codegen emits a call through the platform mapping.
--
-- 'opaque' declares a platform-native type that ll-lang can hold and
--   pass to other functions, but cannot pattern-match or construct.

-- External: maps to System.Console.WriteLine / console.log / print / ...
-- The return type is the platform's native string return (idiomatic per target).
external console_log(msg Str) Str

-- Opaque: a platform-native handle type. ll-lang code can receive it from
-- external functions and pass it around but cannot inspect its internals.
opaque Buffer

-- Use the external function — no different from a regular call.
greet(name Str) =
  console_log (strConcat "Hello, " (strConcat name "!"))
