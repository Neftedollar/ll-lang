module Examples.TypeParser

-- Phase 7.3a: a real recursive-descent **type-declaration** parser written in
-- ll-lang itself. Third self-hosting milestone after 09-lexer-real.lll and
-- 11-parser-real.lll. Together they cover lexing, expression parsing, and
-- (this slice) type-declaration parsing — three pieces of the eventual
-- ll-lang-in-ll-lang front end.
--
-- Grammar (single-line form only):
--   typeDecl  = 'type' Upper param* '=' ctor ('|' ctor)*
--   param     = single-uppercase-letter Upper            -- A, B, ...
--   ctor      = Upper typeArg*
--   typeArg   = Upper                                    -- TyVar if length 1, else TyCon
--
-- The pretty-printer produces a normalised form so the runtime test can
-- string-match it:
--   type Maybe (A) = Some(A) | None
--   type Result (A) (E) = Ok(A) | Err(E)
--   type Shape = Circle | Rect | Empty
--   type Wrapped = MkWrapped(Int)
--
-- Nullary ctors print as just the name; ctors with args wrap them in
-- parens, comma-separated. Type prms print one-per-paren so the boundary
-- between prms and the `=` is visually obvious.

Token =
  | TUpper Str
  | TLower Str
  | TEq
  | TBar
  | TNewline
  | TEnd

TypeArg =
  | TAVar Str
  | TACon Str

Ctor = MkCtor Str List[TypeArg]

TypeDecl = MkTypeDecl Str List[Str] List[Ctor]

-- ---------- Char predicates ---------------------------------------------

-- ASCII uppercase test, written without `&&` (which ll-lang lacks).
isUpperChar(c Char) =
  n = charToInt c
  if n < 65
    false
  else if n > 90
    false
  else true

isLowerChar(c Char) =
  n = charToInt c
  if n < 97
    false
  else if n > 122
    false
  else true

isIdStart(c Char) =
  if isUpperChar c
    true
  else isLowerChar c

isIdCont(c Char) =
  if isIdStart c
    true
  else charIsDigit c

-- ---------- Lexer --------------------------------------------------------

-- Greedy take/drop while predicate, lifted from 09-lexer-real.lll.
takeWhilePred(p)(cs List[Char]) =
  | c :: rest ->
    if p c
      listAppend [c] (takeWhilePred p rest)
    else []
  | _ -> []

dropWhilePred(p)(cs List[Char]) =
  | c :: rest ->
    if p c
      dropWhilePred p rest
    else cs
  | _ -> []

-- Classify an identifier string. The keyword 'type' becomes TKwType; an
-- uppercase-starting ident becomes TUpper; everything else is TLower.
classifyIdent(s Str) =
  match s
    | _ ->
      cs = strChars s
      match cs
        | c :: _ ->
          if isUpperChar c
            TUpper s
          else TLower s
        | _ -> TLower s

lexId(cs List[Char]) =
  idChars = takeWhilePred isIdCont cs
  leftover = dropWhilePred isIdCont cs
  tok = classifyIdent (strFromChars idChars)
  listAppend [tok] (lexChars leftover)

lexChars(cs List[Char]) =
  | c :: rest ->
    if c == '\n'
      listAppend [TNewline] (lexChars rest)
    else if charIsSpace c
      lexChars rest
    else if c == '='
      listAppend [TEq] (lexChars rest)
    else if c == '|'
      listAppend [TBar] (lexChars rest)
    else if isIdStart c
      lexId cs
    else lexChars rest
  | _ -> [TEnd]

tokenize(src Str) = lexChars (strChars src)

-- ---------- Recursive-descent parser ------------------------------------

-- Skip leading newlines: blank lines between decls are not significant.
skipNewlines(toks List[Token]) =
  | TNewline :: rest -> skipNewlines rest
  | _ -> toks

-- Top-level driver. Walks the token stream, peeling off one type decl at a
-- time, until it sees TEnd. Uses fn-clause sugar on the cleaned-up token
-- stream so the empty / TEnd / non-empty cases are syntactically obvious.
parseTypeDecls(toks List[Token]) =
  parseDeclsClean (skipNewlines toks)

-- Use cons-pattern fast path: only attempt to parse a decl if the head is
-- TKwType. Anything else (TEnd, blank lines that already got skipped, an
-- unexpected token) terminates the recursion.
parseDeclsClean(toks List[Token]) =
  | TUpper _ :: _ -> consDecl (parseTypeDecl toks)
  | _ -> []

-- Helper: turn a (head, leftover) result into the recursive list. Splits
-- the multi-line body out of the parseDeclsClean wildcard arm so each
-- clause body stays single-line.
consDecl(pair) =
  let (d, rest) = pair
  d :: parseTypeDecls rest

-- Single decl: 'type' Upper param* '=' ctor ('|' ctor)*
parseTypeDecl(toks List[Token]) =
  | TUpper name :: rest ->
    let (prms, rest2) = parseParams rest
    rest3 = match rest2
      | TEq :: r -> r
      | _ -> rest2
   
    let (ctors, rest4) = parseCtors rest3
    (MkTypeDecl name prms ctors, rest4)
  | _ -> (MkTypeDecl "?" [] [], toks)

-- Collect zero or more single-letter uppercase prms, stopping at TEq.
parseParams(toks List[Token]) =
  | TUpper s :: rest ->
    if strLen s == 1
      let (ps, rest2) = parseParams rest
      (s :: ps, rest2)
    else ([], toks)
  | _ -> ([], toks)

-- Collect ctors separated by '|'. The first ctor is mandatory; each
-- subsequent ctor is preceded by a TBar.
parseCtors(toks List[Token]) =
  let (c, rest) = parseCtor toks
  parseCtorsTail [c] rest

parseCtorsTail(acc List[Ctor])(toks List[Token]) =
  | TBar :: rest ->
    let (c, rest2) = parseCtor rest
    parseCtorsTail (listAppend acc [c]) rest2
  | _ -> (acc, toks)

-- Single ctor: Upper typeArg*
parseCtor(toks List[Token]) =
  | TUpper name :: rest ->
    let (args, rest2) = parseTypeArgs rest
    (MkCtor name args, rest2)
  | _ -> (MkCtor "?" [], toks)

-- Collect zero or more type args, stopping on TBar / TNewline / TEnd /
-- anything else that ends a ctor body.
parseTypeArgs(toks List[Token]) =
  | TUpper s :: rest ->
    arg = if strLen s == 1
      TAVar s
    else TACon s
    let (args, rest2) = parseTypeArgs rest
    (arg :: args, rest2)
  | _ -> ([], toks)

-- ---------- Pretty printer ----------------------------------------------

-- Render a TypeArg as just its name. Type vars and type cons print the
-- same way at the leaf level — the wrapping context disambiguates.
showTypeArg(a TypeArg) =
  | TAVar s -> s
  | TACon s -> s

-- Render a list of args as `(a1, a2, a3)` or empty string for no args.
showArgs(args List[TypeArg]) =
  if listIsEmpty args
    ""
  else
    inner = listFold (\acc a. if strLen acc == 0
      showTypeArg a
    else strConcat (strConcat acc ", ") (showTypeArg a)) "" args
    strConcat (strConcat "(" inner) ")"

showCtor(c Ctor) =
  | MkCtor name args -> strConcat name (showArgs args)

showCtors(cs List[Ctor]) =
  listFold (\acc c. if strLen acc == 0
    showCtor c
  else strConcat (strConcat acc " | ") (showCtor c)) "" cs

-- Render the type-param list as ` (A) (B)` with a leading space, or empty.
showParams(ps List[Str]) =
  listFold (\acc p. strConcat (strConcat acc " (") (strConcat p ")")) "" ps

showDecl(d TypeDecl) =
  | MkTypeDecl name prms ctors -> strConcat (strConcat (strConcat name (showParams prms)) " = ") (showCtors ctors)

show(ds List[TypeDecl]) =
  listFold (\acc d. if strLen acc == 0
    showDecl d
  else strConcat (strConcat acc "\n") (showDecl d)) "" ds

-- ---------- Driver -------------------------------------------------------

main() =
  src = "Maybe A = Some A | None\nResult A E = Ok A | Err E\nShape = Circle | Rect | Empty\nWrapped = MkWrapped Int"
  toks = tokenize src
  decls = parseTypeDecls toks
  printfn (show decls)
