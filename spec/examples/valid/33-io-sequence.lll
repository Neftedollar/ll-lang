module Examples.IoSequence

import Std.IO

-- ============================================================
-- Std.IO imperative-style programming.
--
-- ll-lang is already impure (printfn is a builtin) but Std.IO
-- wraps effects in a composable IO monad, so programs READ in
-- build-then-run style:
--   * ioPure  — lift a pure value
--   * ioMap   — transform an IO result (functor map)
--   * ioThen  — sequence two actions, discarding the first
--   * ioForEach — iterate a list with effects
--   * ioRun   — execute the final description
-- ============================================================

-- Build a greeting for one name: print it, return 0.
greet(name Str) =
  ioPutStrLn (strConcat "  hello, " name)

-- Pure computation lifted into IO via ioMap: square the input.
squaredIO(n Int) =
  ioMap (\x. x * x) (ioPure n)

-- A chain of ioThen steps reads top-to-bottom like imperative code.
banner =
  line1 = ioPutStrLn "== io demo =="
  line2 = ioPutStrLn "  (banner 1)"
  line3 = ioPutStrLn "  (banner 2)"
  ioThen line1 (ioThen line2 line3)

checkBool(label Str)(ok Bool) =
  if ok
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " label)

main =
  -- ── 1. Chain of ioThen prints in order ────────────────────
  _ = ioRun banner
  _ = checkBool "1 banner ran" true

  -- ── 2. ioForEach over a list ──────────────────────────────
  _ = ioRun (ioForEach ["Ada"; "Grace"; "Ken"] greet)
  _ = checkBool "2 forEach greetings" true

  -- ── 3. ioPure + ioMap for a pure computation inside IO ────
  sq = ioRun (squaredIO 7)
  _ = checkBool "3 squaredIO = 49" (sq == 49)

  -- ── 4. ioMap composition: add 1 after squaring ────────────
  val = ioRun (ioMap (\x. x + 1) (squaredIO 6))
  _ = checkBool "4 ioMap compose = 37" (val == 37)

  -- ── 5. ioBind chain: compute, print, return ───────────────
  prog = ioBind (ioPure 10) (\x. ioThen (ioPutStrLn (strConcat "  value=" (intToStr x))) (ioPure (x * 2)))
  r5 = ioRun prog
  _ = checkBool "5 ioBind chain = 20" (r5 == 20)

  -- ── 6. ioSequence collects results ────────────────────────
  results = ioRun (ioSequence [ioPure 1; ioPure 2; ioPure 3])
  total = listFold (\acc x. acc + x) 0 results
  _ = checkBool "6 ioSequence sum = 6" (total == 6)

  -- ── 7. ioWhen gates on a condition ────────────────────────
  _ = ioRun (ioWhen true (ioPutStrLn "  (conditional ran)"))
  _ = ioRun (ioWhen false (ioPutStrLn "THIS SHOULD NOT PRINT"))
  _ = checkBool "7 ioWhen branches" true

  printfn "Done"
