module Lllcself.CompileTs

import Std.Elaborator
import Std.CodegenTS

-- Facade: full pipeline (Lexer -> Parser -> Elaborator -> CodegenTS emitter).
-- Calls `emitModuleTs`, which is a uniquely-named alias exported by
-- `Std.CodegenTS` so that this facade still emits TypeScript even when
-- downstream consumers also import `Std.Codegen` (which would otherwise
-- shadow the bare `emitModule` name via F# `open` ordering).

showTsErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

compileTs(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModuleTs ast
  else
    showTsErrors errors
