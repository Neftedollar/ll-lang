module Lllcself.CompileLlvm

import Std.Elaborator
import Std.CodegenLLVM

-- Facade: calls CodegenLLVM's uniquely-named `emitModuleLlvm`.

showLlvmErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

compileLlvm(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModuleLlvm ast
  else
    showLlvmErrors errors
