module Lllcself.Main

import Std.Compiler
import Std.Bool
import Std.Maybe
import Std.Reverse
import Std.CompilerLoader
import Std.Parser
import Std.Lexer
import Std.Elaborator
import Std.Codegen
import Std.CodegenTS
import Std.CodegenPy
import Std.CodegenJava
import Std.CodegenCSharp
import Std.CodegenLLVM
import Lllcself.Mcp

external dirList(path Str) List[Str]
external dirExists(path Str) Bool
external processRun(cmd Str)(args List[Str]) Str
external processRunEx(cmd Str)(args List[Str])(cwd Str)(timeoutSec Int) Str

-- Self-hosted ll-lang CLI.
-- Commands:
--   compile <file>  -> emit F#
--   check   <file>  -> emit compact diagnostics JSON
--   next    <file>  -> emit nearest blocking stage JSON
--   render  <file>  -> emit canonical ll-lang source
--   tokens  <file>  -> emit token estimate JSON
--   symbol  <file> <name> -> lookup top-level symbol kind JSON
--   reverse <target> <file> -> reverse target source into ll-lang (foundation slice)
--   mcp             -> run MCP stdio server loop
--
-- With a single bare path argument, defaults to `compile <file>`.

usageText =
  "usage: lllcself <command> [--target fs|ts|py|java|cs|llvm] <file|dir> [arg]\ncommands: build | compile | check | run | new | install | mod add|tidy|why | next | render | tokens | symbol | reverse | mcp"

encodeJsonEscape(c Char) =
  match c
    | '\n' -> "\\n"
    | '\t' -> "\\t"
    | '\r' -> "\\r"
    | '\\' -> "\\\\"
    | '"' -> "\\\""
    | _ -> strFromChars [c]

escapeJson(s Str) =
  listFold (\acc c. strConcat acc (encodeJsonEscape c)) "" (strChars s)

jsonStr(s Str) =
  strConcat "\"" (strConcat (escapeJson s) "\"")

ioError(msg Str) =
  p1 = "{\"ok\":false,\"stage\":\"io\",\"primary_error\":"
  p2 = strConcat p1 (jsonStr msg)
  strConcat p2 ",\"secondary_count\":0}"

okCompactJson =
  "{\"ok\":true,\"stage\":\"ok\",\"primary_error\":\"\",\"secondary_count\":0}"

compactIsOk(s Str) =
  strContains "\"ok\":true" s

strStartsWith(prefix Str)(s Str) =
  plen = strLen prefix
  slen = strLen s
  if plen > slen
    false
  else
    strSlice s 0 plen == prefix

strEndsWith(suffix Str)(s Str) =
  slen = strLen s
  tlen = strLen suffix
  if tlen > slen
    false
  else
    strSlice s (slen - tlen) tlen == suffix

trimLeftRev(cs List[Char]) =
  match cs
    | [] -> []
    | c :: rest ->
      if c == ' '
        trimLeftRev rest
      else
        if c == '\t'
          trimLeftRev rest
        else
          cs

trimLeft(s Str) =
  strFromChars (trimLeftRev (strChars s))

pathJoin(base Str)(name Str) =
  blen = strLen base
  if blen == 0
    name
  else
    lastChar = strSlice base (blen - 1) 1
    if lastChar == "/"
      strConcat base name
    else
      strConcat base (strConcat "/" name)

lastSlashChars(cs List[Char])(idx Int)(last Int) =
  match cs
    | [] -> last
    | c :: rest ->
      if c == '/'
        lastSlashChars rest (idx + 1) idx
      else
        lastSlashChars rest (idx + 1) last

pathDir(path Str) =
  idx = lastSlashChars (strChars path) 0 (0 - 1)
  if idx < 0
    "."
  else
    strSlice path 0 idx

findStdlibDirFrom(dir Str) =
  candidate = pathJoin dir "stdlib/src"
  if dirExists candidate
    candidate
  else
    parent = pathDir dir
    if parent == dir
      "stdlib/src"
    else
      if strLen parent == 0
        "stdlib/src"
      else
        findStdlibDirFrom parent

joinWith(sep Str)(xs List[Str]) =
  match xs
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

listAppendLocal(a List[A])(b List[A]) =
  match a
    | [] -> b
    | x :: rest -> x :: listAppendLocal rest b

listAnyLocal(p)(xs) =
  match xs
    | [] -> false
    | x :: rest ->
      if p x
        true
      else
        listAnyLocal p rest

listFindLocal(p)(xs) =
  match xs
    | [] -> None
    | x :: rest ->
      if p x
        Some x
      else
        listFindLocal p rest

listLastLocal(xs List[A]) =
  match xs
    | [] -> None
    | x :: [] -> Some x
    | _ :: rest -> listLastLocal rest

listFilterLocal(p)(xs) =
  match xs
    | [] -> []
    | x :: rest ->
      tail = listFilterLocal p rest
      if p x
        x :: tail
      else
        tail

listMapLocal(f)(xs) =
  match xs
    | [] -> []
    | x :: rest ->
      f x :: listMapLocal f rest

listContainsLocal(target Str)(xs List[Str]) =
  match xs
    | [] -> false
    | x :: rest ->
      if x == target
        true
      else
        listContainsLocal target rest

strLowerChar(c Char) =
  n = charToInt c
  if n >= 65
    if n <= 90
      intToChar (n + 32)
    else
      c
  else
    c

strLower(s Str) =
  strFromChars (listMapLocal strLowerChar (strChars s))

strUpperChar(c Char) =
  n = charToInt c
  if n >= 97
    if n <= 122
      intToChar (n - 32)
    else
      c
  else
    c

strUpper(s Str) =
  strFromChars (listMapLocal strUpperChar (strChars s))

normalizeTarget(raw Str) =
  t = strLower (strTrim raw)
  if t == "fsharp"
    "fs"
  else
    if t == "typescript"
      "ts"
    else
      if t == "python"
        "py"
      else
        if t == "csharp"
          "cs"
        else
          t

emitForTarget(targetRaw Str)(m Module) =
  target = normalizeTarget targetRaw
  if target == "fs"
    emitModuleFs m
  else
    if target == "ts"
      emitModuleTs m
    else
      if target == "py"
        emitModulePy m
      else
        if target == "java"
          emitModuleJava m
        else
          if target == "cs"
            emitModuleCSharp m
          else
            if target == "llvm"
              emitModuleLLVM m
            else
              strConcat "Unsupported target: " targetRaw

compileSourceForTarget(target Str)(src Str) =
  compact = checkCompact src
  if compactIsOk compact
    m = normalizeModule (parseModule (tokenize src))
    emitForTarget target m
  else
    compact

moduleNameFromSourceLines(lines List[Str]) =
  match lines
    | [] -> "Main"
    | ln :: rest ->
      t = trimLeft ln
      if strStartsWith "module " t
        strSlice t 7 (strLen t - 7)
      else
        moduleNameFromSourceLines rest

importNamesFromSourceLines(lines List[Str]) =
  match lines
    | [] -> []
    | ln :: rest ->
      t = trimLeft ln
      tail = importNamesFromSourceLines rest
      if strStartsWith "import " t
        name = strSlice t 7 (strLen t - 7)
        if strLen name > 0
          name :: tail
        else
          tail
      else
        tail

modulePathFromSource(src Str) =
  modName = moduleNameFromSourceLines (strSplit "\n" src)
  strSplit "." modName

importsFromSource(src Str) =
  importNamesFromSourceLines (strSplit "\n" src)

filterLllFiles(paths List[Str]) =
  match paths
    | [] -> []
    | p :: rest ->
      tail = filterLllFiles rest
      if strEndsWith ".lll" p
        p :: tail
      else
        tail

toLoadedFilePath(p Str) =
  src = readFile p
  MkLoadedFile p (modulePathFromSource src) (importsFromSource src)

loadProjectFiles(root Str) =
  srcDir = pathJoin root "src"
  if dirExists srcDir
    files = filterLllFiles (dirList srcDir)
    listMapLocal toLoadedFilePath files
  else
    []

projectLoadErrorJson(msg Str) =
  p1 = "{\"ok\":false,\"stage\":\"project\",\"primary_error\":"
  p2 = strConcat p1 (jsonStr msg)
  strConcat p2 ",\"secondary_count\":0}"

SourcePair = MkSourcePair Str Str

spPath(p SourcePair) =
  match p
    | MkSourcePair path _ -> path

spSrc(p SourcePair) =
  match p
    | MkSourcePair _ src -> src

isIdentStartLocal(c Char) =
  if charIsAlpha c
    true
  else
    c == '_'

isIdentContLocal(c Char) =
  if isIdentStartLocal c
    true
  else
    charIsDigit c

takeIdentLocal(cs List[Char]) =
  match cs
    | [] -> []
    | c :: rest ->
      if isIdentContLocal c
        c :: takeIdentLocal rest
      else
        []

leadingIdentLocal(s Str) =
  t = trimLeft s
  chars = strChars t
  match chars
    | [] -> None
    | c :: _ ->
      if isIdentStartLocal c
        Some (strFromChars (takeIdentLocal chars))
      else
        None

prefixedLeadingIdent(prefix Str)(line Str) =
  if strStartsWith prefix line
    rest = trimLeft (strSlice line (strLen prefix) (strLen line - strLen prefix))
    leadingIdentLocal rest
  else
    None

collectVisibleNameFromLine(line Str) =
  t = trimLeft line
  if strLen t == 0
    None
  else if strStartsWith "--" t
    None
  else if strStartsWith "module " t
    None
  else if strStartsWith "import " t
    None
  else if strStartsWith "|" t
    None
  else
    nExport = prefixedLeadingIdent "export " t
    if isSome nExport
      nExport
    else
      nExternal = prefixedLeadingIdent "external " t
      if isSome nExternal
        nExternal
      else
        nOpaque = prefixedLeadingIdent "opaque " t
        if isSome nOpaque
          nOpaque
        else
          nLead = leadingIdentLocal t
          if isSome nLead
            if strContains "=" t
              nLead
            else if strContains "(" t
              nLead
            else
              None
          else
            None

appendUniqueLocal(name Str)(acc List[Str]) =
  if listContainsLocal name acc
    acc
  else
    name :: acc

appendUniqueListLocal(xs List[Str])(acc List[Str]) =
  match xs
    | [] -> acc
    | x :: rest ->
      appendUniqueListLocal rest (appendUniqueLocal x acc)

collectVisibleNamesFromSource(src Str) =
  lines = strSplit "\n" src
  names = listFilterMap collectVisibleNameFromLine lines
  listReverse (appendUniqueListLocal names [])

collectVisibleNamesFromPairs(selfPath Str)(pairs List[SourcePair]) =
  match pairs
    | [] -> []
    | pair :: rest ->
      tail = collectVisibleNamesFromPairs selfPath rest
      p = spPath pair
      if p == selfPath
        tail
      else
        src = spSrc pair
        appendUniqueListLocal (collectVisibleNamesFromSource src) tail

ClosureState = MkClosureState (List[LoadedFile]) (List[SourcePair])

csLoaded(st ClosureState) =
  match st
    | MkClosureState loaded _ -> loaded

csPairs(st ClosureState) =
  match st
    | MkClosureState _ pairs -> pairs

resolveImportPath(baseDir Str)(stdlibDir Str)(importName Str) =
  parts = strSplit "." importName
  match parts
    | "Std" :: rest ->
      if listIsEmpty rest
        None
      else
        rel = strConcat (joinWith "/" rest) ".lll"
        Some (pathJoin stdlibDir rel)
    | _ ->
      match listLastLocal parts
        | None -> None
        | Some last ->
          if strLen last == 0
            None
          else
            Some (pathJoin baseDir (strConcat last ".lll"))

lookupSourceByPath(path Str)(pairs List[SourcePair]) =
  match pairs
    | [] -> None
    | pair :: rest ->
      p = spPath pair
      src = spSrc pair
      if p == path
        Some src
      else
        lookupSourceByPath path rest

collectImportClosure(baseDir Str)(stdlibDir Str)(queue List[Str])(seen List[Str])(loaded List[LoadedFile])(pairs List[SourcePair]) =
  match queue
    | [] -> MkClosureState loaded pairs
    | p :: rest ->
      if listContainsLocal p seen
        collectImportClosure baseDir stdlibDir rest seen loaded pairs
      else
        if fileExists p == false
          collectImportClosure baseDir stdlibDir rest (p :: seen) loaded pairs
        else
          src = readFile p
          modPath = modulePathFromSource src
          imps = importsFromSource src
          lf = MkLoadedFile p modPath imps
          depPaths =
            listFilterMap (\imp. resolveImportPath baseDir stdlibDir imp) imps
          nextQueue = listAppendLocal rest depPaths
          collectImportClosure baseDir stdlibDir nextQueue (p :: seen) (lf :: loaded) ((MkSourcePair p src) :: pairs)

checkCompactWithImports(path Str)(src Str) =
  base = checkCompact src
  baseDir = pathDir path
  stdlibDir = findStdlibDirFrom baseDir
  startQueue = path :: []
  state = collectImportClosure baseDir stdlibDir startQueue [] [] []
  loadedRev = csLoaded state
  pairs = csPairs state
  loaded = listReverse loadedRev
  if listLen loaded <= 1
    base
  else
    loadRes = loadProject loaded
    match loadRes
      | LoaderErr _ -> base
      | LoaderOk ordered ->
        orderedSrcs =
          listFilterMap (\lf. lookupSourceByPath (lfPath lf) pairs) ordered
        preludeOperatorsPath = pathJoin stdlibDir "Operators.lll"
        fixitySrcs =
          if fileExists preludeOperatorsPath
            preludeSrc = readFile preludeOperatorsPath
            listAppendLocal orderedSrcs (preludeSrc :: [])
          else
            orderedSrcs
        fixityConflicts = checkProjectFixityConflicts fixitySrcs
        if listIsEmpty fixityConflicts
          visibleNames = collectVisibleNamesFromPairs path pairs
          checkCompactWithVisible src visibleNames
        else
          msg = match fixityConflicts | e :: _ -> e | [] -> "resolver fixity conflict"
          p1 = "{\"ok\":false,\"stage\":\"resolver\",\"primary_error\":\""
          p2 = strConcat p1 msg
          p3 = strConcat p2 "\",\"secondary_count\":"
          p4 = strConcat p3 (intToStr (listLen fixityConflicts - 1))
          strConcat p4 "}"

runCheckFile(path Str) =
  if fileExists path
    src = readFile path
    result = checkCompactWithImports path src
    _ = print result
    if compactIsOk result
      0
    else
      1
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runCheckProject(root Str) =
  if dirExists root
    files = loadProjectFiles root
    if listIsEmpty files
      _ = print (projectLoadErrorJson (strConcat "No .lll files under " (pathJoin root "src")))
      1
    else
      loadRes = loadProject files
      match loadRes
        | LoaderErr errs ->
          first = match errs | e :: _ -> renderLoaderError e | [] -> "project load failed"
          _ = print (projectLoadErrorJson first)
          1
        | LoaderOk ordered ->
          sources = listMapLocal (\lf. readFile (lfPath lf)) ordered
          errs = compileProject sources
          if listIsEmpty errs
            _ = print okCompactJson
            0
          else
            firstErr = match errs | e :: _ -> e | [] -> "project type-check failed"
            _ = print (projectLoadErrorJson firstErr)
            1
  else
    _ = print (ioError (strConcat "Directory not found: " root))
    1

runCheck(target Str)(path Str) =
  if dirExists path
    runCheckProject path
  else
    _ = target
    runCheckFile path

runCompile(target Str)(path Str) =
  if fileExists path
    src = readFile path
    out = compileSourceForTarget target src
    _ = print out
    if strStartsWith "{\"ok\":false" out
      1
    else
      0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runTempPath(path Str)(ext Str) =
  plen = strLen path
  if strEndsWith ".lll" path
    base = strSlice path 0 (plen - 4)
    strConcat base ext
  else
    strConcat path ext

runExecute(target Str)(path Str) =
  if fileExists path
    src = readFile path
    out = compileSourceForTarget target src
    if strStartsWith "{\"ok\":false" out
      _ = print out
      1
    else
      t = normalizeTarget target
      if t == "py"
        pyPath = runTempPath path ".lllc.run.py"
        _ = writeFile pyPath out
        marker = "__LLLC_EXIT__"
        cmd = "python3 \"$1\" 2>&1; printf \"\\n__LLLC_EXIT__%s\" \"$?\""
        raw = processRun "sh" ("-lc" :: cmd :: "lllcself-run" :: pyPath :: [])
        idx = strIndexOf marker raw
        if idx < 0
          _ = print raw
          1
        else
          body = strSlice raw 0 idx
          codeRaw = strSlice raw (idx + strLen marker) (strLen raw - idx - strLen marker)
          code = strTrim codeRaw
          _ = print body
          if code == "0"
            0
          else
            1
      else
        _ = print (ioError (strConcat "self run currently supports only --target py (requested: " (strConcat target ")")))
        1
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runBuild(target Str)(path Str) =
  if dirExists path
    files = loadProjectFiles path
    if listIsEmpty files
      _ = print (projectLoadErrorJson (strConcat "No .lll files under " (pathJoin path "src")))
      1
    else
      loadRes = loadProject files
      match loadRes
        | LoaderErr errs ->
          first = match errs | e :: _ -> renderLoaderError e | [] -> "project load failed"
          _ = print (projectLoadErrorJson first)
          1
        | LoaderOk ordered ->
          outputs = listMapLocal (\lf. compileSourceForTarget target (readFile (lfPath lf))) ordered
          _ = print (joinWith "\n\n" outputs)
          bad = listAnyLocal (\s. strStartsWith "{\"ok\":false" s) outputs
          if bad
            1
          else
            0
  else
    runCompile target path

runRender(path Str) =
  if fileExists path
    src = readFile path
    _ = print (renderCompact src)
    0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runTokens(path Str) =
  if fileExists path
    src = readFile path
    _ = print (tokenEstimate src)
    0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runNext(path Str) =
  if fileExists path
    src = readFile path
    _ = print (nextBlocker src)
    0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runSymbol(path Str)(name Str) =
  if fileExists path
    src = readFile path
    _ = print (lookupSymbol src name)
    0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runReverse(target Str)(path Str) =
  if fileExists path
    src = readFile path
    _ = print (reverseToLll target src)
    0
  else
    _ = print (ioError (strConcat "File not found: " path))
    1

runMcp(dummy Int) =
  _ = mcpLoop 0
  0

splitOnceEq(s Str) =
  idx = strIndexOf "=" s
  if idx < 0
    None
  else
    left = strSlice s 0 idx
    right = strSlice s (idx + 1) (strLen s - idx - 1)
    Some (left, right)

runModAdd(root Str)(spec Str) =
  manifest = pathJoin root "lll.toml"
  if fileExists manifest
    match splitOnceEq spec
      | None ->
        _ = print (ioError "mod add expects name=source")
        1
      | Some (name, source) ->
        content = readFile manifest
        depLine = strConcat (strTrim name) (strConcat " = \"" (strConcat (strTrim source) "\""))
        next =
          if strContains "[deps]" content
            if strContains depLine content
              content
            else
              strConcat content (strConcat "\n" (strConcat depLine "\n"))
          else
            strConcat content (strConcat "\n\n[deps]\n" (strConcat depLine "\n"))
        _ = writeFile manifest next
        _ = print "{\"ok\":true,\"changed\":true}"
        0
  else
    _ = print (ioError (strConcat "Manifest not found: " manifest))
    1

runModWhy(root Str)(dep Str) =
  files = loadProjectFiles root
  names =
    listFilterMap (\lf.
      src = readFile (lfPath lf)
      imps = importsFromSource src
      if listContainsLocal dep imps
        Some (joinWith "." (lfModule lf))
      else
        None
    ) files
  _ = print (strConcat "{\"ok\":true,\"dep\":" (strConcat (jsonStr dep) (strConcat ",\"direct_importers\":[" (strConcat (joinWith "," (listMapLocal jsonStr names)) "]}"))))
  0

runInstall(root Str) =
  _ = root
  _ = print "{\"ok\":true,\"changed\":false,\"message\":\"Self-host baseline: install/tidy is no-op.\"}"
  0

runNew(name Str) =
  if strLen (strTrim name) == 0
    _ = print (ioError "new expects project name")
    1
  else
    srcDir = pathJoin name "src"
    _ = processRunEx "mkdir" ["-p"; srcDir] "." 30
    cap =
      c0 = strSlice name 0 1
      rest = strSlice name 1 (strLen name - 1)
      strConcat (strUpper c0) rest
    manifest = strConcat "[project]\nname = \"" (strConcat name "\"\nversion = \"0.1.0\"\nentry = \"src/Main.lll\"\n")
    mainSrc = strConcat "module " (strConcat cap ".Main\n\nmain() = printfn \"Hello from ll-lang!\"\n")
    _ = writeFile (pathJoin name "lll.toml") manifest
    _ = writeFile (pathJoin srcDir "Main.lll") mainSrc
    _ = print (strConcat "{\"ok\":true,\"path\":" (strConcat (jsonStr name) "}"))
    0

runArgs(args List[Str]) =
  match args
    | "build" :: "--target" :: target :: path :: [] -> runBuild target path
    | "build" :: path :: [] -> runBuild "fs" path
    | "check" :: "--target" :: target :: path :: [] -> runCheck target path
    | "check" :: path :: [] -> runCheck "fs" path
    | "compile" :: "--target" :: target :: path :: [] -> runCompile target path
    | "compile" :: path :: [] -> runCompile "fs" path
    | "run" :: "--target" :: target :: path :: [] -> runExecute target path
    | "run" :: path :: [] -> runExecute "py" path
    | "new" :: name :: [] -> runNew name
    | "install" :: [] -> runInstall "."
    | "mod" :: "tidy" :: [] -> runInstall "."
    | "mod" :: "add" :: spec :: [] -> runModAdd "." spec
    | "mod" :: "why" :: dep :: [] -> runModWhy "." dep
    | "next" :: path :: [] -> runNext path
    | "render" :: path :: [] -> runRender path
    | "tokens" :: path :: [] -> runTokens path
    | "symbol" :: path :: name :: [] -> runSymbol path name
    | "reverse" :: target :: path :: [] -> runReverse target path
    | "mcp" :: [] -> runMcp 0
    | path :: [] -> runCompile "fs" path
    | _ ->
      _ = printfn usageText
      1

main() =
  runArgs getArgs
