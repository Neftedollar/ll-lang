module Lllcself.CompilePy

import Std.Elaborator
import Std.CodegenPy

-- Facade: full pipeline, calls CodegenPy's uniquely-named `emitModulePy`.

showPyErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

compilePy(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModulePy ast
  else
    showPyErrors errors
