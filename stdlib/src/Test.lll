module Std.Test

import Std.Maybe
import Std.Result

-- ============================================================================
-- Std.Test — testing framework for ll-lang (Phase 1)
--
-- Core building blocks:
--   TestResult   — Pass Str | Fail Str           (one assertion outcome)
--   TestNode     — Leaf TestResult | Group ...   (structured tree of tests)
--   test / describe                              (DSL constructors)
--   runAll / runAllExit                          (runners with summary)
--
-- Thunking: `test` takes `Int -> TestResult` so the assertion body is NOT
-- evaluated until `runAll` walks the tree. Pass any Int (we call with 0).
--
-- Backward compat: legacy assert*/renderResult/run helpers below are kept
-- unchanged — existing stdlib self-tests (Monad/IO/Builder) still call them.
-- ============================================================================

TestResult = Pass Str | Fail Str

-- ---- Legacy assertions (Phase 0, kept verbatim) ----------------------------

assertTrue(label Str)(cond Bool) =
  if cond
    Pass label
  else
    Fail label

assertEqInt(label Str)(expected Int)(actual Int) =
  if expected == actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (intToStr expected) (strConcat " actual=" (intToStr actual)))))

assertEqStr(label Str)(expected Str)(actual Str) =
  if expected == actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat expected (strConcat " actual=" actual))))

assertEqBool(label Str)(expected Bool)(actual Bool) =
  if expected == actual
    Pass label
  else
    Fail label

renderResult(r TestResult) =
  match r
    | Pass label -> strConcat "OK " label
    | Fail msg -> strConcat "FAIL " msg

run(results List[TestResult]) =
  listFold
    (\fails r.
      _ = printfn (renderResult r)
      match r
        | Pass _ -> fails
        | Fail _ -> fails + 1
    )
    0
    results

-- ---- New assertions (Phase 1) ----------------------------------------------

-- Float abs-diff tolerance. We explicitly use `absf` (builtin) to avoid
-- relying on ordering subtleties of float expressions in the generated code.
assertEqFloat(label Str)(expected Float)(actual Float)(tolerance Float) =
  diff = absf (expected - actual)
  if diff <= tolerance
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (floatToStr expected) (strConcat " actual=" (strConcat (floatToStr actual) (strConcat " tol=" (floatToStr tolerance)))))))

-- Structural equality on List[Int].
listEqInt(xs List[Int])(ys List[Int]) =
  match xs
    | [] ->
      match ys
        | [] -> true
        | _ :: _ -> false
    | x :: xrest ->
      match ys
        | [] -> false
        | y :: yrest ->
          if x == y
            listEqInt xrest yrest
          else
            false

-- Join integers as "1,2,3". Mirrors the idiom in Std.Lexer.showTokens:
-- listFold with a multiline if/else lambda body.
joinIntList(xs List[Int]) =
  strs = listMap intToStr xs
  listFold (\acc s.
    if strLen acc == 0
      s
    else strConcat (strConcat acc ",") s
  ) "" strs

-- Display form like "[1,2,3]".
showIntList(xs List[Int]) =
  strConcat "[" (strConcat (joinIntList xs) "]")

assertEqList(label Str)(expected List[Int])(actual List[Int]) =
  if listEqInt expected actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (showIntList expected) (strConcat " actual=" (showIntList actual)))))

assertContains(label Str)(needle Str)(haystack Str) =
  if strContains needle haystack
    Pass label
  else
    Fail (strConcat label (strConcat " missing=" (strConcat needle (strConcat " in=" haystack))))

assertStartsWith(label Str)(prefix Str)(s Str) =
  plen = strLen prefix
  slen = strLen s
  ok =
    if plen > slen
      false
    else
      strSlice s 0 plen == prefix
  if ok
    Pass label
  else
    Fail (strConcat label (strConcat " expected prefix=" (strConcat prefix (strConcat " got=" s))))

assertMaybeSome(label Str)(m Maybe[Int]) =
  match m
    | Some _ -> Pass label
    | None -> Fail (strConcat label " expected Some, got None")

assertMaybeNone(label Str)(m Maybe[Int]) =
  match m
    | Some v -> Fail (strConcat label (strConcat " expected None, got Some=" (intToStr v)))
    | None -> Pass label

assertResultOk(label Str)(r Result[Int][Str]) =
  match r
    | Ok _ -> Pass label
    | Err e -> Fail (strConcat label (strConcat " expected Ok, got Err=" e))

assertResultErr(label Str)(r Result[Int][Str]) =
  match r
    | Ok v -> Fail (strConcat label (strConcat " expected Err, got Ok=" (intToStr v)))
    | Err _ -> Pass label

-- ---- Structured tree ------------------------------------------------------

-- LazyLeaf carries a label and a thunk so that side effects (setup/teardown,
-- IO-driven assertions) run only when the runner walks the tree. Leaf is
-- retained for compatibility with any caller that hand-built test results.
TestNode = Leaf TestResult | Group Str (List[TestNode]) | LazyLeaf Str (Int -> TestResult)

-- Deferred test. Thunk takes a dummy Int so the body runs only under runAll.
-- Phase 2: returns LazyLeaf, making the thunk genuinely lazy (the body no
-- longer fires at construction time). For legacy callers that pass
-- `constResult r`, r is still computed eagerly inside constResult — so
-- observable output is unchanged.
test(label Str)(thunk Int -> TestResult) =
  LazyLeaf label thunk

describe(name Str)(children List[TestNode]) =
  Group name children

-- ---- Phase 2: setup / teardown --------------------------------------------
--
-- beforeEach and afterEach transform a list of TestNodes so that an action
-- runs before (or after) each contained *leaf* test, recursively. The action
-- is `Int -> Int`; its return value is ignored. Group structure is preserved
-- so nesting and depth-based indentation still work under the runner.
--
-- Typical usage:
--   describe "File ops" (afterEach cleanup tests)
--
-- where cleanup is `\_. deleteFile "/tmp/x"; 0`.

-- Thunk constructors for setup/teardown. Extracted so the `match` arms
-- stay single-expression and the parser is happy with indentation.
beforeThunkLeaf(action Int -> Int)(r TestResult) =
  \d.
    _ = action d
    r

beforeThunkLazy(action Int -> Int)(thunk Int -> TestResult) =
  \d.
    _ = action d
    thunk d

afterThunkLeaf(action Int -> Int)(r TestResult) =
  \d.
    _ = action d
    r

afterThunkLazy(action Int -> Int)(thunk Int -> TestResult) =
  \d.
    result = thunk d
    _ = action d
    result

-- Wrap a single TestNode so `action` runs before its (lazy) body.
wrapBefore(action Int -> Int)(node TestNode) =
  match node
    | Leaf r -> LazyLeaf "(before+leaf)" (beforeThunkLeaf action r)
    | LazyLeaf label thunk -> LazyLeaf label (beforeThunkLazy action thunk)
    | Group name children -> Group name (listMap (wrapBefore action) children)

-- Wrap a single TestNode so `action` runs after its (lazy) body.
wrapAfter(action Int -> Int)(node TestNode) =
  match node
    | Leaf r -> LazyLeaf "(leaf+after)" (afterThunkLeaf action r)
    | LazyLeaf label thunk -> LazyLeaf label (afterThunkLazy action thunk)
    | Group name children -> Group name (listMap (wrapAfter action) children)

-- Public helpers that operate on a list of TestNodes (the typical argument
-- to `describe`). Returns a new list with the action threaded in.
beforeEach(action Int -> Int)(tests List[TestNode]) =
  listMap (wrapBefore action) tests

afterEach(action Int -> Int)(tests List[TestNode]) =
  listMap (wrapAfter action) tests

-- ---- Phase 2: parameterized tests ------------------------------------------
--
-- Table-driven tests. One body function runs against many tuple inputs; the
-- result is a `List[TestNode]` that can be spliced into `describe`.
--
-- Monomorphic helpers are provided for the common tuple shapes — the type
-- system currently struggles with fully-polymorphic parameterization, so we
-- offer (Int, Int) and (Str, Int) out of the box. Extend as new shapes come
-- up.

-- Label suffix "#<idx>" appended to the base name so each case has a unique
-- identifier in the output.
caseLabel(baseName Str)(idx Int) =
  strConcat baseName (strConcat " #" (intToStr idx))

-- Build LazyLeaf nodes from indexed cases. We use a fold that threads an
-- index counter and accumulates nodes in reverse, then reverses once at the
-- end to preserve input order.
--
-- Note: ll-lang type signatures don't (yet) accept tuple types like
-- `List[(Int, Int)]`, so we use a polymorphic type variable `C` for the
-- case element. The runtime value is a tuple; the body deconstructs it.
-- Use the concrete helpers `parameterizedIntInt` / `parameterizedStrInt`
-- defined below — they are just monomorphic aliases for call-site clarity.

parameterized(baseName Str)(cases List[C])(body C -> TestResult) =
  pair =
    listFold
      (\acc c.
        match acc
          | (idx, nodes) ->
            label = caseLabel baseName idx
            node = LazyLeaf label (\d. body c)
            ((idx + 1), (node :: nodes))
      )
      (0, [])
      cases
  match pair
    | (_, nodes) -> listReverse nodes

-- Monomorphic aliases over `parameterized` — purely for call-site
-- documentation of the expected tuple shape. The underlying generic
-- implementation does all the work.
parameterizedIntInt(baseName Str)(cases List[C])(body C -> TestResult) =
  parameterized baseName cases body

parameterizedStrInt(baseName Str)(cases List[C])(body C -> TestResult) =
  parameterized baseName cases body

-- ---- Runner ---------------------------------------------------------------

-- Produce `n` copies of "  " (2-space indent per depth level).
indentStr(depth Int) =
  if depth <= 0
    ""
  else
    strConcat "  " (indentStr (depth - 1))

-- Render a TestResult with indent; return the new fail count.
renderResultAt(pad Str)(fails Int)(r TestResult) =
  match r
    | Pass label ->
      _ = printfn (strConcat pad (strConcat "OK " label))
      fails
    | Fail msg ->
      _ = printfn (strConcat pad (strConcat "FAIL " msg))
      fails + 1

-- Walk a node, printing with depth indentation; return fails-so-far + depth.
-- We thread the running fail count through listFold. LazyLeaf forces its
-- thunk here — this is where beforeEach/afterEach action effects actually
-- fire, in left-to-right test order.
renderNode(depth Int)(fails Int)(node TestNode) =
  pad = indentStr depth
  match node
    | Leaf r -> renderResultAt pad fails r
    | LazyLeaf _ thunk -> renderResultAt pad fails (thunk 0)
    | Group name children ->
      _ = printfn (strConcat pad (strConcat "describe \"" (strConcat name "\"")))
      listFold
        (\f child. renderNode (depth + 1) f child)
        fails
        children

runAll(suites List[TestNode]) =
  failCount = listFold (\f node. renderNode 0 f node) 0 suites
  total = countLeaves suites 0
  passCount = total - failCount
  summary = strConcat "Total: " (strConcat (intToStr passCount) (strConcat " passed, " (strConcat (intToStr failCount) " failed")))
  _ = printfn summary
  failCount

-- Count Leaf + LazyLeaf nodes across the forest (for the summary line).
countLeaves(nodes List[TestNode])(acc Int) =
  listFold
    (\a node.
      match node
        | Leaf _ -> a + 1
        | LazyLeaf _ _ -> a + 1
        | Group _ children -> countLeaves children a
    )
    acc
    nodes

runAllExit(suites List[TestNode]) =
  failCount = runAll suites
  exit failCount

-- ============================================================================
-- Self-tests
-- ============================================================================

-- Helper: a thunk that returns the given already-computed result. Used by
-- tests below to sidestep the need to write a body expression.
constResult(r TestResult) =
  \ignored. r

-- Sample Maybe / Result values for the new assertions.
sampleSome = Some 7
sampleNone = None
sampleOk = Ok 3
sampleErr = Err "boom"

main =
  -- ---- Legacy API (unchanged behaviour) ---------------------------------
  results =
    [ assertTrue "1 assertTrue pass" true
    ; assertTrue "2 assertTrue fail" false
    ; assertEqInt "3 assertEqInt pass" 42 42
    ; assertEqInt "4 assertEqInt fail" 1 2
    ; assertEqStr "5 assertEqStr pass" "hi" "hi"
    ; assertEqStr "6 assertEqStr fail" "a" "b"
    ; assertEqBool "7 assertEqBool pass" true true
    ; assertEqBool "8 assertEqBool fail" true false
    ]
  legacyFails = run results
  _ = printfn (strConcat "Legacy done failCount=" (intToStr legacyFails))

  -- ---- New Phase 1 API: describe / test / runAll -----------------------
  mathChildren =
    [ test "1 add works"      (constResult (assertEqInt "1 add works" 4 (2 + 2)))
    ; test "2 eqList pass"    (constResult (assertEqList "2 eqList pass" [1; 2; 3] [1; 2; 3]))
    ; test "3 eqList fail"    (constResult (assertEqList "3 eqList fail" [1; 2] [1; 2; 3]))
    ; test "4 eqFloat pass"   (constResult (assertEqFloat "4 eqFloat pass" 1.0 1.0 0.01))
    ; test "5 eqFloat fail"   (constResult (assertEqFloat "5 eqFloat fail" 1.0 2.0 0.01))
    ]
  mathSuite = describe "Math" mathChildren

  strChildren =
    [ test "6 contains pass"    (constResult (assertContains "6 contains pass" "ell" "hello"))
    ; test "7 contains fail"    (constResult (assertContains "7 contains fail" "xyz" "hello"))
    ; test "8 startsWith pass"  (constResult (assertStartsWith "8 startsWith pass" "he" "hello"))
    ; test "9 startsWith fail"  (constResult (assertStartsWith "9 startsWith fail" "wo" "hello"))
    ]
  strSuite = describe "Str" strChildren

  mrChildren =
    [ test "10 maybeSome pass" (constResult (assertMaybeSome "10 maybeSome pass" sampleSome))
    ; test "11 maybeSome fail" (constResult (assertMaybeSome "11 maybeSome fail" sampleNone))
    ; test "12 maybeNone pass" (constResult (assertMaybeNone "12 maybeNone pass" sampleNone))
    ; test "13 maybeNone fail" (constResult (assertMaybeNone "13 maybeNone fail" sampleSome))
    ; test "14 resultOk pass"  (constResult (assertResultOk  "14 resultOk pass" sampleOk))
    ; test "15 resultOk fail"  (constResult (assertResultOk  "15 resultOk fail" sampleErr))
    ; test "16 resultErr pass" (constResult (assertResultErr "16 resultErr pass" sampleErr))
    ; test "17 resultErr fail" (constResult (assertResultErr "17 resultErr fail" sampleOk))
    ]
  maybeResSuite = describe "Maybe+Result" mrChildren

  edgeChildren =
    [ test "19 nested pass" (constResult (assertEqInt "19 nested pass" 0 0))
    ; test "20 nested fail" (constResult (assertEqInt "20 nested fail" 1 2))
    ]
  edgeGroup = describe "edge cases" edgeChildren

  parserChildren =
    [ test "18 empty input" (constResult (assertTrue "18 empty input" true))
    ; edgeGroup
    ]
  nested = describe "Parser" parserChildren

  allSuites = [mathSuite; strSuite; maybeResSuite; nested]
  newFails = runAll allSuites
  _ = printfn (strConcat "New API failCount=" (intToStr newFails))

  -- ---- Phase 2: parameterized tests -----------------------------------
  -- Table-driven: one body runs across all cases; labels auto-numbered.
  squareCases = [(1, 1); (2, 4); (3, 9); (4, 15)]  -- last one fails on purpose
  squareBody = \pair.
    match pair
      | (n, expected) ->
        label = strConcat "square n=" (intToStr n)
        assertEqInt label expected (n * n)
  squareChildren = parameterizedIntInt "square" squareCases squareBody
  squareSuite = describe "Parameterized squares" squareChildren

  -- Str, Int parameterized variant: length-of-string check.
  lenCases = [("", 0); ("a", 1); ("hello", 5)]
  lenBody = \pair.
    match pair
      | (s, expected) ->
        label = strConcat "strLen s=" s
        assertEqInt label expected (strLen s)
  lenChildren = parameterizedStrInt "len" lenCases lenBody
  lenSuite = describe "Parameterized strLen" lenChildren

  -- ---- Phase 2: beforeEach / afterEach --------------------------------
  -- Mock setup/teardown: since we have no mutable state in the harness,
  -- verify ordering by printing markers. Real callers would do IO like
  -- creating and deleting temp files.
  setupAction = \d.
    _ = printfn "  [setup]"
    0
  teardownAction = \d.
    _ = printfn "  [teardown]"
    0

  fileOpsChildren =
    [ test "f1 open"  (constResult (assertTrue "f1 open"  true))
    ; test "f2 write" (constResult (assertTrue "f2 write" true))
    ]
  fileOpsWrapped = afterEach teardownAction (beforeEach setupAction fileOpsChildren)
  fileOpsSuite = describe "File ops (setup+teardown)" fileOpsWrapped

  phase2Suites = [squareSuite; lenSuite; fileOpsSuite]
  phase2Fails = runAll phase2Suites
  _ = printfn (strConcat "Phase 2 failCount=" (intToStr phase2Fails))

  -- Timing status: ll-lang has no time primitive (no timeMs in Elaborator
  -- builtins) and adding one would touch initial-compiler/. Deferred to
  -- Phase 3 per issue #150 constraints.
  _ = printfn "Timing: deferred (no time primitive in runtime)"

  printfn "Done"
