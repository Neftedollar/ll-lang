module Std.Test

import Std.Maybe
import Std.Result

-- ============================================================================
-- Std.Test — testing framework for ll-lang (Phase 1)
--
-- Core building blocks:
--   TestResult   — Pass Str | Fail Str           (one assertion outcome)
--   TestNode     — Leaf TestResult | Group ...   (structured tree of tests)
--   test / describe                              (DSL constructors)
--   runAll / runAllExit                          (runners with summary)
--
-- Thunking: `test` takes `Int -> TestResult` so the assertion body is NOT
-- evaluated until `runAll` walks the tree. Pass any Int (we call with 0).
--
-- Backward compat: legacy assert*/renderResult/run helpers below are kept
-- unchanged — existing stdlib self-tests (Monad/IO/Builder) still call them.
-- ============================================================================

TestResult = Pass Str | Fail Str

-- ---- Legacy assertions (Phase 0, kept verbatim) ----------------------------

assertTrue(label Str)(cond Bool) =
  if cond
    Pass label
  else
    Fail label

assertEqInt(label Str)(expected Int)(actual Int) =
  if expected == actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (intToStr expected) (strConcat " actual=" (intToStr actual)))))

assertEqStr(label Str)(expected Str)(actual Str) =
  if expected == actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat expected (strConcat " actual=" actual))))

assertEqBool(label Str)(expected Bool)(actual Bool) =
  if expected == actual
    Pass label
  else
    Fail label

renderResult(r TestResult) =
  match r
    | Pass label -> strConcat "OK " label
    | Fail msg -> strConcat "FAIL " msg

run(results List[TestResult]) =
  listFold
    (\fails r.
      _ = printfn (renderResult r)
      match r
        | Pass _ -> fails
        | Fail _ -> fails + 1
    )
    0
    results

-- ---- New assertions (Phase 1) ----------------------------------------------

-- Float abs-diff tolerance. We explicitly use `absf` (builtin) to avoid
-- relying on ordering subtleties of float expressions in the generated code.
assertEqFloat(label Str)(expected Float)(actual Float)(tolerance Float) =
  diff = absf (expected - actual)
  if diff <= tolerance
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (floatToStr expected) (strConcat " actual=" (strConcat (floatToStr actual) (strConcat " tol=" (floatToStr tolerance)))))))

-- Structural equality on List[Int].
listEqInt(xs List[Int])(ys List[Int]) =
  match xs
    | [] ->
      match ys
        | [] -> true
        | _ :: _ -> false
    | x :: xrest ->
      match ys
        | [] -> false
        | y :: yrest ->
          if x == y
            listEqInt xrest yrest
          else
            false

-- Join integers as "1,2,3". Mirrors the idiom in Std.Lexer.showTokens:
-- listFold with a multiline if/else lambda body.
joinIntList(xs List[Int]) =
  strs = listMap intToStr xs
  listFold (\acc s.
    if strLen acc == 0
      s
    else strConcat (strConcat acc ",") s
  ) "" strs

-- Display form like "[1,2,3]".
showIntList(xs List[Int]) =
  strConcat "[" (strConcat (joinIntList xs) "]")

assertEqList(label Str)(expected List[Int])(actual List[Int]) =
  if listEqInt expected actual
    Pass label
  else
    Fail (strConcat label (strConcat " expected=" (strConcat (showIntList expected) (strConcat " actual=" (showIntList actual)))))

assertContains(label Str)(needle Str)(haystack Str) =
  if strContains needle haystack
    Pass label
  else
    Fail (strConcat label (strConcat " missing=" (strConcat needle (strConcat " in=" haystack))))

assertStartsWith(label Str)(prefix Str)(s Str) =
  plen = strLen prefix
  slen = strLen s
  ok =
    if plen > slen
      false
    else
      strSlice s 0 plen == prefix
  if ok
    Pass label
  else
    Fail (strConcat label (strConcat " expected prefix=" (strConcat prefix (strConcat " got=" s))))

assertMaybeSome(label Str)(m Maybe[Int]) =
  match m
    | Some _ -> Pass label
    | None -> Fail (strConcat label " expected Some, got None")

assertMaybeNone(label Str)(m Maybe[Int]) =
  match m
    | Some v -> Fail (strConcat label (strConcat " expected None, got Some=" (intToStr v)))
    | None -> Pass label

assertResultOk(label Str)(r Result[Int][Str]) =
  match r
    | Ok _ -> Pass label
    | Err e -> Fail (strConcat label (strConcat " expected Ok, got Err=" e))

assertResultErr(label Str)(r Result[Int][Str]) =
  match r
    | Ok v -> Fail (strConcat label (strConcat " expected Err, got Ok=" (intToStr v)))
    | Err _ -> Pass label

-- ---- Structured tree ------------------------------------------------------

-- LazyLeaf carries a label and a thunk so that side effects (setup/teardown,
-- IO-driven assertions) run only when the runner walks the tree. Leaf is
-- retained for compatibility with any caller that hand-built test results.
-- Phase 3:
--   Skipped — from xtest; reported as SKIP, not counted as pass/fail.
--   Focused — from ftest; when ANY Focused node exists in the tree, only
--   Focused nodes run; non-focused LazyLeafs turn into implicit skips.
TestNode = Leaf TestResult | Group Str (List[TestNode]) | LazyLeaf Str (Int -> TestResult) | Skipped Str | Focused Str (Int -> TestResult)

-- Deferred test. Thunk takes a dummy Int so the body runs only under runAll.
-- Phase 2: returns LazyLeaf, making the thunk genuinely lazy (the body no
-- longer fires at construction time). For legacy callers that pass
-- `constResult r`, r is still computed eagerly inside constResult — so
-- observable output is unchanged.
test(label Str)(thunk Int -> TestResult) =
  LazyLeaf label thunk

describe(name Str)(children List[TestNode]) =
  Group name children

-- Phase 3: explicit skip. Body is never run; runner prints SKIP <label> and
-- the leaf is excluded from pass/fail counts.
xtest(label Str)(thunk Int -> TestResult) =
  Skipped label

-- Phase 3: focus this test. If any Focused node exists anywhere in the
-- suites list passed to runAll, non-focused LazyLeafs are silently skipped
-- (treated like Skipped in output). If no Focused nodes exist, ftest behaves
-- just like test.
ftest(label Str)(thunk Int -> TestResult) =
  Focused label thunk

-- ---- Phase 2: setup / teardown --------------------------------------------
--
-- beforeEach and afterEach transform a list of TestNodes so that an action
-- runs before (or after) each contained *leaf* test, recursively. The action
-- is `Int -> Int`; its return value is ignored. Group structure is preserved
-- so nesting and depth-based indentation still work under the runner.
--
-- Typical usage:
--   describe "File ops" (afterEach cleanup tests)
--
-- where cleanup is `\_. deleteFile "/tmp/x"; 0`.

-- Thunk constructors for setup/teardown. Extracted so the `match` arms
-- stay single-expression and the parser is happy with indentation.
beforeThunkLeaf(action Int -> Int)(r TestResult) =
  \d.
    _ = action d
    r

beforeThunkLazy(action Int -> Int)(thunk Int -> TestResult) =
  \d.
    _ = action d
    thunk d

afterThunkLeaf(action Int -> Int)(r TestResult) =
  \d.
    _ = action d
    r

afterThunkLazy(action Int -> Int)(thunk Int -> TestResult) =
  \d.
    result = thunk d
    _ = action d
    result

-- Wrap a single TestNode so `action` runs before its (lazy) body.
-- Skipped nodes pass through untouched (the action would be misleading since
-- the body never runs). Focused nodes get the same treatment as LazyLeaf.
wrapBefore(action Int -> Int)(node TestNode) =
  match node
    | Leaf r -> LazyLeaf "(before+leaf)" (beforeThunkLeaf action r)
    | LazyLeaf label thunk -> LazyLeaf label (beforeThunkLazy action thunk)
    | Skipped label -> Skipped label
    | Focused label thunk -> Focused label (beforeThunkLazy action thunk)
    | Group name children -> Group name (listMap (wrapBefore action) children)

-- Wrap a single TestNode so `action` runs after its (lazy) body.
wrapAfter(action Int -> Int)(node TestNode) =
  match node
    | Leaf r -> LazyLeaf "(leaf+after)" (afterThunkLeaf action r)
    | LazyLeaf label thunk -> LazyLeaf label (afterThunkLazy action thunk)
    | Skipped label -> Skipped label
    | Focused label thunk -> Focused label (afterThunkLazy action thunk)
    | Group name children -> Group name (listMap (wrapAfter action) children)

-- Public helpers that operate on a list of TestNodes (the typical argument
-- to `describe`). Returns a new list with the action threaded in.
beforeEach(action Int -> Int)(tests List[TestNode]) =
  listMap (wrapBefore action) tests

afterEach(action Int -> Int)(tests List[TestNode]) =
  listMap (wrapAfter action) tests

-- ---- Phase 2: parameterized tests ------------------------------------------
--
-- Table-driven tests. One body function runs against many tuple inputs; the
-- result is a `List[TestNode]` that can be spliced into `describe`.
--
-- Monomorphic helpers are provided for the common tuple shapes — the type
-- system currently struggles with fully-polymorphic parameterization, so we
-- offer (Int, Int) and (Str, Int) out of the box. Extend as new shapes come
-- up.

-- Label suffix "#<idx>" appended to the base name so each case has a unique
-- identifier in the output.
caseLabel(baseName Str)(idx Int) =
  strConcat baseName (strConcat " #" (intToStr idx))

-- Build LazyLeaf nodes from indexed cases. We use a fold that threads an
-- index counter and accumulates nodes in reverse, then reverses once at the
-- end to preserve input order.
--
-- Note: ll-lang type signatures don't (yet) accept tuple types like
-- `List[(Int, Int)]`, so we use a polymorphic type variable `C` for the
-- case element. The runtime value is a tuple; the body deconstructs it.
-- Use the concrete helpers `parameterizedIntInt` / `parameterizedStrInt`
-- defined below — they are just monomorphic aliases for call-site clarity.

parameterized(baseName Str)(cases List[C])(body C -> TestResult) =
  pair =
    listFold
      (\acc c.
        match acc
          | (idx, nodes) ->
            label = caseLabel baseName idx
            node = LazyLeaf label (\d. body c)
            ((idx + 1), (node :: nodes))
      )
      (0, [])
      cases
  match pair
    | (_, nodes) -> listReverse nodes

-- Monomorphic aliases over `parameterized` — purely for call-site
-- documentation of the expected tuple shape. The underlying generic
-- implementation does all the work.
parameterizedIntInt(baseName Str)(cases List[C])(body C -> TestResult) =
  parameterized baseName cases body

parameterizedStrInt(baseName Str)(cases List[C])(body C -> TestResult) =
  parameterized baseName cases body

-- ---- Runner ---------------------------------------------------------------

-- Produce `n` copies of "  " (2-space indent per depth level).
indentStr(depth Int) =
  if depth <= 0
    ""
  else
    strConcat "  " (indentStr (depth - 1))

-- Result of rendering a single leaf. Threading three counters through the
-- tree is clearer than an Int-triple here.
-- fails, skips, durationMs (sum); duration is 0 when timeMs unused.
RunCounts = RunCounts Int Int Int

addFail(c RunCounts) =
  match c
    | RunCounts f s d -> RunCounts (f + 1) s d

addSkip(c RunCounts) =
  match c
    | RunCounts f s d -> RunCounts f (s + 1) d

-- Render a TestResult with indent; return the new counts.
renderResultAt(pad Str)(counts RunCounts)(r TestResult) =
  match r
    | Pass label ->
      _ = printfn (strConcat pad (strConcat "OK " label))
      counts
    | Fail msg ->
      _ = printfn (strConcat pad (strConcat "FAIL " msg))
      addFail counts

-- Render with a [Xms] timing suffix. Used by focus + lazy paths.
renderResultTimed(pad Str)(counts RunCounts)(elapsed Int)(r TestResult) =
  suffix = strConcat " [" (strConcat (intToStr elapsed) "ms]")
  match r
    | Pass label ->
      _ = printfn (strConcat pad (strConcat "OK " (strConcat label suffix)))
      counts
    | Fail msg ->
      _ = printfn (strConcat pad (strConcat "FAIL " (strConcat msg suffix)))
      addFail counts

-- Detect whether any Focused node exists anywhere in a forest. Used by the
-- runner to decide whether to activate focus-mode (silently skip everything
-- that isn't Focused or Skipped).
hasFocusInNode(node TestNode) =
  match node
    | Leaf _ -> false
    | LazyLeaf _ _ -> false
    | Skipped _ -> false
    | Focused _ _ -> true
    | Group _ children -> hasFocusList children

hasFocusList(nodes List[TestNode]) =
  listFold
    (\acc n.
      if acc
        true
      else
        hasFocusInNode n
    )
    false
    nodes

-- Execute a single thunk, measuring wall time. Returns a pair (elapsedMs, result).
runTimed(thunk Int -> TestResult) =
  t0 = timeMs 0
  r = thunk 0
  t1 = timeMs 0
  ((t1 - t0), r)

-- Walk a node, printing with depth indentation; return updated RunCounts.
-- focusMode: if true, LazyLeafs are silently skipped (they aren't ftest'd);
-- Focused thunks always run; Skipped always prints SKIP.
renderNode(focusMode Bool)(depth Int)(counts RunCounts)(node TestNode) =
  pad = indentStr depth
  match node
    | Leaf r -> renderResultAt pad counts r
    | LazyLeaf label thunk ->
      if focusMode
        -- Non-focused test under focus-mode: skip silently with SKIP line.
        _ = printfn (strConcat pad (strConcat "SKIP " label))
        addSkip counts
      else
        timed = runTimed thunk
        match timed
          | (elapsed, r) -> renderResultTimed pad counts elapsed r
    | Skipped label ->
      _ = printfn (strConcat pad (strConcat "SKIP " label))
      addSkip counts
    | Focused label thunk ->
      timed = runTimed thunk
      match timed
        | (elapsed, r) ->
          suffix = strConcat " [" (strConcat (intToStr elapsed) "ms]")
          match r
            | Pass _ ->
              _ = printfn (strConcat pad (strConcat "FOCUS " (strConcat label suffix)))
              counts
            | Fail msg ->
              _ = printfn (strConcat pad (strConcat "FOCUS-FAIL " (strConcat msg suffix)))
              addFail counts
    | Group name children ->
      _ = printfn (strConcat pad (strConcat "describe \"" (strConcat name "\"")))
      listFold
        (\c child. renderNode focusMode (depth + 1) c child)
        counts
        children

runAll(suites List[TestNode]) =
  focusMode = hasFocusList suites
  zero = RunCounts 0 0 0
  finalCounts = listFold (\c node. renderNode focusMode 0 c node) zero suites
  total = countLeaves suites 0
  match finalCounts
    | RunCounts failCount skipCount _ ->
      passCount = total - failCount - skipCount
      summary = strConcat "Total: " (strConcat (intToStr passCount) (strConcat " passed, " (strConcat (intToStr failCount) (strConcat " failed, " (strConcat (intToStr skipCount) " skipped")))))
      _ = printfn summary
      failCount

-- Count all leaf-like nodes across the forest (for the summary line).
-- Leaf + LazyLeaf + Skipped + Focused each count as one test.
countLeaves(nodes List[TestNode])(acc Int) =
  listFold
    (\a node.
      match node
        | Leaf _ -> a + 1
        | LazyLeaf _ _ -> a + 1
        | Skipped _ -> a + 1
        | Focused _ _ -> a + 1
        | Group _ children -> countLeaves children a
    )
    acc
    nodes

runAllExit(suites List[TestNode]) =
  failCount = runAll suites
  exit failCount

-- ---- Phase 3: JUnit XML output --------------------------------------------
--
-- runAllJunit walks the test tree, executes every test (not honouring focus
-- mode here — the XML is meant to report the full suite) and emits a JUnit
-- XML file to the requested path. Each top-level `describe` becomes a single
-- `<testsuite>`; nested describes are flattened into dotted classnames.

-- XML entity escaping for a single character.
xmlEscapeChar(c Char) =
  if c == '<'
    "&lt;"
  else if c == '>'
    "&gt;"
  else if c == '&'
    "&amp;"
  else if c == '"'
    "&quot;"
  else if c == '\''
    "&apos;"
  else strFromChars [c]

xmlEscapeChars(cs List[Char])(acc Str) =
  match cs
    | c :: rest -> xmlEscapeChars rest (strConcat acc (xmlEscapeChar c))
    | _ -> acc

xmlEscape(s Str) =
  xmlEscapeChars (strChars s) ""

-- A JUnit-ready record per test case. `kind` is "pass" | "fail" | "skip".
-- `msg` carries the Fail body (empty for pass/skip). `timeMs` is wall time.
JunitCase = JunitCase Str Str Str Int

caseKind(jc JunitCase) =
  match jc
    | JunitCase _ k _ _ -> k

-- Execute a LazyLeaf/Focused thunk and return a JunitCase. Errors/skips map
-- to the appropriate kind. We run every thunk once here — independently of
-- the text runner — so runAllJunit doesn't depend on runAll's ordering.
nodeToCase(node TestNode) =
  match node
    | Leaf r ->
      match r
        | Pass label -> JunitCase label "pass" "" 0
        | Fail msg -> JunitCase msg "fail" msg 0
    | LazyLeaf label thunk ->
      timed = runTimed thunk
      match timed
        | (elapsed, r) ->
          match r
            | Pass _ -> JunitCase label "pass" "" elapsed
            | Fail msg -> JunitCase label "fail" msg elapsed
    | Focused label thunk ->
      timed = runTimed thunk
      match timed
        | (elapsed, r) ->
          match r
            | Pass _ -> JunitCase label "pass" "" elapsed
            | Fail msg -> JunitCase label "fail" msg elapsed
    | Skipped label -> JunitCase label "skip" "" 0
    | Group _ _ -> JunitCase "(group)" "skip" "" 0

-- Flatten a group-or-leaf to a list of JunitCase, preserving left-to-right
-- order. The recursion goes through flattenCasesOfList to keep each
-- function monomorphic — HM struggled when flattenCases was passed as a
-- first-class value to listMap.
flattenCasesOfList(nodes List[TestNode]) =
  match nodes
    | [] -> []
    | n :: rest ->
      match n
        | Group _ children -> listAppend (flattenCasesOfList children) (flattenCasesOfList rest)
        | Leaf _ -> (nodeToCase n) :: (flattenCasesOfList rest)
        | LazyLeaf _ _ -> (nodeToCase n) :: (flattenCasesOfList rest)
        | Skipped _ -> (nodeToCase n) :: (flattenCasesOfList rest)
        | Focused _ _ -> (nodeToCase n) :: (flattenCasesOfList rest)

-- Build an ms-as-seconds string "0.004" for JUnit's time="" attribute. No
-- floatToStr gymnastics — JUnit accepts integer-looking "0" fine too, but
-- consumers prefer 3-decimal seconds.
padRemStr(rem Int) =
  if rem < 10
    strConcat "00" (intToStr rem)
  else
    if rem < 100
      strConcat "0" (intToStr rem)
    else
      intToStr rem

msToSecStr(ms Int) =
  whole = ms / 1000
  rem = ms - (whole * 1000)
  strConcat (intToStr whole) (strConcat "." (padRemStr rem))

-- Build the opening `<testcase ...` fragment (no closing `>` or ` />`).
-- Kept monolithic on a single line — ll-lang's indentation-sensitive parser
-- dislikes multi-line strConcat continuations inside nested match arms.
caseOpenTag(suiteName Str)(label Str)(elapsed Int) =
  strConcat "    <testcase name=\"" (strConcat (xmlEscape label) (strConcat "\" classname=\"" (strConcat (xmlEscape suiteName) (strConcat "\" time=\"" (strConcat (msToSecStr elapsed) "\"")))))

renderCaseXml(suiteName Str)(jc JunitCase) =
  match jc
    | JunitCase label kind msg elapsed ->
      openTag = caseOpenTag suiteName label elapsed
      if kind == "pass"
        strConcat openTag " />\n"
      else
        if kind == "skip"
          strConcat openTag ">\n      <skipped />\n    </testcase>\n"
        else
          strConcat openTag (strConcat ">\n      <failure message=\"" (strConcat (xmlEscape msg) "\" />\n    </testcase>\n"))

-- Count cases of a given kind in a list.
countKind(cases List[JunitCase])(kind Str) =
  listFold
    (\acc jc.
      if caseKind jc == kind
        acc + 1
      else
        acc
    )
    0
    cases

-- Build the `<testsuite ...>` opening tag with all attributes. Kept on one
-- line so the parser's indentation tracker doesn't trip.
suiteOpenTag(name Str)(total Int)(failures Int)(skipped Int) =
  strConcat "  <testsuite name=\"" (strConcat (xmlEscape name) (strConcat "\" tests=\"" (strConcat (intToStr total) (strConcat "\" failures=\"" (strConcat (intToStr failures) (strConcat "\" skipped=\"" (strConcat (intToStr skipped) "\">\n")))))))

renderSuiteXml(node TestNode) =
  match node
    | Group name children ->
      cases = flattenCasesOfList children
      total = listLen cases
      failures = countKind cases "fail"
      skipped = countKind cases "skip"
      casesXml = listFold (\acc jc. strConcat acc (renderCaseXml name jc)) "" cases
      header = suiteOpenTag name total failures skipped
      (cases, strConcat header (strConcat casesXml "  </testsuite>\n"))
    | _ ->
      -- Top-level bare leaf: synthesize a one-suite "ungrouped".
      jc = nodeToCase node
      casesXml = renderCaseXml "ungrouped" jc
      failures =
        if caseKind jc == "fail"
          1
        else
          0
      skipped =
        if caseKind jc == "skip"
          1
        else
          0
      header = suiteOpenTag "ungrouped" 1 failures skipped
      ([jc], strConcat header (strConcat casesXml "  </testsuite>\n"))

-- Concat the XML fragments produced by rendering each top-level suite.
-- (The allCases list is built separately via listConcat.)
buildSuitesXml(suites List[TestNode]) =
  match suites
    | [] -> ""
    | s :: rest ->
      pair = renderSuiteXml s
      match pair
        | (_, xml) -> strConcat xml (buildSuitesXml rest)

runAllJunit(suites List[TestNode])(outputPath Str) =
  allCases = flattenCasesOfList suites
  body = buildSuitesXml suites
  total = listLen allCases
  failures = countKind allCases "fail"
  skipped = countKind allCases "skip"
  header = strConcat "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuites tests=\"" (strConcat (intToStr total) (strConcat "\" failures=\"" (strConcat (intToStr failures) (strConcat "\" skipped=\"" (strConcat (intToStr skipped) "\">\n")))))
  xml = strConcat header (strConcat body "</testsuites>\n")
  _ = writeFile outputPath xml
  total

-- ============================================================================
-- Self-tests
-- ============================================================================

-- Helper: a thunk that returns the given already-computed result. Used by
-- tests below to sidestep the need to write a body expression.
constResult(r TestResult) =
  \ignored. r

-- Sample Maybe / Result values for the new assertions.
sampleSome = Some 7
sampleNone = None
sampleOk = Ok 3
sampleErr = Err "boom"

main =
  -- ---- Legacy API (unchanged behaviour) ---------------------------------
  results =
    [ assertTrue "1 assertTrue pass" true
    ; assertTrue "2 assertTrue fail" false
    ; assertEqInt "3 assertEqInt pass" 42 42
    ; assertEqInt "4 assertEqInt fail" 1 2
    ; assertEqStr "5 assertEqStr pass" "hi" "hi"
    ; assertEqStr "6 assertEqStr fail" "a" "b"
    ; assertEqBool "7 assertEqBool pass" true true
    ; assertEqBool "8 assertEqBool fail" true false
    ]
  legacyFails = run results
  _ = printfn (strConcat "Legacy done failCount=" (intToStr legacyFails))

  -- ---- New Phase 1 API: describe / test / runAll -----------------------
  mathChildren =
    [ test "1 add works"      (constResult (assertEqInt "1 add works" 4 (2 + 2)))
    ; test "2 eqList pass"    (constResult (assertEqList "2 eqList pass" [1; 2; 3] [1; 2; 3]))
    ; test "3 eqList fail"    (constResult (assertEqList "3 eqList fail" [1; 2] [1; 2; 3]))
    ; test "4 eqFloat pass"   (constResult (assertEqFloat "4 eqFloat pass" 1.0 1.0 0.01))
    ; test "5 eqFloat fail"   (constResult (assertEqFloat "5 eqFloat fail" 1.0 2.0 0.01))
    ]
  mathSuite = describe "Math" mathChildren

  strChildren =
    [ test "6 contains pass"    (constResult (assertContains "6 contains pass" "ell" "hello"))
    ; test "7 contains fail"    (constResult (assertContains "7 contains fail" "xyz" "hello"))
    ; test "8 startsWith pass"  (constResult (assertStartsWith "8 startsWith pass" "he" "hello"))
    ; test "9 startsWith fail"  (constResult (assertStartsWith "9 startsWith fail" "wo" "hello"))
    ]
  strSuite = describe "Str" strChildren

  mrChildren =
    [ test "10 maybeSome pass" (constResult (assertMaybeSome "10 maybeSome pass" sampleSome))
    ; test "11 maybeSome fail" (constResult (assertMaybeSome "11 maybeSome fail" sampleNone))
    ; test "12 maybeNone pass" (constResult (assertMaybeNone "12 maybeNone pass" sampleNone))
    ; test "13 maybeNone fail" (constResult (assertMaybeNone "13 maybeNone fail" sampleSome))
    ; test "14 resultOk pass"  (constResult (assertResultOk  "14 resultOk pass" sampleOk))
    ; test "15 resultOk fail"  (constResult (assertResultOk  "15 resultOk fail" sampleErr))
    ; test "16 resultErr pass" (constResult (assertResultErr "16 resultErr pass" sampleErr))
    ; test "17 resultErr fail" (constResult (assertResultErr "17 resultErr fail" sampleOk))
    ]
  maybeResSuite = describe "Maybe+Result" mrChildren

  edgeChildren =
    [ test "19 nested pass" (constResult (assertEqInt "19 nested pass" 0 0))
    ; test "20 nested fail" (constResult (assertEqInt "20 nested fail" 1 2))
    ]
  edgeGroup = describe "edge cases" edgeChildren

  parserChildren =
    [ test "18 empty input" (constResult (assertTrue "18 empty input" true))
    ; edgeGroup
    ]
  nested = describe "Parser" parserChildren

  allSuites = [mathSuite; strSuite; maybeResSuite; nested]
  newFails = runAll allSuites
  _ = printfn (strConcat "New API failCount=" (intToStr newFails))

  -- ---- Phase 2: parameterized tests -----------------------------------
  -- Table-driven: one body runs across all cases; labels auto-numbered.
  squareCases = [(1, 1); (2, 4); (3, 9); (4, 15)]  -- last one fails on purpose
  squareBody = \pair.
    match pair
      | (n, expected) ->
        label = strConcat "square n=" (intToStr n)
        assertEqInt label expected (n * n)
  squareChildren = parameterizedIntInt "square" squareCases squareBody
  squareSuite = describe "Parameterized squares" squareChildren

  -- Str, Int parameterized variant: length-of-string check.
  lenCases = [("", 0); ("a", 1); ("hello", 5)]
  lenBody = \pair.
    match pair
      | (s, expected) ->
        label = strConcat "strLen s=" s
        assertEqInt label expected (strLen s)
  lenChildren = parameterizedStrInt "len" lenCases lenBody
  lenSuite = describe "Parameterized strLen" lenChildren

  -- ---- Phase 2: beforeEach / afterEach --------------------------------
  -- Mock setup/teardown: since we have no mutable state in the harness,
  -- verify ordering by printing markers. Real callers would do IO like
  -- creating and deleting temp files.
  setupAction = \d.
    _ = printfn "  [setup]"
    0
  teardownAction = \d.
    _ = printfn "  [teardown]"
    0

  fileOpsChildren =
    [ test "f1 open"  (constResult (assertTrue "f1 open"  true))
    ; test "f2 write" (constResult (assertTrue "f2 write" true))
    ]
  fileOpsWrapped = afterEach teardownAction (beforeEach setupAction fileOpsChildren)
  fileOpsSuite = describe "File ops (setup+teardown)" fileOpsWrapped

  phase2Suites = [squareSuite; lenSuite; fileOpsSuite]
  phase2Fails = runAll phase2Suites
  _ = printfn (strConcat "Phase 2 failCount=" (intToStr phase2Fails))

  -- ---- Phase 3: skip / focus demo ------------------------------------
  -- When no ftest is present in the forest, xtest still marks SKIP and
  -- normal tests run as usual.
  skipOnlyChildren =
    [ test  "s1 runs normally" (constResult (assertTrue "s1 runs normally" true))
    ; xtest "s2 pending feature" (constResult (assertTrue "s2 pending" true))
    ; test  "s3 also runs"      (constResult (assertTrue "s3 also runs" true))
    ]
  skipOnlySuite = describe "Skip demo (no focus)" skipOnlyChildren
  _ = runAll [skipOnlySuite]

  -- When an ftest is present: only ftest + xtest execute; non-focused
  -- LazyLeafs are reported as SKIP and not counted as passes.
  focusChildren =
    [ test  "f1 should be silenced"   (constResult (assertTrue "f1 silenced" true))
    ; xtest "f2 explicit skip"        (constResult (assertTrue "f2" true))
    ; ftest "f3 focus me"             (constResult (assertTrue "f3 focus me" true))
    ; test  "f4 should also be silenced" (constResult (assertTrue "f4 silenced" true))
    ]
  focusSuite = describe "Focus demo" focusChildren
  _ = runAll [focusSuite]

  -- ---- Phase 3: JUnit XML output -------------------------------------
  -- Mixed pass/fail/skip so the generated XML exercises every branch.
  junitChildren =
    [ test  "j1 add works"    (constResult (assertEqInt "j1 add works" 4 (2 + 2)))
    ; test  "j2 sub fails"    (constResult (assertEqInt "j2 sub fails" 3 (5 - 1)))
    ; xtest "j3 pending"      (constResult (assertTrue "j3 pending" true))
    ; test  "j4 <xml> & \"quotes\"" (constResult (assertTrue "j4 xml-escape" true))
    ]
  junitSuite = describe "Math & \"core\"" junitChildren
  junitPath = "/tmp/ll-lang-test-results.xml"
  junitTotal = runAllJunit [junitSuite] junitPath
  _ = printfn (strConcat "JUnit wrote " (strConcat (intToStr junitTotal) (strConcat " tests to " junitPath)))
  junitXml = readFile junitPath
  _ = printfn "---- JUnit XML ----"
  _ = printfn junitXml
  _ = printfn "---- end XML ----"

  -- ---- Phase 3: timing ------------------------------------------------
  -- Exercised implicitly by every LazyLeaf above; demonstrate explicitly.
  _ = printfn (strConcat "timeMs baseline: " (intToStr (timeMs 0)))

  printfn "Done"
