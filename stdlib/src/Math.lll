module Std.Math

clampInt(lo Int)(hi Int)(x Int) =
  if x < lo
    lo
  else if x > hi
    hi
  else
    x

clampFloat(lo Float)(hi Float)(x Float) =
  if x < lo
    lo
  else if x > hi
    hi
  else
    x

betweenInt(lo Int)(hi Int)(x Int) =
  if x < lo
    false
  else
    x <= hi

betweenFloat(lo Float)(hi Float)(x Float) =
  if x < lo
    false
  else
    x <= hi

signInt(x Int) =
  if x > 0
    1
  else if x < 0
    0 - 1
  else
    0

signFloat(x Float) =
  if x > 0.0
    1.0
  else if x < 0.0
    0.0 - 1.0
  else
    0.0

-- ---- Self-checks -------------------------------------------------------------

check(label Str)(ok Bool) =
  if ok
    _ = printfn (strConcat "OK " label)
    0
  else
    _ = printfn (strConcat "FAIL " label)
    1

main =
  _ = check "1 clampInt lo" (clampInt 0 10 (0 - 5) == 0)
  _ = check "2 clampInt hi" (clampInt 0 10 20 == 10)
  _ = check "3 clampInt mid" (clampInt 0 10 5 == 5)
  _ = check "4 betweenInt lo" (betweenInt 1 5 0 == false)
  _ = check "5 betweenInt hi" (betweenInt 1 5 6 == false)
  _ = check "6 betweenInt in" (betweenInt 1 5 3 == true)
  _ = check "7 signInt pos" (signInt 7 == 1)
  _ = check "8 signInt neg" (signInt (0 - 3) == (0 - 1))
  _ = check "9 signInt zero" (signInt 0 == 0)
  printfn "Done"

