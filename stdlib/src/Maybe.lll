module Std.Maybe

-- Canonical Maybe type for ll-lang stdlib.
-- Each file that needs Maybe must define it locally (single-file lllc run mode),
-- but this module is the canonical reference and documents the full Maybe API.
--
-- NOTE: maybeMap, maybeBind, maybeWithDefault are compiler prelude builtins.
-- This module adds isSome / isNone which are not in the prelude.

export Maybe A = Some A | None

export isNone(m Maybe[A]) =
  match m
    | Some _ -> false
    | None -> true

export isSome(m Maybe[A]) =
  match m
    | Some _ -> true
    | None -> false

-- ---- Tests ----------------------------------------------------------------

export check(label Str)(ok Bool) =
  if ok
    _ = printfn (strConcat "OK " label)
    0
  else
    _ = printfn (strConcat "FAIL " label)
    1

export doubleInMaybe(x Int) = Some (x * 2)

maybeCheck(label Str)(got Str)(expected Str) =
  if got == expected
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat " expected=" (strConcat expected (strConcat " got=" got)))))

boolStr(b Bool) =
  if b
    "true"
  else "false"

-- Extract Maybe[Int] to Str using pattern match (avoids object-typed prelude in C# backend)
maybeIntStr(m Maybe[Int]) =
  match m
    | Some v -> intToStr v
    | None -> "none"

main =
  -- 1. isSome on Some
  _ = maybeCheck "1 isSome" (boolStr (isSome (Some 1))) "true"

  -- 2. isSome on None
  _ = maybeCheck "2 isSome None" (boolStr (isSome None)) "false"

  -- 3. isNone on None
  _ = maybeCheck "3 isNone" (boolStr (isNone None)) "true"

  -- 4. isNone on Some
  _ = maybeCheck "4 isNone Some" (boolStr (isNone (Some 5))) "false"

  -- 5. maybeWithDefault Some (via pattern match)
  _ = maybeCheck "5 withDefault Some" (maybeIntStr (Some 42)) "42"

  -- 6. maybeWithDefault None (via pattern match)
  _ = maybeCheck "6 withDefault None" (maybeIntStr None) "none"

  -- 7-10: maybeMap / maybeBind verified via the F# backend only.
  -- The C# prelude emits `maybeMap(Func<object,object> f)` which cannot be
  -- called with a typed lambda in multi-module builds.  The full tests live
  -- in tests/LLLangTests/StdlibMaybeTests.fs and run against the F# target.

  printfn "Done"
