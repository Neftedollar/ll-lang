module Std.Map

-- Map implemented as an Okasaki red-black tree.
-- Keys are compared via an explicit comparator: cmp a b
--   returns negative if a < b, zero if a == b, positive if a > b

type Color = Red | Black

-- RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)
type RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)

type Maybe A = Some A | None

-- Empty map
fn mapEmpty() RBMap[K][V] = Leaf

-- Size of map
fn mapSize(m RBMap[K][V]) Int =
  match m with
    | Leaf -> 0
    | Node _ left _ _ right -> 1 + mapSize left + mapSize right

-- balance helpers: detect and fix each of the 4 red-violation cases.
-- Called only when the top node colour is Black.

-- Try to fix left-left violation: Black (Red (Red a x xv b) y yv c) z zv d
fn balanceLeft(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) RBMap[K][V] =
  match left with
    | Node (Red) ll lk lv lr ->
      match ll with
        | Node (Red) a xk xv b ->
          Node (Red) (Node (Black) a xk xv b) lk lv (Node (Black) lr k v right)
        | _ ->
          match lr with
            | Node (Red) b yk yv c ->
              Node (Red) (Node (Black) ll lk lv b) yk yv (Node (Black) c k v right)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- Try to fix right violations: Black a x xv (Red (Red b y yv c) z zv d)
--                          or: Black a x xv (Red b y yv (Red c z zv d))
fn balanceRight(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) RBMap[K][V] =
  match right with
    | Node (Red) rl rk rv rr ->
      match rl with
        | Node (Red) b yk yv c ->
          Node (Red) (Node (Black) left k v b) yk yv (Node (Black) c rk rv rr)
        | _ ->
          match rr with
            | Node (Red) c zk zv d ->
              Node (Red) (Node (Black) left k v rl) rk rv (Node (Black) c zk zv d)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- balance: Okasaki RB-tree rebalancing (4 cases)
-- Only needs to act when color is Black
fn balance(c Color)(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) RBMap[K][V] =
  match c with
    | Red -> Node (Red) left k v right
    | Black ->
      match left with
        | Node (Red) _ _ _ _ ->
          let result = balanceLeft left k v right
          match result with
            | Node (Red) _ _ _ _ -> result
            | _ -> balanceRight left k v right
        | _ -> balanceRight left k v right

-- ins: recursive insert helper (preserves RB invariants via balance)
fn ins(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) RBMap[K][V] =
  match m with
    | Leaf -> Node (Red) Leaf k v Leaf
    | Node c left nk nv right ->
      let d = cmp k nk
      if d < 0
        balance c (ins cmp k v left) nk nv right
      else if d > 0
        balance c left nk nv (ins cmp k v right)
      else Node c left nk v right

-- mapInsert: insert k->v into map, replacing value if key exists
fn mapInsert(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) RBMap[K][V] =
  let t = ins cmp k v m
  match t with
    | Leaf -> Leaf
    | Node _ left nk nv right -> Node (Black) left nk nv right

-- mapLookup: lookup key k
fn mapLookup(cmp K -> K -> Int)(k K)(m RBMap[K][V]) Maybe[V] =
  match m with
    | Leaf -> None
    | Node _ left nk nv right ->
      let d = cmp k nk
      if d < 0
        mapLookup cmp k left
      else if d > 0
        mapLookup cmp k right
      else Some nv

-- mapContains: check if key k is in map
fn mapContains(cmp K -> K -> Int)(k K)(m RBMap[K][V]) Bool =
  match mapLookup cmp k m with
    | Some _ -> true
    | None -> false

-- mapFold: in-order fold over key-value pairs
fn mapFold(f B -> K -> V -> B)(acc B)(m RBMap[K][V]) B =
  match m with
    | Leaf -> acc
    | Node _ left k v right ->
      let acc1 = mapFold f acc left
      let acc2 = f acc1 k v
      mapFold f acc2 right

-- mapKeys: return list of keys in sorted (in-order) order
fn mapKeys(m RBMap[K][V]) List[K] =
  match m with
    | Leaf -> []
    | Node _ left k _ right ->
      let lkeys = mapKeys left
      let rkeys = mapKeys right
      listAppend lkeys (k :: rkeys)

-- Integer comparator
fn intCmp(a Int)(b Int) Int =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- String comparator
fn strCmp(a Str)(b Str) Int =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- Test helper: print OK or FAIL
fn check(label Str)(ok Bool) Int =
  if ok
    let _ = printfn (strConcat "OK " label)
    0
  else
    let _ = printfn (strConcat "FAIL " label)
    1

-- Main: exercise all API functions
fn main() Int =
  -- mapEmpty / mapSize
  let m0 = mapEmpty
  let _ = check "1 mapEmpty size=0" (mapSize m0 == 0)

  -- mapInsert + mapSize
  let m1 = mapInsert intCmp 3 "three" m0
  let m2 = mapInsert intCmp 1 "one" m1
  let m3 = mapInsert intCmp 5 "five" m2
  let m4 = mapInsert intCmp 2 "two" m3
  let m5 = mapInsert intCmp 4 "four" m4
  let _ = check "2 mapInsert size=5" (mapSize m5 == 5)

  -- mapLookup: found
  let r1 = mapLookup intCmp 3 m5
  let ok1 = match r1 with
    | Some v -> v == "three"
    | None -> false
 
  let _ = check "3 mapLookup found" ok1

  -- mapLookup: not found
  let r2 = mapLookup intCmp 99 m5
  let ok2 = match r2 with
    | Some _ -> false
    | None -> true
 
  let _ = check "4 mapLookup missing" ok2

  -- mapContains
  let _ = check "5 mapContains present" (mapContains intCmp 2 m5)
  let _ = check "6 mapContains absent" (mapContains intCmp 99 m5 == false)

  -- mapFold: sum all keys
  let keySum = mapFold (\acc k v. acc + k) 0 m5
  let _ = check "7 mapFold sum keys" (keySum == 15)

  -- mapKeys: in-order keys
  let keys = mapKeys m5
  let _ = check "8 mapKeys length" (listLen keys == 5)

  -- strCmp
  let ms = mapInsert strCmp "banana" 2 (mapInsert strCmp "apple" 1 (mapEmpty))
  let r3 = mapLookup strCmp "apple" ms
  let ok3 = match r3 with
    | Some n -> n == 1
    | None -> false
 
  let _ = check "9 strCmp lookup" ok3

  -- mapEmpty() usage
  let me = mapEmpty
  let _ = check "10 mapEmpty size=0" (mapSize me == 0)

  -- Duplicate key insert: size stays same, value updated
  let md1 = mapInsert intCmp 42 "first" (mapEmpty)
  let md2 = mapInsert intCmp 42 "second" md1
  let okDup = match mapLookup intCmp 42 md2 with
    | Some v -> v == "second"
    | None -> false
 
  let _ = check "11 duplicate key insert" (if mapSize md2 == 1
    okDup
  else false)

  -- Sorted order: insert [5,3,1,4,2], mapKeys returns [1,2,3,4,5]
  let ms1 = mapInsert intCmp 5 0 (mapEmpty)
  let ms2 = mapInsert intCmp 3 0 ms1
  let ms3 = mapInsert intCmp 1 0 ms2
  let ms4 = mapInsert intCmp 4 0 ms3
  let ms5 = mapInsert intCmp 2 0 ms4
  let skeys = mapKeys ms5
  let firstOk = match skeys with
    | h :: _ -> h == 1
    | [] -> false
 
  let lastKey = listAt skeys 4
  let lastOk = match lastKey with
    | Some v -> v == 5
    | None -> false
 
  let _ = check "12 sorted order" (if firstOk
    lastOk
  else false)

  0
