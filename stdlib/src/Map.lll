module Std.Map

import Std.Maybe

-- Map implemented as an Okasaki red-black tree.
-- Keys are compared via an explicit comparator: cmp a b
--   returns negative if a < b, zero if a == b, positive if a > b

export Color = Red | Black

-- RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)
export RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)

-- Empty map
export mapEmpty() = Leaf

-- Size of map
export mapSize(m RBMap[K][V]) =
  match m
    | Leaf -> 0
    | Node _ left _ _ right -> 1 + mapSize left + mapSize right

-- balance helpers: detect and fix each of the 4 red-violation cases.
-- Called only when the top node colour is Black.

-- Try to fix left-left violation: Black (Red (Red a x xv b) y yv c) z zv d
balanceLeft(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match left
    | Node (Red) ll lk lv lr ->
      match ll
        | Node (Red) a xk xv b ->
          Node (Red) (Node (Black) a xk xv b) lk lv (Node (Black) lr k v right)
        | _ ->
          match lr
            | Node (Red) b yk yv c ->
              Node (Red) (Node (Black) ll lk lv b) yk yv (Node (Black) c k v right)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- Try to fix right violations: Black a x xv (Red (Red b y yv c) z zv d)
--                          or: Black a x xv (Red b y yv (Red c z zv d))
balanceRight(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match right
    | Node (Red) rl rk rv rr ->
      match rl
        | Node (Red) b yk yv c ->
          Node (Red) (Node (Black) left k v b) yk yv (Node (Black) c rk rv rr)
        | _ ->
          match rr
            | Node (Red) c zk zv d ->
              Node (Red) (Node (Black) left k v rl) rk rv (Node (Black) c zk zv d)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- balance: Okasaki RB-tree rebalancing (4 cases)
-- Only needs to act when color is Black
balance(c Color)(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match c
    | Red -> Node (Red) left k v right
    | Black ->
      match left
        | Node (Red) _ _ _ _ ->
          result = balanceLeft left k v right
          match result
            | Node (Red) _ _ _ _ -> result
            | _ -> balanceRight left k v right
        | _ -> balanceRight left k v right

-- ins: recursive insert helper (preserves RB invariants via balance)
ins(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) =
  match m
    | Leaf -> Node (Red) Leaf k v Leaf
    | Node c left nk nv right ->
      d = cmp k nk
      if d < 0
        balance c (ins cmp k v left) nk nv right
      else if d > 0
        balance c left nk nv (ins cmp k v right)
      else Node c left nk v right

-- mapInsert: insert k->v into map, replacing value if key exists
export mapInsert(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) =
  t = ins cmp k v m
  match t
    | Leaf -> Leaf
    | Node _ left nk nv right -> Node (Black) left nk nv right

-- mapLookup: lookup key k
export mapLookup(cmp K -> K -> Int)(k K)(m RBMap[K][V]) =
  match m
    | Leaf -> None
    | Node _ left nk nv right ->
      d = cmp k nk
      if d < 0
        mapLookup cmp k left
      else if d > 0
        mapLookup cmp k right
      else Some nv

-- mapContains: check if key k is in map
export mapContains(cmp K -> K -> Int)(k K)(m RBMap[K][V]) =
  match mapLookup cmp k m
    | Some _ -> true
    | None -> false

-- mapFold: in-order fold over key-value pairs
export mapFold(f B -> K -> V -> B)(acc B)(m RBMap[K][V]) =
  match m
    | Leaf -> acc
    | Node _ left k v right ->
      acc1 = mapFold f acc left
      acc2 = f acc1 k v
      mapFold f acc2 right

-- mapKeys: return list of keys in sorted (in-order) order
export mapKeys(m RBMap[K][V]) =
  match m
    | Leaf -> []
    | Node _ left k _ right ->
      lkeys = mapKeys left
      rkeys = mapKeys right
      listAppend lkeys (k :: rkeys)

-- Integer comparator
export intCmp(a Int)(b Int) =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- String comparator
export strCmp(a Str)(b Str) =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- Test helper: print OK or FAIL
export mapCheck(label Str)(ok Bool) =
  if ok
    _ = printfn (strConcat "OK " label)
    0
  else
    _ = printfn (strConcat "FAIL " label)
    1

