module Std.Map

import Std.Maybe

-- Map implemented as an Okasaki red-black tree.
-- Keys are compared via an explicit comparator: cmp a b
--   returns negative if a < b, zero if a == b, positive if a > b

Color = Red | Black

-- RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)
RBMap K V = Leaf | Node Color (RBMap K V) K V (RBMap K V)

-- Empty map
mapEmpty() = Leaf

-- Size of map
mapSize(m RBMap[K][V]) =
  match m
    | Leaf -> 0
    | Node _ left _ _ right -> 1 + mapSize left + mapSize right

-- balance helpers: detect and fix each of the 4 red-violation cases.
-- Called only when the top node colour is Black.

-- Try to fix left-left violation: Black (Red (Red a x xv b) y yv c) z zv d
balanceLeft(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match left
    | Node (Red) ll lk lv lr ->
      match ll
        | Node (Red) a xk xv b ->
          Node (Red) (Node (Black) a xk xv b) lk lv (Node (Black) lr k v right)
        | _ ->
          match lr
            | Node (Red) b yk yv c ->
              Node (Red) (Node (Black) ll lk lv b) yk yv (Node (Black) c k v right)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- Try to fix right violations: Black a x xv (Red (Red b y yv c) z zv d)
--                          or: Black a x xv (Red b y yv (Red c z zv d))
balanceRight(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match right
    | Node (Red) rl rk rv rr ->
      match rl
        | Node (Red) b yk yv c ->
          Node (Red) (Node (Black) left k v b) yk yv (Node (Black) c rk rv rr)
        | _ ->
          match rr
            | Node (Red) c zk zv d ->
              Node (Red) (Node (Black) left k v rl) rk rv (Node (Black) c zk zv d)
            | _ -> Node (Black) left k v right
    | _ -> Node (Black) left k v right

-- balance: Okasaki RB-tree rebalancing (4 cases)
-- Only needs to act when color is Black
balance(c Color)(left RBMap[K][V])(k K)(v V)(right RBMap[K][V]) =
  match c
    | Red -> Node (Red) left k v right
    | Black ->
      match left
        | Node (Red) _ _ _ _ ->
          result = balanceLeft left k v right
          match result
            | Node (Red) _ _ _ _ -> result
            | _ -> balanceRight left k v right
        | _ -> balanceRight left k v right

-- ins: recursive insert helper (preserves RB invariants via balance)
ins(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) =
  match m
    | Leaf -> Node (Red) Leaf k v Leaf
    | Node c left nk nv right ->
      d = cmp k nk
      if d < 0
        balance c (ins cmp k v left) nk nv right
      else if d > 0
        balance c left nk nv (ins cmp k v right)
      else Node c left nk v right

-- mapInsert: insert k->v into map, replacing value if key exists
mapInsert(cmp K -> K -> Int)(k K)(v V)(m RBMap[K][V]) =
  t = ins cmp k v m
  match t
    | Leaf -> Leaf
    | Node _ left nk nv right -> Node (Black) left nk nv right

-- mapLookup: lookup key k
mapLookup(cmp K -> K -> Int)(k K)(m RBMap[K][V]) =
  match m
    | Leaf -> None
    | Node _ left nk nv right ->
      d = cmp k nk
      if d < 0
        mapLookup cmp k left
      else if d > 0
        mapLookup cmp k right
      else Some nv

-- mapContains: check if key k is in map
mapContains(cmp K -> K -> Int)(k K)(m RBMap[K][V]) =
  match mapLookup cmp k m
    | Some _ -> true
    | None -> false

-- mapFold: in-order fold over key-value pairs
mapFold(f B -> K -> V -> B)(acc B)(m RBMap[K][V]) =
  match m
    | Leaf -> acc
    | Node _ left k v right ->
      acc1 = mapFold f acc left
      acc2 = f acc1 k v
      mapFold f acc2 right

-- mapKeys: return list of keys in sorted (in-order) order
mapKeys(m RBMap[K][V]) =
  match m
    | Leaf -> []
    | Node _ left k _ right ->
      lkeys = mapKeys left
      rkeys = mapKeys right
      listAppend lkeys (k :: rkeys)

-- Integer comparator
intCmp(a Int)(b Int) =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- String comparator
strCmp(a Str)(b Str) =
  if a < b
    0 - 1
  else if a > b
    1
  else 0

-- Test helper: print OK or FAIL
mapCheck(label Str)(ok Bool) =
  if ok
    _ = printfn (strConcat "OK " label)
    0
  else
    _ = printfn (strConcat "FAIL " label)
    1

-- Main: exercise all API functions
main() =
  -- mapEmpty / mapSize
  m0 = mapEmpty
  _ = mapCheck "1 mapEmpty size=0" (mapSize m0 == 0)

  -- mapInsert + mapSize
  m1 = mapInsert intCmp 3 "three" m0
  m2 = mapInsert intCmp 1 "one" m1
  m3 = mapInsert intCmp 5 "five" m2
  m4 = mapInsert intCmp 2 "two" m3
  m5 = mapInsert intCmp 4 "four" m4
  _ = mapCheck "2 mapInsert size=5" (mapSize m5 == 5)

  -- mapLookup: found
  r1 = mapLookup intCmp 3 m5
  ok1 = match r1
    | Some v -> v == "three"
    | None -> false
 
  _ = mapCheck "3 mapLookup found" ok1

  -- mapLookup: not found
  r2 = mapLookup intCmp 99 m5
  ok2 = match r2
    | Some _ -> false
    | None -> true
 
  _ = mapCheck "4 mapLookup missing" ok2

  -- mapContains
  _ = mapCheck "5 mapContains present" (mapContains intCmp 2 m5)
  _ = mapCheck "6 mapContains absent" (mapContains intCmp 99 m5 == false)

  -- mapFold: sum all keys
  keySum = mapFold (\acc k v. acc + k) 0 m5
  _ = mapCheck "7 mapFold sum keys" (keySum == 15)

  -- mapKeys: in-order keys
  keys = mapKeys m5
  _ = mapCheck "8 mapKeys length" (listLen keys == 5)

  -- strCmp
  ms = mapInsert strCmp "banana" 2 (mapInsert strCmp "apple" 1 (mapEmpty))
  r3 = mapLookup strCmp "apple" ms
  ok3 = match r3
    | Some n -> n == 1
    | None -> false
 
  _ = mapCheck "9 strCmp lookup" ok3

  -- mapEmpty() usage
  me = mapEmpty
  _ = mapCheck "10 mapEmpty size=0" (mapSize me == 0)

  -- Duplicate key insert: size stays same, value updated
  md1 = mapInsert intCmp 42 "first" (mapEmpty)
  md2 = mapInsert intCmp 42 "second" md1
  okDup = match mapLookup intCmp 42 md2
    | Some v -> v == "second"
    | None -> false
 
  _ = mapCheck "11 duplicate key insert" (if mapSize md2 == 1
    okDup
  else false)

  -- Sorted order: insert [5,3,1,4,2], mapKeys returns [1,2,3,4,5]
  ms1 = mapInsert intCmp 5 0 (mapEmpty)
  ms2 = mapInsert intCmp 3 0 ms1
  ms3 = mapInsert intCmp 1 0 ms2
  ms4 = mapInsert intCmp 4 0 ms3
  ms5 = mapInsert intCmp 2 0 ms4
  skeys = mapKeys ms5
  firstOk = match skeys
    | h :: _ -> h == 1
    | [] -> false
 
  lastKey = listAt skeys 4
  lastOk = match lastKey
    | Some v -> v == 5
    | None -> false
 
  _ = mapCheck "12 sorted order" (if firstOk
    lastOk
  else false)

  0
