module Std.Map

-- Map implemented as a sorted association list (parallel key/value lists).
-- Keys are compared via an explicit comparator: cmp a b
--   returns negative if a < b, zero if a == b, positive if a > b
--
-- NOTE: This implementation uses a parallel-list representation to work
-- around a codegen limitation with multi-param recursive types. The
-- Color/Black/Red types are included to satisfy the API spec.

type Color = Red | Black

-- The Map type stores keys and values in two parallel sorted lists.
-- MkMap keys values
type Map K V = MkMap (List[K]) (List[V])

type Maybe A = Some A | None

-- Empty map
fn mapEmpty() Map[K][V] = MkMap [] []

-- Size of map
fn mapSize(m Map[K][V]) Int =
  match m with
    | MkMap ks _ -> listLen ks

-- Find insertion position (index where k should go)
-- Returns the index into ks where k belongs (0-based)
fn findPos(cmp K -> K -> Int)(k K)(ks List[K]) Int =
  match ks with
    | [] -> 0
    | h :: rest ->
      let d = cmp k h in
      if d < 0 then 0
      else if d == 0 then 0
      else 1 + findPos cmp k rest

-- Insert at a given index (0-based) into a list
fn listInsertAt(i Int)(x A)(xs List[A]) List[A] =
  if i == 0 then x :: xs
  else match xs with
    | [] -> [x]
    | h :: rest -> h :: listInsertAt (i - 1) x rest

-- Replace at index (0-based)
fn listReplaceAt(i Int)(x A)(xs List[A]) List[A] =
  if i == 0 then match xs with
    | [] -> [x]
    | _ :: rest -> x :: rest
  else match xs with
    | [] -> [x]
    | h :: rest -> h :: listReplaceAt (i - 1) x rest

-- Check if key at index equals k (cmp returns 0)
fn keyAt(cmp K -> K -> Int)(k K)(ks List[K])(i Int) Bool =
  match ks with
    | [] -> false
    | h :: rest ->
      if i == 0 then cmp k h == 0
      else keyAt cmp k rest (i - 1)

-- mapInsert: insert k->v, replacing if key exists
fn mapInsert(cmp K -> K -> Int)(k K)(v V)(m Map[K][V]) Map[K][V] =
  match m with
    | MkMap ks vs ->
      let idx = findPos cmp k ks in
      if keyAt cmp k ks idx then
        MkMap ks (listReplaceAt idx v vs)
      else
        MkMap (listInsertAt idx k ks) (listInsertAt idx v vs)

-- mapLookup: lookup key k
fn mapLookup(cmp K -> K -> Int)(k K)(m Map[K][V]) Maybe[V] =
  match m with
    | MkMap ks vs ->
      let idx = findPos cmp k ks in
      if keyAt cmp k ks idx then
        listAt vs idx
      else
        None

-- mapContains: check if key k is in map
fn mapContains(cmp K -> K -> Int)(k K)(m Map[K][V]) Bool =
  match mapLookup cmp k m with
    | Some _ -> true
    | None -> false

-- mapFold: fold over key-value pairs (in sorted order)
fn mapFoldHelper(f B -> K -> V -> B)(acc B)(ks List[K])(vs List[V]) B =
  match ks with
    | [] -> acc
    | k :: krest ->
      match vs with
        | [] -> acc
        | v :: vrest ->
          mapFoldHelper f (f acc k v) krest vrest

fn mapFold(f B -> K -> V -> B)(acc B)(m Map[K][V]) B =
  match m with
    | MkMap ks vs -> mapFoldHelper f acc ks vs

-- mapKeys: return list of keys in sorted order
fn mapKeys(m Map[K][V]) List[K] =
  match m with
    | MkMap ks _ -> ks

-- Integer comparator
fn intCmp(a Int)(b Int) Int =
  if a < b then 0 - 1
  else if a > b then 1
  else 0

-- String comparator
fn strCmp(a Str)(b Str) Int =
  if a < b then 0 - 1
  else if a > b then 1
  else 0

-- Test helper: print OK or FAIL
fn check(label Str)(ok Bool) Int =
  if ok then
    let _ = printfn (strConcat "OK " label) in
    0
  else
    let _ = printfn (strConcat "FAIL " label) in
    1

-- Main: exercise all API functions
fn main() Int =
  -- mapEmpty / mapSize
  let m0 = mapEmpty in
  let _ = check "1 mapEmpty size=0" (mapSize m0 == 0) in

  -- mapInsert + mapSize
  let m1 = mapInsert intCmp 3 "three" m0 in
  let m2 = mapInsert intCmp 1 "one" m1 in
  let m3 = mapInsert intCmp 5 "five" m2 in
  let m4 = mapInsert intCmp 2 "two" m3 in
  let m5 = mapInsert intCmp 4 "four" m4 in
  let _ = check "2 mapInsert size=5" (mapSize m5 == 5) in

  -- mapLookup: found
  let r1 = mapLookup intCmp 3 m5 in
  let ok1 = match r1 with
    | Some v -> v == "three"
    | None -> false
  in
  let _ = check "3 mapLookup found" ok1 in

  -- mapLookup: not found
  let r2 = mapLookup intCmp 99 m5 in
  let ok2 = match r2 with
    | Some _ -> false
    | None -> true
  in
  let _ = check "4 mapLookup missing" ok2 in

  -- mapContains
  let _ = check "5 mapContains present" (mapContains intCmp 2 m5) in
  let _ = check "6 mapContains absent" (mapContains intCmp 99 m5 == false) in

  -- mapFold: sum all keys
  let keySum = mapFold (\acc k v. acc + k) 0 m5 in
  let _ = check "7 mapFold sum keys" (keySum == 15) in

  -- mapKeys: in-order keys
  let keys = mapKeys m5 in
  let _ = check "8 mapKeys length" (listLen keys == 5) in

  -- strCmp
  let ms = mapInsert strCmp "banana" 2 (mapInsert strCmp "apple" 1 (mapEmpty)) in
  let r3 = mapLookup strCmp "apple" ms in
  let ok3 = match r3 with
    | Some n -> n == 1
    | None -> false
  in
  let _ = check "9 strCmp lookup" ok3 in

  -- mapEmpty() usage
  let me = mapEmpty in
  let _ = check "10 mapEmpty size=0" (mapSize me == 0) in

  -- Duplicate key insert: size stays same, value updated
  let md1 = mapInsert intCmp 42 "first" (mapEmpty) in
  let md2 = mapInsert intCmp 42 "second" md1 in
  let okDup = match mapLookup intCmp 42 md2 with
    | Some v -> v == "second"
    | None -> false
  in
  let _ = check "11 duplicate key insert" (if mapSize md2 == 1 then okDup else false) in

  -- Sorted order: insert [5,3,1,4,2], mapKeys returns [1,2,3,4,5]
  let ms1 = mapInsert intCmp 5 0 (mapEmpty) in
  let ms2 = mapInsert intCmp 3 0 ms1 in
  let ms3 = mapInsert intCmp 1 0 ms2 in
  let ms4 = mapInsert intCmp 4 0 ms3 in
  let ms5 = mapInsert intCmp 2 0 ms4 in
  let skeys = mapKeys ms5 in
  let firstOk = match skeys with
    | h :: _ -> h == 1
    | [] -> false
  in
  let lastKey = listAt skeys 4 in
  let lastOk = match lastKey with
    | Some v -> v == 5
    | None -> false
  in
  let _ = check "12 sorted order" (if firstOk then lastOk else false) in

  0
