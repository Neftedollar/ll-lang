module Std.CodegenPy

import Std.Parser

-- Python code emitter in ll-lang.

joinWith(sep Str)(items List[Str]) =
  match items
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

isPyKeyword(s Str) =
  match s
    | "False"    -> true
    | "None"     -> true
    | "True"     -> true
    | "and"      -> true
    | "as"       -> true
    | "assert"   -> true
    | "async"    -> true
    | "await"    -> true
    | "break"    -> true
    | "class"    -> true
    | "continue" -> true
    | "def"      -> true
    | "del"      -> true
    | "elif"     -> true
    | "else"     -> true
    | "except"   -> true
    | "finally"  -> true
    | "for"      -> true
    | "from"     -> true
    | "global"   -> true
    | "if"       -> true
    | "import"   -> true
    | "in"       -> true
    | "is"       -> true
    | "lambda"   -> true
    | "not"      -> true
    | "or"       -> true
    | "pass"     -> true
    | "raise"    -> true
    | "return"   -> true
    | "try"      -> true
    | "while"    -> true
    | "with"     -> true
    | "yield"    -> true
    | "print"    -> true
    | "type"     -> true
    | _          -> false

safeIdent(s Str) =
  if isPyKeyword s
    strConcat "_ll_" s
  else s

encodePyEscape(c Char) =
  match c
    | '\n' -> "\\n"
    | '\t' -> "\\t"
    | '\r' -> "\\r"
    | '\\' -> "\\\\"
    | '"'  -> "\\\""
    | _    -> strFromChars [c]

escapeStr(s Str) =
  listFold (\acc c. strConcat acc (encodePyEscape c)) "" (strChars s)

mapOp(op Str) =
  if op == "/"
    "//"
  else op

isFixedSymbolicOp(op Str) =
  if op == "|>"
    true
  else if op == ">>="
    true
  else if op == ">>"
    true
  else if op == "<|>"
    true
  else false

lowerFixedSymbolicOp(op Str)(l Expr)(r Expr) =
  if op == "|>"
    EApp r l
  else if op == ">>="
    EApp (EApp (EVar "llMaybeBind") l) r
  else if op == ">>"
    EApp (EApp (EVar "llMaybeThen") l) r
  else if op == "<|>"
    EApp (EApp (EVar "llMaybeChoice") l) r
  else
    EBinOp op l r

emitType(t TypeExpr) =
  match t
    | TyName "Int" -> "int"
    | TyName "Float" -> "float"
    | TyName "Str" -> "str"
    | TyName "Bool" -> "bool"
    | TyName "Char" -> "str"
    | TyName "Unit" -> "None"
    | TyName n -> safeIdent n
    | TyApp (TyName "List") a -> strConcat "list[" (strConcat (emitType a) "]")
    | TyApp (TyName "Maybe") a -> strConcat "Optional[" (strConcat (emitType a) "]")
    | TyApp f a -> strConcat (emitType f) (strConcat "[" (strConcat (emitType a) "]"))
    | TyFn a b -> strConcat "Callable[[" (strConcat (emitType a) (strConcat "], " (strConcat (emitType b) "]")))

emitPattern(p Pattern) =
  match p
    | PVar x -> safeIdent x
    | PWild -> "_"
    | PNil -> "[]"
    | PLitInt n -> intToStr n
    | PLitStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | PCons h t ->
      strConcat "[" (strConcat (emitPattern h) (strConcat ", *" (strConcat (emitPattern t) "]")))
    | PCon c args -> emitConPattern c args

emitConPattern(c Str)(args List[Pattern]) =
  match args
    | [] -> safeIdent c
    | _ ->
      inner = joinWith ", " (listMap emitPattern args)
      strConcat (safeIdent c) (strConcat "(" (strConcat inner ")"))

patListHead(xs List[Pattern]) =
  match xs
    | x :: _ -> x
    | _ -> PWild

emitCharLit(c Char) =
  if c == '\n'
    "\"\\n\""
  else if c == '\t'
    "\"\\t\""
  else if c == '\\'
    "\"\\\\\""
  else if c == '"'
    "\"\\\"\""
  else strConcat "\"" (strConcat (strFromChars [c]) "\"")

emitExpr(e Expr) =
  match e
    | EInt n -> intToStr n
    | EStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | EBool b ->
      if b
        "True"
      else "False"
    | EChar c -> emitCharLit c
    | EFloat s -> s
    | EVar x -> safeIdent x
    | ECon c -> safeIdent c
    | ENil -> "[]"
    | EApp f a -> emitApp f a
    | EIf c t el ->
      strConcat "(" (strConcat (emitExpr t) (strConcat " if " (strConcat (emitExpr c) (strConcat " else " (strConcat (emitExpr el) ")")))))
    | EMatch scrut pats bodies ->
      scrutStr = emitExpr scrut
      arms = emitMatchArms scrutStr pats bodies
      strConcat "(lambda _s: " (strConcat arms (strConcat ")(" (strConcat scrutStr ")")))
    | ELam x body ->
      strConcat "(lambda " (strConcat (safeIdent x) (strConcat ": " (strConcat (emitExpr body) ")")))
    | ELet x e body ->
      strConcat "(lambda " (strConcat (safeIdent x) (strConcat ": " (strConcat (emitExpr body) (strConcat ")(" (strConcat (emitExpr e) ")")))))
    | EList items ->
      strConcat "[" (strConcat (joinWith ", " (listMap emitExpr items)) "]")
    | EBinOp op l r ->
      if isFixedSymbolicOp op
        emitExpr (lowerFixedSymbolicOp op l r)
      else
        strConcat "(" (strConcat (emitExpr l) (strConcat " " (strConcat (mapOp op) (strConcat " " (strConcat (emitExpr r) ")")))))
    | ETuple a b ->
      strConcat "(" (strConcat (emitExpr a) (strConcat ", " (strConcat (emitExpr b) ")")))
    | ECons h t ->
      strConcat "[" (strConcat (emitExpr h) (strConcat "] + " (emitExpr t)))

gatherAppHead(e Expr) =
  match e
    | EApp f _ -> gatherAppHead f
    | _ -> e

gatherAppArgs(e Expr) =
  match e
    | EApp f a -> listAppend (gatherAppArgs f) [a]
    | _ -> []

isUpperStart(s Str) =
  match strChars s
    | c :: _ ->
      n = charToInt c
      if n >= 65
        if n <= 90
          true
        else false
      else false
    | _ -> false

emitApp(f Expr)(a Expr) =
  head = gatherAppHead (EApp f a)
  args = gatherAppArgs (EApp f a)
  match head
    | ECon c -> emitConApp c args
    | EVar x ->
      if isUpperStart x
        emitConApp x args
      else
        strConcat "(" (strConcat (emitExpr f) (strConcat ")(" (strConcat (emitExpr a) ")")))
    | _ ->
      strConcat "(" (strConcat (emitExpr f) (strConcat ")(" (strConcat (emitExpr a) ")")))

exprListHead(xs List[Expr]) =
  match xs
    | x :: _ -> x
    | _ -> ENil

emitConApp(c Str)(args List[Expr]) =
  match args
    | [] -> safeIdent c
    | _ ->
      inner = joinWith ", " (listMap emitExpr args)
      strConcat (safeIdent c) (strConcat "(" (strConcat inner ")"))

emitMatchCond(scrut Str)(p Pattern) =
  match p
    | PWild -> ""
    | PVar _ -> ""
    | PNil -> strConcat "len(" (strConcat scrut ") == 0")
    | PCons _ _ -> strConcat "len(" (strConcat scrut ") > 0")
    | PLitInt n -> strConcat scrut (strConcat " == " (intToStr n))
    | PLitStr s -> strConcat scrut (strConcat " == \"" (strConcat (escapeStr s) "\""))
    | PCon c _ -> strConcat scrut (strConcat "._tag == \"" (strConcat c "\""))

emitMatchBinds(scrut Str)(p Pattern)(body Expr) =
  match p
    | PVar x ->
      strConcat "(lambda " (strConcat (safeIdent x) (strConcat ": " (strConcat (emitExpr body) (strConcat ")(" (strConcat scrut ")")))))
    | PCons h t ->
      hStr = match h
        | PVar x -> safeIdent x
        | _ -> "_"
      tStr = match t
        | PVar x -> safeIdent x
        | _ -> "_"
      strConcat "(lambda " (strConcat hStr (strConcat ": (lambda " (strConcat tStr (strConcat ": " (strConcat (emitExpr body) (strConcat ")(" (strConcat scrut (strConcat "[1:])))(" (strConcat scrut "[0])")))))))))
    | PCon c args -> emitConBinds scrut c args body 0
    | _ -> emitExpr body

emitConBinds(scrut Str)(c Str)(args List[Pattern])(body Expr)(idx Int) =
  match args
    | [] -> emitExpr body
    | p :: rest ->
      inner = emitConBinds scrut c rest body (idx + 1)
      match p
        | PVar x ->
          field = strConcat scrut (strConcat "._" (intToStr idx))
          strConcat "(lambda " (strConcat (safeIdent x) (strConcat ": " (strConcat inner (strConcat ")(" (strConcat field ")")))))
        | _ -> inner

emitMatchArms(scrut Str)(pats List[Pattern])(bodies List[Expr]) =
  match pats
    | p :: prest ->
      match bodies
        | b :: brest ->
          cond = emitMatchCond "_s" p
          rest = emitMatchArms "_s" prest brest
          bindExpr = emitMatchBinds "_s" p b
          if strLen cond == 0
            bindExpr
          else if strLen rest == 0
            bindExpr
          else
            strConcat "(" (strConcat bindExpr (strConcat " if " (strConcat cond (strConcat " else " (strConcat rest ")")))))
        | _ -> "None"
    | _ -> "None"

emitCtorField(args List[TypeExpr])(idx Int) =
  match args
    | [] -> ""
    | t :: rest ->
      field = strConcat "    _" (strConcat (intToStr idx) (strConcat ": " (emitType t)))
      remaining = emitCtorField rest (idx + 1)
      if strLen remaining == 0
        field
      else strConcat field (strConcat "\n" remaining)

emitCtor(c Constructor) =
  match c
    | MkCon name args ->
      header = "@dataclass"
      safeName = safeIdent name
      classDef = strConcat (strConcat "class " safeName) (strConcat ":\n    _tag: str = field(init=False, default=\"" (strConcat name "\")"))
      fields = emitCtorField args 0
      if strLen fields == 0
        strConcat header (strConcat "\n" (strConcat classDef "\n    pass"))
      else
        strConcat header (strConcat "\n" (strConcat classDef (strConcat "\n" fields)))

emitCtors(cs List[Constructor]) =
  joinWith "\n\n" (listMap emitCtor cs)

emitUnionAlias(name Str)(cs List[Constructor]) =
  names = joinWith ", " (listMap (\c. match c | MkCon n _ -> safeIdent n) cs)
  strConcat (safeIdent name) (strConcat " = Union[" (strConcat names "]"))

emitParamStr(p Param) =
  match p
    | MkParam n t -> strConcat (safeIdent n) (strConcat ": " (emitType t))

emitParams(ps List[Param]) =
  joinWith ", " (listMap emitParamStr ps)

emitDecl(d Decl) =
  match d
    | DType name _ ctors ->
      ctorDecls = emitCtors ctors
      alias = emitUnionAlias name ctors
      strConcat ctorDecls (strConcat "\n\n" alias)
    | DFn name params _ body ->
      match params
        | [] ->
          strConcat (safeIdent name) (strConcat " = " (strConcat (emitExpr body) ""))
        | _ ->
          paramStr = emitParams params
          strConcat "def " (strConcat (safeIdent name) (strConcat "(" (strConcat paramStr (strConcat "):\n    return " (emitExpr body)))))
    | DLet name body ->
      strConcat (safeIdent name) (strConcat " = " (emitExpr body))
    | DImport parts ->
      strConcat "# import " (joinWith "." parts)
    | DExport inner -> emitDecl inner
    | DExternal name _ _ ->
      strConcat (safeIdent name) " = object  # external"
    | DOpaque name ->
      strConcat (safeIdent name) " = object"
    | DFixity _ _ _ ->
      ""

emitDecls(ds List[Decl]) =
  joinWith "\n\n" (listMap emitDecl ds)

emitPrelude =
  "# --- ll-lang Python runtime helpers ---\nfrom __future__ import annotations\nfrom dataclasses import dataclass, field\nfrom typing import Optional, Union, Callable, Any\nimport sys\ndef listLen(xs): return len(xs)\ndef listMap(f): return lambda xs: list(map(f, xs))\ndef listFilter(p): return lambda xs: list(filter(p, xs))\ndef listFold(f):\n    return lambda z: (lambda xs: _ll_listFold_impl(f, z, xs))\ndef _ll_listFold_impl(f, z, xs):\n    acc = z\n    for x in xs:\n        acc = f(acc)(x)\n    return acc\ndef listReverse(xs): return list(reversed(xs))\ndef listAppend(xs): return lambda ys: xs + ys\ndef listConcat(xss): return [x for xs in xss for x in xs]\ndef listIsEmpty(xs): return len(xs) == 0\ndef listHead(xs): return xs[0] if xs else None\ndef listTail(xs): return xs[1:] if xs else None\ndef strLen(s): return len(s)\ndef strConcat(a): return lambda b: a + b\ndef strChars(s): return list(s)\ndef strFromChars(cs): return ''.join(cs)\ndef strContains(needle): return lambda hay: needle in hay\ndef intToStr(n): return str(n)\ndef charToInt(c): return ord(c)\ndef charIsDigit(c): return c.isdigit()\ndef charIsAlpha(c): return c.isalpha()\ndef charIsSpace(c): return c.isspace()\ndef printfn(s): print(s)\ndef _ll_print(s): sys.stdout.write(s)\n# --- end prelude ---"

emitFixedOpPrelude =
  "def llMaybeBind(m):\n    return lambda f: (f(m._0) if hasattr(m, '_tag') and m._tag == 'Some' else m)\ndef llMaybeThen(m):\n    return lambda n: (n if hasattr(m, '_tag') and m._tag == 'Some' else m)\ndef llMaybeChoice(a):\n    return lambda b: (a if hasattr(a, '_tag') and a._tag == 'Some' else (b if hasattr(a, '_tag') and a._tag == 'None' else (a if a is not None else b)))"

emitModulePath(parts List[Str]) =
  joinWith "." parts

emitModule(m Module) =
  match m
    | MkModule path _fixities decls ->
      modName = emitModulePath path
      header = strConcat "# Generated by lllc (ll-lang Python backend)\n# Module: " modName
      prelude = strConcat emitPrelude (strConcat "\n" emitFixedOpPrelude)
      body = emitDecls decls
      strConcat header (strConcat "\n\n" (strConcat prelude (strConcat "\n\n" body)))

emitModulePy(m Module) =
  emitModule m

codegenPyCheck(label Str)(got Str)(expected Str) =
  if got == expected
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  got:      " (strConcat got (strConcat "\n  expected: " expected)))))

checkContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing: " (strConcat needle (strConcat "\n  in: " got)))))

checkNotContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  unexpected: " (strConcat needle (strConcat "\n  in: " got)))))
  else
    printfn (strConcat "OK " label)

main =
  -- 1. EInt
  _ = codegenPyCheck "1 EInt 42" (emitExpr (EInt 42)) "42"

  -- 2. EStr
  _ = codegenPyCheck "2 EStr hello" (emitExpr (EStr "hello")) "\"hello\""

  -- 3. EBool true
  _ = codegenPyCheck "3 EBool true" (emitExpr (EBool true)) "True"

  -- 4. EBool false
  _ = codegenPyCheck "4 EBool false" (emitExpr (EBool false)) "False"

  -- 5. EBinOp +
  _ = codegenPyCheck "5 EBinOp +" (emitExpr (EBinOp "+" (EInt 1) (EInt 2))) "(1 + 2)"

  -- 6. EIf ternary
  _ = codegenPyCheck "6 EIf" (emitExpr (EIf (EBool true) (EInt 1) (EInt 0))) "(1 if True else 0)"

  -- 7. ELet
  _ = codegenPyCheck "7 ELet" (emitExpr (ELet "x" (EInt 5) (EVar "x"))) "(lambda x: x)(5)"

  -- 8. ELam
  _ = codegenPyCheck "8 ELam" (emitExpr (ELam "x" (EVar "x"))) "(lambda x: x)"

  -- 9. EList
  twoItems = EInt 1 :: EInt 2 :: []
  _ = codegenPyCheck "9 EList" (emitExpr (EList twoItems)) "[1, 2]"

  -- 10. TyName Int
  _ = codegenPyCheck "10 TyName Int" (emitType (TyName "Int")) "int"

  -- 11. TyName Str
  _ = codegenPyCheck "11 TyName Str" (emitType (TyName "Str")) "str"

  -- 12. TyApp List Int
  _ = codegenPyCheck "12 TyApp List Int" (emitType (TyApp (TyName "List") (TyName "Int"))) "list[int]"

  -- 13. TyApp Maybe Bool
  _ = codegenPyCheck "13 TyApp Maybe Bool" (emitType (TyApp (TyName "Maybe") (TyName "Bool"))) "Optional[bool]"

  -- 14. TyFn Int Bool
  _ = codegenPyCheck "14 TyFn" (emitType (TyFn (TyName "Int") (TyName "Bool"))) "Callable[[int], bool]"

  -- 15. DType with dataclasses
  colorCtors = MkCon "Red" [] :: MkCon "Green" (TyName "Int" :: []) :: []
  colorOut = emitDecl (DType "Color" [] colorCtors)
  _ = checkContains "15 DType dataclass" colorOut "@dataclass"
  _ = checkContains "15 DType class Red" colorOut "class Red:"
  _ = checkContains "15 DType union alias" colorOut "Color = Union["

  -- 16. DFn add
  addParams = MkParam "a" (TyName "Int") :: MkParam "b" (TyName "Int") :: []
  addOut = emitDecl (DFn "add" addParams None (EBinOp "+" (EVar "a") (EVar "b")))
  _ = checkContains "16 DFn def" addOut "def add("
  _ = checkContains "16 DFn return" addOut "return"

  -- 17. safeIdent keyword
  _ = codegenPyCheck "17 safeIdent lambda" (safeIdent "lambda") "_ll_lambda"
  _ = codegenPyCheck "17 safeIdent foo" (safeIdent "foo") "foo"

  -- 18. EFloat
  _ = codegenPyCheck "18 EFloat" (emitExpr (EFloat "3.14")) "3.14"

  -- 19. ETuple
  _ = codegenPyCheck "19 ETuple" (emitExpr (ETuple (EVar "a") (EVar "b"))) "(a, b)"

  -- 20. Full module
  idParams = MkParam "x" (TyName "Int") :: []
  modDecls = DType "Color" [] (MkCon "Red" [] :: []) :: DFn "id" idParams None (EVar "x") :: []
  out = emitModule (MkModule ("Test" :: "Py" :: []) [] modDecls)
  _ = checkContains "20 module header" out "Module: Test.Py"
  _ = checkContains "20 module prelude" out "ll-lang Python runtime"
  _ = checkContains "20 module type" out "class Red:"
  _ = checkContains "20 module fn" out "def id("

  pipeOut = emitExpr (EBinOp "|>" (EInt 1) (EVar "inc"))
  _ = codegenPyCheck "21 |> lowers to app" pipeOut "(inc)(1)"
  bindOut = emitExpr (EBinOp ">>=" (EVar "m") (EVar "f"))
  _ = checkNotContains "22 >>= raw removed" bindOut ">>="
  _ = checkContains "22 >>= lowers to helper" bindOut "llMaybeBind"
  thenOut = emitExpr (EBinOp ">>" (EVar "m") (EVar "n"))
  _ = checkNotContains "23 >> raw removed" thenOut ">>"
  _ = checkContains "23 >> lowers to helper" thenOut "llMaybeThen"
  choiceOut = emitExpr (EBinOp "<|>" (EVar "a") (EVar "b"))
  _ = checkNotContains "24 <|> raw removed" choiceOut "<|>"
  _ = checkContains "24 <|> lowers to helper" choiceOut "llMaybeChoice"

  0
