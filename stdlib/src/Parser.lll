module Std.Parser

import Std.Lexer
import Std.Operators

-- Standalone recursive-descent parser for ll-lang.
-- Consumes a List[Token] produced by Std.Lexer and returns an AST.
--
-- Return convention: every parse function returns (result, remainingTokens).
-- Based on the bootstrap parser in spec/examples/valid/20-bootstrap-compiler.lll.

-- ---- AST types ---------------------------------------------------------

-- Patterns (defined before Expr to avoid mutual-recursion issues)
Pattern =
  | PVar Str
  | PWild
  | PCon Str (List[Pattern])
  | PLitInt Int
  | PLitStr Str
  | PCons Pattern Pattern
  | PNil

-- Expressions
Expr =
  | EInt Int
  | EStr Str
  | EBool Bool
  | EChar Char
  | EFloat Str
  | EVar Str
  | ECon Str
  | EApp Expr Expr
  | EIf Expr Expr Expr
  | EMatch Expr (List[Pattern]) (List[Expr])
  | ELam Str Expr
  | ELet Str Expr Expr
  | ELetTuple Str Str Expr Expr
  | EList (List[Expr])
  | EBinOp Str Expr Expr
  | ETuple Expr Expr
  | ENil
  | ECons Expr Expr

-- Type expressions
TypeExpr =
  | TyName Str
  | TyApp TypeExpr TypeExpr
  | TyFn TypeExpr TypeExpr

-- Declarations
Param = MkParam Str TypeExpr

Constructor = MkCon Str (List[TypeExpr])

FixityAssoc =
  | FixityNone
  | FixityLeft
  | FixityRight
  | FixityInvalid

FixityDecl = MkFixity FixityAssoc Int Str

Decl =
  | DFn Str (List[Param]) (Maybe[TypeExpr]) Expr
  | DType Str (List[Str]) (List[Constructor])
  | DImport (List[Str])
  | DImportUrl Str
  | DExport Decl
  | DLet Str Expr
  | DExternal Str (List[Param]) TypeExpr
  | DOpaque Str
  | DFixity FixityAssoc Int Str

-- Module
Module = MkModule (List[Str]) (List[FixityDecl]) (List[Decl])

-- ---- Token stream helpers ----------------------------------------------

skipNewlines(toks List[Token]) =
  match toks
    | Newline :: rest -> skipNewlines rest
    | Indent :: rest -> skipNewlines rest
    | Dedent :: rest -> skipNewlines rest
    | _ -> toks

-- ---- isAtomStart -------------------------------------------------------

isAtomStart(t Token) =
  match t
    | IntLit _ -> true
    | FloatLit _ -> true
    | StrLit _ -> true
    | CharLit _ -> true
    | KwTrue -> true
    | KwFalse -> true
    | Ident _ -> true
    | TypeId _ -> true
    | LParen -> true
    | LBrack -> true
    | _ -> false

-- ---- Type parsing ------------------------------------------------------

-- Skip bracket type args like [Int] in Maybe[Int]; we discard them.
skipBrackTypeArgs(toks List[Token]) =
  match toks
    | LBrack :: rest ->
      rest2 = skipBrackTypeBody rest
      skipBrackTypeArgs rest2
    | _ -> toks

skipBrackTypeBody(toks List[Token]) =
  match toks
    | RBrack :: rest -> rest
    | LBrack :: rest ->
      rest2 = skipBrackTypeBody rest
      skipBrackTypeBody rest2
    | _ :: rest -> skipBrackTypeBody rest
    | [] -> []

-- Parse a single type expression (name or name[arg]).
parseTypeExpr(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      rest2 = skipBrackTypeArgs rest
      (TyName name, rest2)
    | Ident name :: rest ->
      (TyName name, rest)
    | _ -> (TyName "?", toks)

-- Optional return type annotation before `=`.
parseReturnType(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      rest2 = skipBrackTypeArgs rest
      (Some (TyName name), rest2)
    | _ -> (None, toks)

-- ---- Param group parsing -----------------------------------------------

-- Parse zero or more (name Type) param groups.
parseParamGroups(toks List[Token]) =
  match toks
    | LParen :: RParen :: rest -> ([], rest)
    | LParen :: Ident pname :: TypeId tname :: rest ->
      rest2 = skipBrackTypeArgs rest
      rest3 = match rest2
        | RParen :: r -> r
        | _ -> rest2
      let (ps, rest4) = parseParamGroups rest3
      (MkParam pname (TyName tname) :: ps, rest4)
    | LParen :: Underscore :: Ident pname :: TypeId tname :: rest ->
      rest2 = skipBrackTypeArgs rest
      rest3 = match rest2
        | RParen :: r -> r
        | _ -> rest2
      let (ps, rest4) = parseParamGroups rest3
      (MkParam (strConcat "_" pname) (TyName tname) :: ps, rest4)
    | LParen :: Ident pname :: RParen :: rest ->
      let (ps, rest2) = parseParamGroups rest
      (MkParam pname (TyName "?") :: ps, rest2)
    | _ -> ([], toks)

-- ---- Type declaration parsing ------------------------------------------

parseTypeParams(toks List[Token]) =
  match toks
    | TypeId s :: rest ->
      if strLen s == 1
        let (ps, rest2) = parseTypeParams rest
        (s :: ps, rest2)
      else ([], toks)
    | _ -> ([], toks)

parseConArgs(toks List[Token]) =
  match toks
    | TypeId _ :: _ ->
      let (arg, rest) = parseTypeExpr toks
      let (args, rest2) = parseConArgs rest
      (arg :: args, rest2)
    | _ -> ([], toks)

parseCon(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      let (args, rest2) = parseConArgs rest
      (MkCon name args, rest2)
    | _ -> (MkCon "?" [], toks)

parseConsTail(acc List[Constructor])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: rest ->
      rest2 = skipNewlines rest
      let (c, rest3) = parseCon rest2
      parseConsTail (listAppend acc [c]) rest3
    | _ -> (acc, toks)

parseConList(toks List[Token]) =
  toks2 = skipNewlines toks
  toks3 = match toks2
    | Bar :: r -> skipNewlines r
    | _ -> toks2
  let (c, rest) = parseCon toks3
  parseConsTail [c] rest

parseTypeDecl(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      let (prms, rest2) = parseTypeParams rest
      rest3 = match (skipNewlines rest2)
        | Eq :: r -> skipNewlines r
        | _ -> skipNewlines rest2
      let (ctors, rest4) = parseConList rest3
      (DType name prms ctors, rest4)
    | _ -> (DType "?" [] [], toks)

-- ---- Pattern parsing ---------------------------------------------------

parsePrimaryPat(toks List[Token]) =
  match toks
    | IntLit n :: rest -> (PLitInt n, rest)
    | StrLit s :: rest -> (PLitStr s, rest)
    | Underscore :: rest -> (PWild, rest)
    | LBrack :: RBrack :: rest -> (PNil, rest)
    | Ident s :: rest -> (PVar s, rest)
    | TypeId name :: rest ->
      let (args, rest2) = parsePatArgs rest
      (PCon name args, rest2)
    | _ -> (PWild, toks)

parsePatArgs(toks List[Token]) =
  match toks
    | Ident _ :: _ -> parsePatArgsCons toks
    | Underscore :: _ -> parsePatArgsCons toks
    | IntLit _ :: _ -> parsePatArgsCons toks
    | LBrack :: RBrack :: _ -> parsePatArgsCons toks
    | _ -> ([], toks)

parsePatArgsCons(toks List[Token]) =
  let (p, rest) = parsePrimaryPat toks
  let (ps, rest2) = parsePatArgs rest
  (listAppend [p] ps, rest2)

parsePat(toks List[Token]) =
  let (p, rest) = parsePrimaryPat toks
  match rest
    | ColonColon :: rest2 ->
      let (tail, rest3) = parsePat rest2
      (PCons p tail, rest3)
    | _ -> (p, rest)

-- ---- Expression parsing ------------------------------------------------

-- Arm body stops before | (next arm) but allows if/let.
parseArmBodyWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | KwIf :: rest -> parseIfWithFixities fixities rest
    | KwLet :: rest -> parseLetInWithFixities fixities rest
    | Ident _ :: Eq :: _ -> parseLetInWithFixities fixities toks2
    | _ -> parseInfixExpr 0 fixities toks2

parseArmBody(toks List[Token]) =
  parseArmBodyWithFixities [] toks

skipArrow(toks List[Token]) =
  match toks
    | Arrow :: r -> r
    | _ -> toks

-- Returns ((pat, body), rest) for one arm
parseArmWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | Bar :: rest ->
      let (p, rest2) = parsePat rest
      rest3 = skipArrow rest2
      let (body, rest4) = parseArmBodyWithFixities fixities rest3
      ((p, body), rest4)
    | _ -> ((PWild, EInt 0), toks)

parseArm(toks List[Token]) =
  parseArmWithFixities [] toks

-- Returns ((pats, bodies), rest) — two parallel lists
parseArmsWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: _ ->
      let (pb, rest) = parseArmWithFixities fixities toks2
      let (p, b) = pb
      let (morePB, rest2) = parseArmsWithFixities fixities rest
      let (ps, bs) = morePB
      ((p :: ps, b :: bs), rest2)
    | _ -> (([], []), toks2)

parseArms(toks List[Token]) =
  parseArmsWithFixities [] toks

parseMatchWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  let (scrut, rest) = parseExprWithFixities fixities toks
  let (armLists, rest2) = parseArmsWithFixities fixities rest
  let (pats, bodies) = armLists
  (EMatch scrut pats bodies, rest2)

parseMatch(toks List[Token]) =
  parseMatchWithFixities [] toks

parseIfWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  let (cond, rest) = parseExprWithFixities fixities toks
  rest2 = skipNewlines rest
  let (thenE, rest3) = parseExprWithFixities fixities rest2
  rest3a = skipNewlines rest3
  rest4 = match rest3a
    | KwElse :: r -> skipNewlines r
    | _ -> rest3a
  let (elseE, rest5) = parseExprWithFixities fixities rest4
  (EIf cond thenE elseE, rest5)

parseIf(toks List[Token]) =
  parseIfWithFixities [] toks

skipKwIn(toks List[Token]) =
  skipNewlines toks

parseLetInWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | LParen :: Ident a :: Comma :: Ident b :: RParen :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (e1, rest2) = parseExprWithFixities fixities rest0
      rest3 = skipKwIn rest2
      let (e2, rest4) = parseExprWithFixities fixities rest3
      (ELetTuple a b e1 e2, rest4)
    | Ident name :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (e1, rest2) = parseExprWithFixities fixities rest0
      rest3 = skipKwIn rest2
      let (e2, rest4) = parseExprWithFixities fixities rest3
      (ELet name e1 e2, rest4)
    | _ -> (EInt 0, toks)

parseLetIn(toks List[Token]) =
  parseLetInWithFixities [] toks

parseLamParams(acc List[Str])(toks List[Token]) =
  match toks
    | Ident name :: rest -> parseLamParams (listAppend acc [name]) rest
    | _ -> (acc, toks)

wrapLamParams(parms List[Str])(body Expr) =
  match parms
    | p :: rest -> ELam p (wrapLamParams rest body)
    | _ -> body

parseLamWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  let (parms, rest) = parseLamParams [] toks
  match rest
    | Dot :: rest2 ->
      let (body, rest3) = parseExprWithFixities fixities rest2
      (wrapLamParams parms body, rest3)
    | _ -> (EInt 0, toks)

parseLam(toks List[Token]) =
  parseLamWithFixities [] toks

parserAssocFromSpec(a FixityAssocSpec) =
  match a
    | AssocNone -> FixityNone
    | AssocLeft -> FixityLeft
    | AssocRight -> FixityRight

parserFixityFromSpec(spec OpFixity) =
  match spec
    | MkOpFixity op assoc prec -> MkFixity (parserAssocFromSpec assoc) prec op

defaultExprFixities =
  listMap parserFixityFromSpec defaultOperatorFixities

exprOpFromToken(t Token) =
  match t
    | Plus -> Some "+"
    | Minus -> Some "-"
    | Star -> Some "*"
    | Slash -> Some "/"
    | Caret -> Some "^"
    | EqEq -> Some "=="
    | Neq -> Some "!="
    | Lt -> Some "<"
    | Gt -> Some ">"
    | Le -> Some "<="
    | Ge -> Some ">="
    | PipeForward -> Some "|>"
    | Bind -> Some ">>="
    | ThenThen -> Some ">>"
    | Choice -> Some "<|>"
    | ColonColon -> Some "::"
    | Arrow -> Some "->"
    | _ -> None

findFixityByOp(op Str)(fixities List[FixityDecl]) =
  match fixities
    | [] -> None
    | MkFixity assoc prec name :: rest ->
      if name == op
        Some (MkFixity assoc prec name)
      else
        findFixityByOp op rest

resolveExprFixity(op Str)(moduleFixities List[FixityDecl]) =
  match findFixityByOp op moduleFixities
    | Some fx -> Some fx
    | None -> findFixityByOp op defaultExprFixities

fixityAssoc(fx FixityDecl) =
  match fx
    | MkFixity assoc _ _ -> assoc

fixityPrec(fx FixityDecl) =
  match fx
    | MkFixity _ prec _ -> prec

infixExpr(op Str)(lhs Expr)(rhs Expr) =
  if op == "::"
    ECons lhs rhs
  else
    if op == "->"
      EBinOp "|>" lhs rhs
    else
      EBinOp op lhs rhs

nextMinPrecFor(fx FixityDecl) =
  assoc = fixityAssoc fx
  prec = fixityPrec fx
  if assoc == FixityRight
    prec
  else
    prec + 1

parseInfixTail(lhs Expr)(minPrec Int)(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | t :: rest ->
      match exprOpFromToken t
        | None -> (lhs, toks)
        | Some op ->
          match resolveExprFixity op fixities
            | None -> (lhs, toks)
            | Some fx ->
              prec = fixityPrec fx
              if prec < minPrec
                (lhs, toks)
              else
                nextMin = nextMinPrecFor fx
                let (rhs, rest2) = parseInfixExpr nextMin fixities rest
                node = infixExpr op lhs rhs
                parseInfixTail node minPrec fixities rest2
    | [] -> (lhs, [])

parseInfixExpr(minPrec Int)(fixities List[FixityDecl])(toks List[Token]) =
  let (lhs, rest) = parseAppWithFixities fixities toks
  parseInfixTail lhs minPrec fixities rest

parseExprWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | KwIf :: rest -> parseIfWithFixities fixities rest
    | KwMatch :: rest -> parseMatchWithFixities fixities rest
    | KwLet :: rest -> parseLetInWithFixities fixities rest
    | Ident _ :: Eq :: _ -> parseLetInWithFixities fixities toks
    | Backslash :: rest -> parseLamWithFixities fixities rest
    | _ -> parseInfixExpr 0 fixities toks

parseExpr(toks List[Token]) =
  parseExprWithFixities [] toks

-- Application layer: left-associative juxtaposition
parseAppWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  let (e, rest) = parseAtomWithFixities fixities toks
  parseAppTailWithFixities fixities e rest

parseApp(toks List[Token]) =
  parseAppWithFixities [] toks

parseAppTailWithFixities(fixities List[FixityDecl])(lhs Expr)(toks List[Token]) =
  match toks
    | t :: _ ->
      if isAtomStart t
        let (arg, rest) = parseAtomWithFixities fixities toks
        parseAppTailWithFixities fixities (EApp lhs arg) rest
      else (lhs, toks)
    | _ -> (lhs, toks)

parseAppTail(lhs Expr)(toks List[Token]) =
  parseAppTailWithFixities [] lhs toks

-- Parse a list literal body (after `[` consumed)
parseListLitWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | RBrack :: rest -> (ENil, rest)
    | _ ->
      let (e, rest) = parseListElemWithFixities fixities toks
      match rest
        | RBrack :: rest2 -> (ECons e ENil, rest2)
        | Comma :: rest2 ->
          let (tail, rest3) = parseListLitWithFixities fixities rest2
          (ECons e tail, rest3)
        | _ ->
          let (tail, rest2) = parseListLitWithFixities fixities rest
          (ECons e tail, rest2)

parseListLit(toks List[Token]) =
  parseListLitWithFixities [] toks

parseListElemWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | TypeId _ :: _ -> parseAppWithFixities fixities toks
    | _ -> parseAtomWithFixities fixities toks

parseListElem(toks List[Token]) =
  parseListElemWithFixities [] toks

parseAtomParenTailWithFixities(fixities List[FixityDecl])(e Expr)(toks List[Token]) =
  match toks
    | Comma :: rest ->
      rest2 = skipNewlines rest
      let (e2, rest3) = parseExprWithFixities fixities rest2
      match rest3
        | RParen :: rest4 -> (ETuple e e2, rest4)
        | _ -> (ETuple e e2, rest3)
    | RParen :: rest -> (e, rest)
    | _ -> (e, toks)

parseAtomParenTail(e Expr)(toks List[Token]) =
  parseAtomParenTailWithFixities [] e toks

-- Atomic expressions
parseAtomWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | IntLit n :: rest -> (EInt n, rest)
    | FloatLit s :: rest -> (EFloat s, rest)
    | StrLit s :: rest -> (EStr s, rest)
    | CharLit c :: rest -> (EChar c, rest)
    | KwTrue :: rest -> (EBool true, rest)
    | KwFalse :: rest -> (EBool false, rest)
    | Ident s :: rest -> (EVar s, rest)
    | TypeId s :: rest -> (ECon s, rest)
    | LBrack :: RBrack :: rest -> (ENil, rest)
    | LBrack :: rest -> parseListLitWithFixities fixities rest
    | LParen :: rest ->
      let (e, rest2) = parseExprWithFixities fixities rest
      parseAtomParenTailWithFixities fixities e rest2
    | _ -> (EInt 0, toks)

parseAtom(toks List[Token]) =
  parseAtomWithFixities [] toks

-- ---- Function declaration parsing --------------------------------------

lastParamVar(prms List[Param]) =
  match prms
    | [] -> EInt 0
    | MkParam n _ :: [] -> EVar n
    | _ :: rest -> lastParamVar rest

parseFnBodyWithFixities(fixities List[FixityDecl])(prms List[Param])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: _ ->
      let (armLists, rest) = parseArmsWithFixities fixities toks2
      let (pats, bodies) = armLists
      scrut = lastParamVar prms
      (EMatch scrut pats bodies, rest)
    | _ -> parseExprWithFixities fixities toks2

parseFnBody(prms List[Param])(toks List[Token]) =
  parseFnBodyWithFixities [] prms toks

parseFnDeclWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | Ident name :: rest ->
      let (prms, rest2) = parseParamGroups rest
      let (retTy, rest3) = parseReturnType rest2
      rest4 = match (skipNewlines rest3)
        | Eq :: r -> skipNewlines r
        | _ -> skipNewlines rest3
      let (body, rest5) = parseFnBodyWithFixities fixities prms rest4
      (DFn name prms retTy body, rest5)
    | _ -> (DFn "?" [] None (EInt 0), toks)

parseFnDecl(toks List[Token]) =
  parseFnDeclWithFixities [] toks

-- ---- Module-level let binding (no `in`, top-level) --------------------

parseLetDeclWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | KwLet :: Ident name :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (body, rest2) = parseExprWithFixities fixities rest0
      (DLet name body, rest2)
    | _ -> (DLet "?" (EInt 0), toks)

parseLetDecl(toks List[Token]) =
  parseLetDeclWithFixities [] toks

-- ---- Import declaration ------------------------------------------------

parseImportPath(acc List[Str])(toks List[Token]) =
  match toks
    | Dot :: TypeId seg :: rest ->
      parseImportPath (listAppend acc [seg]) rest
    | _ -> (acc, toks)

parseImportDecl(toks List[Token]) =
  match toks
    | KwImport :: TypeId head :: rest ->
      let (segs, rest2) = parseImportPath [head] rest
      (DImport segs, rest2)
    | KwImport :: StrLit url :: rest ->
      (DImportUrl url, rest)
    | _ -> (DImport [], toks)

-- ---- External declaration parsing ------------------------------------
-- Syntax: external name(p T) RetType

parseExternalDecl(toks List[Token]) =
  match toks
    | KwExternal :: Ident name :: rest ->
      let (prms, rest2) = parseParamGroups rest
      let (retTy, rest3) = parseReturnType rest2
      retFinal = match retTy
        | Some ty -> ty
        | None -> TyName "?"
      (DExternal name prms retFinal, rest3)
    | _ -> (DExternal "?" [] (TyName "?"), toks)

-- ---- Opaque declaration parsing ----------------------------------------
-- Syntax: opaque TypeName

parseOpaqueDecl(toks List[Token]) =
  match toks
    | KwOpaque :: TypeId name :: rest -> (DOpaque name, rest)
    | _ -> (DOpaque "?", toks)

-- ---- Fixity declaration parsing ---------------------------------------
-- Syntax:
--   infixl <precedence-int> <operator>
--   infixr <precedence-int> <operator>
--   infix  <precedence-int> <operator>

tokenToFixityOp(t Token) =
  match t
    | Plus -> Some "+"
    | Minus -> Some "-"
    | Star -> Some "*"
    | Slash -> Some "/"
    | Caret -> Some "^"
    | EqEq -> Some "=="
    | Neq -> Some "!="
    | Lt -> Some "<"
    | Gt -> Some ">"
    | Le -> Some "<="
    | Ge -> Some ">="
    | PipeForward -> Some "|>"
    | Bind -> Some ">>="
    | ThenThen -> Some ">>"
    | Choice -> Some "<|>"
    | ColonColon -> Some "::"
    | Arrow -> Some "->"
    | Eq -> Some "="
    | Bar -> Some "|"
    | Colon -> Some ":"
    | Dot -> Some "."
    | _ -> None

parseFixityOp(toks List[Token]) =
  match toks
    | [] -> ("?", [])
    | t :: rest ->
      match tokenToFixityOp t
        | Some op -> (op, rest)
        | None -> ("?", rest)

parseFixityDecl(toks List[Token]) =
  match toks
    | KwInfixL :: IntLit prec :: rest ->
      let (op, rest2) = parseFixityOp rest
      (DFixity FixityLeft prec op, rest2)
    | KwInfixR :: IntLit prec :: rest ->
      let (op, rest2) = parseFixityOp rest
      (DFixity FixityRight prec op, rest2)
    | KwInfix :: IntLit prec :: rest ->
      let (op, rest2) = parseFixityOp rest
      (DFixity FixityNone prec op, rest2)
    -- Malformed declaration: still consume one token and defer a precise
    -- diagnostic to elaboration.
    | KwInfixL :: rest -> (DFixity FixityInvalid 99 "?", rest)
    | KwInfixR :: rest -> (DFixity FixityInvalid 99 "?", rest)
    | KwInfix :: rest -> (DFixity FixityInvalid 99 "?", rest)
    | _ -> (DFixity FixityInvalid 99 "?", toks)

-- ---- Top-level declaration dispatch ------------------------------------

parseOneDeclWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  match toks
    | TypeId _ :: _ -> parseTypeDecl toks
    | KwLet :: _ -> parseLetDeclWithFixities fixities toks
    | Ident _ :: _ -> parseFnDeclWithFixities fixities toks
    | KwImport :: _ -> parseImportDecl toks
    | KwExternal :: _ -> parseExternalDecl toks
    | KwOpaque :: _ -> parseOpaqueDecl toks
    | KwInfixL :: _ -> parseFixityDecl toks
    | KwInfixR :: _ -> parseFixityDecl toks
    | KwInfix :: _ -> parseFixityDecl toks
    | KwExport :: rest ->
      let (inner, rest2) = parseOneDeclWithFixities fixities rest
      (DExport inner, rest2)
    | _ -> (DLet "?" (EInt 0), toks)

parseOneDecl(toks List[Token]) =
  parseOneDeclWithFixities [] toks

parseDeclsWithFixities(fixities List[FixityDecl])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Eof :: _ -> []
    | [] -> []
    | TypeId _ :: _ ->
      let (d, rest) = parseTypeDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwLet :: _ ->
      let (d, rest) = parseLetDeclWithFixities fixities toks2
      d :: parseDeclsWithFixities fixities rest
    | Ident _ :: _ ->
      let (d, rest) = parseFnDeclWithFixities fixities toks2
      d :: parseDeclsWithFixities fixities rest
    | KwImport :: _ ->
      let (d, rest) = parseImportDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwExternal :: _ ->
      let (d, rest) = parseExternalDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwOpaque :: _ ->
      let (d, rest) = parseOpaqueDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwInfixL :: _ ->
      let (d, rest) = parseFixityDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwInfixR :: _ ->
      let (d, rest) = parseFixityDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwInfix :: _ ->
      let (d, rest) = parseFixityDecl toks2
      d :: parseDeclsWithFixities fixities rest
    | KwExport :: rest ->
      let (inner, rest2) = parseOneDeclWithFixities fixities rest
      DExport inner :: parseDeclsWithFixities fixities rest2
    | _ -> []

parseDecls(toks List[Token]) =
  parseDeclsWithFixities [] toks

-- ---- Module header parsing ---------------------------------------------

parseModulePath(acc List[Str])(toks List[Token]) =
  match toks
    | Dot :: TypeId seg :: rest ->
      parseModulePath (listAppend acc [seg]) rest
    | _ -> (acc, toks)

parseModuleHeader(toks List[Token]) =
  match toks
    | KwModule :: TypeId head :: rest ->
      let (segs, rest2) = parseModulePath [head] rest
      (segs, rest2)
    | _ -> ([], toks)

fixityFromDecl(d Decl) =
  match d
    | DFixity assoc prec op -> Some (MkFixity assoc prec op)
    | DExport inner -> fixityFromDecl inner
    | _ -> None

collectFixities(decls List[Decl]) =
  match decls
    | [] -> []
    | d :: rest ->
      tail = collectFixities rest
      match fixityFromDecl d
        | Some fx -> fx :: tail
        | None -> tail

dropFixityDecls(decls List[Decl]) =
  match decls
    | [] -> []
    | d :: rest ->
      tail = dropFixityDecls rest
      match d
        | DFixity _ _ _ -> tail
        | DExport inner ->
          match fixityFromDecl inner
            | Some _ -> tail
            | None -> DExport inner :: tail
        | _ -> d :: tail

-- Main entry: parse a full module from a token list.
parseModule(toks List[Token]) =
  toks2 = skipNewlines toks
  let (path, rest) = parseModuleHeader toks2
  rawDecls = parseDecls (skipNewlines rest)
  fixities = collectFixities rawDecls
  typedDecls = parseDeclsWithFixities fixities (skipNewlines rest)
  decls = dropFixityDecls typedDecls
  MkModule path fixities decls

-- ---- Show helpers (for tests) ------------------------------------------

boolToStr(b Bool) =
  if b
    "true"
  else "false"

showExpr(e Expr) =
  match e
    | EInt n -> strConcat "EInt " (intToStr n)
    | EStr s -> strConcat "EStr " s
    | EBool b -> strConcat "EBool " (boolToStr b)
    | EChar c -> strConcat "EChar " (strFromChars [c])
    | EFloat s -> strConcat "EFloat " s
    | EVar s -> strConcat "EVar " s
    | ECon s -> strConcat "ECon " s
    | ENil -> "ENil"
    | ECons h t ->
      strConcat (strConcat "ECons(" (showExpr h)) (strConcat " " (strConcat (showExpr t) ")"))
    | EApp f x ->
      strConcat (strConcat "EApp(" (showExpr f)) (strConcat " " (strConcat (showExpr x) ")"))
    | EIf c a b ->
      strConcat "EIf(" (strConcat (showExpr c) (strConcat " " (strConcat (showExpr a) (strConcat " " (strConcat (showExpr b) ")")))))
    | EBinOp op l r ->
      strConcat "EBinOp(" (strConcat op (strConcat " " (strConcat (showExpr l) (strConcat " " (strConcat (showExpr r) ")")))))
    | ETuple a b ->
      strConcat "ETuple(" (strConcat (showExpr a) (strConcat " " (strConcat (showExpr b) ")")))
    | ELet n e1 e2 ->
      strConcat "ELet " (strConcat n (strConcat "=(" (strConcat (showExpr e1) (strConcat ") in (" (strConcat (showExpr e2) ")")))))
    | ELam n b ->
      strConcat "ELam " (strConcat n (strConcat "." (showExpr b)))
    | EMatch s pats bodies ->
      strConcat "EMatch(" (strConcat (showExpr s) "...)")
    | EList es -> "EList(...)"

showPattern(p Pattern) =
  match p
    | PVar s -> strConcat "PVar " s
    | PWild -> "PWild"
    | PCon name args -> strConcat "PCon " name
    | PLitInt n -> strConcat "PLitInt " (intToStr n)
    | PLitStr s -> strConcat "PLitStr " s
    | PCons h t -> strConcat "PCons(" (strConcat (showPattern h) (strConcat " " (strConcat (showPattern t) ")")))
    | PNil -> "PNil"

showMaybeTy(m Maybe[TypeExpr]) =
  match m
    | Some _ -> "Some"
    | None -> "None"

joinDot(segs List[Str]) =
  listFold (\acc s.
    if strLen acc == 0
      s
    else strConcat (strConcat acc ".") s
  ) "" segs

showDecl(d Decl) =
  match d
    | DFn name prms retTy body ->
      strConcat "DFn " (strConcat name (strConcat " body=(" (strConcat (showExpr body) ")")))
    | DType name prms ctors ->
      strConcat "DType " name
    | DImport segs ->
      path = joinDot segs
      strConcat "DImport " path
    | DImportUrl url ->
      strConcat "DImportUrl " url
    | DExport inner ->
      strConcat "DExport(" (strConcat (showDecl inner) ")")
    | DLet name body ->
      strConcat "DLet " (strConcat name (strConcat "=(" (strConcat (showExpr body) ")")))
    | DExternal name _prms _retTy ->
      strConcat "DExternal " name
    | DOpaque name ->
      strConcat "DOpaque " name
    | DFixity assoc prec op ->
      assocS = match assoc
        | FixityLeft -> "left"
        | FixityRight -> "right"
        | FixityNone -> "none"
        | FixityInvalid -> "invalid"
      p1 = strConcat "DFixity " assocS
      p2 = strConcat p1 " "
      p3 = strConcat p2 (intToStr prec)
      strConcat (strConcat p3 " ") op

-- ---- Test helpers ------------------------------------------------------

parserCheckExpr(label Str)(toks List[Token])(expected Str) =
  let (e, _rest) = parseExpr (skipNewlines toks)
  got = showExpr e
  if got == expected
    printfn (strConcat "OK " label)
  else
    p1 = strConcat "FAIL " label
    p2 = strConcat p1 "\n  expected: "
    p3 = strConcat p2 expected
    p4 = strConcat p3 "\n  got:      "
    p5 = strConcat p4 got
    printfn p5

parserCheckDecl(label Str)(toks List[Token])(expected Str) =
  let (d, _rest) = parseOneDecl (skipNewlines toks)
  got = showDecl d
  if got == expected
    printfn (strConcat "OK " label)
  else
    p1 = strConcat "FAIL " label
    p2 = strConcat p1 "\n  expected: "
    p3 = strConcat p2 expected
    p4 = strConcat p3 "\n  got:      "
    p5 = strConcat p4 got
    printfn p5

parserCheckModule(label Str)(toks List[Token])(expectedDeclCount Int) =
  m = parseModule toks
  match m
    | MkModule path _fixities decls ->
      n = listLen decls
      if n == expectedDeclCount
        printfn (strConcat "OK " label)
      else
        p1 = strConcat "FAIL " label
        p2 = strConcat p1 " expected "
        p3 = strConcat p2 (intToStr expectedDeclCount)
        p4 = strConcat p3 " decls, got "
        p5 = strConcat p4 (intToStr n)
        printfn p5

parserCheckModuleFixities(label Str)(toks List[Token])(expectedFixityCount Int) =
  m = parseModule toks
  match m
    | MkModule _ fixities _ ->
      n = listLen fixities
      if n == expectedFixityCount
        printfn (strConcat "OK " label)
      else
        p1 = strConcat "FAIL " label
        p2 = strConcat p1 " expected "
        p3 = strConcat p2 (intToStr expectedFixityCount)
        p4 = strConcat p3 " fixities, got "
        p5 = strConcat p4 (intToStr n)
        printfn p5

findFnBodyByName(name Str)(decls List[Decl]) =
  match decls
    | [] -> None
    | d :: rest ->
      match d
        | DFn n _ _ body ->
          if n == name
            Some body
          else
            findFnBodyByName name rest
        | DExport inner ->
          match inner
            | DFn n _ _ body ->
              if n == name
                Some body
              else
                findFnBodyByName name rest
            | _ -> findFnBodyByName name rest
        | _ -> findFnBodyByName name rest

parserCheckModuleFnBody(label Str)(toks List[Token])(fnName Str)(expected Str) =
  m = parseModule toks
  match m
    | MkModule _ _ decls ->
      match findFnBodyByName fnName decls
        | Some body ->
          got = showExpr body
          if got == expected
            printfn (strConcat "OK " label)
          else
            p1 = strConcat "FAIL " label
            p2 = strConcat p1 "\n  expected: "
            p3 = strConcat p2 expected
            p4 = strConcat p3 "\n  got:      "
            p5 = strConcat p4 got
            printfn p5
        | None ->
          p1 = strConcat "FAIL " label
          p2 = strConcat p1 " missing fn body for "
          printfn (strConcat p2 fnName)

-- ---- Tests -------------------------------------------------------------
-- Token lists are built with :: cons (no comma list syntax in ll-lang).

main =
  -- 1. external decl: external httpGet(url Str) Str
  _ = parserCheckDecl "1 external fn" (KwExternal :: Ident "httpGet" :: LParen :: Ident "url" :: TypeId "Str" :: RParen :: TypeId "Str" :: Eof :: []) "DExternal httpGet"
  -- 2. external decl: external ping() Bool
  _ = parserCheckDecl "2 external no args" (KwExternal :: Ident "ping" :: LParen :: RParen :: TypeId "Bool" :: Eof :: []) "DExternal ping"
  -- 3. opaque decl: opaque HttpClient
  _ = parserCheckDecl "3 opaque" (KwOpaque :: TypeId "HttpClient" :: Eof :: []) "DOpaque HttpClient"
  -- 4. opaque decl: opaque Promise
  _ = parserCheckDecl "4 opaque2" (KwOpaque :: TypeId "Promise" :: Eof :: []) "DOpaque Promise"
  -- 5. module with external + opaque: 2 decls
  toks5 = KwModule :: TypeId "M" :: Newline :: KwExternal :: Ident "connect" :: LParen :: Ident "url" :: TypeId "Str" :: RParen :: TypeId "Bool" :: Newline :: KwOpaque :: TypeId "Conn" :: Eof :: []
  _ = parserCheckModule "5 module 2 decls" toks5 2
  -- 5b. fixity declaration
  _ = parserCheckDecl "5b fixity infixl" (KwInfixL :: IntLit 6 :: Plus :: Eof :: []) "DFixity left 6 +"
  _ = parserCheckDecl "5c fixity infixr" (KwInfixR :: IntLit 5 :: ColonColon :: Eof :: []) "DFixity right 5 ::"
  _ = parserCheckDecl "5d fixity infix" (KwInfix :: IntLit 4 :: EqEq :: Eof :: []) "DFixity none 4 =="
  _ = parserCheckDecl "5e malformed fixity" (KwInfixL :: Plus :: Eof :: []) "DFixity invalid 99 ?"
  toks5f = KwModule :: TypeId "M" :: Newline :: KwInfixL :: IntLit 6 :: Plus :: Newline :: Ident "add" :: LParen :: Ident "a" :: TypeId "Int" :: RParen :: LParen :: Ident "b" :: TypeId "Int" :: RParen :: Eq :: Ident "a" :: Plus :: Ident "b" :: Eof :: []
  _ = parserCheckModuleFixities "5f module fixity metadata" toks5f 1
  toks5g = KwModule :: TypeId "M" :: Newline :: KwInfixL :: IntLit 7 :: Plus :: Newline :: KwInfixL :: IntLit 6 :: Star :: Newline :: Ident "calc" :: LParen :: Ident "a" :: TypeId "Int" :: RParen :: LParen :: Ident "b" :: TypeId "Int" :: RParen :: LParen :: Ident "c" :: TypeId "Int" :: RParen :: Eq :: Ident "a" :: Plus :: Ident "b" :: Star :: Ident "c" :: Eof :: []
  _ = parserCheckModuleFnBody "5g module fixity changes expression parse" toks5g "calc" "EBinOp(* EBinOp(+ EVar a EVar b) EVar c)"

  -- 6. Int literal: 42
  _ = parserCheckExpr "6 EInt" (IntLit 42 :: Eof :: []) "EInt 42"
  -- 7. Str literal: "hi"
  _ = parserCheckExpr "7 EStr" (StrLit "hi" :: Eof :: []) "EStr hi"
  -- 8. Bool true
  _ = parserCheckExpr "8 EBool true" (KwTrue :: Eof :: []) "EBool true"
  -- 9. Bool false
  _ = parserCheckExpr "9 EBool false" (KwFalse :: Eof :: []) "EBool false"
  -- 10. Variable
  _ = parserCheckExpr "10 EVar" (Ident "x" :: Eof :: []) "EVar x"
  -- 11. Constructor
  _ = parserCheckExpr "11 ECon" (TypeId "None" :: Eof :: []) "ECon None"
  -- 12. Empty list ENil
  _ = parserCheckExpr "12 ENil" (LBrack :: RBrack :: Eof :: []) "ENil"
  -- 13. Lambda: \x. x
  _ = parserCheckExpr "13 ELam" (Backslash :: Ident "x" :: Dot :: Ident "x" :: Eof :: []) "ELam x.EVar x"
  -- 14. Binary op: 1 + 2
  _ = parserCheckExpr "14 EBinOp" (IntLit 1 :: Plus :: IntLit 2 :: Eof :: []) "EBinOp(+ EInt 1 EInt 2)"
  -- 15. Application: f x
  _ = parserCheckExpr "15 EApp" (Ident "f" :: Ident "x" :: Eof :: []) "EApp(EVar f EVar x)"
  -- 16. import decl
  _ = parserCheckDecl "16 DImport" (KwImport :: TypeId "Std" :: Dot :: TypeId "Map" :: Eof :: []) "DImport Std.Map"
  -- 17. top-level value binding: x = 42 → parsed as zero-arg DFn
  _ = parserCheckDecl "17 value binding" (Ident "x" :: Eq :: IntLit 42 :: Eof :: []) "DFn x body=(EInt 42)"
  -- 18. function decl: add(a Int)(b Int) = a + b
  toks18 = Ident "add" :: LParen :: Ident "a" :: TypeId "Int" :: RParen :: LParen :: Ident "b" :: TypeId "Int" :: RParen :: Eq :: Ident "a" :: Plus :: Ident "b" :: Eof :: []
  _ = parserCheckDecl "18 DFn" toks18 "DFn add body=(EBinOp(+ EVar a EVar b))"
  -- 19. Pipe: 1 |> inc
  _ = parserCheckExpr "19 pipe forward" (IntLit 1 :: PipeForward :: Ident "inc" :: Eof :: []) "EBinOp(|> EInt 1 EVar inc)"
  -- 20. Pipe alias: 1 -> inc
  _ = parserCheckExpr "20 pipe arrow" (IntLit 1 :: Arrow :: Ident "inc" :: Eof :: []) "EBinOp(|> EInt 1 EVar inc)"
  -- 21. Bind: m >>= f
  _ = parserCheckExpr "21 bind" (Ident "m" :: Bind :: Ident "f" :: Eof :: []) "EBinOp(>>= EVar m EVar f)"
  -- 22. Sequence: a >> b
  _ = parserCheckExpr "22 then then" (Ident "a" :: ThenThen :: Ident "b" :: Eof :: []) "EBinOp(>> EVar a EVar b)"
  -- 23. Choice: a <|> b
  _ = parserCheckExpr "23 choice" (Ident "a" :: Choice :: Ident "b" :: Eof :: []) "EBinOp(<|> EVar a EVar b)"
  -- 24. Mixed precedence: 1 |> inc >>= f <|> alt
  toks24 = IntLit 1 :: PipeForward :: Ident "inc" :: Bind :: Ident "f" :: Choice :: Ident "alt" :: Eof :: []
  _ = parserCheckExpr "24 mixed precedence" toks24 "EBinOp(<|> EBinOp(>>= EBinOp(|> EInt 1 EVar inc) EVar f) EVar alt)"

  printfn "Done"
