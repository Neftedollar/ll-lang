module Std.Toml

import Std.Maybe

-- Minimal TOML parser for ll.toml project manifests.
-- Rewrites Manifest.fs (F#) in ll-lang — pure functional, no mutable state.
--
-- Parses: [table] headers, key = "value", key = ["a", "b"]
-- Ignores: unknown keys/tables (forward compatibility)

-- Manifest: name, version, entry, deps (list of key-value pairs), platform
Manifest = MkManifest Str Str Str (List[Str]) (List[Str])
-- deps stored as flat list: [key1, val1, key2, val2, ...]
-- (avoiding Map dependency for standalone compilation)

-- Parser state threaded through line processing
Section = SecProject | SecDeps | SecPlatform | SecOther
ParseState = MkState Section (Maybe[Str]) Str Str (List[Str]) (List[Str]) (Maybe[Str])
-- MkState section name version entry deps platform error

-- ---- String helpers ----

strStartsWith(prefix Str)(s Str) =
  if strLen prefix > strLen s
    false
  else strSlice s 0 (strLen prefix) == prefix

strDropPrefix(n Int)(s Str) =
  if n >= strLen s
    ""
  else strSlice s n (strLen s - n)

strTakeUntil(ch Str)(s Str) =
  idx = strIndexOf ch s
  if idx < 0
    s
  else strSlice s 0 idx

-- Strip inline # comment, then trim
stripComment(s Str) =
  strTrim (strTakeUntil "#" s)

-- ---- Quoted string parser (char-by-char) ----

decodeEscape(e Char) =
  if e == 'n'
    '\n'
  else if e == 't'
    '\t'
  else if e == '"'
    '"'
  else if e == '\\'
    '\\'
  else e

parseQuotedChars(cs List[Char]) =
  match cs
    | [] -> ([], [])
    | c :: rest ->
      if c == '"'
        ([], rest)
      else if c == '\\'
        parseQuotedEsc rest
      else
        let (body, leftover) = parseQuotedChars rest
        (c :: body, leftover)

parseQuotedEsc(cs List[Char]) =
  match cs
    | [] -> ([], [])
    | e :: rest2 ->
      let (body, leftover) = parseQuotedChars rest2
      (decodeEscape e :: body, leftover)

-- Parse "value" from a string, returns the unquoted content
parseQuotedStr(s Str) =
  cs = strChars s
  match cs
    | c :: rest ->
      if c == '"'
        let (body, _) = parseQuotedChars rest
        Some (strFromChars body)
      else None
    | [] -> None

-- ---- Array parser ----

-- Parse ["a", "b", "c"] — simple: split by comma, parse each quoted value
cleanArrayItem(s Str) =
  if strStartsWith "[" s
    strTrim (strDropPrefix 1 s)
  else if strStartsWith "]" s
    ""
  else s

parseArrayItems(items List[Str]) =
  match items
    | [] -> []
    | item :: rest ->
      cleaned = cleanArrayItem (strTrim item)
      final = strTrim (strTakeUntil "]" cleaned)
      if strLen final == 0
        parseArrayItems rest
      else
        match parseQuotedStr final
          | Some v -> v :: parseArrayItems rest
          | None -> parseArrayItems rest

parseStringArray(s Str) =
  inner = strTakeUntil "]" (strDropPrefix 1 s)
  parts = strSplit "," inner
  parseArrayItems parts

-- ---- Line processing ----

parseSectionHeader(line Str) =
  inner = strTrim (strTakeUntil "]" (strDropPrefix 1 line))
  if inner == "project"
    SecProject
  else if inner == "deps"
    SecDeps
  else if inner == "platform"
    SecPlatform
  else SecOther

parseKeyValue(line Str) =
  eqIdx = strIndexOf "=" line
  if eqIdx < 0
    ("", "")
  else
    key = strTrim (strSlice line 0 eqIdx)
    valRaw = strTrim (strDropPrefix (eqIdx + 1) line)
    (key, valRaw)

processProjectLine(key Str)(valRaw Str)(st ParseState) =
  match parseQuotedStr valRaw
    | None -> st
    | Some v ->
      match st
        | MkState sec name ver entry deps plat err ->
          if key == "name"
            MkState sec (Some v) ver entry deps plat err
          else if key == "version"
            MkState sec name v entry deps plat err
          else if key == "entry"
            MkState sec name ver v deps plat err
          else st

processDepsLine(key Str)(valRaw Str)(st ParseState) =
  match parseQuotedStr valRaw
    | None -> st
    | Some v ->
      -- strip quotes from key if present
      cleanKey = match parseQuotedStr key
        | Some k -> k
        | None -> key
     
      match st
        | MkState sec name ver entry deps plat err ->
          MkState sec name ver entry (listAppend deps [cleanKey v]) plat err

processPlatformLine(key Str)(valRaw Str)(st ParseState) =
  if key == "use"
    if strStartsWith "[" valRaw
      items = parseStringArray valRaw
      match st
        | MkState sec name ver entry deps _ err ->
          MkState sec name ver entry deps items err
    else st
  else st

processLine(st ParseState)(line Str) =
  trimmed = stripComment line
  if strLen trimmed == 0
    st
  else if strStartsWith "[" trimmed
    sec = parseSectionHeader trimmed
    match st
      | MkState _ name ver entry deps plat err ->
        MkState sec name ver entry deps plat err
  else if strContains "=" trimmed
    let (key, valRaw) = parseKeyValue trimmed
    match st
      | MkState sec _ _ _ _ _ _ ->
        match sec
          | SecProject -> processProjectLine key valRaw st
          | SecDeps -> processDepsLine key valRaw st
          | SecPlatform -> processPlatformLine key valRaw st
          | SecOther -> st
  else st

-- ---- Main parser ----

foldLines(f ParseState -> Str -> ParseState)(acc ParseState)(lines List[Str]) =
  match lines
    | [] -> acc
    | line :: rest -> foldLines f (f acc line) rest

parseManifest(src Str) =
  lines = strSplit "\n" src
  init = MkState SecOther None "0.0.0" "src/Main.lll" [] [] None
  final = foldLines processLine init lines
  match final
    | MkState _ name ver entry deps plat _ ->
      match name
        | Some n -> Some (MkManifest n ver entry deps plat)
        | None -> None

-- ---- Accessors (avoid nested constructor patterns in match) ----

mName(m Manifest) =
  match m
    | MkManifest n _ _ _ _ -> n

mVersion(m Manifest) =
  match m
    | MkManifest _ v _ _ _ -> v

mDeps(m Manifest) =
  match m
    | MkManifest _ _ _ d _ -> d

mPlatform(m Manifest) =
  match m
    | MkManifest _ _ _ _ p -> p

-- ---- Tests ----

tomlCheck(label Str)(ok Bool) =
  if ok
    _ = printfn (strConcat "OK " label)
    0
  else
    _ = printfn (strConcat "FAIL " label)
    1

checkManifest(r Maybe[Manifest])(f Manifest -> Bool) =
  match r
    | Some m -> f m
    | None -> false

main() =
  -- Test 1: parse minimal ll.toml
  src1 = "[project]\nname = \"myapp\""
  r1 = parseManifest src1
  _ = tomlCheck "1 parse name" (checkManifest r1 (\m. mName m == "myapp"))

  -- Test 2: parse version
  src2 = "[project]\nname = \"test\"\nversion = \"1.2.3\"\nentry = \"src/App.lll\""
  r2 = parseManifest src2
  _ = tomlCheck "2 parse version" (checkManifest r2 (\m. mVersion m == "1.2.3"))

  -- Test 3: missing name returns None
  src3 = "[project]\nversion = \"1.0\""
  r3 = parseManifest src3
  ok3 = match r3
    | Some _ -> false
    | None -> true
 
  _ = tomlCheck "3 missing name" ok3

  -- Test 4: comments and blank lines
  src4 = "# comment\n\n[project]\n# another comment\nname = \"app\""
  r4 = parseManifest src4
  _ = tomlCheck "4 comments" (checkManifest r4 (\m. mName m == "app"))

  -- Test 5: platform array
  src5 = "[project]\nname = \"p\"\n[platform]\nuse = [\"fsharp\", \"node\"]"
  r5 = parseManifest src5
  _ = tomlCheck "5 platform array" (checkManifest r5 (\m. listLen (mPlatform m) == 2))

  -- Test 6: deps section
  src6 = "[project]\nname = \"d\"\n[deps]\ncore = \"1.0\"\nutils = \"2.0\""
  r6 = parseManifest src6
  _ = tomlCheck "6 deps" (checkManifest r6 (\m. listLen (mDeps m) == 4))

  -- Test 7: parse the actual stdlib/ll.toml
  realSrc = readFile "stdlib/ll.toml"
  r7 = parseManifest realSrc
  _ = tomlCheck "7 real ll.toml" (checkManifest r7 (\m. mName m == "std"))

  -- Test 8: quoted string with escape
  src8 = "[project]\nname = \"hello\\nworld\""
  r8 = parseManifest src8
  _ = tomlCheck "8 escaped string" (checkManifest r8 (\m. strLen (mName m) == 11))

  -- Test 9: inline comment after value
  src9 = "[project]\nname = \"val\" # inline comment"
  r9 = parseManifest src9
  _ = tomlCheck "9 inline comment" (checkManifest r9 (\m. mName m == "val"))

  0
