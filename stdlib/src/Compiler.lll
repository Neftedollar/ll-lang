module Std.Compiler

import Std.Lexer
import Std.Parser
import Std.Elaborator
import Std.Codegen

-- End-to-end ll-lang compiler pipeline.
-- Lexer -> Parser -> Elaborator -> Codegen, all in ll-lang.
-- Usage: `lllc run stdlib/src/Compiler.lll`

-- ============================================================
-- PIPELINE
-- ============================================================

showErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

-- Compile ll-lang source to F# source (or an error report).
compile(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModule ast
  else
    showErrors errors

-- ============================================================
-- TESTS
-- ============================================================

compilerCheckContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing:  " (strConcat needle (strConcat "\n  in output:\n" got)))))

checkHasError(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  expected error containing: " (strConcat needle (strConcat "\n  got: " got)))))

main() =
  -- Test 1: simple function pipeline
  -- Compiles:  module Test.Hello
  --            add(a Int)(b Int) = a + b
  -- Expects F# output with module header, prelude, and add function.
  src1 = "module Test.Hello\nadd(a Int)(b Int) = a + b\n"
  out1 = compile src1
  _ = compilerCheckContains "1 module header" out1 "module Test.Hello"
  _ = compilerCheckContains "1 prelude present" out1 "ll-lang stdlib prelude"
  _ = compilerCheckContains "1 add function" out1 "let rec add"

  -- Test 2: type + match + function
  -- Compiles:  module Test.Colors
  --            Color = Red | Blue | Green
  --            describe(c Color) = match c
  --              | Red -> "red"
  --              | Blue -> "blue"
  --              | Green -> "green"
  src2 = "module Test.Colors\nColor = Red | Blue | Green\ndescribe(c Color) =\n  match c\n    | Red -> \"red\"\n    | Blue -> \"blue\"\n    | Green -> \"green\"\n"
  out2 = compile src2
  _ = compilerCheckContains "2 module colors" out2 "module Test.Colors"
  _ = compilerCheckContains "2 type Color" out2 "type Color"
  _ = compilerCheckContains "2 ctor Red" out2 "| Red"
  _ = compilerCheckContains "2 describe fn" out2 "let rec describe"
  _ = compilerCheckContains "2 match expr" out2 "match"

  -- Test 3: unbound variable produces error (not F# output)
  -- Compiles:  module Test.Bad
  --            broken(x Int) = y
  -- Expects an error about unbound variable y.
  src3 = "module Test.Bad\nbroken(x Int) = y\n"
  out3 = compile src3
  _ = checkHasError "3 unbound var error" out3 "Unbound variable: y"

  -- Test 4: let binding at module level
  src4 = "module Test.Const\nlet answer = 42\n"
  out4 = compile src4
  _ = compilerCheckContains "4 module const" out4 "module Test.Const"
  _ = compilerCheckContains "4 let binding" out4 "let answer"

  -- Test 5: if/else expression
  src5 = "module Test.IfElse\nabs(n Int) = if n < 0\n  0 - n\nelse n\n"
  out5 = compile src5
  _ = compilerCheckContains "5 abs function" out5 "let rec abs"
  _ = compilerCheckContains "5 if expression" out5 "if"

  0
