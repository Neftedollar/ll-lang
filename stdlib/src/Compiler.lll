module Std.Compiler

-- End-to-end ll-lang compiler pipeline.
-- Lexer -> Parser -> Elaborator -> Codegen, all in ll-lang.
-- Self-contained: all required types and functions are defined here.
-- Usage: `lllc run stdlib/src/Compiler.lll`

-- ============================================================
-- SHARED TYPES
-- ============================================================

Maybe A = Some A | None

-- ---- Token -------------------------------------------------

Token =
  | KwLet | KwTag | KwUnit
  | KwTrait | KwImpl | KwImport | KwExport | KwModule
  | KwIf | KwElse | KwTrue | KwFalse
  | KwMatch
  | Ident Str | TypeId Str
  | IntLit Int | FloatLit Str | StrLit Str | CharLit Char
  | Arrow | Backslash | Dot | Comma | Colon | ColonColon
  | Eq | Bar
  | LBrack | RBrack | LParen | RParen
  | Plus | Minus | Star | Slash | Caret
  | Lt | Gt | Le | Ge | EqEq | Neq
  | Underscore
  | Newline | Indent | Dedent
  | Eof | TError Char

-- ---- AST ---------------------------------------------------

Pattern =
  | PVar Str
  | PWild
  | PCon Str (List[Pattern])
  | PLitInt Int
  | PLitStr Str
  | PCons Pattern Pattern
  | PNil

Expr =
  | EInt Int
  | EStr Str
  | EBool Bool
  | EChar Char
  | EFloat Str
  | EVar Str
  | ECon Str
  | EApp Expr Expr
  | EIf Expr Expr Expr
  | EMatch Expr (List[Pattern]) (List[Expr])
  | ELam Str Expr
  | ELet Str Expr Expr
  | EList (List[Expr])
  | EBinOp Str Expr Expr
  | ETuple Expr Expr
  | ENil
  | ECons Expr Expr

TypeExpr =
  | TyName Str
  | TyApp TypeExpr TypeExpr
  | TyFn TypeExpr TypeExpr

Param = MkParam Str TypeExpr

Constructor = MkCon Str (List[TypeExpr])

Decl =
  | DFn Str (List[Param]) (Maybe[TypeExpr]) Expr
  | DType Str (List[Str]) (List[Constructor])
  | DImport (List[Str])
  | DExport Decl
  | DLet Str Expr

Module = MkModule (List[Str]) (List[Decl])

-- ---- Elaborator error --------------------------------------

ElabError = MkError Str

errMsg(e ElabError) =
  match e
    | MkError msg -> msg

-- ============================================================
-- LEXER
-- ============================================================

isUpperChar(c Char) =
  n = charToInt c
  if n < 65
    false
  else if n > 90
    false
  else true

isLowerChar(c Char) =
  n = charToInt c
  if n < 97
    false
  else if n > 122
    false
  else true

isIdStart(c Char) =
  if isUpperChar c
    true
  else isLowerChar c

isIdCont(c Char) =
  if isIdStart c
    true
  else if charIsDigit c
    true
  else c == '_'

takeIdCont(cs List[Char]) =
  match cs
    | c :: rest ->
      if isIdCont c
        listAppend [c] (takeIdCont rest)
      else []
    | _ -> []

dropIdCont(cs List[Char]) =
  match cs
    | c :: rest ->
      if isIdCont c
        dropIdCont rest
      else cs
    | _ -> []

takeDigit(cs List[Char]) =
  match cs
    | c :: rest ->
      if charIsDigit c
        listAppend [c] (takeDigit rest)
      else []
    | _ -> []

dropDigit(cs List[Char]) =
  match cs
    | c :: rest ->
      if charIsDigit c
        dropDigit rest
      else cs
    | _ -> []

classifyIdent(s Str) =
  match s
    | "let"    -> KwLet
    | "tag"    -> KwTag
    | "unit"   -> KwUnit
    | "trait"  -> KwTrait
    | "impl"   -> KwImpl
    | "import" -> KwImport
    | "export" -> KwExport
    | "module" -> KwModule
    | "if"     -> KwIf
    | "else"   -> KwElse
    | "true"   -> KwTrue
    | "false"  -> KwFalse
    | "match"  -> KwMatch
    | _ ->
      cs = strChars s
      match cs
        | c :: _ ->
          if isUpperChar c
            TypeId s
          else Ident s
        | _ -> Ident s

parseIntStr(s Str) =
  match strToInt s
    | Some n -> n
    | None -> 0

decodeEscape(c Char) =
  if c == 'n'
    '\n'
  else if c == 't'
    '\t'
  else if c == 'r'
    '\r'
  else if c == '\\'
    '\\'
  else if c == '\''
    '\''
  else if c == '"'
    '"'
  else if c == '0'
    '\0'
  else c

takeStrBody(cs List[Char]) =
  match cs
    | [] -> ([], [])
    | c :: rest ->
      if c == '"'
        ([], rest)
      else if c == '\\'
        takeStrBodyEsc rest
      else
        pair = takeStrBody rest
        match pair
          | (body, leftover) -> (c :: body, leftover)

takeStrBodyEsc(cs List[Char]) =
  match cs
    | [] -> ([], [])
    | esc :: rest ->
      pair = takeStrBody rest
      match pair
        | (body, leftover) -> (decodeEscape esc :: body, leftover)

lexId(cs List[Char]) =
  idChars = takeIdCont cs
  leftover = dropIdCont cs
  tok = classifyIdent (strFromChars idChars)
  listAppend [tok] (lexChars leftover)

lexNum(cs List[Char]) =
  digits = takeDigit cs
  rest0  = dropDigit cs
  match rest0
    | '.' :: c2 :: rest1 ->
      if charIsDigit c2
        fracDigits = takeDigit (c2 :: rest1)
        rest2 = dropDigit (c2 :: rest1)
        intPart = strFromChars digits
        fracPart = strFromChars fracDigits
        floatStr = strConcat (strConcat intPart ".") fracPart
        listAppend [FloatLit floatStr] (lexChars rest2)
      else
        n = parseIntStr (strFromChars digits)
        listAppend [IntLit n] (lexChars rest0)
    | _ ->
      n = parseIntStr (strFromChars digits)
      listAppend [IntLit n] (lexChars rest0)

lexStr(cs List[Char]) =
  pair = takeStrBody cs
  match pair
    | (body, leftover) -> listAppend [StrLit (strFromChars body)] (lexChars leftover)

lexCharLit(cs List[Char]) =
  match cs
    | [] -> [Eof]
    | ch :: rest ->
      if ch == '\\'
        match rest
          | [] -> [Eof]
          | esc :: rest2 ->
            match rest2
              | '\'' :: rest3 ->
                listAppend [CharLit (decodeEscape esc)] (lexChars rest3)
              | _ -> lexChars cs
      else
        match rest
          | '\'' :: rest2 ->
            listAppend [CharLit ch] (lexChars rest2)
          | _ -> lexChars cs

skipLineComment(cs List[Char]) =
  match cs
    | [] -> [Eof]
    | c :: rest ->
      if c == '\n'
        listAppend [Newline] (lexChars rest)
      else skipLineComment rest

lexEqOrEqEq(cs List[Char]) =
  match cs
    | '=' :: rest -> listAppend [EqEq] (lexChars rest)
    | _ -> listAppend [Eq] (lexChars cs)

lexNeq(cs List[Char]) =
  match cs
    | '=' :: rest -> listAppend [Neq] (lexChars rest)
    | _ -> lexChars cs

lexLtOrLe(cs List[Char]) =
  match cs
    | '=' :: rest -> listAppend [Le] (lexChars rest)
    | _ -> listAppend [Lt] (lexChars cs)

lexGtOrGe(cs List[Char]) =
  match cs
    | '=' :: rest -> listAppend [Ge] (lexChars rest)
    | _ -> listAppend [Gt] (lexChars cs)

lexMinusOrArrow(cs List[Char]) =
  match cs
    | '>' :: rest -> listAppend [Arrow] (lexChars rest)
    | '-' :: rest -> skipLineComment rest
    | _ -> listAppend [Minus] (lexChars cs)

lexColonOrCons(cs List[Char]) =
  match cs
    | ':' :: rest -> listAppend [ColonColon] (lexChars rest)
    | _ -> listAppend [Colon] (lexChars cs)

lexUnderOrIdent(cs List[Char]) =
  match cs
    | c :: _ ->
      if isIdCont c
        idChars = listAppend ['_'] (takeIdCont cs)
        leftover = dropIdCont cs
        tok = classifyIdent (strFromChars idChars)
        listAppend [tok] (lexChars leftover)
      else listAppend [Underscore] (lexChars cs)
    | _ -> listAppend [Underscore] (lexChars cs)

lexChars(cs List[Char]) =
  match cs
    | [] -> [Eof]
    | c :: rest ->
      if c == '\n'
        listAppend [Newline] (lexChars rest)
      else if charIsSpace c
        lexChars rest
      else if c == '-'
        lexMinusOrArrow rest
      else if isIdStart c
        lexId cs
      else if c == '_'
        lexUnderOrIdent rest
      else if charIsDigit c
        lexNum cs
      else if c == '"'
        lexStr rest
      else if c == '\''
        lexCharLit rest
      else if c == '='
        lexEqOrEqEq rest
      else if c == '!'
        lexNeq rest
      else if c == '<'
        lexLtOrLe rest
      else if c == '>'
        lexGtOrGe rest
      else if c == ':'
        lexColonOrCons rest
      else if c == '('
        listAppend [LParen] (lexChars rest)
      else if c == ')'
        listAppend [RParen] (lexChars rest)
      else if c == '['
        listAppend [LBrack] (lexChars rest)
      else if c == ']'
        listAppend [RBrack] (lexChars rest)
      else if c == '|'
        listAppend [Bar] (lexChars rest)
      else if c == '+'
        listAppend [Plus] (lexChars rest)
      else if c == '*'
        listAppend [Star] (lexChars rest)
      else if c == '/'
        listAppend [Slash] (lexChars rest)
      else if c == '^'
        listAppend [Caret] (lexChars rest)
      else if c == '.'
        listAppend [Dot] (lexChars rest)
      else if c == ','
        listAppend [Comma] (lexChars rest)
      else if c == '\\'
        listAppend [Backslash] (lexChars rest)
      else listAppend [TError c] (lexChars rest)

tokenize(src Str) =
  lexChars (strChars src)

-- ============================================================
-- PARSER
-- ============================================================

skipNewlines(toks List[Token]) =
  match toks
    | Newline :: rest -> skipNewlines rest
    | Indent :: rest -> skipNewlines rest
    | Dedent :: rest -> skipNewlines rest
    | _ -> toks

isAtomStart(t Token) =
  match t
    | IntLit _ -> true
    | FloatLit _ -> true
    | StrLit _ -> true
    | CharLit _ -> true
    | KwTrue -> true
    | KwFalse -> true
    | Ident _ -> true
    | TypeId _ -> true
    | LParen -> true
    | LBrack -> true
    | _ -> false

skipBrackTypeArgs(toks List[Token]) =
  match toks
    | LBrack :: rest ->
      rest2 = skipBrackTypeBody rest
      skipBrackTypeArgs rest2
    | _ -> toks

skipBrackTypeBody(toks List[Token]) =
  match toks
    | RBrack :: rest -> rest
    | LBrack :: rest ->
      rest2 = skipBrackTypeBody rest
      skipBrackTypeBody rest2
    | _ :: rest -> skipBrackTypeBody rest
    | [] -> []

parseTypeExpr(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      rest2 = skipBrackTypeArgs rest
      (TyName name, rest2)
    | Ident name :: rest ->
      (TyName name, rest)
    | _ -> (TyName "?", toks)

parseReturnType(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      rest2 = skipBrackTypeArgs rest
      (Some (TyName name), rest2)
    | _ -> (None, toks)

parseParamGroups(toks List[Token]) =
  match toks
    | LParen :: RParen :: rest -> ([], rest)
    | LParen :: Ident pname :: TypeId tname :: rest ->
      rest2 = skipBrackTypeArgs rest
      rest3 = match rest2
        | RParen :: r -> r
        | _ -> rest2
      let (ps, rest4) = parseParamGroups rest3
      (MkParam pname (TyName tname) :: ps, rest4)
    | LParen :: Underscore :: Ident pname :: TypeId tname :: rest ->
      rest2 = skipBrackTypeArgs rest
      rest3 = match rest2
        | RParen :: r -> r
        | _ -> rest2
      let (ps, rest4) = parseParamGroups rest3
      (MkParam (strConcat "_" pname) (TyName tname) :: ps, rest4)
    | LParen :: Ident pname :: RParen :: rest ->
      let (ps, rest2) = parseParamGroups rest
      (MkParam pname (TyName "?") :: ps, rest2)
    | _ -> ([], toks)

parseTypeParams(toks List[Token]) =
  match toks
    | TypeId s :: rest ->
      if strLen s == 1
        let (ps, rest2) = parseTypeParams rest
        (s :: ps, rest2)
      else ([], toks)
    | _ -> ([], toks)

parseConArgs(toks List[Token]) =
  match toks
    | TypeId _ :: _ ->
      let (arg, rest) = parseTypeExpr toks
      let (args, rest2) = parseConArgs rest
      (arg :: args, rest2)
    | _ -> ([], toks)

parseCon(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      let (args, rest2) = parseConArgs rest
      (MkCon name args, rest2)
    | _ -> (MkCon "?" [], toks)

parseConsTail(acc List[Constructor])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: rest ->
      rest2 = skipNewlines rest
      let (c, rest3) = parseCon rest2
      parseConsTail (listAppend acc [c]) rest3
    | _ -> (acc, toks)

parseConList(toks List[Token]) =
  toks2 = skipNewlines toks
  toks3 = match toks2
    | Bar :: r -> skipNewlines r
    | _ -> toks2
  let (c, rest) = parseCon toks3
  parseConsTail [c] rest

parseTypeDecl(toks List[Token]) =
  match toks
    | TypeId name :: rest ->
      let (prms, rest2) = parseTypeParams rest
      rest3 = match (skipNewlines rest2)
        | Eq :: r -> skipNewlines r
        | _ -> skipNewlines rest2
      let (ctors, rest4) = parseConList rest3
      (DType name prms ctors, rest4)
    | _ -> (DType "?" [] [], toks)

parsePrimaryPat(toks List[Token]) =
  match toks
    | IntLit n :: rest -> (PLitInt n, rest)
    | StrLit s :: rest -> (PLitStr s, rest)
    | Underscore :: rest -> (PWild, rest)
    | LBrack :: RBrack :: rest -> (PNil, rest)
    | Ident s :: rest -> (PVar s, rest)
    | TypeId name :: rest ->
      let (args, rest2) = parsePatArgs rest
      (PCon name args, rest2)
    | _ -> (PWild, toks)

parsePatArgs(toks List[Token]) =
  match toks
    | Ident _ :: _ -> parsePatArgsCons toks
    | Underscore :: _ -> parsePatArgsCons toks
    | IntLit _ :: _ -> parsePatArgsCons toks
    | LBrack :: RBrack :: _ -> parsePatArgsCons toks
    | _ -> ([], toks)

parsePatArgsCons(toks List[Token]) =
  let (p, rest) = parsePrimaryPat toks
  let (ps, rest2) = parsePatArgs rest
  (listAppend [p] ps, rest2)

parsePat(toks List[Token]) =
  let (p, rest) = parsePrimaryPat toks
  match rest
    | ColonColon :: rest2 ->
      let (tail, rest3) = parsePat rest2
      (PCons p tail, rest3)
    | _ -> (p, rest)

parseArmBody(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | KwIf :: rest -> parseIf rest
    | KwLet :: rest -> parseLetIn rest
    | Ident _ :: Eq :: _ -> parseLetIn toks2
    | _ -> parseCompare toks2

skipArrow(toks List[Token]) =
  match toks
    | Arrow :: r -> r
    | _ -> toks

parseArm(toks List[Token]) =
  match toks
    | Bar :: rest ->
      let (p, rest2) = parsePat rest
      rest3 = skipArrow rest2
      let (body, rest4) = parseArmBody rest3
      ((p, body), rest4)
    | _ -> ((PWild, EInt 0), toks)

parseArms(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: _ ->
      let (pb, rest) = parseArm toks2
      let (p, b) = pb
      let (morePB, rest2) = parseArms rest
      let (ps, bs) = morePB
      ((p :: ps, b :: bs), rest2)
    | _ -> (([], []), toks2)

parseMatch(toks List[Token]) =
  let (scrut, rest) = parseExpr toks
  let (armLists, rest2) = parseArms rest
  let (pats, bodies) = armLists
  (EMatch scrut pats bodies, rest2)

parseIf(toks List[Token]) =
  let (cond, rest) = parseExpr toks
  rest2 = skipNewlines rest
  let (thenE, rest3) = parseExpr rest2
  rest3a = skipNewlines rest3
  rest4 = match rest3a
    | KwElse :: r -> skipNewlines r
    | _ -> rest3a
  let (elseE, rest5) = parseExpr rest4
  (EIf cond thenE elseE, rest5)

skipKwIn(toks List[Token]) =
  match toks
    | KwLet :: r -> skipNewlines r
    | _ -> skipNewlines toks

parseLetIn(toks List[Token]) =
  match toks
    | LParen :: Ident a :: Comma :: Ident b :: RParen :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (e1, rest2) = parseExpr rest0
      rest3 = skipKwIn rest2
      let (e2, rest4) = parseExpr rest3
      (ELet a e1 (ELet b (ETuple e1 e2) e2), rest4)
    | Ident name :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (e1, rest2) = parseExpr rest0
      rest3 = skipKwIn rest2
      let (e2, rest4) = parseExpr rest3
      (ELet name e1 e2, rest4)
    | _ -> (EInt 0, toks)

parseLamParams(acc List[Str])(toks List[Token]) =
  match toks
    | Ident name :: rest -> parseLamParams (listAppend acc [name]) rest
    | _ -> (acc, toks)

wrapLamParams(parms List[Str])(body Expr) =
  match parms
    | p :: rest -> ELam p (wrapLamParams rest body)
    | _ -> body

parseLam(toks List[Token]) =
  let (parms, rest) = parseLamParams [] toks
  match rest
    | Dot :: rest2 ->
      let (body, rest3) = parseExpr rest2
      (wrapLamParams parms body, rest3)
    | _ -> (EInt 0, toks)

parseExpr(toks List[Token]) =
  match toks
    | KwIf :: rest -> parseIf rest
    | KwMatch :: rest -> parseMatch rest
    | KwLet :: rest -> parseLetIn rest
    | Ident _ :: Eq :: _ -> parseLetIn toks
    | Backslash :: rest -> parseLam rest
    | _ -> parseCompare toks

parseCompare(toks List[Token]) =
  let (e, rest) = parseCons toks
  parseCompareTail e rest

parseCompareTail(lhs Expr)(toks List[Token]) =
  match toks
    | EqEq :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp "==" lhs rhs) rest2
    | Neq :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp "!=" lhs rhs) rest2
    | Lt :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp "<" lhs rhs) rest2
    | Gt :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp ">" lhs rhs) rest2
    | Le :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp "<=" lhs rhs) rest2
    | Ge :: r ->
      let (rhs, rest2) = parseCons r
      parseCompareTail (EBinOp ">=" lhs rhs) rest2
    | _ -> (lhs, toks)

parseCons(toks List[Token]) =
  let (head, rest) = parseAddSub toks
  match rest
    | ColonColon :: rest2 ->
      let (tail, rest3) = parseCons rest2
      (ECons head tail, rest3)
    | _ -> (head, rest)

parseAddSub(toks List[Token]) =
  let (e, rest) = parseMulDiv toks
  parseAddSubTail e rest

parseAddSubTail(lhs Expr)(toks List[Token]) =
  match toks
    | Plus :: rest ->
      let (r, rest2) = parseMulDiv rest
      parseAddSubTail (EBinOp "+" lhs r) rest2
    | Minus :: rest ->
      let (r, rest2) = parseMulDiv rest
      parseAddSubTail (EBinOp "-" lhs r) rest2
    | _ -> (lhs, toks)

parseMulDiv(toks List[Token]) =
  let (e, rest) = parseApp toks
  parseMulDivTail e rest

parseMulDivTail(lhs Expr)(toks List[Token]) =
  match toks
    | Star :: rest ->
      let (r, rest2) = parseApp rest
      parseMulDivTail (EBinOp "*" lhs r) rest2
    | Slash :: rest ->
      let (r, rest2) = parseApp rest
      parseMulDivTail (EBinOp "/" lhs r) rest2
    | _ -> (lhs, toks)

parseApp(toks List[Token]) =
  let (e, rest) = parseAtom toks
  parseAppTail e rest

parseAppTail(lhs Expr)(toks List[Token]) =
  match toks
    | t :: _ ->
      if isAtomStart t
        let (arg, rest) = parseAtom toks
        parseAppTail (EApp lhs arg) rest
      else (lhs, toks)
    | _ -> (lhs, toks)

parseListLit(toks List[Token]) =
  match toks
    | RBrack :: rest -> (ENil, rest)
    | _ ->
      let (e, rest) = parseListElem toks
      match rest
        | RBrack :: rest2 -> (ECons e ENil, rest2)
        | Comma :: rest2 ->
          let (tail, rest3) = parseListLit rest2
          (ECons e tail, rest3)
        | _ ->
          let (tail, rest2) = parseListLit rest
          (ECons e tail, rest2)

parseListElem(toks List[Token]) =
  match toks
    | TypeId _ :: _ -> parseApp toks
    | _ -> parseAtom toks

parseAtomParenTail(e Expr)(toks List[Token]) =
  match toks
    | Comma :: rest ->
      rest2 = skipNewlines rest
      let (e2, rest3) = parseExpr rest2
      match rest3
        | RParen :: rest4 -> (ETuple e e2, rest4)
        | _ -> (ETuple e e2, rest3)
    | RParen :: rest -> (e, rest)
    | _ -> (e, toks)

parseAtom(toks List[Token]) =
  match toks
    | IntLit n :: rest -> (EInt n, rest)
    | FloatLit s :: rest -> (EFloat s, rest)
    | StrLit s :: rest -> (EStr s, rest)
    | CharLit c :: rest -> (EChar c, rest)
    | KwTrue :: rest -> (EBool true, rest)
    | KwFalse :: rest -> (EBool false, rest)
    | Ident s :: rest -> (EVar s, rest)
    | TypeId s :: rest -> (ECon s, rest)
    | LBrack :: RBrack :: rest -> (ENil, rest)
    | LBrack :: rest -> parseListLit rest
    | LParen :: rest ->
      let (e, rest2) = parseExpr rest
      parseAtomParenTail e rest2
    | _ -> (EInt 0, toks)

lastParamVar(prms List[Param]) =
  match prms
    | [] -> EInt 0
    | MkParam n _ :: [] -> EVar n
    | _ :: rest -> lastParamVar rest

parseFnBody(prms List[Param])(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Bar :: _ ->
      let (armLists, rest) = parseArms toks2
      let (pats, bodies) = armLists
      scrut = lastParamVar prms
      (EMatch scrut pats bodies, rest)
    | _ -> parseExpr toks2

parseFnDecl(toks List[Token]) =
  match toks
    | Ident name :: rest ->
      let (prms, rest2) = parseParamGroups rest
      let (retTy, rest3) = parseReturnType rest2
      rest4 = match (skipNewlines rest3)
        | Eq :: r -> skipNewlines r
        | _ -> skipNewlines rest3
      let (body, rest5) = parseFnBody prms rest4
      (DFn name prms retTy body, rest5)
    | _ -> (DFn "?" [] None (EInt 0), toks)

parseLetDecl(toks List[Token]) =
  match toks
    | KwLet :: Ident name :: Eq :: rest ->
      rest0 = skipNewlines rest
      let (body, rest2) = parseExpr rest0
      (DLet name body, rest2)
    | _ -> (DLet "?" (EInt 0), toks)

parseImportPath(acc List[Str])(toks List[Token]) =
  match toks
    | Dot :: TypeId seg :: rest ->
      parseImportPath (listAppend acc [seg]) rest
    | _ -> (acc, toks)

parseImportDecl(toks List[Token]) =
  match toks
    | KwImport :: TypeId head :: rest ->
      let (segs, rest2) = parseImportPath [head] rest
      (DImport segs, rest2)
    | _ -> (DImport [], toks)

parseOneDecl(toks List[Token]) =
  match toks
    | TypeId _ :: _ -> parseTypeDecl toks
    | KwLet :: _ -> parseLetDecl toks
    | Ident _ :: _ -> parseFnDecl toks
    | KwImport :: _ -> parseImportDecl toks
    | KwExport :: rest ->
      let (inner, rest2) = parseOneDecl rest
      (DExport inner, rest2)
    | _ -> (DLet "?" (EInt 0), toks)

parseDecls(toks List[Token]) =
  toks2 = skipNewlines toks
  match toks2
    | Eof :: _ -> []
    | [] -> []
    | TypeId _ :: _ ->
      let (d, rest) = parseTypeDecl toks2
      d :: parseDecls rest
    | KwLet :: _ ->
      let (d, rest) = parseLetDecl toks2
      d :: parseDecls rest
    | Ident _ :: _ ->
      let (d, rest) = parseFnDecl toks2
      d :: parseDecls rest
    | KwImport :: _ ->
      let (d, rest) = parseImportDecl toks2
      d :: parseDecls rest
    | KwExport :: rest ->
      let (inner, rest2) = parseOneDecl rest
      DExport inner :: parseDecls rest2
    | _ -> []

parseModulePath(acc List[Str])(toks List[Token]) =
  match toks
    | Dot :: TypeId seg :: rest ->
      parseModulePath (listAppend acc [seg]) rest
    | _ -> (acc, toks)

parseModuleHeader(toks List[Token]) =
  match toks
    | KwModule :: TypeId head :: rest ->
      let (segs, rest2) = parseModulePath [head] rest
      (segs, rest2)
    | _ -> ([], toks)

parseModule(toks List[Token]) =
  toks2 = skipNewlines toks
  let (path, rest) = parseModuleHeader toks2
  decls = parseDecls (skipNewlines rest)
  MkModule path decls

-- ============================================================
-- ELABORATOR
-- ============================================================

Env = MkEnv (List[Str])

emptyEnv = MkEnv []

envAdd(name Str)(env Env) =
  match env
    | MkEnv xs -> MkEnv (listAppend xs [name])

envAddAll(names List[Str])(env Env) =
  listFold (\acc n. envAdd n acc) env names

strOrEq(target Str)(acc Bool)(x Str) =
  if acc
    true
  else
    x == target

envHas(name Str)(env Env) =
  match env
    | MkEnv xs -> listFold (\acc x. strOrEq name acc x) false xs

patBinders(p Pattern) =
  match p
    | PVar name -> [name]
    | PWild -> []
    | PNil -> []
    | PLitInt _ -> []
    | PLitStr _ -> []
    | PCons h t -> listAppend (patBinders h) (patBinders t)
    | PCon _ args -> patBindersList args

patBindersList(ps List[Pattern]) =
  match ps
    | [] -> []
    | p :: rest -> listAppend (patBinders p) (patBindersList rest)

paramName(p Param) =
  match p
    | MkParam n _ -> n

paramNames(ps List[Param]) =
  listMap (\p. paramName p) ps

conName(c Constructor) =
  match c
    | MkCon n _ -> n

conNames(cs List[Constructor]) =
  listMap (\c. conName c) cs

listContains(name Str)(xs List[Str]) =
  listFold (\acc x. strOrEq name acc x) false xs

findDuplicatesAcc(xs List[Str])(seen List[Str]) =
  match xs
    | [] -> []
    | x :: rest ->
      if listContains x seen
        x :: findDuplicatesAcc rest seen
      else
        findDuplicatesAcc rest (x :: seen)

findDuplicates(xs List[Str]) =
  findDuplicatesAcc xs []

declName(d Decl) =
  match d
    | DFn name _ _ _ -> Some name
    | DLet name _ -> Some name
    | DType name _ _ -> Some name
    | DImport _ -> None
    | DExport inner -> declName inner

addDeclName(acc List[Str])(d Decl) =
  match declName d
    | Some name -> listAppend acc [name]
    | None -> acc

collectDeclNames(decls List[Decl]) =
  listFold (\acc d. addDeclName acc d) [] decls

collectDecl(d Decl)(env Env) =
  match d
    | DFn name _ _ _ -> envAdd name env
    | DLet name _ -> envAdd name env
    | DType _ _ ctors -> envAddAll (conNames ctors) env
    | DImport _ -> env
    | DExport inner -> collectDecl inner env

collectDecls(decls List[Decl])(env Env) =
  listFold (\acc d. collectDecl d acc) env decls

checkExpr(env Env)(e Expr) =
  match e
    | EInt _ -> []
    | EStr _ -> []
    | EBool _ -> []
    | EChar _ -> []
    | EFloat _ -> []
    | ENil -> []
    | EVar name ->
      if envHas name env
        []
      else
        [MkError (strConcat "Unbound variable: " name)]
    | ECon name ->
      if envHas name env
        []
      else
        [MkError (strConcat "Unbound constructor: " name)]
    | EApp f x ->
      listAppend (checkExpr env f) (checkExpr env x)
    | EBinOp _ l r ->
      listAppend (checkExpr env l) (checkExpr env r)
    | EIf cnd thn els ->
      listAppend (listAppend (checkExpr env cnd) (checkExpr env thn)) (checkExpr env els)
    | ELam param body ->
      env2 = envAdd param env
      checkExpr env2 body
    | ELet name rhs body ->
      rhsErrs = checkExpr env rhs
      env2 = envAdd name env
      bodyErrs = checkExpr env2 body
      listAppend rhsErrs bodyErrs
    | EMatch scrut pats bodies ->
      scrutErrs = checkExpr env scrut
      armErrs = checkArms env pats bodies
      listAppend scrutErrs armErrs
    | EList items ->
      listFold (\acc item. listAppend acc (checkExpr env item)) [] items
    | ECons h t ->
      listAppend (checkExpr env h) (checkExpr env t)
    | ETuple a b ->
      listAppend (checkExpr env a) (checkExpr env b)

checkArmsCons(env Env)(p Pattern)(restPats List[Pattern])(bodies List[Expr]) =
  match bodies
    | [] -> []
    | b :: restBodies ->
      armEnv = envAddAll (patBinders p) env
      armErrs = checkExpr armEnv b
      restErrs = checkArms env restPats restBodies
      listAppend armErrs restErrs

checkArms(env Env)(pats List[Pattern])(bodies List[Expr]) =
  match pats
    | [] -> []
    | p :: restPats -> checkArmsCons env p restPats bodies

checkDecl(env Env)(d Decl) =
  match d
    | DFn _ params _ body ->
      bodyEnv = envAddAll (paramNames params) env
      checkExpr bodyEnv body
    | DLet _ body ->
      checkExpr env body
    | DType _ _ _ -> []
    | DImport _ -> []
    | DExport inner -> checkDecl env inner

checkDecls(env Env)(decls List[Decl]) =
  listFold (\acc d. listAppend acc (checkDecl env d)) [] decls

makeDupError(name Str) =
  MkError (strConcat "Duplicate declaration: " name)

checkDuplicates(decls List[Decl]) =
  names = collectDeclNames decls
  dups = findDuplicates names
  listMap (\name. makeDupError name) dups

elaborate(m Module) =
  match m
    | MkModule _ decls ->
      env = collectDecls decls emptyEnv
      dupErrs = checkDuplicates decls
      bodyErrs = checkDecls env decls
      listAppend dupErrs bodyErrs

-- ============================================================
-- CODEGEN
-- ============================================================

joinWith(sep Str)(items List[Str]) =
  match items
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

isFsKeyword(s Str) =
  if s == "abstract"
    true
  else if s == "and"
    true
  else if s == "as"
    true
  else if s == "begin"
    true
  else if s == "class"
    true
  else if s == "do"
    true
  else if s == "done"
    true
  else if s == "downcast"
    true
  else if s == "elif"
    true
  else if s == "else"
    true
  else if s == "end"
    true
  else if s == "exception"
    true
  else if s == "false"
    true
  else if s == "for"
    true
  else if s == "fun"
    true
  else if s == "function"
    true
  else if s == "if"
    true
  else if s == "in"
    true
  else if s == "inherit"
    true
  else if s == "inline"
    true
  else if s == "interface"
    true
  else if s == "let"
    true
  else if s == "match"
    true
  else if s == "member"
    true
  else if s == "mod"
    true
  else if s == "module"
    true
  else if s == "mutable"
    true
  else if s == "namespace"
    true
  else if s == "new"
    true
  else if s == "not"
    true
  else if s == "null"
    true
  else if s == "of"
    true
  else if s == "open"
    true
  else if s == "or"
    true
  else if s == "override"
    true
  else if s == "private"
    true
  else if s == "public"
    true
  else if s == "rec"
    true
  else if s == "return"
    true
  else if s == "static"
    true
  else if s == "struct"
    true
  else if s == "then"
    true
  else if s == "to"
    true
  else if s == "true"
    true
  else if s == "try"
    true
  else if s == "type"
    true
  else if s == "upcast"
    true
  else if s == "use"
    true
  else if s == "val"
    true
  else if s == "void"
    true
  else if s == "when"
    true
  else if s == "while"
    true
  else if s == "with"
    true
  else if s == "yield"
    true
  else if s == "trait"
    true
  else false

safeIdent(s Str) =
  if isFsKeyword s
    strConcat "__ll_" s
  else s

encodeStrEscape(c Char) =
  if c == '\n'
    "\\n"
  else if c == '\t'
    "\\t"
  else if c == '\r'
    "\\r"
  else if c == '\\'
    "\\\\"
  else if c == '"'
    "\\\""
  else strFromChars [c]

escapeStr(s Str) =
  listFold (\acc c. strConcat acc (encodeStrEscape c)) "" (strChars s)

mapOp(op Str) =
  if op == "=="
    "="
  else if op == "!="
    "<>"
  else op

isTypeParam(s Str) =
  match strChars s
    | c :: [] ->
      n = charToInt c
      if n >= 65
        if n <= 90
          true
        else false
      else false
    | _ -> false

emitType(t TypeExpr) =
  match t
    | TyName "Int" -> "int64"
    | TyName "Str" -> "string"
    | TyName "Bool" -> "bool"
    | TyName "Char" -> "char"
    | TyName "Float" -> "float"
    | TyName "Unit" -> "unit"
    | TyName n ->
      if isTypeParam n
        strConcat "'" n
      else n
    | TyApp (TyName "List") a -> strConcat (emitType a) " list"
    | TyApp f a ->
      head = collectTyAppHead (TyApp f a)
      args = collectTyAppArgs (TyApp f a)
      match args
        | _ :: [] -> strConcat (emitType a) (strConcat " " (emitType head))
        | _ ->
          inner = joinWith ", " (listMap emitType args)
          strConcat (emitType head) (strConcat "<" (strConcat inner ">"))
    | TyFn a b -> strConcat (emitType a) (strConcat " -> " (emitType b))

collectTyAppHead(t TypeExpr) =
  match t
    | TyApp f _ -> collectTyAppHead f
    | _ -> t

collectTyAppArgs(t TypeExpr) =
  match t
    | TyApp f a -> listAppend (collectTyAppArgs f) [a]
    | _ -> []

emitPattern(p Pattern) =
  match p
    | PVar x -> safeIdent x
    | PWild -> "_"
    | PNil -> "[]"
    | PLitInt n -> strConcat (intToStr n) "L"
    | PLitStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | PCons h t ->
      strConcat "(" (strConcat (emitPattern h) (strConcat " :: " (strConcat (emitPattern t) ")")))
    | PCon c args -> emitConPattern c args

emitConPattern(c Str)(args List[Pattern]) =
  match args
    | [] -> c
    | _ :: [] ->
      inner = emitPattern (patListHead args)
      strConcat c (strConcat "(" (strConcat inner ")"))
    | _ ->
      inner = joinWith ", " (listMap emitPattern args)
      strConcat c (strConcat "(" (strConcat inner ")"))

patListHead(xs List[Pattern]) =
  match xs
    | x :: _ -> x
    | _ -> PWild

emitCharLit(c Char) =
  if c == '\n'
    "'\\n'"
  else if c == '\t'
    "'\\t'"
  else if c == '\\'
    "'\\\\'"
  else if c == '\''
    "'\\''"
  else strConcat (strConcat "'" (strFromChars [c])) "'"

emitExpr(e Expr) =
  match e
    | EInt n -> strConcat (intToStr n) "L"
    | EStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | EBool b ->
      if b
        "true"
      else "false"
    | EChar c -> emitCharLit c
    | EFloat s -> s
    | EVar x -> safeIdent x
    | ECon c -> c
    | ENil -> "[]"
    | EApp f a -> emitApp f a
    | EIf c t el ->
      strConcat "(if " (strConcat (emitExpr c) (strConcat " then " (strConcat (emitExpr t) (strConcat " else " (strConcat (emitExpr el) ")")))))
    | EMatch scrut pats bodies ->
      arms = emitArms pats bodies
      strConcat "(match " (strConcat (emitExpr scrut) (strConcat " with " (strConcat arms ")")))
    | ELam x body ->
      strConcat "(fun " (strConcat (safeIdent x) (strConcat " -> " (strConcat (emitExpr body) ")")))
    | ELet x e body ->
      strConcat "(let " (strConcat (safeIdent x) (strConcat " = " (strConcat (emitExpr e) (strConcat " in " (strConcat (emitExpr body) ")")))))
    | EList items ->
      strConcat "[" (strConcat (joinWith "; " (listMap emitExpr items)) "]")
    | EBinOp op l r ->
      strConcat "(" (strConcat (emitExpr l) (strConcat " " (strConcat (mapOp op) (strConcat " " (strConcat (emitExpr r) ")")))))
    | ETuple a b ->
      strConcat "(" (strConcat (emitExpr a) (strConcat ", " (strConcat (emitExpr b) ")")))
    | ECons h t ->
      strConcat "(" (strConcat (emitExpr h) (strConcat " :: " (strConcat (emitExpr t) ")")))

gatherAppHead(e Expr) =
  match e
    | EApp f _ -> gatherAppHead f
    | _ -> e

gatherAppArgs(e Expr) =
  match e
    | EApp f a -> listAppend (gatherAppArgs f) [a]
    | _ -> []

isUpperStart(s Str) =
  match strChars s
    | c :: _ ->
      n = charToInt c
      if n >= 65
        if n <= 90
          true
        else false
      else false
    | _ -> false

emitApp(f Expr)(a Expr) =
  head = gatherAppHead (EApp f a)
  args = gatherAppArgs (EApp f a)
  match head
    | ECon c -> emitConApp c args
    | EVar x ->
      if isUpperStart x
        emitConApp x args
      else
        strConcat "(" (strConcat (emitExpr f) (strConcat " " (strConcat (emitExpr a) ")")))
    | _ ->
      strConcat "(" (strConcat (emitExpr f) (strConcat " " (strConcat (emitExpr a) ")")))

exprListHead(xs List[Expr]) =
  match xs
    | x :: _ -> x
    | _ -> ENil

emitConApp(c Str)(args List[Expr]) =
  match args
    | [] -> c
    | _ :: [] ->
      strConcat "(" (strConcat c (strConcat " " (strConcat (emitExpr (exprListHead args)) ")")))
    | _ ->
      inner = joinWith ", " (listMap emitExpr args)
      strConcat "(" (strConcat c (strConcat " (" (strConcat inner "))")))

emitArms(pats List[Pattern])(bodies List[Expr]) =
  match pats
    | p :: prest ->
      match bodies
        | b :: brest ->
          arm = strConcat "| " (strConcat (emitPattern p) (strConcat " -> " (emitExpr b)))
          rest = emitArms prest brest
          if strLen rest == 0
            arm
          else strConcat arm (strConcat " " rest)
        | _ -> ""
    | _ -> ""

emitTypeParam(s Str) = strConcat "'" s

emitTypeParams(tvars List[Str]) =
  match tvars
    | [] -> ""
    | _ ->
      inner = joinWith ", " (listMap emitTypeParam tvars)
      strConcat "<" (strConcat inner ">")

emitCtorArgs(args List[TypeExpr]) =
  joinWith " * " (listMap emitType args)

emitCtor(c Constructor) =
  match c
    | MkCon name args ->
      match args
        | [] -> strConcat "    | " name
        | _ -> strConcat "    | " (strConcat name (strConcat " of " (emitCtorArgs args)))

emitCtors(cs List[Constructor]) =
  joinWith "\n" (listMap emitCtor cs)

emitParamName(p Param) =
  match p
    | MkParam n _ -> safeIdent n

emitParamStr(ps List[Param]) =
  match ps
    | [] -> ""
    | _ -> strConcat " " (joinWith " " (listMap emitParamName ps))

emitDecl(d Decl) =
  match d
    | DType name tvars ctors ->
      header = strConcat "type " (strConcat name (emitTypeParams tvars))
      body = emitCtors ctors
      strConcat header (strConcat " =\n" body)
    | DFn name params _ body ->
      paramStr = emitParamStr params
      strConcat "let rec " (strConcat (safeIdent name) (strConcat paramStr (strConcat " =\n    " (emitExpr body))))
    | DLet name body ->
      strConcat "let " (strConcat (safeIdent name) (strConcat " = " (emitExpr body)))
    | DImport parts ->
      strConcat "// import " (joinWith "." parts)
    | DExport inner -> emitDecl inner

emitDecls(ds List[Decl]) =
  joinWith "\n\n" (listMap emitDecl ds)

emitPrelude =
  "// --- ll-lang prelude ---\nlet listLen (xs: 'a list) : int64 = int64 (List.length xs)\nlet listMap f xs = List.map f xs\nlet listFilter p xs = List.filter p xs\nlet listFold f z xs = List.fold f z xs\nlet listReverse xs = List.rev xs\nlet listAppend xs ys = List.append xs ys\nlet listIsEmpty xs = List.isEmpty xs\nlet strLen (s: string) : int64 = int64 s.Length\nlet strConcat (a: string) (b: string) = a + b\nlet strChars (s: string) = s |> Seq.toList\nlet strFromChars (cs: char list) = System.String(cs |> List.toArray)\nlet intToStr (n: int64) = string n\nlet charToInt (c: char) = int64 (int c)\nlet printfn (s: string) = System.Console.WriteLine(s)\n// --- end prelude ---"

emitModulePath(parts List[Str]) =
  joinWith "." parts

emitModule(m Module) =
  match m
    | MkModule path decls ->
      header = strConcat "module " (emitModulePath path)
      prelude = emitPrelude
      body = emitDecls decls
      strConcat header (strConcat "\n\n" (strConcat prelude (strConcat "\n\n" body)))

-- ============================================================
-- PIPELINE
-- ============================================================

showErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

-- Compile ll-lang source to F# source (or an error report).
compile(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModule ast
  else
    showErrors errors

-- ============================================================
-- TESTS
-- ============================================================

checkContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing:  " (strConcat needle (strConcat "\n  in output:\n" got)))))

checkHasError(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  expected error containing: " (strConcat needle (strConcat "\n  got: " got)))))

main() =
  -- Test 1: simple function pipeline
  -- Compiles:  module Test.Hello
  --            add(a Int)(b Int) = a + b
  -- Expects F# output with module header, prelude, and add function.
  src1 = "module Test.Hello\nadd(a Int)(b Int) = a + b\n"
  out1 = compile src1
  _ = checkContains "1 module header" out1 "module Test.Hello"
  _ = checkContains "1 prelude present" out1 "ll-lang prelude"
  _ = checkContains "1 add function" out1 "let rec add"

  -- Test 2: type + match + function
  -- Compiles:  module Test.Colors
  --            Color = Red | Blue | Green
  --            describe(c Color) = match c
  --              | Red -> "red"
  --              | Blue -> "blue"
  --              | Green -> "green"
  src2 = "module Test.Colors\nColor = Red | Blue | Green\ndescribe(c Color) =\n  match c\n    | Red -> \"red\"\n    | Blue -> \"blue\"\n    | Green -> \"green\"\n"
  out2 = compile src2
  _ = checkContains "2 module colors" out2 "module Test.Colors"
  _ = checkContains "2 type Color" out2 "type Color"
  _ = checkContains "2 ctor Red" out2 "| Red"
  _ = checkContains "2 describe fn" out2 "let rec describe"
  _ = checkContains "2 match expr" out2 "match"

  -- Test 3: unbound variable produces error (not F# output)
  -- Compiles:  module Test.Bad
  --            broken(x Int) = y
  -- Expects an error about unbound variable y.
  src3 = "module Test.Bad\nbroken(x Int) = y\n"
  out3 = compile src3
  _ = checkHasError "3 unbound var error" out3 "Unbound variable: y"

  -- Test 4: let binding at module level
  src4 = "module Test.Const\nlet answer = 42\n"
  out4 = compile src4
  _ = checkContains "4 module const" out4 "module Test.Const"
  _ = checkContains "4 let binding" out4 "let answer"

  -- Test 5: if/else expression
  src5 = "module Test.IfElse\nabs(n Int) = if n < 0\n  0 - n\nelse n\n"
  out5 = compile src5
  _ = checkContains "5 abs function" out5 "let rec abs"
  _ = checkContains "5 if expression" out5 "if"

  0
