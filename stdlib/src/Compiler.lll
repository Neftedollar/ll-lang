module Std.Compiler

import Std.Lexer
import Std.Parser
import Std.Elaborator
import Std.Codegen

-- End-to-end ll-lang compiler pipeline.
-- Lexer -> Parser -> Elaborator -> Codegen, all in ll-lang.
-- Usage: `lllc run stdlib/src/Compiler.lll`

-- ============================================================
-- PIPELINE
-- ============================================================

showErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

-- Compile ll-lang source to F# source (or an error report).
compile(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborate ast
  if listIsEmpty errors
    emitModule ast
  else
    showErrors errors

collectErrors(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elaborate ast

firstErrorMessage(errs List[ElabError]) =
  match errs
    | e :: _ -> errMsg e
    | [] -> ""

checkCompact(src Str) =
  errors = collectErrors src
  if listIsEmpty errors
    "{\"ok\":true,\"stage\":\"ok\",\"primary_error\":\"\",\"secondary_count\":0}"
  else
    msg = firstErrorMessage errors
    secondary = listLen errors - 1
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"primary_error\":\""
    p2 = strConcat p1 msg
    p3 = strConcat p2 "\",\"secondary_count\":"
    p4 = strConcat p3 (intToStr secondary)
    strConcat p4 "}"

renderCompact(src Str) =
  src

tokenEstimate(src Str) =
  toks = tokenize src
  n = listLen toks
  p1 = "{\"ok\":true,\"tokens\":"
  p2 = strConcat p1 (intToStr n)
  strConcat p2 "}"

nextBlocker(src Str) =
  errors = collectErrors src
  if listIsEmpty errors
    "{\"ok\":true,\"stage\":\"none\",\"message\":\"\"}"
  else
    msg = firstErrorMessage errors
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"message\":\""
    p2 = strConcat p1 msg
    strConcat p2 "\"}"

declKind(d Decl)(name Str) =
  match d
    | DFn n _ _ _ ->
      if n == name
        "fn"
      else ""
    | DType n _ _ ->
      if n == name
        "type"
      else ""
    | DLet n _ ->
      if n == name
        "let"
      else ""
    | DExternal n _ _ ->
      if n == name
        "external"
      else ""
    | DOpaque _ -> ""
    | DImport _ -> ""
    | DExport inner -> declKind inner name

findDeclKind(decls List[Decl])(name Str) =
  match decls
    | [] -> ""
    | d :: rest ->
      kind = declKind d name
      if strLen kind == 0
        findDeclKind rest name
      else kind

lookupSymbol(src Str)(name Str) =
  tokens = tokenize src
  ast = parseModule tokens
  match ast
    | MkModule _ decls ->
      kind = findDeclKind decls name
      if strLen kind == 0
        p1 = "{\"found\":false,\"name\":\""
        p2 = strConcat p1 name
        strConcat p2 "\"}"
      else
        p1 = "{\"found\":true,\"name\":\""
        p2 = strConcat p1 name
        p3 = strConcat p2 "\",\"kind\":\""
        p4 = strConcat p3 kind
        strConcat p4 "\"}"

-- ============================================================
-- TESTS
-- ============================================================

compilerCheckContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing:  " (strConcat needle (strConcat "\n  in output:\n" got)))))

checkHasError(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  expected error containing: " (strConcat needle (strConcat "\n  got: " got)))))
