module Std.Compiler

import Std.Lexer
import Std.Parser
import Std.Elaborator
import Std.Codegen
import Std.CompilerInfer

-- End-to-end ll-lang compiler pipeline.
-- Lexer -> Parser -> Elaborator -> HM Infer -> Codegen, all in ll-lang.
-- Usage: `lllc run stdlib/src/Compiler.lll`

-- ============================================================
-- PIPELINE
-- ============================================================

showErrors(errs List[ElabError]) =
  listFold (\acc e.
    msg = errMsg e
    if strLen acc == 0
      msg
    else strConcat acc (strConcat "\n" msg)
  ) "" errs

-- Compile ll-lang source to F# source (or an error report).
-- Compile ll-lang source to F# source (or an error report).
-- Pipeline: Lexer → Parser → Elaborator → Codegen.
-- (Use compileWithInfer for the full HM-inference pipeline.)
compile(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elabErrs = elaborate ast
  if listIsEmpty elabErrs
    emitModule ast
  else
    showErrors elabErrs

collectErrors(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elaborate ast

firstErrorMessage(errs List[ElabError]) =
  match errs
    | e :: _ -> errMsg e
    | [] -> ""

checkCompact(src Str) =
  errors = collectErrors src
  if listIsEmpty errors
    "{\"ok\":true,\"stage\":\"ok\",\"primary_error\":\"\",\"secondary_count\":0}"
  else
    msg = firstErrorMessage errors
    secondary = listLen errors - 1
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"primary_error\":\""
    p2 = strConcat p1 msg
    p3 = strConcat p2 "\",\"secondary_count\":"
    p4 = strConcat p3 (intToStr secondary)
    strConcat p4 "}"

checkCompactWithVisible(src Str)(visibleNames List[Str]) =
  tokens = tokenize src
  ast = parseModule tokens
  errors = elaborateWithNames visibleNames ast
  if listIsEmpty errors
    "{\"ok\":true,\"stage\":\"ok\",\"primary_error\":\"\",\"secondary_count\":0}"
  else
    msg = firstErrorMessage errors
    secondary = listLen errors - 1
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"primary_error\":\""
    p2 = strConcat p1 msg
    p3 = strConcat p2 "\",\"secondary_count\":"
    p4 = strConcat p3 (intToStr secondary)
    strConcat p4 "}"

renderCompact(src Str) =
  src

tokenEstimate(src Str) =
  toks = tokenize src
  n = listLen toks
  p1 = "{\"ok\":true,\"tokens\":"
  p2 = strConcat p1 (intToStr n)
  strConcat p2 "}"

nextBlocker(src Str) =
  errors = collectErrors src
  if listIsEmpty errors
    "{\"ok\":true,\"stage\":\"none\",\"message\":\"\"}"
  else
    msg = firstErrorMessage errors
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"message\":\""
    p2 = strConcat p1 msg
    strConcat p2 "\"}"

declKind(d Decl)(name Str) =
  match d
    | DFn n _ _ _ ->
      if n == name
        "fn"
      else ""
    | DType n _ _ ->
      if n == name
        "type"
      else ""
    | DLet n _ ->
      if n == name
        "let"
      else ""
    | DExternal n _ _ ->
      if n == name
        "external"
      else ""
    | DOpaque _ -> ""
    | DImport _ -> ""
    | DImportUrl _ -> ""
    | DFixity _ _ _ -> ""
    | DExport inner -> declKind inner name

declVisibleNames(d Decl) =
  match d
    | DFn n _ _ _ -> [n]
    | DLet n _ -> [n]
    | DType _ _ ctors ->
      listMap (\ctor.
        match ctor
          | MkCon name _ -> name
      ) ctors
    | DImport _ -> []
    | DImportUrl _ -> []
    | DFixity _ _ _ -> []
    | DExport inner -> declVisibleNames inner
    | DExternal n _ _ -> [n]
    | DOpaque _ -> []

collectVisibleNames(decls List[Decl]) =
  listFold (\acc d. listAppend acc (declVisibleNames d)) [] decls

findDeclKind(decls List[Decl])(name Str) =
  match decls
    | [] -> ""
    | d :: rest ->
      kind = declKind d name
      if strLen kind == 0
        findDeclKind rest name
      else kind

lookupSymbol(src Str)(name Str) =
  tokens = tokenize src
  ast = parseModule tokens
  match ast
    | MkModule _ _ decls ->
      kind = findDeclKind decls name
      if strLen kind == 0
        p1 = "{\"found\":false,\"name\":\""
        p2 = strConcat p1 name
        strConcat p2 "\"}"
      else
        p1 = "{\"found\":true,\"name\":\""
        p2 = strConcat p1 name
        p3 = strConcat p2 "\",\"kind\":\""
        p4 = strConcat p3 kind
        strConcat p4 "\"}"

FixityOrigin = MkFixityOrigin Str FixityAssoc Int Str
-- op, assoc, precedence, source module path

foOp(fx FixityOrigin) =
  match fx
    | MkFixityOrigin op _ _ _ -> op

foAssoc(fx FixityOrigin) =
  match fx
    | MkFixityOrigin _ assoc _ _ -> assoc

foPrec(fx FixityOrigin) =
  match fx
    | MkFixityOrigin _ _ prec _ -> prec

foSrc(fx FixityOrigin) =
  match fx
    | MkFixityOrigin _ _ _ src -> src

assocEq(a FixityAssoc)(b FixityAssoc) =
  match a
    | FixityNone -> b == FixityNone
    | FixityLeft -> b == FixityLeft
    | FixityRight -> b == FixityRight
    | FixityInvalid -> b == FixityInvalid

assocName(a FixityAssoc) =
  match a
    | FixityNone -> "none"
    | FixityLeft -> "left"
    | FixityRight -> "right"
    | FixityInvalid -> "invalid"

compareCharLists(a List[Char])(b List[Char]) =
  match a
    | [] ->
      match b
        | [] -> 0
        | _ :: _ -> -1
    | ca :: restA ->
      match b
        | [] -> 1
        | cb :: restB ->
          ia = charToInt ca
          ib = charToInt cb
          if ia < ib
            -1
          else if ia > ib
            1
          else
            compareCharLists restA restB

compareStr(a Str)(b Str) =
  compareCharLists (strChars a) (strChars b)

fixityOriginLe(a FixityOrigin)(b FixityOrigin) =
  srcCmp = compareStr (foSrc a) (foSrc b)
  if srcCmp < 0
    true
  else if srcCmp > 0
    false
  else
    precA = foPrec a
    precB = foPrec b
    if precA < precB
      true
    else if precA > precB
      false
    else
      assocCmp = compareStr (assocName (foAssoc a)) (assocName (foAssoc b))
      if assocCmp < 0
        true
      else if assocCmp > 0
        false
      else
        opCmp = compareStr (foOp a) (foOp b)
        opCmp <= 0

joinPathSegments(parts List[Str]) =
  match parts
    | [] -> ""
    | p :: [] -> p
    | p :: rest -> strConcat p (strConcat "." (joinPathSegments rest))

moduleNameForFixity(path List[Str]) =
  nm = joinPathSegments path
  if strLen nm == 0
    "<anonymous>"
  else
    nm

fixityOriginsFromSource(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  match ast
    | MkModule path fixities _ ->
      srcName = moduleNameForFixity path
      listMap (\fx.
        match fx
          | MkFixity assoc prec op -> MkFixityOrigin op assoc prec srcName
      ) fixities

fixityConflictMessage(a FixityOrigin)(b FixityOrigin) =
  left =
    if fixityOriginLe a b
      a
    else
      b
  right =
    if fixityOriginLe a b
      b
    else
      a
  op = foOp left
  sa = foSrc left
  sb = foSrc right
  aa = assocName (foAssoc left)
  ab = assocName (foAssoc right)
  pa = intToStr (foPrec left)
  pb = intToStr (foPrec right)
  p1 = "E031 FixityConflict op:"
  p2 = strConcat p1 op
  p3 = strConcat p2 " sources:"
  p4 = strConcat p3 sa
  p5 = strConcat p4 "("
  p6 = strConcat p5 aa
  p7 = strConcat p6 ","
  p8 = strConcat p7 pa
  p9 = strConcat p8 ") vs "
  p10 = strConcat p9 sb
  p11 = strConcat p10 "("
  p12 = strConcat p11 ab
  p13 = strConcat p12 ","
  p14 = strConcat p13 pb
  strConcat p14 ")"

fixityConflictsWithSeen(fx FixityOrigin)(seen List[FixityOrigin]) =
  match seen
    | [] -> []
    | s :: rest ->
      tail = fixityConflictsWithSeen fx rest
      if foOp fx == foOp s
        sameAssoc = assocEq (foAssoc fx) (foAssoc s)
        samePrec = foPrec fx == foPrec s
        if sameAssoc
          if samePrec
            tail
          else
            fixityConflictMessage s fx :: tail
        else
          fixityConflictMessage s fx :: tail
      else
        tail

collectFixityConflictsAcc(origins List[FixityOrigin])(seen List[FixityOrigin])(errs List[Str]) =
  match origins
    | [] -> errs
    | fx :: rest ->
      curErrs = fixityConflictsWithSeen fx seen
      collectFixityConflictsAcc rest (fx :: seen) (listAppend errs curErrs)

collectFixityConflicts(origins List[FixityOrigin]) =
  collectFixityConflictsAcc origins [] []

checkProjectFixityConflicts(srcs List[Str]) =
  origins = listConcat (listMap fixityOriginsFromSource srcs)
  collectFixityConflicts origins

-- ---- Multi-file type-checking ----------------------------------------
-- Compile a list of source texts in dependency order (caller must topo-sort).
-- Threads the type environment across files so later files see earlier types.
-- Returns: (all-type-errors, final-env).
-- Elaboration errors are immediately fatal per file (returns that file's errors).

compileFiles(srcs List[Str])(visibleNames List[Str])(env RBMap[Str][Scheme]) =
  match srcs
    | [] -> ([], env)
    | src :: rest ->
      tokens = tokenize src
      ast = parseModule tokens
      elabErrs = elaborateWithNames visibleNames ast
      if listIsEmpty elabErrs
        match ast
          | MkModule _ _ decls ->
            visible2 = listAppend visibleNames (collectVisibleNames decls)
            let (typeErrs, env2) = inferModuleStep env decls
            if listIsEmpty typeErrs
              compileFiles rest visible2 env2
            else
              (typeErrs, env2)
      else
        (listMap errMsg elabErrs, env)

-- Entry: compile ordered source texts starting from the base env.
compileProject(srcs List[Str]) =
  conflictErrs = checkProjectFixityConflicts srcs
  if listIsEmpty conflictErrs
    let (errs, _) = compileFiles srcs [] (baseEnv ())
    errs
  else
    conflictErrs

-- ---- Multi-file elaboration-only check ------------------------------------
-- Same visibility threading as compileFiles, but without HM inference.

elaborateFiles(srcs List[Str])(visibleNames List[Str]) =
  match srcs
    | [] -> []
    | src :: rest ->
      tokens = tokenize src
      ast = parseModule tokens
      elabErrs = elaborateWithNames visibleNames ast
      if listIsEmpty elabErrs
        match ast
          | MkModule _ _ decls ->
            visible2 = listAppend visibleNames (collectVisibleNames decls)
            elaborateFiles rest visible2
      else
        listMap errMsg elabErrs

checkProjectElab(srcs List[Str]) =
  conflictErrs = checkProjectFixityConflicts srcs
  if listIsEmpty conflictErrs
    elaborateFiles srcs []
  else
    conflictErrs

-- ---- Inference-aware pipeline ----------------------------------------

showTypeErrors(errs List[Str]) =
  listFold (\acc e.
    if strLen acc == 0
      e
    else strConcat acc (strConcat "\n" e)
  ) "" errs

-- Compile with full pipeline: Lexer → Parser → Elaborator → HM Infer → Codegen.
compileWithInfer(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elabErrs = elaborate ast
  if listIsEmpty elabErrs
    match ast
      | MkModule _ _ decls ->
        typeErrs = inferModule decls
        if listIsEmpty typeErrs
          emitModule ast
        else
          showTypeErrors typeErrs
  else
    showErrors elabErrs

-- Collect all diagnostics (elaboration + type inference).
collectAllErrors(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elabErrs = elaborate ast
  if listIsEmpty elabErrs
    match ast
      | MkModule _ _ decls -> inferModule decls
  else
    listMap errMsg elabErrs

-- Check with full pipeline; JSON compact output including inference stage.
nextBlockerFull(src Str) =
  tokens = tokenize src
  ast = parseModule tokens
  elabErrs = elaborate ast
  if listIsEmpty elabErrs
    match ast
      | MkModule _ _ decls ->
        typeErrs = inferModule decls
        if listIsEmpty typeErrs
          "{\"ok\":true,\"stage\":\"none\",\"message\":\"\"}"
        else
          msg = match typeErrs | e :: _ -> e | [] -> ""
          p1 = "{\"ok\":false,\"stage\":\"inference\",\"message\":\""
          strConcat p1 (strConcat msg "\"}")
  else
    msg = firstErrorMessage elabErrs
    p1 = "{\"ok\":false,\"stage\":\"elaborator\",\"message\":\""
    strConcat p1 (strConcat msg "\"}")

-- ============================================================
-- TESTS
-- ============================================================

compilerCheckContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing:  " (strConcat needle (strConcat "\n  in output:\n" got)))))

checkHasError(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  expected error containing: " (strConcat needle (strConcat "\n  got: " got)))))

compilerCheck(label Str)(got Str)(expected Str) =
  if got == expected
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat " expected=" (strConcat expected (strConcat " got=" got)))))

main =
  -- 1. compile a trivial function, check F# output has let keyword
  src1 = "module Test\nadd(a Int)(b Int) = a + b\n"
  _ = compilerCheckContains "1 compile basic fn" (compile src1) "add"

  -- 2. compile with type error triggers elab error on undeclared name
  src2 = "module Test\nfoo = undeclaredName\n"
  _ = checkHasError "2 elab error undeclared" (compile src2) "undeclared"

  -- 3. collectAllErrors on valid source returns empty
  errs3 = collectAllErrors src1
  _ = compilerCheck "3 no errors on valid" (intToStr (listLen errs3)) "0"

  -- 4. compileWithInfer on valid source produces F# output
  _ = compilerCheckContains "4 compileWithInfer basic" (compileWithInfer src1) "add"

  -- 5. nextBlockerFull on valid source → ok
  nb5 = nextBlockerFull src1
  _ = compilerCheckContains "5 nextBlockerFull ok" nb5 "\"ok\":true"

  -- 6. nextBlockerFull on undeclared name → elaborator stage
  nb6 = nextBlockerFull src2
  _ = compilerCheckContains "6 nextBlockerFull elab" nb6 "\"stage\":\"elaborator\""

  -- 7. lookupSymbol finds function
  sym7 = lookupSymbol src1 "add"
  _ = compilerCheckContains "7 lookupSymbol found" sym7 "\"found\":true"

  -- 8. lookupSymbol unknown → not found
  sym8 = lookupSymbol src1 "unknown"
  _ = compilerCheckContains "8 lookupSymbol not found" sym8 "\"found\":false"

  -- 9. tokenEstimate > 0 tokens
  te9 = tokenEstimate src1
  _ = compilerCheckContains "9 tokenEstimate ok" te9 "\"ok\":true"

  -- 10. compileProject with two valid modules, no errors
  srcA = "module A\nfoo(x Int) = x\n"
  srcB = "module B\nbar(x Int) = x\n"
  proj10 = compileProject [srcA; srcB]
  _ = compilerCheck "10 compileProject no errs" (intToStr (listLen proj10)) "0"

  -- 11. compileProject with an unbound name, returns type errors
  srcBad = "module Bad\nresult = badFn 1\n"
  proj11 = compileProject [srcBad]
  proj11status = match proj11 | [] -> "none" | _ :: _ -> "err"
  _ = compilerCheck "11 compileProject unbound err" proj11status "err"

  printfn "Done"
