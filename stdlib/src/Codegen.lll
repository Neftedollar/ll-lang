module Std.Codegen

import Std.Parser

-- F# code emitter written in ll-lang.
-- Takes the AST produced by Std.Parser and emits F# source code.

-- ---- String helpers --------------------------------------------------------

joinWith(sep Str)(items List[Str]) =
  match items
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

-- ---- F# keyword escaping ---------------------------------------------------

isFsKeyword(s Str) =
  match s
    | "abstract" -> true
    | "and"      -> true
    | "as"       -> true
    | "assert"   -> true
    | "base"     -> true
    | "begin"    -> true
    | "class"    -> true
    | "default"  -> true
    | "delegate" -> true
    | "do"       -> true
    | "done"     -> true
    | "downcast" -> true
    | "downto"   -> true
    | "elif"     -> true
    | "else"     -> true
    | "end"      -> true
    | "exception" -> true
    | "extern"   -> true
    | "false"    -> true
    | "finally"  -> true
    | "for"      -> true
    | "fun"      -> true
    | "function" -> true
    | "global"   -> true
    | "if"       -> true
    | "in"       -> true
    | "inherit"  -> true
    | "inline"   -> true
    | "interface" -> true
    | "internal" -> true
    | "let"      -> true
    | "match"    -> true
    | "member"   -> true
    | "mod"      -> true
    | "module"   -> true
    | "mutable"  -> true
    | "namespace" -> true
    | "new"      -> true
    | "not"      -> true
    | "null"     -> true
    | "of"       -> true
    | "open"     -> true
    | "or"       -> true
    | "override" -> true
    | "private"  -> true
    | "public"   -> true
    | "rec"      -> true
    | "return"   -> true
    | "static"   -> true
    | "struct"   -> true
    | "then"     -> true
    | "to"       -> true
    | "true"     -> true
    | "try"      -> true
    | "type"     -> true
    | "upcast"   -> true
    | "use"      -> true
    | "val"      -> true
    | "void"     -> true
    | "when"     -> true
    | "while"    -> true
    | "with"     -> true
    | "yield"    -> true
    | "params"   -> true
    | "object"   -> true
    | "trait"    -> true
    | _          -> false

safeIdent(s Str) =
  if isFsKeyword s
    strConcat "__ll_" s
  else s

-- ---- String escaping -------------------------------------------------------

encodeStrEscape(c Char) =
  match c
    | '\n' -> "\\n"
    | '\t' -> "\\t"
    | '\r' -> "\\r"
    | '\\' -> "\\\\"
    | '"'  -> "\\\""
    | _    -> strFromChars [c]

escapeStr(s Str) =
  listFold (\acc c. strConcat acc (encodeStrEscape c)) "" (strChars s)

-- ---- Operator mapping ------------------------------------------------------

mapOp(op Str) =
  if op == "=="
    "="
  else if op == "!="
    "<>"
  else op

-- ---- Type emission ---------------------------------------------------------

isTypeParam(s Str) =
  match strChars s
    | c :: [] ->
      n = charToInt c
      if n >= 65
        if n <= 90
          true
        else false
      else false
    | _ -> false

emitType(t TypeExpr) =
  match t
    | TyName "Int" -> "int64"
    | TyName "Str" -> "string"
    | TyName "Bool" -> "bool"
    | TyName "Char" -> "char"
    | TyName "Float" -> "float"
    | TyName "Unit" -> "unit"
    | TyName n ->
      if isTypeParam n
        strConcat "'" n
      else n
    | TyApp (TyName "List") a -> strConcat (emitType a) " list"
    | TyApp f a ->
      head = collectTyAppHead (TyApp f a)
      args = collectTyAppArgs (TyApp f a)
      match args
        | _ :: [] -> strConcat (emitType a) (strConcat " " (emitType head))
        | _ ->
          inner = joinWith ", " (listMap emitType args)
          strConcat (emitType head) (strConcat "<" (strConcat inner ">"))
    | TyFn a b -> strConcat (emitType a) (strConcat " -> " (emitType b))

collectTyAppHead(t TypeExpr) =
  match t
    | TyApp f _ -> collectTyAppHead f
    | _ -> t

collectTyAppArgs(t TypeExpr) =
  match t
    | TyApp f a -> listAppend (collectTyAppArgs f) [a]
    | _ -> []

-- ---- Pattern emission ------------------------------------------------------

emitPattern(p Pattern) =
  match p
    | PVar x -> safeIdent x
    | PWild -> "_"
    | PNil -> "[]"
    | PLitInt n -> strConcat (intToStr n) "L"
    | PLitStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | PCons h t ->
      strConcat "(" (strConcat (emitPattern h) (strConcat " :: " (strConcat (emitPattern t) ")")))
    | PCon c args -> emitConPattern c args

emitConPattern(c Str)(args List[Pattern]) =
  match args
    | [] -> c
    | _ :: [] ->
      inner = emitPattern (patListHead args)
      strConcat c (strConcat "(" (strConcat inner ")"))
    | _ ->
      inner = joinWith ", " (listMap emitPattern args)
      strConcat c (strConcat "(" (strConcat inner ")"))

patListHead(xs List[Pattern]) =
  match xs
    | x :: _ -> x
    | _ -> PWild

-- ---- Expression emission ---------------------------------------------------

emitCharLit(c Char) =
  if c == '\n'
    "'\\n'"
  else if c == '\t'
    "'\\t'"
  else if c == '\\'
    "'\\\\'"
  else if c == '\''
    "'\\''"
  else strConcat (strConcat "'" (strFromChars [c])) "'"

emitExpr(e Expr) =
  match e
    | EInt n -> strConcat (intToStr n) "L"
    | EStr s -> strConcat "\"" (strConcat (escapeStr s) "\"")
    | EBool b ->
      if b
        "true"
      else "false"
    | EChar c -> emitCharLit c
    | EFloat s -> s
    | EVar x -> safeIdent x
    | ECon c -> c
    | ENil -> "[]"
    | EApp f a -> emitApp f a
    | EIf c t el ->
      strConcat "(if " (strConcat (emitExpr c) (strConcat " then " (strConcat (emitExpr t) (strConcat " else " (strConcat (emitExpr el) ")")))))
    | EMatch scrut pats bodies ->
      arms = emitArms pats bodies
      strConcat "(match " (strConcat (emitExpr scrut) (strConcat " with " (strConcat arms ")")))
    | ELam x body ->
      strConcat "(fun " (strConcat (safeIdent x) (strConcat " -> " (strConcat (emitExpr body) ")")))
    | ELet x e body ->
      strConcat "(let " (strConcat (safeIdent x) (strConcat " = " (strConcat (emitExpr e) (strConcat " in " (strConcat (emitExpr body) ")")))))
    | EList items ->
      strConcat "[" (strConcat (joinWith "; " (listMap emitExpr items)) "]")
    | EBinOp op l r ->
      strConcat "(" (strConcat (emitExpr l) (strConcat " " (strConcat (mapOp op) (strConcat " " (strConcat (emitExpr r) ")")))))
    | ETuple a b ->
      strConcat "(" (strConcat (emitExpr a) (strConcat ", " (strConcat (emitExpr b) ")")))
    | ECons h t ->
      strConcat "(" (strConcat (emitExpr h) (strConcat " :: " (strConcat (emitExpr t) ")")))

-- Gather EApp head
gatherAppHead(e Expr) =
  match e
    | EApp f _ -> gatherAppHead f
    | _ -> e

-- Gather EApp args (left to right)
gatherAppArgs(e Expr) =
  match e
    | EApp f a -> listAppend (gatherAppArgs f) [a]
    | _ -> []

isUpperStart(s Str) =
  match strChars s
    | c :: _ ->
      n = charToInt c
      if n >= 65
        if n <= 90
          true
        else false
      else false
    | _ -> false

emitApp(f Expr)(a Expr) =
  head = gatherAppHead (EApp f a)
  args = gatherAppArgs (EApp f a)
  match head
    | ECon c -> emitConApp c args
    | EVar x ->
      if isUpperStart x
        emitConApp x args
      else
        strConcat "(" (strConcat (emitExpr f) (strConcat " " (strConcat (emitExpr a) ")")))
    | _ ->
      strConcat "(" (strConcat (emitExpr f) (strConcat " " (strConcat (emitExpr a) ")")))

exprListHead(xs List[Expr]) =
  match xs
    | x :: _ -> x
    | _ -> ENil

emitConApp(c Str)(args List[Expr]) =
  match args
    | [] -> c
    | _ :: [] ->
      strConcat "(" (strConcat c (strConcat " " (strConcat (emitExpr (exprListHead args)) ")")))
    | _ ->
      inner = joinWith ", " (listMap emitExpr args)
      strConcat "(" (strConcat c (strConcat " (" (strConcat inner "))")))

emitArms(pats List[Pattern])(bodies List[Expr]) =
  match pats
    | p :: prest ->
      match bodies
        | b :: brest ->
          arm = strConcat "| " (strConcat (emitPattern p) (strConcat " -> " (emitExpr b)))
          rest = emitArms prest brest
          if strLen rest == 0
            arm
          else strConcat arm (strConcat " " rest)
        | _ -> ""
    | _ -> ""

-- ---- Declaration emission --------------------------------------------------

emitTypeParam(s Str) = strConcat "'" s

emitTypeParams(tvars List[Str]) =
  match tvars
    | [] -> ""
    | _ ->
      inner = joinWith ", " (listMap emitTypeParam tvars)
      strConcat "<" (strConcat inner ">")

emitCtorArgs(args List[TypeExpr]) =
  joinWith " * " (listMap emitType args)

emitCtor(c Constructor) =
  match c
    | MkCon name args ->
      match args
        | [] -> strConcat "    | " name
        | _ -> strConcat "    | " (strConcat name (strConcat " of " (emitCtorArgs args)))

emitCtors(cs List[Constructor]) =
  joinWith "\n" (listMap emitCtor cs)

emitParamName(p Param) =
  match p
    | MkParam n _ -> safeIdent n

emitParamStr(ps List[Param]) =
  match ps
    | [] -> ""
    | _ -> strConcat " " (joinWith " " (listMap emitParamName ps))

-- ---- Recursion detection ---------------------------------------------------

containsVarExprs(name Str)(exprs List[Expr]) =
  match exprs
    | [] -> false
    | e :: rest ->
      if containsVarExpr name e
        true
      else containsVarExprs name rest

containsVarExpr(name Str)(expr Expr) =
  match expr
    | EVar n -> n == name
    | EApp f arg ->
      if containsVarExpr name f
        true
      else containsVarExpr name arg
    | EBinOp _ l r ->
      if containsVarExpr name l
        true
      else containsVarExpr name r
    | ETuple l r ->
      if containsVarExpr name l
        true
      else containsVarExpr name r
    | ECons h t ->
      if containsVarExpr name h
        true
      else containsVarExpr name t
    | ELam _ body -> containsVarExpr name body
    | ELet _ v body ->
      if containsVarExpr name v
        true
      else containsVarExpr name body
    | EIf c t f ->
      if containsVarExpr name c
        true
      else if containsVarExpr name t
        true
      else containsVarExpr name f
    | EList es -> containsVarExprs name es
    | EMatch e _ bods ->
      if containsVarExpr name e
        true
      else containsVarExprs name bods
    | _ -> false

-- Check for canonical ll-lang Maybe: Maybe A = Some A | None (or None | Some A).
-- When matched, emit as F# option alias to avoid Some/None divergence.
isMaybeAlias(name Str)(tvars List[Str])(ctors List[Constructor]) =
  if name == "Maybe"
    match tvars
      | _ :: [] ->
        match ctors
          | MkCon n1 a1 :: MkCon n2 a2 :: [] ->
            if n1 == "Some"
              if n2 == "None"
                if listIsEmpty a2
                  match a1
                    | _ :: [] -> true
                    | _ -> false
                else false
              else false
            else if n1 == "None"
              if n2 == "Some"
                if listIsEmpty a1
                  match a2
                    | _ :: [] -> true
                    | _ -> false
                else false
              else false
            else false
          | _ -> false
      | _ -> false
  else false

getMaybeArgTypeFromCtors(ctors List[Constructor]) =
  match ctors
    | MkCon n1 a1 :: MkCon _ a2 :: [] ->
      if n1 == "Some"
        match a1
          | t :: _ -> t
          | _ -> TyName "A"
      else
        match a2
          | t :: _ -> t
          | _ -> TyName "A"
    | _ -> TyName "A"

emitDecl(d Decl) =
  match d
    | DType name tvars ctors ->
      if isMaybeAlias name tvars ctors
        p = match tvars | s :: _ -> s | _ -> "A"
        argTy = getMaybeArgTypeFromCtors ctors
        strConcat "type Maybe<'" (strConcat p (strConcat "> = " (strConcat (emitType argTy) " option")))
      else
        header = strConcat "type " (strConcat name (emitTypeParams tvars))
        body = emitCtors ctors
        strConcat header (strConcat " =\n" body)
    | DFn name params _ body ->
      paramStr = emitParamStr params
      isMain = if name == "main"
        listIsEmpty params
      else false
      if isMain
        strConcat "[<EntryPoint>]\nlet main (argv: string[]) =\n    " (strConcat (emitExpr body) "\n    0")
      else
        kw = if containsVarExpr name body
          "let rec "
        else "let "
        strConcat kw (strConcat (safeIdent name) (strConcat paramStr (strConcat " =\n    " (emitExpr body))))
    | DLet name body ->
      strConcat "let " (strConcat (safeIdent name) (strConcat " = " (emitExpr body)))
    | DImport parts ->
      strConcat "// import " (joinWith "." parts)
    | DExport inner -> emitDecl inner
    | DExternal name params retTy ->
      -- external declarations: emit as F# function stubs referencing native impl
      paramStr = emitParamStr params
      strConcat "let " (strConcat (safeIdent name) (strConcat paramStr (strConcat " = failwith \"external: " (strConcat name "\""))))
    | DOpaque name ->
      -- opaque types: emit as F# object alias
      strConcat "type " (strConcat name " = obj")

emitDecls(ds List[Decl]) =
  joinWith "\n\n" (listMap emitDecl ds)

-- ---- Declaration classification --------------------------------------------

isDTypeDecl(d Decl) =
  match d
    | DType _ _ _ -> true
    | DOpaque _ -> true
    | _ -> false

isEmittable(d Decl) =
  match d
    | DImport _ -> false
    | _ -> true

isOtherDecl(d Decl) =
  if isEmittable d
    if isDTypeDecl d
      false
    else true
  else false

hasDeclWithName(name Str)(decls List[Decl]) =
  match decls
    | [] -> false
    | DType n _ _ :: rest ->
      if n == name
        true
      else hasDeclWithName name rest
    | _ :: rest -> hasDeclWithName name rest

-- ---- Prelude ---------------------------------------------------------------
-- Exact match of stage0 fsharpPreludeCore / fsharpPreludeMaybe / fsharpPreludeResult.

preludeCore =
  "// --- ll-lang stdlib prelude (auto-generated) ---\nlet abs (x: int64) = System.Math.Abs(x)\nlet absf (x: float) = System.Math.Abs(x)\nlet sqrt (x: float) = System.Math.Sqrt(x)\nlet min (a: int64) (b: int64) = if a < b then a else b\nlet max (a: int64) (b: int64) = if a > b then a else b\nlet listLen (xs: 'a list) : int64 = int64 (List.length xs)\nlet listMap f xs = List.map f xs\nlet listFilter p xs = List.filter p xs\nlet listFold f z xs = List.fold f z xs\nlet listReverse xs = List.rev xs\nlet listAppend xs ys = List.append xs ys\nlet strLen (s: string) : int64 = int64 s.Length\nlet strConcat (a: string) (b: string) = a + b\nlet strTrim (s: string) = s.Trim()\nlet strContains (needle: string) (haystack: string) = haystack.Contains(needle: string)\nlet print (s: string) = System.Console.Write(s)\nlet printfn (s: string) = System.Console.WriteLine(s)\nlet strChars (s: string) = s |> Seq.toList\nlet charToInt (c: char) = int64 (int c)\nlet intToChar (n: int64) = char (int n)\nlet intToStr (n: int64) = string n\nlet floatToStr (f: float) = f.ToString(System.Globalization.CultureInfo.InvariantCulture)\nlet strSlice (s: string) (start: int64) (len: int64) = s.Substring(int start, int len)\nlet strIndexOf (needle: string) (haystack: string) : int64 = int64 (haystack.IndexOf(needle: string))\nlet strSplit (sep: string) (s: string) = s.Split([| sep |], System.StringSplitOptions.None) |> Array.toList\nlet strFromChars (cs: char list) = System.String(cs |> List.toArray)\nlet strReverse (s: string) = System.String(s.ToCharArray() |> Array.rev)\nlet charIsDigit (c: char) = System.Char.IsDigit(c)\nlet charIsAlpha (c: char) = System.Char.IsLetter(c)\nlet charIsSpace (c: char) = System.Char.IsWhiteSpace(c)\nlet readFile (path: string) = System.IO.File.ReadAllText(path: string)\nlet writeFile (path: string) (contents: string) = System.IO.File.WriteAllText(path, contents)\nlet fileExists (path: string) = System.IO.File.Exists(path: string)\nlet dirList (path: string) : string list = if System.IO.Directory.Exists(path) then System.IO.Directory.GetFiles(path, \"*\", System.IO.SearchOption.AllDirectories) |> Array.toList else []\nlet exit (code: int64) : unit = System.Environment.Exit(int code)\nlet listConcat (xss: 'a list list) = List.concat xss\nlet listIsEmpty (xs: 'a list) = List.isEmpty xs\nlet getArgs : string list = System.Environment.GetCommandLineArgs() |> Array.toList |> List.tail\nlet processSpawn (cmd: string) (args: string list) : int64 =\n    let psi = System.Diagnostics.ProcessStartInfo(cmd)\n    psi.UseShellExecute <- false\n    args |> List.iter (fun a -> psi.ArgumentList.Add(a))\n    let p = System.Diagnostics.Process.Start(psi) in p.WaitForExit(); int64 p.ExitCode"

preludeMaybe =
  "let listHead xs = match xs with [] -> None | x :: _ -> Some x\nlet listTail xs = match xs with [] -> None | _ :: t -> Some t\nlet maybeMap f m = match m with Some x -> Some (f x) | None -> None\nlet maybeBind m f = match m with Some x -> f x | None -> None\nlet maybeWithDefault d m = match m with Some x -> x | None -> d\nlet strToInt (s: string) =\n    match System.Int64.TryParse(s: string) with\n    | true, n -> Some n\n    | false, _ -> None\nlet strToFloat (s: string) =\n    match System.Double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture) with\n    | true, n -> Some n\n    | false, _ -> None\nlet listAt (xs: 'a list) (i: int64) =\n    if int i < 0 || int i >= List.length xs then None else Some (List.item (int i) xs)"

preludeResult =
  "let resultMap f r = match r with Ok x -> Ok (f x) | Err e -> Err e\nlet resultBind r f = match r with Ok x -> f x | Err e -> Err e\nlet resultMapErr f r = match r with Ok x -> Ok x | Err e -> Err (f e)"

preludeEndMark =
  "// --- end prelude ---"

-- ---- Prelude usage detection -----------------------------------------------
-- Mirror stage0: only emit a prelude section when the module actually references
-- at least one name from that section. Walk Expr trees to collect EVar names.

isPreludeCoreName(n Str) =
  match n
    | "abs" -> true | "absf" -> true | "sqrt" -> true | "min" -> true | "max" -> true
    | "listLen" -> true | "listMap" -> true | "listFilter" -> true | "listFold" -> true
    | "listReverse" -> true | "listAppend" -> true
    | "strLen" -> true | "strConcat" -> true | "strTrim" -> true | "strContains" -> true
    | "print" -> true | "printfn" -> true
    | "strChars" -> true | "charToInt" -> true | "intToChar" -> true
    | "intToStr" -> true | "floatToStr" -> true
    | "strSlice" -> true | "strIndexOf" -> true | "strSplit" -> true
    | "strFromChars" -> true | "strReverse" -> true
    | "charIsDigit" -> true | "charIsAlpha" -> true | "charIsSpace" -> true
    | "readFile" -> true | "writeFile" -> true | "fileExists" -> true
    | "dirList" -> true | "exit" -> true
    | "listConcat" -> true | "listIsEmpty" -> true | "getArgs" -> true
    | "processSpawn" -> true
    | _ -> false

isPreludeMaybeName(n Str) =
  match n
    | "listHead" -> true | "listTail" -> true
    | "maybeMap" -> true | "maybeBind" -> true | "maybeWithDefault" -> true
    | "strToInt" -> true | "strToFloat" -> true | "listAt" -> true
    | _ -> false

isPreludeResultName(n Str) =
  match n
    | "resultMap" -> true | "resultBind" -> true | "resultMapErr" -> true
    | _ -> false

-- Walk an expression list, collecting whether any satisfies pred.
exprListAny(pred Expr -> Bool)(es List[Expr]) =
  match es
    | [] -> false
    | e :: rest ->
      if pred e
        true
      else exprListAny pred rest

-- Walk an expression tree looking for any EVar satisfying `isName`.
exprUsesName(isName Str -> Bool)(e Expr) =
  match e
    | EVar n -> isName n
    | EApp f a ->
      if exprUsesName isName f
        true
      else exprUsesName isName a
    | EBinOp _ l r ->
      if exprUsesName isName l
        true
      else exprUsesName isName r
    | ELam _ body -> exprUsesName isName body
    | ELet _ v body ->
      if exprUsesName isName v
        true
      else exprUsesName isName body
    | EIf c t f ->
      if exprUsesName isName c
        true
      else if exprUsesName isName t
        true
      else exprUsesName isName f
    | EList es -> exprListAny (exprUsesName isName) es
    | EMatch s _ bods ->
      if exprUsesName isName s
        true
      else exprListAny (exprUsesName isName) bods
    | ETuple a b ->
      if exprUsesName isName a
        true
      else exprUsesName isName b
    | ECons h t ->
      if exprUsesName isName h
        true
      else exprUsesName isName t
    | _ -> false

declUsesName(isName Str -> Bool)(d Decl) =
  match d
    | DFn _ _ _ body -> exprUsesName isName body
    | DLet _ body -> exprUsesName isName body
    | DExport inner -> declUsesName isName inner
    | _ -> false

declsUseName(isName Str -> Bool)(decls List[Decl]) =
  match decls
    | [] -> false
    | d :: rest ->
      if declUsesName isName d
        true
      else declsUseName isName rest

assemblePrelude(decls List[Decl]) =
  hasMaybe = hasDeclWithName "Maybe" decls
  hasResult = hasDeclWithName "Result" decls
  includeCore = declsUseName isPreludeCoreName decls
  includeMaybe = if hasMaybe
    declsUseName isPreludeMaybeName decls
  else false
  includeResult = if hasResult
    declsUseName isPreludeResultName decls
  else false
  if includeCore
    maybePart = if includeMaybe
      strConcat "\n" preludeMaybe
    else ""
    resultPart = if includeResult
      strConcat "\n" preludeResult
    else ""
    strConcat preludeCore (strConcat maybePart (strConcat resultPart (strConcat "\n" preludeEndMark)))
  else ""

-- ---- Module emission -------------------------------------------------------

emitModulePath(parts List[Str]) =
  joinWith "." parts

emitModule(m Module) =
  match m
    | MkModule path decls ->
      header = strConcat "module " (emitModulePath path)
      typeDecls = listFilter isDTypeDecl decls
      otherDecls = listFilter isOtherDecl decls
      typeStr = emitDecls typeDecls
      prelude = assemblePrelude decls
      otherStr = emitDecls otherDecls
      parts = listFilter (\s. strLen s > 0) [header; typeStr; prelude; otherStr]
      joinWith "\n\n" parts

-- ---- Tests -----------------------------------------------------------------

codegenCheck(label Str)(got Str)(expected Str) =
  if got == expected
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  got:      " (strConcat got (strConcat "\n  expected: " expected)))))

checkContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing: " (strConcat needle (strConcat "\n  in: " got)))))

main =
  -- 1. EInt
  _ = codegenCheck "1 EInt 42" (emitExpr (EInt 42)) "42L"

  -- 2. EStr
  _ = codegenCheck "2 EStr hello" (emitExpr (EStr "hello")) "\"hello\""

  -- 3. EBinOp
  _ = codegenCheck "3 EBinOp +" (emitExpr (EBinOp "+" (EInt 1) (EInt 2))) "(1L + 2L)"

  -- 4. EApp
  _ = codegenCheck "4 EApp f x" (emitExpr (EApp (EVar "f") (EVar "x"))) "(f x)"

  -- 5. EIf
  _ = codegenCheck "5 EIf" (emitExpr (EIf (EBool true) (EInt 1) (EInt 0))) "(if true then 1L else 0L)"

  -- 6. ELet
  _ = codegenCheck "6 ELet" (emitExpr (ELet "x" (EInt 1) (EVar "x"))) "(let x = 1L in x)"

  -- 7. Pattern PCon
  _ = codegenCheck "7 PCon Some v" (emitPattern (PCon "Some" (PVar "v" :: []))) "Some(v)"

  -- 8. TyName Int
  _ = codegenCheck "8 TyName Int" (emitType (TyName "Int")) "int64"

  -- 9. TyApp List Int
  _ = codegenCheck "9 TyApp List Int" (emitType (TyApp (TyName "List") (TyName "Int"))) "int64 list"

  -- 10. DType Color
  colorCtors = MkCon "Red" [] :: MkCon "Blue" [] :: []
  colorDecl = DType "Color" [] colorCtors
  _ = checkContains "10 DType Color" (emitDecl colorDecl) "type Color"

  -- 11. DFn add (not recursive → let, not let rec)
  addParams = MkParam "x" (TyName "Int") :: MkParam "y" (TyName "Int") :: []
  addDecl = DFn "add" addParams None (EBinOp "+" (EVar "x") (EVar "y"))
  _ = checkContains "11 DFn add" (emitDecl addDecl) "let add"

  -- 12. Full module emit
  idParams = MkParam "x" (TyName "Int") :: []
  modDecls = DType "Color" [] colorCtors :: DFn "id" idParams None (EVar "x") :: []
  m = MkModule ("Test" :: "Mod" :: []) modDecls
  out = emitModule m
  _ = checkContains "12 module header" out "module Test.Mod"
  _ = checkContains "12 module type" out "type Color"
  _ = checkContains "12 module fn" out "let id"

  -- 13. PWild pattern
  _ = codegenCheck "13 PWild" (emitPattern PWild) "_"

  -- 14. PNil pattern
  _ = codegenCheck "14 PNil" (emitPattern PNil) "[]"

  -- 15. ELam
  _ = codegenCheck "15 ELam" (emitExpr (ELam "x" (EVar "x"))) "(fun x -> x)"

  -- 16. EList
  twoItems = EInt 1 :: EInt 2 :: []
  _ = codegenCheck "16 EList" (emitExpr (EList twoItems)) "[1L; 2L]"

  -- 17. ETuple
  _ = codegenCheck "17 ETuple" (emitExpr (ETuple (EVar "a") (EVar "b"))) "(a, b)"

  -- 18. keyword escaping
  _ = codegenCheck "18 safeIdent let" (safeIdent "let") "__ll_let"
  _ = codegenCheck "19 safeIdent foo" (safeIdent "foo") "foo"

  -- 20. TyFn
  _ = codegenCheck "20 TyFn" (emitType (TyFn (TyName "Int") (TyName "Bool"))) "int64 -> bool"

  -- 21. DExternal: emits failwith stub
  extDecl = DExternal "httpGet" (MkParam "url" (TyName "Str") :: []) (TyName "Str")
  _ = checkContains "21 DExternal stub" (emitDecl extDecl) "failwith \"external: httpGet\""

  -- 22. DOpaque: emits obj alias
  _ = codegenCheck "22 DOpaque obj alias" (emitDecl (DOpaque "HttpClient")) "type HttpClient = obj"

  -- 23. main() emits [<EntryPoint>] wrapper
  mainDecl = DFn "main" [] None (EApp (EVar "printfn") (EStr "hello"))
  _ = checkContains "23 main EntryPoint" (emitDecl mainDecl) "[<EntryPoint>]"
  _ = checkContains "23 main argv" (emitDecl mainDecl) "(argv: string[])"

  -- 24. DFn factorial (recursive) → let rec
  factBody = EIf (EBinOp "==" (EVar "n") (EInt 0)) (EInt 1) (EBinOp "*" (EVar "n") (EApp (EVar "factorial") (EBinOp "-" (EVar "n") (EInt 1))))
  factDecl = DFn "factorial" (MkParam "n" (TyName "Int") :: []) None factBody
  _ = checkContains "24 DFn factorial is rec" (emitDecl factDecl) "let rec factorial"

  printfn "Done"
