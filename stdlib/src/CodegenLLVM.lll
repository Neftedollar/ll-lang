module Std.CodegenLLVM

import Std.Parser
import Std.Maybe
import Std.CompilerTypes
import Std.CompilerTyped

-- LLVM IR code emitter written in ll-lang.
-- Takes the AST produced by Std.Parser and emits LLVM IR text format (.ll).
-- Uses SSA numbering for unique register names.
--
-- Phase 1 refactor (#149):
--   - Single EmitState record threads temp counter + string index
--   - Single emitExpr(state)(expr) walk replaces 4-way duplicated Instrs/Reg/NextCtr/NextSidx walks
--   - TypedExpr dispatch via emitTypedExpr coexists with the untyped Expr path
--   - emitType extended for TyApp List/Maybe and TyFn -> ptr

-- ---- String helpers --------------------------------------------------------

joinWith(sep Str)(items List[Str]) =
  match items
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

strJoin2(a Str)(b Str) =
  if strLen a == 0
    b
  else
    if strLen b == 0
      a
    else strConcat a (strConcat "\n" b)

-- ---- EmitState -------------------------------------------------------------
-- Phase 1 shape: just temp counter and string-literal index. Future phases
-- extend with: env, lambda counter, lambda defs, declared externs, etc.

EmitState = MkEmitState Int Int   -- tempCtr, strIdx

esTempCtr(st EmitState) =
  match st
    | MkEmitState c _ -> c

esStrIdx(st EmitState) =
  match st
    | MkEmitState _ s -> s

-- Allocate a fresh SSA register: bumps tempCtr and returns (regName, newState).
esFresh(st EmitState) =
  match st
    | MkEmitState c s ->
      let reg = strConcat "%t" (intToStr (c + 1))
      (reg, MkEmitState (c + 1) s)

-- Allocate the next string-literal index: returns (idx, newState) where idx
-- is the current index before allocation.
esNextStr(st EmitState) =
  match st
    | MkEmitState c s -> (s, MkEmitState c (s + 1))

-- Build a fresh initial state.
emitStateInit = MkEmitState 0 0

-- ---- Emit result -----------------------------------------------------------
-- The canonical return shape for emitExpr / emitTypedExpr. Carries:
--   - the updated EmitState (so callers thread it forward),
--   - the instruction block for the expression (may be empty),
--   - the register / value string that holds the expression's result.

EmitExprResult = MkEER EmitState Str Str

eerState(r EmitExprResult) =
  match r
    | MkEER s _ _ -> s

eerInstrs(r EmitExprResult) =
  match r
    | MkEER _ i _ -> i

eerReg(r EmitExprResult) =
  match r
    | MkEER _ _ v -> v

-- ---- Type emission ---------------------------------------------------------
-- Phase 1 extensions:
--   - TyApp (TyName "List") _  -> "ptr"
--   - TyApp (TyName "Maybe") _ -> "ptr"
--   - TyFn _ _                 -> "ptr"
--   - TyName "Str"             -> "ptr"  (was "i8*")

emitLLVMType(t TypeExpr) =
  match t
    | TyName "Int"   -> "i64"
    | TyName "Float" -> "double"
    | TyName "Bool"  -> "i1"
    | TyName "Char"  -> "i8"
    | TyName "Str"   -> "ptr"
    | TyName "Unit"  -> "void"
    | TyName _       -> "i64"
    | TyApp (TyName "List") _  -> "ptr"
    | TyApp (TyName "Maybe") _ -> "ptr"
    | TyApp _ _                -> "ptr"
    | TyFn _ _                 -> "ptr"

-- ---- SSA name helper -------------------------------------------------------

ssaName(n Int) =
  strConcat "%t" (intToStr n)

-- ---- String literal encoding -----------------------------------------------

encodeLLVMChar(c Char) =
  match c
    | '\n' -> "\\0A"
    | '\t' -> "\\09"
    | '\r' -> "\\0D"
    | '\\' -> "\\\\"
    | '"'  -> "\\22"
    | _    -> strFromChars [c]

encodeLLVMStr(s Str) =
  listFold (\acc c. strConcat acc (encodeLLVMChar c)) "" (strChars s)

strGlobalDecl(idx Int)(s Str) =
  encoded = encodeLLVMStr s
  len = intToStr (strLen s + 1)
  idxStr = intToStr idx
  strConcat "@.str." (strConcat idxStr (strConcat " = private unnamed_addr constant [" (strConcat len (strConcat " x i8] c\"" (strConcat encoded "\\00\"")))))

-- Materialize a getelementptr expression for string literal @.str.<idx>
-- given its total byte length (strLen s + 1 for the trailing NUL).
strGepExpr(idx Int)(totalLen Int) =
  idxStr = intToStr idx
  lenStr = intToStr totalLen
  strConcat "getelementptr inbounds ([" (strConcat lenStr (strConcat " x i8], [" (strConcat lenStr (strConcat " x i8]* @.str." (strConcat idxStr ", i64 0, i64 0")))))

-- ---- Binary op helpers -----------------------------------------------------

llvmIntOp(op Str) =
  if op == "+"
    "add i64"
  else
    if op == "-"
      "sub i64"
    else
      if op == "*"
        "mul i64"
      else
        if op == "/"
          "sdiv i64"
        else "add i64"

llvmCmpOp(op Str) =
  if op == "=="
    "icmp eq i64"
  else
    if op == "!="
      "icmp ne i64"
    else
      if op == "<"
        "icmp slt i64"
      else
        if op == ">"
          "icmp sgt i64"
        else
          if op == "<="
            "icmp sle i64"
          else
            if op == ">="
              "icmp sge i64"
            else "icmp eq i64"

isCmpOp(op Str) =
  if op == "=="
    true
  else
    if op == "!="
      true
    else
      if op == "<"
        true
      else
        if op == ">"
          true
        else
          if op == "<="
            true
          else
            if op == ">="
              true
            else false

-- ---- getStrVal helper ------------------------------------------------------

getStrVal(e Expr) =
  match e
    | EStr s -> s
    | _ -> ""

-- ---- extractFnName helper --------------------------------------------------

extractFnName(e Expr) =
  match e
    | EVar n -> n
    | ECon n -> n
    | EApp f _ -> extractFnName f
    | _ -> "unknown"

extractTypedFnName(te TypedExpr) =
  match te
    | TEVar n _ -> n
    | TECon n _ -> n
    | TEApp f _ _ -> extractTypedFnName f
    | _ -> "unknown"

-- ---- emitExpr --------------------------------------------------------------
-- Phase 1: single threaded walk, returns EmitExprResult (state, instrs, reg).
-- Replaces the 4-way duplicated POC walks
-- (emitExprInstrs / emitExprReg / emitExprNextCtr / emitExprNextSidx).
--
-- Not yet supported (remain in Phase 2+): ELam, EMatch, EList, ETuple, ECons.

emitExpr(state EmitState)(e Expr) =
  match e
    | EInt n  -> MkEER state "" (intToStr n)
    | EFloat s -> MkEER state "" s
    | EBool b ->
      reg =
        if b
          "1"
        else "0"
      MkEER state "" reg
    | EChar c -> MkEER state "" (intToStr (charToInt c))
    | EStr s ->
      let (idx, st2) = esNextStr state
      totalLen = strLen s + 1
      decl = strGlobalDecl idx s
      gep = strGepExpr idx totalLen
      MkEER st2 decl gep
    | EVar n  -> MkEER state "" (strConcat "%" n)
    | ECon _  -> MkEER state "" "0"
    | ENil    -> MkEER state "" "null"
    | EBinOp op l r ->
      lr = emitExpr state l
      rr = emitExpr (eerState lr) r
      let (dst, st2) = esFresh (eerState rr)
      lreg = eerReg lr
      rreg = eerReg rr
      instrBody =
        if isCmpOp op
          strConcat (llvmCmpOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
        else
          strConcat (llvmIntOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
      instr = strConcat "  " (strConcat dst (strConcat " = " instrBody))
      prefix = strJoin2 (eerInstrs lr) (eerInstrs rr)
      all =
        if strLen prefix == 0
          instr
        else strConcat prefix (strConcat "\n" instr)
      MkEER st2 all dst
    | EIf cond thenE elseE ->
      cr = emitExpr state cond
      -- Labels use the temp counter at the branch point for uniqueness.
      labelN = esTempCtr (eerState cr)
      thenLbl = strConcat "then" (intToStr labelN)
      elseLbl = strConcat "else" (intToStr labelN)
      mergeLbl = strConcat "merge" (intToStr labelN)
      creg = eerReg cr
      brInstr = strConcat "  br i1 " (strConcat creg (strConcat ", label %" (strConcat thenLbl (strConcat ", label %" elseLbl))))
      -- Bump counter once before descending into the branches so the phi
      -- destination doesn't collide with intermediate regs.
      let (_, stAfterBr) = esFresh (eerState cr)
      tr = emitExpr stAfterBr thenE
      thenBodyPre =
        if strLen (eerInstrs tr) == 0
          ""
        else strConcat (eerInstrs tr) "\n"
      thenBlock = strConcat thenLbl (strConcat ":\n" (strConcat thenBodyPre (strConcat "  br label %" mergeLbl)))
      let (_, stAfterThen) = esFresh (eerState tr)
      er = emitExpr stAfterThen elseE
      elseBodyPre =
        if strLen (eerInstrs er) == 0
          ""
        else strConcat (eerInstrs er) "\n"
      elseBlock = strConcat elseLbl (strConcat ":\n" (strConcat elseBodyPre (strConcat "  br label %" mergeLbl)))
      let (dst, stPhi) = esFresh (eerState er)
      treg = eerReg tr
      ereg = eerReg er
      phiParts = strConcat treg (strConcat ", %" (strConcat thenLbl (strConcat "], [" (strConcat ereg (strConcat ", %" (strConcat elseLbl "]"))))))
      phiInstr = strConcat "  " (strConcat dst (strConcat " = phi i64 [" phiParts))
      mergeBlock = strConcat mergeLbl (strConcat ":\n" phiInstr)
      condPart =
        if strLen (eerInstrs cr) == 0
          brInstr
        else strConcat (eerInstrs cr) (strConcat "\n" brInstr)
      all = strConcat condPart (strConcat "\n" (strConcat thenBlock (strConcat "\n" (strConcat elseBlock (strConcat "\n" mergeBlock)))))
      MkEER stPhi all dst
    | ELet _ valE bodyE ->
      vr = emitExpr state valE
      let (dst, st2) = esFresh (eerState vr)
      aliasInstr = strConcat "  " (strConcat dst (strConcat " = add i64 " (strConcat (eerReg vr) ", 0")))
      br = emitExpr st2 bodyE
      viAlias =
        if strLen (eerInstrs vr) == 0
          aliasInstr
        else strConcat (eerInstrs vr) (strConcat "\n" aliasInstr)
      all =
        if strLen (eerInstrs br) == 0
          viAlias
        else strConcat viAlias (strConcat "\n" (eerInstrs br))
      MkEER (eerState br) all (eerReg br)
    | EApp f a ->
      fr = emitExpr state f
      ar = emitExpr (eerState fr) a
      let (dst, st2) = esFresh (eerState ar)
      fnName = extractFnName f
      areg = eerReg ar
      callInstr = strConcat "  " (strConcat dst (strConcat " = call i64 @" (strConcat fnName (strConcat "(i64 " (strConcat areg ")")))))
      prefix = strJoin2 (eerInstrs fr) (eerInstrs ar)
      all =
        if strLen prefix == 0
          callInstr
        else strConcat prefix (strConcat "\n" callInstr)
      MkEER st2 all dst
    | _ -> MkEER state "" "0"

-- ---- emitTypedExpr ---------------------------------------------------------
-- Mirrors emitExpr but consumes typed IR from Compiler.Infer. Phase 1 scope:
-- literals, vars, cons, if, let, binop, app — same subset as emitExpr.
-- Lambdas / match / list / tuple / cons will be handled in Phase 2+.

emitTypedExpr(state EmitState)(te TypedExpr) =
  match te
    | TEInt n _  -> MkEER state "" (intToStr n)
    | TEFloat s _ -> MkEER state "" s
    | TEBool b _ ->
      reg =
        if b
          "1"
        else "0"
      MkEER state "" reg
    | TEChar c _ -> MkEER state "" (intToStr (charToInt c))
    | TEStr s _ ->
      let (idx, st2) = esNextStr state
      totalLen = strLen s + 1
      decl = strGlobalDecl idx s
      gep = strGepExpr idx totalLen
      MkEER st2 decl gep
    | TEVar n _ -> MkEER state "" (strConcat "%" n)
    | TECon _ _ -> MkEER state "" "0"
    | TENil _   -> MkEER state "" "null"
    | TEUnit _  -> MkEER state "" "void"
    | TEBinOp op l r _ ->
      lr = emitTypedExpr state l
      rr = emitTypedExpr (eerState lr) r
      let (dst, st2) = esFresh (eerState rr)
      lreg = eerReg lr
      rreg = eerReg rr
      instrBody =
        if isCmpOp op
          strConcat (llvmCmpOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
        else
          strConcat (llvmIntOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
      instr = strConcat "  " (strConcat dst (strConcat " = " instrBody))
      prefix = strJoin2 (eerInstrs lr) (eerInstrs rr)
      all =
        if strLen prefix == 0
          instr
        else strConcat prefix (strConcat "\n" instr)
      MkEER st2 all dst
    | TEIf cond thenE elseE _ ->
      cr = emitTypedExpr state cond
      labelN = esTempCtr (eerState cr)
      thenLbl = strConcat "then" (intToStr labelN)
      elseLbl = strConcat "else" (intToStr labelN)
      mergeLbl = strConcat "merge" (intToStr labelN)
      creg = eerReg cr
      brInstr = strConcat "  br i1 " (strConcat creg (strConcat ", label %" (strConcat thenLbl (strConcat ", label %" elseLbl))))
      let (_, stAfterBr) = esFresh (eerState cr)
      tr = emitTypedExpr stAfterBr thenE
      thenBodyPre =
        if strLen (eerInstrs tr) == 0
          ""
        else strConcat (eerInstrs tr) "\n"
      thenBlock = strConcat thenLbl (strConcat ":\n" (strConcat thenBodyPre (strConcat "  br label %" mergeLbl)))
      let (_, stAfterThen) = esFresh (eerState tr)
      er = emitTypedExpr stAfterThen elseE
      elseBodyPre =
        if strLen (eerInstrs er) == 0
          ""
        else strConcat (eerInstrs er) "\n"
      elseBlock = strConcat elseLbl (strConcat ":\n" (strConcat elseBodyPre (strConcat "  br label %" mergeLbl)))
      let (dst, stPhi) = esFresh (eerState er)
      treg = eerReg tr
      ereg = eerReg er
      phiParts = strConcat treg (strConcat ", %" (strConcat thenLbl (strConcat "], [" (strConcat ereg (strConcat ", %" (strConcat elseLbl "]"))))))
      phiInstr = strConcat "  " (strConcat dst (strConcat " = phi i64 [" phiParts))
      mergeBlock = strConcat mergeLbl (strConcat ":\n" phiInstr)
      condPart =
        if strLen (eerInstrs cr) == 0
          brInstr
        else strConcat (eerInstrs cr) (strConcat "\n" brInstr)
      all = strConcat condPart (strConcat "\n" (strConcat thenBlock (strConcat "\n" (strConcat elseBlock (strConcat "\n" mergeBlock)))))
      MkEER stPhi all dst
    | TeLet _ valE bodyE _ ->
      vr = emitTypedExpr state valE
      let (dst, st2) = esFresh (eerState vr)
      aliasInstr = strConcat "  " (strConcat dst (strConcat " = add i64 " (strConcat (eerReg vr) ", 0")))
      br = emitTypedExpr st2 bodyE
      viAlias =
        if strLen (eerInstrs vr) == 0
          aliasInstr
        else strConcat (eerInstrs vr) (strConcat "\n" aliasInstr)
      all =
        if strLen (eerInstrs br) == 0
          viAlias
        else strConcat viAlias (strConcat "\n" (eerInstrs br))
      MkEER (eerState br) all (eerReg br)
    | TEApp f a _ ->
      fr = emitTypedExpr state f
      ar = emitTypedExpr (eerState fr) a
      let (dst, st2) = esFresh (eerState ar)
      fnName = extractTypedFnName f
      areg = eerReg ar
      callInstr = strConcat "  " (strConcat dst (strConcat " = call i64 @" (strConcat fnName (strConcat "(i64 " (strConcat areg ")")))))
      prefix = strJoin2 (eerInstrs fr) (eerInstrs ar)
      all =
        if strLen prefix == 0
          callInstr
        else strConcat prefix (strConcat "\n" callInstr)
      MkEER st2 all dst
    | _ -> MkEER state "" "0"

-- ---- emitExprGlobs ---------------------------------------------------------
-- Walks the expression and accumulates every string-literal global declaration
-- (@.str.<n> = private unnamed_addr constant [...]). Threads the same
-- EmitState so indices line up with what emitExpr produced.

emitExprGlobs(state EmitState)(e Expr) =
  match e
    | EStr s ->
      let (idx, st2) = esNextStr state
      (strGlobalDecl idx s, st2)
    | EBinOp _ l r ->
      let (lg, st2) = emitExprGlobs state l
      let (rg, st3) = emitExprGlobs st2 r
      (strJoin2 lg rg, st3)
    | EIf cond thenE elseE ->
      let (cg, st2) = emitExprGlobs state cond
      let (tg, st3) = emitExprGlobs st2 thenE
      let (eg, st4) = emitExprGlobs st3 elseE
      (strJoin2 cg (strJoin2 tg eg), st4)
    | ELet _ valE bodyE ->
      let (vg, st2) = emitExprGlobs state valE
      let (bg, st3) = emitExprGlobs st2 bodyE
      (strJoin2 vg bg, st3)
    | EApp f a ->
      let (fg, st2) = emitExprGlobs state f
      let (ag, st3) = emitExprGlobs st2 a
      (strJoin2 fg ag, st3)
    | _ -> ("", state)

-- ---- Param helpers ---------------------------------------------------------

emitParam(p Param) =
  match p
    | MkParam name ty -> strConcat (emitLLVMType ty) (strConcat " %" name)

emitParams(ps List[Param]) =
  joinWith ", " (listMap emitParam ps)

paramReturnType(retTy Maybe[TypeExpr]) =
  match retTy
    | Some t -> emitLLVMType t
    | None   -> "i64"

-- ---- Declaration emitter ---------------------------------------------------

emitDecl(d Decl)(strIdx Int) =
  match d
    | DFn name params retTy body ->
      retType = paramReturnType retTy
      paramStr = emitParams params
      initSt = MkEmitState 0 strIdx
      res = emitExpr initSt body
      bodyInstrs = eerInstrs res
      retReg = eerReg res
      let (globs, _) = emitExprGlobs (MkEmitState 0 strIdx) body
      globSection =
        if strLen globs == 0
          ""
        else strConcat globs "\n"
      bodySection =
        if strLen bodyInstrs == 0
          strConcat "  ret " (strConcat retType (strConcat " " retReg))
        else strConcat bodyInstrs (strConcat "\n  ret " (strConcat retType (strConcat " " retReg)))
      strConcat globSection (strConcat "define " (strConcat retType (strConcat " @" (strConcat name (strConcat "(" (strConcat paramStr (strConcat ") {\nentry:\n" (strConcat bodySection "\n}"))))))))
    | DType name _ _ ->
      strConcat "; type " name
    | DImport parts ->
      strConcat "; import " (joinWith "." parts)
    | DLet name body ->
      initSt = MkEmitState 0 strIdx
      res = emitExpr initSt body
      reg = eerReg res
      let (globs, _) = emitExprGlobs (MkEmitState 0 strIdx) body
      globSection =
        if strLen globs == 0
          ""
        else strConcat globs "\n"
      strConcat globSection (strConcat "@" (strConcat name (strConcat " = global i64 " reg)))
    | DExport inner -> emitDecl inner strIdx
    | DExternal name _ _ ->
      strConcat "; external: " name
    | DOpaque name ->
      strConcat "; opaque: " name

emitDecls(ds List[Decl])(strIdx Int) =
  match ds
    | [] -> ""
    | d :: rest ->
      first = emitDecl d strIdx
      remaining = emitDecls rest (strIdx + 1)
      if strLen remaining == 0
        first
      else strConcat first (strConcat "\n\n" remaining)

-- ---- Module emission -------------------------------------------------------

emitModulePath(parts List[Str]) =
  joinWith "." parts

emitModule(m Module) =
  match m
    | MkModule path decls ->
      pathStr = emitModulePath path
      header = strConcat "; module " pathStr
      prelude = "; ll-lang LLVM IR output\n; target triple: x86_64-unknown-linux-gnu\n"
      body = emitDecls decls 0
      strConcat prelude (strConcat header (strConcat "\n\n" body))

-- Uniquely-named alias so callers that import multiple codegens can pick
-- LLVM's emitter without bare-name shadowing.
emitModuleLlvm(m Module) = emitModule m

-- ---- Test helpers ----------------------------------------------------------

checkContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing: " (strConcat needle (strConcat "\n  in: " got)))))

-- ---- Tests -----------------------------------------------------------------
