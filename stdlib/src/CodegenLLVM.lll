module Std.CodegenLLVM

import Std.Parser
import Std.Maybe
import Std.Map
import Std.CompilerTypes
import Std.CompilerTyped

-- LLVM IR code emitter written in ll-lang.
-- Takes the AST produced by Std.Parser and emits LLVM IR text format (.ll).
-- Uses SSA numbering for unique register names.
--
-- Phase 1 refactor (#149):
--   - Single EmitState record threads temp counter + string index
--   - Single emitExpr(state)(expr) walk replaces 4-way duplicated Instrs/Reg/NextCtr/NextSidx walks
--   - TypedExpr dispatch via emitTypedExpr coexists with the untyped Expr path
--   - emitType extended for TyApp List/Maybe and TyFn -> ptr
--
-- Phase 2 (#149):
--   - EmitState extended with strPool + nullaryGlobals set
--   - TEBinOp dispatches on operand type (Int/Float/Bool/Str)
--   - Str equality lowers to @strEq runtime call
--   - String pool with dedup (buildStringPool + emitStringPtrGep)
--   - coerceValue helper (i1/i8/i64/double/ptr conversions)
--   - main coerce: entry-point `main` forced to i32 signature, body value
--     cast via emitCastToMainI32
--   - collectNullaryGlobals: bare TEVar references to zero-arg TDFn lower
--     to `call <ty> @name()` instead of `%name`
--   - litToConst / evalConst / constToLlvm for TDLet globals with constant
--     RHS (e.g. `pi = 3.14` -> `@pi = global double 3.14`)
--   - emitTypedDecl / emitTypedModule wire the full pipeline

-- ---- String helpers --------------------------------------------------------

joinWith(sep Str)(items List[Str]) =
  match items
    | [] -> ""
    | x :: [] -> x
    | x :: rest -> strConcat x (strConcat sep (joinWith sep rest))

strJoin2(a Str)(b Str) =
  if strLen a == 0
    b
  else
    if strLen b == 0
      a
    else strConcat a (strConcat "\n" b)

-- ---- EmitState -------------------------------------------------------------
-- Phase 2 shape: temp counter + string-literal counter (used by the Expr
-- path) + pre-built string pool + pre-built nullary-globals set. The
-- TypedExpr path consults the pool/set via the state; the Expr path keeps
-- its pre-pool behaviour (allocate-on-demand @.str.N indices).

-- Phase 3 shape: Phase 2 fields + labelCtr + ctorTags + nextCtorTag.
-- ctorTags is project-scope: set once by the emit driver via a pre-pass over
-- all TDType decls, then read-only during emission. nextCtorTag is stored
-- in the state so the seed pass can thread its counter without globals.

EmitState = MkEmitState Int Int (RBMap[Str][Int]) (RBMap[Str][Int]) Int (RBMap[Str][Int]) Int
  -- tempCtr, strIdx, strPool, nullaryGlobals, labelCtr, ctorTags, nextCtorTag

esTempCtr(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> c

esStrIdx(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> s

esStrPool(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> p

esNullaryGlobals(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> g

esLabelCtr(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> l

esCtorTags(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> t

esNextCtorTag(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> n

-- Allocate a fresh SSA register: bumps tempCtr and returns (regName, newState).
esFresh(st EmitState) =
  match st
    | MkEmitState c s p g l t n ->
      let reg = strConcat "%t" (intToStr (c + 1))
      (reg, MkEmitState (c + 1) s p g l t n)

-- Allocate the next string-literal index: returns (idx, newState) where idx
-- is the current index before allocation.
esNextStr(st EmitState) =
  match st
    | MkEmitState c s p g l t n -> (s, MkEmitState c (s + 1) p g l t n)

-- Allocate a fresh block label. Returns (labelName, newState). The labelName
-- is always the bare identifier (no leading `%`); callers prepend `%` when
-- emitting a `br label %X` instruction or a plain `X:` for the label itself.
esFreshLabel(prefix Str)(st EmitState) =
  match st
    | MkEmitState c s p g l t n ->
      let lbl = strConcat prefix (intToStr l)
      (lbl, MkEmitState c s p g (l + 1) t n)

-- Allocate three labels in one go: (case, body, next) — the shape used by
-- match-arm lowering. Returns ((caseLbl, bodyLbl, nextLbl), newState).
esFreshLabelTriple(st EmitState) =
  let (caseLbl, st1) = esFreshLabel "match_case_" st
  let (bodyLbl, st2) = esFreshLabel "match_body_" st1
  let (nextLbl, st3) = esFreshLabel "match_next_" st2
  ((caseLbl, bodyLbl, nextLbl), st3)

-- Replace the pool / globals sections (used by the pre-pass).
esSetPool(st EmitState)(pool RBMap[Str][Int]) =
  match st
    | MkEmitState c s _ g l t n -> MkEmitState c s pool g l t n

esSetGlobals(st EmitState)(globs RBMap[Str][Int]) =
  match st
    | MkEmitState c s p _ l t n -> MkEmitState c s p globs l t n

esSetCtorTags(st EmitState)(tags RBMap[Str][Int])(nextN Int) =
  match st
    | MkEmitState c s p g l _ _ -> MkEmitState c s p g l tags nextN

-- Look up a constructor's tag; returns -99 (sentinel) for unknown names
-- so mis-use surfaces quickly in generated IR rather than silently matching 0.
esCtorTag(name Str)(st EmitState) =
  match mapLookup strCmp name (esCtorTags st)
    | Some v -> v
    | None -> 0 - 99

-- Build a fresh initial state (all counters 0, empty maps).
emitStateInit = MkEmitState 0 0 Leaf Leaf 0 Leaf 1

emitStateWith(pool RBMap[Str][Int])(globs RBMap[Str][Int]) =
  MkEmitState 0 0 pool globs 0 Leaf 1

emitStateWithTags(pool RBMap[Str][Int])(globs RBMap[Str][Int])(tags RBMap[Str][Int])(nextN Int) =
  MkEmitState 0 0 pool globs 0 tags nextN

-- Predicate: is `name` a nullary global?
isNullaryGlobal(name Str)(st EmitState) =
  mapContains strCmp name (esNullaryGlobals st)

-- ---- Emit result -----------------------------------------------------------
-- The canonical return shape for emitExpr / emitTypedExpr. Carries:
--   - the updated EmitState (so callers thread it forward),
--   - the instruction block for the expression (may be empty),
--   - the register / value string that holds the expression's result.

EmitExprResult = MkEER EmitState Str Str

eerState(r EmitExprResult) =
  match r
    | MkEER s _ _ -> s

eerInstrs(r EmitExprResult) =
  match r
    | MkEER _ i _ -> i

eerReg(r EmitExprResult) =
  match r
    | MkEER _ _ v -> v

-- ---- Type emission ---------------------------------------------------------

emitLLVMType(t TypeExpr) =
  match t
    | TyName "Int"   -> "i64"
    | TyName "Float" -> "double"
    | TyName "Bool"  -> "i1"
    | TyName "Char"  -> "i8"
    | TyName "Str"   -> "ptr"
    | TyName "Unit"  -> "void"
    | TyName _       -> "i64"
    | TyApp (TyName "List") _  -> "ptr"
    | TyApp (TyName "Maybe") _ -> "ptr"
    | TyApp _ _                -> "ptr"
    | TyFn _ _                 -> "ptr"

-- Default value for a given emit type. Matches F# `defaultValue`.
defaultLLVMValue(ty Str) =
  if ty == "i64"
    "0"
  else if ty == "i1"
    "0"
  else if ty == "i8"
    "0"
  else if ty == "double"
    "0.0"
  else if ty == "void"
    ""
  else "null"

-- ---- SSA name helper -------------------------------------------------------

ssaName(n Int) =
  strConcat "%t" (intToStr n)

-- ---- String literal encoding -----------------------------------------------

encodeLLVMChar(c Char) =
  match c
    | '\n' -> "\\0A"
    | '\t' -> "\\09"
    | '\r' -> "\\0D"
    | '\\' -> "\\\\"
    | '"'  -> "\\22"
    | _    -> strFromChars [c]

encodeLLVMStr(s Str) =
  listFold (\acc c. strConcat acc (encodeLLVMChar c)) "" (strChars s)

strGlobalDecl(idx Int)(s Str) =
  encoded = encodeLLVMStr s
  len = intToStr (strLen s + 1)
  idxStr = intToStr idx
  strConcat "@.str." (strConcat idxStr (strConcat " = private unnamed_addr constant [" (strConcat len (strConcat " x i8] c\"" (strConcat encoded "\\00\"")))))

-- Phase 2: pool-style string global with `@.strK` symbol (no dot), matches
-- F# `buildStringPool` naming ("@.str" + index).
strPoolDecl(idx Int)(s Str) =
  encoded = encodeLLVMStr s
  len = intToStr (strLen s + 1)
  idxStr = intToStr idx
  strConcat "@.str" (strConcat idxStr (strConcat " = private unnamed_addr constant [" (strConcat len (strConcat " x i8] c\"" (strConcat encoded "\\00\", align 1")))))

-- Materialize a getelementptr expression for string literal @.str.<idx>
-- given its total byte length (strLen s + 1 for the trailing NUL).
strGepExpr(idx Int)(totalLen Int) =
  idxStr = intToStr idx
  lenStr = intToStr totalLen
  strConcat "getelementptr inbounds ([" (strConcat lenStr (strConcat " x i8], [" (strConcat lenStr (strConcat " x i8]* @.str." (strConcat idxStr ", i64 0, i64 0")))))

-- Phase 2 pool GEP: matches F# emitStringPtr output shape:
--   "getelementptr inbounds ([N x i8], ptr @.strK, i64 0, i64 0)"
-- Returns the raw expression text; caller inlines into an instruction.
strPoolGepExpr(idx Int)(totalLen Int) =
  idxStr = intToStr idx
  lenStr = intToStr totalLen
  strConcat "getelementptr inbounds ([" (strConcat lenStr (strConcat " x i8], ptr @.str" (strConcat idxStr ", i64 0, i64 0)")))

-- Emit an instruction that loads a pool string pointer into a fresh reg.
-- Returns EmitExprResult (state, instrs, reg).
emitStringPtrGep(state EmitState)(lit Str) =
  match mapLookup strCmp lit (esStrPool state)
    | None -> MkEER state "" "null"
    | Some idx ->
      totalLen = strLen lit + 1
      let (dst, st2) = esFresh state
      instr = strConcat "  " (strConcat dst (strConcat " = " (strPoolGepExpr idx totalLen)))
      MkEER st2 instr dst

-- ---- Binary op helpers -----------------------------------------------------

llvmIntOp(op Str) =
  if op == "+"
    "add i64"
  else
    if op == "-"
      "sub i64"
    else
      if op == "*"
        "mul i64"
      else
        if op == "/"
          "sdiv i64"
        else "add i64"

llvmFloatOp(op Str) =
  if op == "+"
    "fadd double"
  else
    if op == "-"
      "fsub double"
    else
      if op == "*"
        "fmul double"
      else
        if op == "/"
          "fdiv double"
        else "fadd double"

llvmCmpOp(op Str) =
  if op == "=="
    "icmp eq i64"
  else
    if op == "!="
      "icmp ne i64"
    else
      if op == "<"
        "icmp slt i64"
      else
        if op == ">"
          "icmp sgt i64"
        else
          if op == "<="
            "icmp sle i64"
          else
            if op == ">="
              "icmp sge i64"
            else "icmp eq i64"

llvmFloatCmpOp(op Str) =
  if op == "=="
    "fcmp oeq double"
  else
    if op == "!="
      "fcmp one double"
    else
      if op == "<"
        "fcmp olt double"
      else
        if op == ">"
          "fcmp ogt double"
        else
          if op == "<="
            "fcmp ole double"
          else
            if op == ">="
              "fcmp oge double"
            else "fcmp oeq double"

-- Bool-typed ops: arithmetic `+/-/*//` degenerate to `and/or i1`, and
-- comparisons flow through `icmp`.
llvmBoolOp(op Str) =
  if op == "=="
    "icmp eq i1"
  else
    if op == "!="
      "icmp ne i1"
    else "icmp eq i1"

isCmpOp(op Str) =
  if op == "=="
    true
  else
    if op == "!="
      true
    else
      if op == "<"
        true
      else
        if op == ">"
          true
        else
          if op == "<="
            true
          else
            if op == ">="
              true
            else false

isArithOp(op Str) =
  if op == "+"
    true
  else
    if op == "-"
      true
    else
      if op == "*"
        true
      else
        if op == "/"
          true
        else false

-- ---- getStrVal helper ------------------------------------------------------

getStrVal(e Expr) =
  match e
    | EStr s -> s
    | _ -> ""

-- ---- extractFnName helper --------------------------------------------------

extractFnName(e Expr) =
  match e
    | EVar n -> n
    | ECon n -> n
    | EApp f _ -> extractFnName f
    | _ -> "unknown"

extractTypedFnName(te TypedExpr) =
  match te
    | TEVar n _ -> n
    | TECon n _ -> n
    | TEApp f _ _ -> extractTypedFnName f
    | _ -> "unknown"

-- ---- coerceValue ----------------------------------------------------------
-- Port of F# `coerceValue`. Given from/to LLVM types and a register, emit
-- zext/trunc/sitofp/fptosi/ptrtoint/inttoptr as needed. Returns
-- EmitExprResult so callers thread the state.

coerceValue(state EmitState)(fromTy Str)(toTy Str)(value Str) =
  if fromTy == toTy
    MkEER state "" value
  else
    if fromTy == "i1"
      if toTy == "i64"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = zext i1 " (strConcat value " to i64")))
        MkEER st2 instr dst
      else if toTy == "double"
        r1 = coerceValue state "i1" "i64" value
        r2 = coerceValue (eerState r1) "i64" "double" (eerReg r1)
        MkEER (eerState r2) (strJoin2 (eerInstrs r1) (eerInstrs r2)) (eerReg r2)
      else MkEER state "" value
    else if fromTy == "i8"
      if toTy == "i64"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = zext i8 " (strConcat value " to i64")))
        MkEER st2 instr dst
      else if toTy == "double"
        r1 = coerceValue state "i8" "i64" value
        r2 = coerceValue (eerState r1) "i64" "double" (eerReg r1)
        MkEER (eerState r2) (strJoin2 (eerInstrs r1) (eerInstrs r2)) (eerReg r2)
      else MkEER state "" value
    else if fromTy == "double"
      if toTy == "i64"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = fptosi double " (strConcat value " to i64")))
        MkEER st2 instr dst
      else MkEER state "" value
    else if fromTy == "ptr"
      if toTy == "i64"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = ptrtoint ptr " (strConcat value " to i64")))
        MkEER st2 instr dst
      else if toTy == "i1"
        r1 = coerceValue state "ptr" "i64" value
        r2 = coerceValue (eerState r1) "i64" "i1" (eerReg r1)
        MkEER (eerState r2) (strJoin2 (eerInstrs r1) (eerInstrs r2)) (eerReg r2)
      else if toTy == "double"
        r1 = coerceValue state "ptr" "i64" value
        r2 = coerceValue (eerState r1) "i64" "double" (eerReg r1)
        MkEER (eerState r2) (strJoin2 (eerInstrs r1) (eerInstrs r2)) (eerReg r2)
      else MkEER state "" value
    else if fromTy == "i64"
      if toTy == "i1"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = icmp ne i64 " (strConcat value ", 0")))
        MkEER st2 instr dst
      else if toTy == "i8"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = trunc i64 " (strConcat value " to i8")))
        MkEER st2 instr dst
      else if toTy == "double"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = sitofp i64 " (strConcat value " to double")))
        MkEER st2 instr dst
      else if toTy == "ptr"
        let (dst, st2) = esFresh state
        instr = strConcat "  " (strConcat dst (strConcat " = inttoptr i64 " (strConcat value " to ptr")))
        MkEER st2 instr dst
      else MkEER state "" value
    else MkEER state "" value

-- Cast the body value of `main` to i32 for the C-ABI entry-point return.
-- Mirrors F# emitCastToMainI32.
emitCastToMainI32(state EmitState)(bodyTy Str)(value Str) =
  if bodyTy == "i32"
    MkEER state "" value
  else if bodyTy == "i64"
    let (dst, st2) = esFresh state
    instr = strConcat "  " (strConcat dst (strConcat " = trunc i64 " (strConcat value " to i32")))
    MkEER st2 instr dst
  else if bodyTy == "i1"
    let (dst, st2) = esFresh state
    instr = strConcat "  " (strConcat dst (strConcat " = zext i1 " (strConcat value " to i32")))
    MkEER st2 instr dst
  else if bodyTy == "i8"
    let (dst, st2) = esFresh state
    instr = strConcat "  " (strConcat dst (strConcat " = zext i8 " (strConcat value " to i32")))
    MkEER st2 instr dst
  else if bodyTy == "double"
    let (dst, st2) = esFresh state
    instr = strConcat "  " (strConcat dst (strConcat " = fptosi double " (strConcat value " to i32")))
    MkEER st2 instr dst
  else if bodyTy == "ptr"
    r1 = coerceValue state "ptr" "i64" value
    let (dst, st2) = esFresh (eerState r1)
    instr = strConcat "  " (strConcat dst (strConcat " = trunc i64 " (strConcat (eerReg r1) " to i32")))
    MkEER st2 (strJoin2 (eerInstrs r1) instr) dst
  else MkEER state "" "0"

-- ---- isStrType ------------------------------------------------------------

isStrType(t TypeExpr) =
  match t
    | TyName "Str" -> true
    | _ -> false

isBoolType(t TypeExpr) =
  match t
    | TyName "Bool" -> true
    | _ -> false

isFloatType(t TypeExpr) =
  match t
    | TyName "Float" -> true
    | _ -> false

isIntType(t TypeExpr) =
  match t
    | TyName "Int" -> true
    | _ -> false

-- ---- emitExpr --------------------------------------------------------------
-- Phase 1: single threaded walk, returns EmitExprResult (state, instrs, reg).
-- Replaces the 4-way duplicated POC walks
-- (emitExprInstrs / emitExprReg / emitExprNextCtr / emitExprNextSidx).
--
-- Not yet supported (remain in Phase 2+): ELam, EMatch, EList, ETuple, ECons.

emitExpr(state EmitState)(e Expr) =
  match e
    | EInt n  -> MkEER state "" (intToStr n)
    | EFloat s -> MkEER state "" s
    | EBool b ->
      reg =
        if b
          "1"
        else "0"
      MkEER state "" reg
    | EChar c -> MkEER state "" (intToStr (charToInt c))
    | EStr s ->
      let (idx, st2) = esNextStr state
      totalLen = strLen s + 1
      decl = strGlobalDecl idx s
      gep = strGepExpr idx totalLen
      MkEER st2 decl gep
    | EVar n  -> MkEER state "" (strConcat "%" n)
    | ECon _  -> MkEER state "" "0"
    | ENil    -> MkEER state "" "null"
    | EBinOp op l r ->
      lr = emitExpr state l
      rr = emitExpr (eerState lr) r
      let (dst, st2) = esFresh (eerState rr)
      lreg = eerReg lr
      rreg = eerReg rr
      instrBody =
        if isCmpOp op
          strConcat (llvmCmpOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
        else
          strConcat (llvmIntOp op) (strConcat " " (strConcat lreg (strConcat ", " rreg)))
      instr = strConcat "  " (strConcat dst (strConcat " = " instrBody))
      prefix = strJoin2 (eerInstrs lr) (eerInstrs rr)
      all =
        if strLen prefix == 0
          instr
        else strConcat prefix (strConcat "\n" instr)
      MkEER st2 all dst
    | EIf cond thenE elseE ->
      cr = emitExpr state cond
      -- Labels use the temp counter at the branch point for uniqueness.
      labelN = esTempCtr (eerState cr)
      thenLbl = strConcat "then" (intToStr labelN)
      elseLbl = strConcat "else" (intToStr labelN)
      mergeLbl = strConcat "merge" (intToStr labelN)
      creg = eerReg cr
      brInstr = strConcat "  br i1 " (strConcat creg (strConcat ", label %" (strConcat thenLbl (strConcat ", label %" elseLbl))))
      -- Bump counter once before descending into the branches so the phi
      -- destination doesn't collide with intermediate regs.
      let (_, stAfterBr) = esFresh (eerState cr)
      tr = emitExpr stAfterBr thenE
      thenBodyPre =
        if strLen (eerInstrs tr) == 0
          ""
        else strConcat (eerInstrs tr) "\n"
      thenBlock = strConcat thenLbl (strConcat ":\n" (strConcat thenBodyPre (strConcat "  br label %" mergeLbl)))
      let (_, stAfterThen) = esFresh (eerState tr)
      er = emitExpr stAfterThen elseE
      elseBodyPre =
        if strLen (eerInstrs er) == 0
          ""
        else strConcat (eerInstrs er) "\n"
      elseBlock = strConcat elseLbl (strConcat ":\n" (strConcat elseBodyPre (strConcat "  br label %" mergeLbl)))
      let (dst, stPhi) = esFresh (eerState er)
      treg = eerReg tr
      ereg = eerReg er
      phiParts = strConcat treg (strConcat ", %" (strConcat thenLbl (strConcat "], [" (strConcat ereg (strConcat ", %" (strConcat elseLbl "]"))))))
      phiInstr = strConcat "  " (strConcat dst (strConcat " = phi i64 [" phiParts))
      mergeBlock = strConcat mergeLbl (strConcat ":\n" phiInstr)
      condPart =
        if strLen (eerInstrs cr) == 0
          brInstr
        else strConcat (eerInstrs cr) (strConcat "\n" brInstr)
      all = strConcat condPart (strConcat "\n" (strConcat thenBlock (strConcat "\n" (strConcat elseBlock (strConcat "\n" mergeBlock)))))
      MkEER stPhi all dst
    | ELet _ valE bodyE ->
      vr = emitExpr state valE
      let (dst, st2) = esFresh (eerState vr)
      aliasInstr = strConcat "  " (strConcat dst (strConcat " = add i64 " (strConcat (eerReg vr) ", 0")))
      br = emitExpr st2 bodyE
      viAlias =
        if strLen (eerInstrs vr) == 0
          aliasInstr
        else strConcat (eerInstrs vr) (strConcat "\n" aliasInstr)
      all =
        if strLen (eerInstrs br) == 0
          viAlias
        else strConcat viAlias (strConcat "\n" (eerInstrs br))
      MkEER (eerState br) all (eerReg br)
    | EApp f a ->
      fr = emitExpr state f
      ar = emitExpr (eerState fr) a
      let (dst, st2) = esFresh (eerState ar)
      fnName = extractFnName f
      areg = eerReg ar
      callInstr = strConcat "  " (strConcat dst (strConcat " = call i64 @" (strConcat fnName (strConcat "(i64 " (strConcat areg ")")))))
      prefix = strJoin2 (eerInstrs fr) (eerInstrs ar)
      all =
        if strLen prefix == 0
          callInstr
        else strConcat prefix (strConcat "\n" callInstr)
      MkEER st2 all dst
    | _ -> MkEER state "" "0"

-- ---- Typed binop emission -------------------------------------------------
-- Phase 2: dispatch on operand type. For Str ==/!=, lower to @strEq call.

-- Extract the LLVM type string from a TypedExpr node. Avoids using
-- `typedExprType` (which returns a TypeExpr), since threading TypeExpr
-- values through this function seemed to confuse the HM inferencer on
-- sibling branches. Here we pattern-match and call emitLLVMType on the
-- embedded TypeExpr, returning Str.
llvmTypeOfTE(te TypedExpr) =
  match te
    | TEInt _ ty -> emitLLVMType ty
    | TEStr _ ty -> emitLLVMType ty
    | TEBool _ ty -> emitLLVMType ty
    | TEChar _ ty -> emitLLVMType ty
    | TEFloat _ ty -> emitLLVMType ty
    | TEVar _ ty -> emitLLVMType ty
    | TECon _ ty -> emitLLVMType ty
    | TEApp _ _ ty -> emitLLVMType ty
    | TELam _ _ _ ty -> emitLLVMType ty
    | TeLet _ _ _ ty -> emitLLVMType ty
    | TEIf _ _ _ ty -> emitLLVMType ty
    | TEMatch _ _ _ ty -> emitLLVMType ty
    | TEList _ ty -> emitLLVMType ty
    | TECons _ _ ty -> emitLLVMType ty
    | TEBinOp _ _ _ ty -> emitLLVMType ty
    | TETuple _ _ ty -> emitLLVMType ty
    | TENil ty -> emitLLVMType ty
    | TEUnit ty -> emitLLVMType ty

-- Emit a simple binop instruction "%dst = <opStr> <lreg>, <rreg>".
-- Returns EmitExprResult.
emitBinInstr(state EmitState)(opStr Str)(lreg Str)(rreg Str) =
  let (dst, st1) = esFresh state
  tail = strConcat " " (strConcat lreg (strConcat ", " rreg))
  instr = strConcat "  " (strConcat dst (strConcat " = " (strConcat opStr tail)))
  MkEER st1 instr dst

-- Emit `strEq ==` (returns i1 in a fresh register).
emitStrEq(state EmitState)(lreg Str)(rreg Str) =
  let (dst, st1) = esFresh state
  args = strConcat lreg (strConcat ", ptr " rreg)
  closeParen = ")"
  callPart = strConcat " = call i1 @strEq(ptr " (strConcat args closeParen)
  instr = strConcat "  " (strConcat dst callPart)
  MkEER st1 instr dst

-- Emit `strEq !=` (strEq then xor 1).
emitStrNeq(state EmitState)(lreg Str)(rreg Str) =
  eqRes = emitStrEq state lreg rreg
  let (notReg, st2) = esFresh (eerState eqRes)
  notInstr = strConcat "  " (strConcat notReg (strConcat " = xor i1 " (strConcat (eerReg eqRes) ", 1")))
  combined = strConcat (eerInstrs eqRes) (strConcat "\n" notInstr)
  MkEER st2 combined notReg

-- Dispatch binop emission on the LLVM type of the left operand (passed as Str).
-- `lTyStr` is the already-lowered LLVM type ("i64"/"double"/"i1"/"ptr").
emitTypedBinOpByTy(state EmitState)(op Str)(lTyStr Str)(lreg Str)(rreg Str) =
  if lTyStr == "ptr"
    if op == "=="
      emitStrEq state lreg rreg
    else if op == "!="
      emitStrNeq state lreg rreg
    else MkEER state "" "0"
  else if lTyStr == "double"
    if isCmpOp op
      emitBinInstr state (llvmFloatCmpOp op) lreg rreg
    else
      emitBinInstr state (llvmFloatOp op) lreg rreg
  else if lTyStr == "i1"
    if op == "=="
      emitBinInstr state "icmp eq i1" lreg rreg
    else if op == "!="
      emitBinInstr state "icmp ne i1" lreg rreg
    else MkEER state "" "0"
  else
    if isCmpOp op
      emitBinInstr state (llvmCmpOp op) lreg rreg
    else
      emitBinInstr state (llvmIntOp op) lreg rreg

-- ---- Phase 3: ADT runtime block, tag seeding, alloc helpers --------------
--
-- Port of F# emitRuntimeBlock + declares for node_tag_safe / node_payload_safe
-- / node_tail_safe. Emitted once per program at the top of the .ll output.
-- The C runtime in sdks/Platform.LLVM.SDK/runtime/lllc_runtime.c implements
-- the three node_* helpers; we only need a `declare`.

llvmRuntimeBlock =
  rtMalloc = "declare ptr @malloc(i64)\n\n"
  rtAlloc = "define ptr @__ll_alloc(i64 %tag, i64 %payload, ptr %tail) {\nentry:\n  %raw = call ptr @malloc(i64 24)\n  %tagp = getelementptr inbounds { i64, i64, ptr }, ptr %raw, i32 0, i32 0\n  store i64 %tag, ptr %tagp\n  %payloadp = getelementptr inbounds { i64, i64, ptr }, ptr %raw, i32 0, i32 1\n  store i64 %payload, ptr %payloadp\n  %tailp = getelementptr inbounds { i64, i64, ptr }, ptr %raw, i32 0, i32 2\n  store ptr %tail, ptr %tailp\n  ret ptr %raw\n}\n\n"
  rtNodeHelpers = "declare i64 @node_tag_safe(ptr)\ndeclare i64 @node_payload_safe(ptr)\ndeclare ptr @node_tail_safe(ptr)\n"
  strConcat rtMalloc (strConcat rtAlloc rtNodeHelpers)

-- LIST_CONS_TAG as a Str; matches F# `-1` sentinel used for list spine cells
-- and for extra-arg tail nodes of multi-arg constructors.
listConsTagStr = "-1"

-- ---- Ctor tag seeding -----------------------------------------------------
-- Walk TDType decls and build a project-scope (name -> Int) tag map.
-- Tag assignment: first ctor in first module gets tag 1, then +1 per new
-- ctor across all modules. Re-seeing the same name keeps the first tag.

-- Extract ctor-name list from a Constructor value.
ctorNameOf(c Constructor) =
  match c
    | MkCon n _ -> n

-- Seed tags for a list of Constructor. Returns (tags', nextN').
seedCtorsList(tags RBMap[Str][Int])(nextN Int)(cs List[Constructor]) =
  match cs
    | [] -> (tags, nextN)
    | c :: rest ->
      name = ctorNameOf c
      match mapLookup strCmp name tags
        | Some _ -> seedCtorsList tags nextN rest
        | None ->
          tags2 = mapInsert strCmp name nextN tags
          seedCtorsList tags2 (nextN + 1) rest

-- Seed tags for one TypedDecl (only TDType contributes).
seedCtorsDecl(tags RBMap[Str][Int])(nextN Int)(d TypedDecl) =
  match d
    | TDType _ _ ctors -> seedCtorsList tags nextN ctors
    | _ -> (tags, nextN)

-- Seed tags for a list of TypedDecls.
seedCtorsDecls(tags RBMap[Str][Int])(nextN Int)(ds List[TypedDecl]) =
  match ds
    | [] -> (tags, nextN)
    | d :: rest ->
      let (tags2, n2) = seedCtorsDecl tags nextN d
      seedCtorsDecls tags2 n2 rest

-- Seed tags for a single module.
seedCtorsModule(tags RBMap[Str][Int])(nextN Int)(tm TypedModule) =
  seedCtorsDecls tags nextN (typedModDecls tm)

-- Seed tags for a list of modules (project-scope). Recursive walk so we
-- avoid tuple-in-lambda-arg HM issues.
seedCtorsModulesFrom(tags RBMap[Str][Int])(nextN Int)(tms List[TypedModule]) =
  match tms
    | [] -> (tags, nextN)
    | tm :: rest ->
      let (t2, n2) = seedCtorsModule tags nextN tm
      seedCtorsModulesFrom t2 n2 rest

seedCtorsModules(tms List[TypedModule]) =
  seedCtorsModulesFrom Leaf 1 tms

-- ---- Alloc + null-safe loads ----------------------------------------------
-- Port of F# emitAllocNode / emitLoadNodeTag / emitLoadNodePayload /
-- emitLoadNodeTail. Each returns EmitExprResult (state', instr, reg).

emitAllocNode(state EmitState)(tagStr Str)(payloadStr Str)(tailStr Str) =
  let (dst, st1) = esFresh state
  args = strConcat "(i64 " (strConcat tagStr (strConcat ", i64 " (strConcat payloadStr (strConcat ", ptr " (strConcat tailStr ")")))))
  instr = strConcat "  " (strConcat dst (strConcat " = call ptr @__ll_alloc" args))
  MkEER st1 instr dst

emitLoadNodeTag(state EmitState)(nodePtr Str) =
  let (dst, st1) = esFresh state
  instr = strConcat "  " (strConcat dst (strConcat " = call i64 @node_tag_safe(ptr " (strConcat nodePtr ")")))
  MkEER st1 instr dst

emitLoadNodePayload(state EmitState)(nodePtr Str) =
  let (dst, st1) = esFresh state
  instr = strConcat "  " (strConcat dst (strConcat " = call i64 @node_payload_safe(ptr " (strConcat nodePtr ")")))
  MkEER st1 instr dst

emitLoadNodeTail(state EmitState)(nodePtr Str) =
  let (dst, st1) = esFresh state
  instr = strConcat "  " (strConcat dst (strConcat " = call ptr @node_tail_safe(ptr " (strConcat nodePtr ")")))
  MkEER st1 instr dst

-- Emit an icmp/phi-style helper: compare i1 a to constant 1 etc. Actually
-- simpler: just emit `<dst> = and i1 <a>, <b>`, returning EER.
emitAndI1(state EmitState)(a Str)(b Str) =
  if a == "1"
    MkEER state "" b
  else if b == "1"
    MkEER state "" a
  else if a == "0"
    MkEER state "" "0"
  else if b == "0"
    MkEER state "" "0"
  else
    let (dst, st1) = esFresh state
    instr = strConcat "  " (strConcat dst (strConcat " = and i1 " (strConcat a (strConcat ", " b))))
    MkEER st1 instr dst

-- Emit `<dst> = icmp <pred> i64 <a>, <b>`.
emitICmpI64(state EmitState)(pred Str)(a Str)(b Str) =
  let (dst, st1) = esFresh state
  instr = strConcat "  " (strConcat dst (strConcat " = icmp " (strConcat pred (strConcat " i64 " (strConcat a (strConcat ", " b))))))
  MkEER st1 instr dst

-- Emit `<dst> = icmp <pred> ptr <a>, <b>`.
emitICmpPtr(state EmitState)(pred Str)(a Str)(b Str) =
  let (dst, st1) = esFresh state
  instr = strConcat "  " (strConcat dst (strConcat " = icmp " (strConcat pred (strConcat " ptr " (strConcat a (strConcat ", " b))))))
  MkEER st1 instr dst

-- ---- Constructor ABI ------------------------------------------------------
--
-- ABI (matches F# emitAllocNode + LIST_CONS_TAG tail-chain convention):
--   0-arg: single cell {tag=T, payload=0, tail=null}
--   1-arg: single cell {tag=T, payload=arg0_i64, tail=null}
--   N-arg (N>=2): head cell {tag=T, payload=arg0_i64, tail=chain} where
--     chain is a reverse cons of remaining args with tag=LIST_CONS_TAG.
--
-- All scalar payloads are coerced to i64 (the ADT-cell payload slot width).

-- Build a cons chain from list of already-coerced i64 payloads (in order),
-- terminating in `null`. Returns (state', instrs, reg) where `reg` holds
-- the head of the reverse chain — i.e. last element is the tail's tail.
-- Matches F# `buildRest`: walks the REVERSED list, building each node
-- pointing at the previous accumulator.
emitBuildConsTail(state EmitState)(payloadsRev List[Str]) =
  match payloadsRev
    | [] -> MkEER state "" "null"
    | x :: rest ->
      prior = emitBuildConsTail state rest
      nodeRes = emitAllocNode (eerState prior) listConsTagStr x (eerReg prior)
      instrs = strJoin2 (eerInstrs prior) (eerInstrs nodeRes)
      MkEER (eerState nodeRes) instrs (eerReg nodeRes)

-- Emit allocation for a constructor application given tag + i64 arg regs.
emitCtorAlloc(state EmitState)(tagStr Str)(argI64s List[Str]) =
  match argI64s
    | [] -> emitAllocNode state tagStr "0" "null"
    | firstArg :: rest ->
      tailRes =
        match rest
          | [] -> MkEER state "" "null"
          | _ -> emitBuildConsTail state (listReverse rest)
      headRes = emitAllocNode (eerState tailRes) tagStr firstArg (eerReg tailRes)
      all = strJoin2 (eerInstrs tailRes) (eerInstrs headRes)
      MkEER (eerState headRes) all (eerReg headRes)

-- Ctor application: emit args + allocation. Inlined for up to 3 args
-- (Phase 3 target examples have ≤ 2 args per ctor; grows easily if needed).
emitCtorApp(state EmitState)(cname Str)(argsList List[TypedExpr]) =
  match argsList
    | [] ->
      tagStr = intToStr (esCtorTag cname state)
      emitAllocNode state tagStr "0" "null"
    | a :: [] ->
      argR = emitOneArgI64 state a
      tagStr = intToStr (esCtorTag cname (eerState argR))
      alloc = emitAllocNode (eerState argR) tagStr (eerReg argR) "null"
      all = strJoin2 (eerInstrs argR) (eerInstrs alloc)
      MkEER (eerState alloc) all (eerReg alloc)
    | a :: b :: [] ->
      aR = emitOneArgI64 state a
      bR = emitOneArgI64 (eerState aR) b
      -- Tail chain: 2nd arg in a single LIST_CONS_TAG cell with null tail.
      tailCell = emitAllocNode (eerState bR) listConsTagStr (eerReg bR) "null"
      tagStr = intToStr (esCtorTag cname (eerState tailCell))
      headCell = emitAllocNode (eerState tailCell) tagStr (eerReg aR) (eerReg tailCell)
      all = strJoin2 (strJoin2 (eerInstrs aR) (eerInstrs bR)) (strJoin2 (eerInstrs tailCell) (eerInstrs headCell))
      MkEER (eerState headCell) all (eerReg headCell)
    | a :: b :: c :: [] ->
      aR = emitOneArgI64 state a
      bR = emitOneArgI64 (eerState aR) b
      cR = emitOneArgI64 (eerState bR) c
      cell3 = emitAllocNode (eerState cR) listConsTagStr (eerReg cR) "null"
      cell2 = emitAllocNode (eerState cell3) listConsTagStr (eerReg bR) (eerReg cell3)
      tagStr = intToStr (esCtorTag cname (eerState cell2))
      cell1 = emitAllocNode (eerState cell2) tagStr (eerReg aR) (eerReg cell2)
      ia = strJoin2 (eerInstrs aR) (eerInstrs bR)
      iab = strJoin2 ia (eerInstrs cR)
      ic = strJoin2 (eerInstrs cell3) (eerInstrs cell2)
      icc = strJoin2 ic (eerInstrs cell1)
      all = strJoin2 iab icc
      MkEER (eerState cell1) all (eerReg cell1)
    | _ ->
      -- Fallback: 4+ args unsupported in Phase 3 (add when needed).
      MkEER state "" "null"

-- Gather nested TEApp spine. Returns (headTypedExpr, argsInOrder).
gatherTypedApp(te TypedExpr)(acc List[TypedExpr]) =
  match te
    | TEApp f a _ -> gatherTypedApp f (a :: acc)
    | _ -> (te, acc)

-- Emit i64-coerced argument regs for a list of TypedExprs. Uses a PatRes-
-- style wrapper type to dodge HM inference trouble with self-recursive 3-
-- tuple returns when the recursion also forward-refs emitTypedExpr.
ArgsRes = MkArgResult EmitState Str (List[Str])

argsState(r ArgsRes) = match r | MkArgResult s _ _ -> s
argsInstrs(r ArgsRes) = match r | MkArgResult _ i _ -> i
argsResRegs(r ArgsRes) = match r | MkArgResult _ _ rs -> rs

-- Emit one TypedExpr, i64-coerced. Returns EER (state', instrs, reg).
emitOneArgI64(state EmitState)(a TypedExpr) =
  r = emitTypedExpr state a
  argTy = llvmTypeOfTE a
  coerced = coerceValue (eerState r) argTy "i64" (eerReg r)
  combined = strJoin2 (eerInstrs r) (eerInstrs coerced)
  MkEER (eerState coerced) combined (eerReg coerced)

-- ---- Pattern match lowering ----------------------------------------------
--
-- Port of F# emitMatch + emitPatternValue + emitListPattern + emitCtorPattern
-- (lines 883-1059). Simplified for Phase 3 target examples 40-43:
--   - PWild / PVar / PLitInt / PLitStr
--   - PCon name args (including 0-arg nullary)
--   - PCons head tail
--   - PNil (empty list; also PCon "[]" [])
-- No PLitBool, PLitChar, PLitFloat, PTuple (not in Pattern type).
--
-- Bindings implemented via alias instructions: after a successful sub-pattern
-- load, emit `%<name> = add i64 %tN, 0` (or ptr variant) so later `TEVar n`
-- resolves naturally.

-- Result shape for pattern lowering.
PatRes = MkPatRes EmitState Str Str
  -- state', instrs (test+bind code), condReg ("0" / "1" / SSA %tN)

prState(r PatRes) =
  match r | MkPatRes s _ _ -> s

prInstrs(r PatRes) =
  match r | MkPatRes _ i _ -> i

prCond(r PatRes) =
  match r | MkPatRes _ _ c -> c

-- Emit a bind-alias for a pattern variable `name` holding value `val` of
-- type `valTy` ("i64" / "ptr"). Always returns instrs that define `%name`.
emitBindAlias(state EmitState)(name Str)(valTy Str)(value Str) =
  if valTy == "ptr"
    -- alias ptr: use getelementptr with i64 0 (no-op)
    instr = strConcat "  %" (strConcat name (strConcat " = getelementptr i8, ptr " (strConcat value ", i64 0")))
    MkEER state instr (strConcat "%" name)
  else
    instr = strConcat "  %" (strConcat name (strConcat " = add i64 " (strConcat value ", 0")))
    MkEER state instr (strConcat "%" name)

-- Core pattern-value lowering.
--   valTy : LLVM type of scrutinee value ("i64" / "ptr")
--   value : register holding scrutinee
--   pat   : the pattern to match
-- Returns PatRes with condReg (i1) + bind-alias instrs interleaved.
emitPatternValue(state EmitState)(valTy Str)(value Str)(pat Pattern) =
  MkPatRes state "" "1"

-- Stubs during bisection.
emitCtorPattern(state EmitState)(valTy Str)(value Str)(name Str)(args List[Pattern]) =
  MkPatRes state "" "1"

consumeCtorArgs(state EmitState)(accCond Str)(firstPayload Str)(tailPtr Str)(idx Int)(rest List[Pattern]) =
  MkPatRes state "" accCond

-- Emit a full match expression. scrutVal / scrutTy / pats / bodies / resultTy.
-- Returns EmitExprResult. Lowering shape:
--
--   <scrut code>
--   br label %case0
-- case0:
--   <pat0 test+bind>
--   br i1 %c0, label %body0, label %next0      (if c0 == "1"/"0", emit plain br)
-- body0:
--   <body0 code>
--   %r0 = <coerce body0 to resultTy>
--   br label %end
-- next0:            (actually same as case1's label)
--   ...
-- fail:
--   br label %end   (contributes `undef` fallback to phi)
-- end:
--   %result = phi <resultTy> [ %r0, %body0 ], ..., [ undef, %fail ]

-- One-arm lowering helper: emit the case label, pattern test, conditional br,
-- body label, body code, br to end, next label. Returns PatRes-style but
-- additionally tracks the body-value for phi incoming.

-- MatchArm emission result: carries (state', instrs, bodyVal, bodyLbl).
MatchArmRes = MkMatchArmRes EmitState Str Str Str
marState(r MatchArmRes) = match r | MkMatchArmRes s _ _ _ -> s
marInstrs(r MatchArmRes) = match r | MkMatchArmRes _ i _ _ -> i
marBodyVal(r MatchArmRes) = match r | MkMatchArmRes _ _ v _ -> v
marBodyLbl(r MatchArmRes) = match r | MkMatchArmRes _ _ _ l -> l

-- Lower one arm. `caseLbl` is the entry label for this arm. `nextLbl` is
-- the label to fall through to on mismatch (next arm or failLbl).
emitOneArm(state EmitState)(resultTy Str)(scrutTy Str)(scrutVal Str)(endLbl Str)(caseLbl Str)(nextLbl Str)(pat Pattern)(body TypedExpr) =
  MkMatchArmRes state "" "0" caseLbl

-- Walk arms. Returns (state', instrs, incomingList) where incomingList is
-- `List[(bodyVal, bodyLbl)]` encoded as TagEntry Str Str to avoid tuple-in-
-- type-param parser bug.
PhiIncoming = MkPhiIncoming Str Str

emitAllArms(state EmitState)(resultTy Str)(scrutTy Str)(scrutVal Str)(endLbl Str)(failLbl Str)(caseLbls List[Str])(arms List[Pattern])(bodies List[TypedExpr]) =
  match arms
    | [] -> (state, "", [])
    | pat :: restPats ->
      match bodies
        | [] -> (state, "", [])
        | body :: restBodies ->
          match caseLbls
            | [] -> (state, "", [])
            | caseLbl :: restCaseLbls ->
              nextLbl =
                match restCaseLbls
                  | [] -> failLbl
                  | nxt :: _ -> nxt
              armRes = emitOneArm state resultTy scrutTy scrutVal endLbl caseLbl nextLbl pat body
              let (st2, tailInstrs, tailInc) = emitAllArms (marState armRes) resultTy scrutTy scrutVal endLbl failLbl restCaseLbls restPats restBodies
              inc = MkPhiIncoming (marBodyVal armRes) (marBodyLbl armRes)
              combinedInstrs = strJoin2 (marInstrs armRes) tailInstrs
              (st2, combinedInstrs, listAppend [inc] tailInc)

-- Allocate N fresh match_case labels.
allocCaseLbls(state EmitState)(n Int) =
  if n == 0
    (state, [])
  else
    let (lbl, st1) = esFreshLabel "match_case_" state
    let (st2, rest) = allocCaseLbls st1 (n - 1)
    (st2, listAppend [lbl] rest)

-- Render phi incoming list: "[ v0, %l0 ], [ v1, %l1 ], ..."
renderIncoming(incoming List[PhiIncoming]) =
  match incoming
    | [] -> ""
    | inc :: [] ->
      match inc | MkPhiIncoming v l -> strConcat "[ " (strConcat v (strConcat ", %" (strConcat l " ]")))
    | inc :: rest ->
      match inc | MkPhiIncoming v l ->
        strConcat "[ " (strConcat v (strConcat ", %" (strConcat l (strConcat " ], " (renderIncoming rest)))))

-- Default (undef) fallback value for a given resultTy.
undefFallback(resultTy Str) =
  if resultTy == "void"
    ""
  else if resultTy == "ptr"
    "null"
  else if resultTy == "double"
    "0.0"
  else "0"

emitMatch(state EmitState)(scrut TypedExpr)(pats List[TypedPattern])(bodies List[TypedExpr])(resultTy Str) =
  MkEER state "" "0"

-- ---- emitTypedExpr ---------------------------------------------------------
-- Phase 2: consumes typed IR, dispatches on operand type for binops,
-- pulls string literals from the state-held pool, and lowers bare TEVar
-- references to nullary globals as `call <ty> @name()`.
-- Phase 3: adds TECon / TEApp-with-TECon-head / TECons / TEList / TEMatch.

emitTypedExpr(state EmitState)(te TypedExpr) =
  match te
    | TEInt n _  -> MkEER state "" (intToStr n)
    | TEFloat s _ -> MkEER state "" s
    | TEBool b _ ->
      reg =
        if b
          "1"
        else "0"
      MkEER state "" reg
    | TEChar c _ -> MkEER state "" (intToStr (charToInt c))
    | TEStr s _ -> emitStringPtrGep state s
    | TEVar n _ -> MkEER state "" (strConcat "%" n)
    | TECon name _ -> MkEER state "" "0"
    | TENil _   -> MkEER state "" "null"
    | TEUnit _  -> MkEER state "" "void"
    -- | TECons h t _ ->
    --   hr = emitTypedExpr state h
    --   tr = emitTypedExpr (eerState hr) t
    --   hTy = llvmTypeOfTE h
    --   tTy = llvmTypeOfTE t
    --   hc = coerceValue (eerState tr) hTy "i64" (eerReg hr)
    --   tc = coerceValue (eerState hc) tTy "ptr" (eerReg tr)
    --   alloc = emitAllocNode (eerState tc) listConsTagStr (eerReg hc) (eerReg tc)
    --   all =
    --     strJoin2
    --       (strJoin2 (eerInstrs hr) (eerInstrs tr))
    --       (strJoin2 (strJoin2 (eerInstrs hc) (eerInstrs tc)) (eerInstrs alloc))
    --   MkEER (eerState alloc) all (eerReg alloc)
    -- | TEList items _ ->
    --   emitTypedListLit state items
    -- TEMatch disabled temporarily for HM bisection
    -- | TEMatch scrut pats bodies _ ->
    --   resultTy = llvmTypeOfTE te
    --   emitMatch state scrut pats bodies resultTy
    | TEBinOp op l r _ ->
      lr = emitTypedExpr state l
      rr = emitTypedExpr (eerState lr) r
      lTyStr = llvmTypeOfTE l
      binRes = emitTypedBinOpByTy (eerState rr) op lTyStr (eerReg lr) (eerReg rr)
      prefix = strJoin2 (eerInstrs lr) (eerInstrs rr)
      all =
        if strLen prefix == 0
          eerInstrs binRes
        else
          if strLen (eerInstrs binRes) == 0
            prefix
          else strConcat prefix (strConcat "\n" (eerInstrs binRes))
      MkEER (eerState binRes) all (eerReg binRes)
    | TEIf cond thenE elseE _ ->
      cr = emitTypedExpr state cond
      labelN = esTempCtr (eerState cr)
      thenLbl = strConcat "then" (intToStr labelN)
      elseLbl = strConcat "else" (intToStr labelN)
      mergeLbl = strConcat "merge" (intToStr labelN)
      creg = eerReg cr
      brInstr = strConcat "  br i1 " (strConcat creg (strConcat ", label %" (strConcat thenLbl (strConcat ", label %" elseLbl))))
      let (_, stAfterBr) = esFresh (eerState cr)
      tr = emitTypedExpr stAfterBr thenE
      thenBodyPre =
        if strLen (eerInstrs tr) == 0
          ""
        else strConcat (eerInstrs tr) "\n"
      thenBlock = strConcat thenLbl (strConcat ":\n" (strConcat thenBodyPre (strConcat "  br label %" mergeLbl)))
      let (_, stAfterThen) = esFresh (eerState tr)
      er = emitTypedExpr stAfterThen elseE
      elseBodyPre =
        if strLen (eerInstrs er) == 0
          ""
        else strConcat (eerInstrs er) "\n"
      elseBlock = strConcat elseLbl (strConcat ":\n" (strConcat elseBodyPre (strConcat "  br label %" mergeLbl)))
      let (dst, stPhi) = esFresh (eerState er)
      treg = eerReg tr
      ereg = eerReg er
      phiParts = strConcat treg (strConcat ", %" (strConcat thenLbl (strConcat "], [" (strConcat ereg (strConcat ", %" (strConcat elseLbl "]"))))))
      phiInstr = strConcat "  " (strConcat dst (strConcat " = phi i64 [" phiParts))
      mergeBlock = strConcat mergeLbl (strConcat ":\n" phiInstr)
      condPart =
        if strLen (eerInstrs cr) == 0
          brInstr
        else strConcat (eerInstrs cr) (strConcat "\n" brInstr)
      all = strConcat condPart (strConcat "\n" (strConcat thenBlock (strConcat "\n" (strConcat elseBlock (strConcat "\n" mergeBlock)))))
      MkEER stPhi all dst
    | TeLet _ valE bodyE _ ->
      vr = emitTypedExpr state valE
      let (dst, st2) = esFresh (eerState vr)
      aliasInstr = strConcat "  " (strConcat dst (strConcat " = add i64 " (strConcat (eerReg vr) ", 0")))
      br = emitTypedExpr st2 bodyE
      viAlias =
        if strLen (eerInstrs vr) == 0
          aliasInstr
        else strConcat (eerInstrs vr) (strConcat "\n" aliasInstr)
      all =
        if strLen (eerInstrs br) == 0
          viAlias
        else strConcat viAlias (strConcat "\n" (eerInstrs br))
      MkEER (eerState br) all (eerReg br)
    | TEApp f a _ ->
      fr = emitTypedExpr state f
      ar = emitTypedExpr (eerState fr) a
      let (dst, st2) = esFresh (eerState ar)
      fnName = extractTypedFnName f
      areg = eerReg ar
      callInstr = strConcat "  " (strConcat dst (strConcat " = call i64 @" (strConcat fnName (strConcat "(i64 " (strConcat areg ")")))))
      prefix = strJoin2 (eerInstrs fr) (eerInstrs ar)
      all =
        if strLen prefix == 0
          callInstr
        else strConcat prefix (strConcat "\n" callInstr)
      MkEER st2 all dst
    | _ -> MkEER state "" "0"

-- Helper for TEList lowering: build a reverse cons chain from a list of
-- TypedExprs. (Placed after emitTypedExpr since it recurses into it.)
emitTypedListLit(state EmitState)(items List[TypedExpr]) =
  match items
    | [] -> MkEER state "" "null"
    | x :: rest ->
      tailRes = emitTypedListLit state rest
      hr = emitTypedExpr (eerState tailRes) x
      hTy = llvmTypeOfTE x
      hc = coerceValue (eerState hr) hTy "i64" (eerReg hr)
      alloc = emitAllocNode (eerState hc) listConsTagStr (eerReg hc) (eerReg tailRes)
      all = strJoin2 (eerInstrs tailRes) (strJoin2 (strJoin2 (eerInstrs hr) (eerInstrs hc)) (eerInstrs alloc))
      MkEER (eerState alloc) all (eerReg alloc)

-- ---- emitExprGlobs ---------------------------------------------------------
-- Walks the expression and accumulates every string-literal global declaration
-- (@.str.<n> = private unnamed_addr constant [...]). Threads the same
-- EmitState so indices line up with what emitExpr produced.

emitExprGlobs(state EmitState)(e Expr) =
  match e
    | EStr s ->
      let (idx, st2) = esNextStr state
      (strGlobalDecl idx s, st2)
    | EBinOp _ l r ->
      let (lg, st2) = emitExprGlobs state l
      let (rg, st3) = emitExprGlobs st2 r
      (strJoin2 lg rg, st3)
    | EIf cond thenE elseE ->
      let (cg, st2) = emitExprGlobs state cond
      let (tg, st3) = emitExprGlobs st2 thenE
      let (eg, st4) = emitExprGlobs st3 elseE
      (strJoin2 cg (strJoin2 tg eg), st4)
    | ELet _ valE bodyE ->
      let (vg, st2) = emitExprGlobs state valE
      let (bg, st3) = emitExprGlobs st2 bodyE
      (strJoin2 vg bg, st3)
    | EApp f a ->
      let (fg, st2) = emitExprGlobs state f
      let (ag, st3) = emitExprGlobs st2 a
      (strJoin2 fg ag, st3)
    | _ -> ("", state)

-- ---- Param helpers ---------------------------------------------------------

emitParam(p Param) =
  match p
    | MkParam name ty -> strConcat (emitLLVMType ty) (strConcat " %" name)

emitParams(ps List[Param]) =
  joinWith ", " (listMap emitParam ps)

-- Typed-path param emission: use positional %arg<i> names (matches F# emitParam).
emitTypedParam(idx Int)(p Param) =
  match p
    | MkParam _ ty -> strConcat (emitLLVMType ty) (strConcat " %arg" (intToStr idx))

-- Emit params as "ty %arg0, ty %arg1, ...". Recursion threads the index.
emitTypedParamsFrom(idx Int)(ps List[Param]) =
  match ps
    | [] -> ""
    | p :: [] -> emitTypedParam idx p
    | p :: rest -> strConcat (emitTypedParam idx p) (strConcat ", " (emitTypedParamsFrom (idx + 1) rest))

emitTypedParamsWithIdx(ps List[Param]) =
  emitTypedParamsFrom 0 ps

paramReturnType(retTy Maybe[TypeExpr]) =
  match retTy
    | Some t -> emitLLVMType t
    | None   -> "i64"

-- ---- litToConst / evalConst / constToLlvm ---------------------------------
-- Port of F# helpers for TDLet globals with literal / constant-folded RHS.

-- Const value: tag + Int/Float(Str)/Bool/Char
ConstVal =
  | CInt Int
  | CFloat Str    -- keep as Str since ll-lang Float is stored Str
  | CBool Bool
  | CChar Int

-- Try to extract a ConstVal from a literal-bearing TypedExpr node.
litToConst(te TypedExpr) =
  match te
    | TEInt n _ -> Some (CInt n)
    | TEFloat s _ -> Some (CFloat s)
    | TEBool b _ -> Some (CBool b)
    | TEChar c _ -> Some (CChar (charToInt c))
    | _ -> None

-- Fold a constant expression (literal only for now — arith folding is
-- deferred to Phase 3+ along with richer eval).
evalConst(te TypedExpr) =
  litToConst te

-- Render a ConstVal against a target LLVM type. Returns Maybe[Str].
constToLlvm(llvmTy Str)(cv ConstVal) =
  match cv
    | CInt n ->
      if llvmTy == "i64"
        Some (intToStr n)
      else if llvmTy == "i8"
        Some (intToStr n)
      else None
    | CChar c ->
      if llvmTy == "i64"
        Some (intToStr c)
      else if llvmTy == "i8"
        Some (intToStr c)
      else None
    | CFloat s ->
      if llvmTy == "double"
        Some s
      else None
    | CBool b ->
      if llvmTy == "i1"
        boolLit =
          if b
            "1"
          else "0"
        Some boolLit
      else None

-- ---- String pool construction ---------------------------------------------
-- Walk a TypedExpr and return all string literals reachable from it
-- (in left-to-right encounter order). Caller dedupes.

collectTypedExprStringLits(te TypedExpr) =
  match te
    | TEStr s _ -> [s]
    | TEApp f a _ -> listAppend (collectTypedExprStringLits f) (collectTypedExprStringLits a)
    | TELam _ _ body _ -> collectTypedExprStringLits body
    | TeLet _ v b _ -> listAppend (collectTypedExprStringLits v) (collectTypedExprStringLits b)
    | TEIf c t e _ ->
      listAppend (collectTypedExprStringLits c) (listAppend (collectTypedExprStringLits t) (collectTypedExprStringLits e))
    | TEBinOp _ l r _ -> listAppend (collectTypedExprStringLits l) (collectTypedExprStringLits r)
    | TECons h t _ -> listAppend (collectTypedExprStringLits h) (collectTypedExprStringLits t)
    | TEList xs _ -> listFold (\acc x. listAppend acc (collectTypedExprStringLits x)) [] xs
    | TETuple a b _ -> listAppend (collectTypedExprStringLits a) (collectTypedExprStringLits b)
    | TEMatch scrut _ bodies _ ->
      listAppend (collectTypedExprStringLits scrut)
        (listFold (\acc b. listAppend acc (collectTypedExprStringLits b)) [] bodies)
    | _ -> []

collectTypedDeclStringLits(d TypedDecl) =
  match d
    | TDFn _ _ body -> collectTypedExprStringLits body
    | TDLet _ _ e -> collectTypedExprStringLits e
    | _ -> []

-- Dedupe a list of strings, preserving first-occurrence order.
dedupStrList(xs List[Str]) =
  listFold
    (\acc x.
      if listAny (\y. x == y) acc
        acc
      else listAppend acc [x]
    )
    []
    xs

-- Build the pool map: literal -> index. Index assigned left-to-right.
buildStringPoolMap(lits List[Str]) =
  result = listFold
    (\st lit.
      match st
        | (m, i) -> (mapInsert strCmp lit i m, i + 1)
    )
    (Leaf, 0)
    lits
  match result
    | (m, _) -> m

-- Build the pool declarations string ("@.str0 = ... \n @.str1 = ... \n ...").
buildStringPoolDecls(lits List[Str]) =
  result = listFold
    (\st lit.
      match st
        | (acc, i) ->
          d = strPoolDecl i lit
          nextAcc =
            if strLen acc == 0
              d
            else strConcat acc (strConcat "\n" d)
          (nextAcc, i + 1)
    )
    ("", 0)
    lits
  match result
    | (s, _) -> s

-- Full string pool: returns the literal->index map alongside the unique list,
-- the caller folds the declarations separately via buildStringPoolDecls.
buildStringPoolLits(decls List[TypedDecl]) =
  allLits = listFold (\acc d. listAppend acc (collectTypedDeclStringLits d)) [] decls
  dedupStrList allLits

-- ---- collectNullaryGlobals ------------------------------------------------
-- Scan a list of TypedDecls for zero-arg TDFn. These names, when referenced
-- via a bare TEVar elsewhere, must lower to `call <ty> @name()` because the
-- parser desugars `name = expr` as TDFn("name", [], ..., expr).

collectNullaryGlobals(decls List[TypedDecl]) =
  listFold
    (\acc d.
      match d
        | TDFn sig _ _ ->
          match sig
            | MkTypedFnSig name params _ ->
              match params
                | [] -> mapInsert strCmp name 1 acc
                | _ -> acc
        | _ -> acc
    )
    Leaf
    decls

-- ---- Typed-decl emission --------------------------------------------------
-- Emit a single TypedDecl. Threads the shared pool + nullary-globals state.

-- isEntryMain: function named "main" with zero params (after parser desugar
-- top-level `main = body` becomes `TDFn "main" [] ... body`).
isEntryMain(sig TypedFnSig) =
  match sig
    | MkTypedFnSig name params _ ->
      if name == "main"
        match params
          | [] -> true
          | _ -> false
      else false

emitTypedFn(pool RBMap[Str][Int])(globs RBMap[Str][Int])(tags RBMap[Str][Int])(sig TypedFnSig)(body TypedExpr) =
  match sig
    | MkTypedFnSig name params retTy ->
      retType = emitLLVMType retTy
      paramStr = emitTypedParamsWithIdx params
      isMain = isEntryMain sig
      initSt = emitStateWithTags pool globs tags 1
      bodyRes = emitTypedExpr initSt body
      bodyInstrs = eerInstrs bodyRes
      retReg = eerReg bodyRes
      if isMain
        -- Entry-point main: force i32 return, cast body value.
        bodyTy = llvmTypeOfTE body
        castRes = emitCastToMainI32 (eerState bodyRes) bodyTy retReg
        castInstrs = eerInstrs castRes
        fullInstrs =
          if strLen bodyInstrs == 0
            castInstrs
          else if strLen castInstrs == 0
            bodyInstrs
          else strConcat bodyInstrs (strConcat "\n" castInstrs)
        retValue = eerReg castRes
        instrBlock =
          if strLen fullInstrs == 0
            ""
          else strConcat "\n" fullInstrs
        strConcat "define i32 @main() {\nentry:" (strConcat instrBlock (strConcat "\n  ret i32 " (strConcat retValue "\n}")))
      else if retType == "void"
        instrBlock =
          if strLen bodyInstrs == 0
            ""
          else strConcat "\n" bodyInstrs
        strConcat "define void @" (strConcat name (strConcat "(" (strConcat paramStr (strConcat ") {\nentry:" (strConcat instrBlock "\n  ret void\n}")))))
      else
        -- Regular typed function.
        instrBlock =
          if strLen bodyInstrs == 0
            ""
          else strConcat "\n" bodyInstrs
        strConcat "define " (strConcat retType (strConcat " @" (strConcat name (strConcat "(" (strConcat paramStr (strConcat ") {\nentry:" (strConcat instrBlock (strConcat "\n  ret " (strConcat retType (strConcat " " (strConcat retReg "\n}")))))))))))

-- Emit a TypedDecl.
emitTypedDecl(pool RBMap[Str][Int])(globs RBMap[Str][Int])(tags RBMap[Str][Int])(d TypedDecl) =
  match d
    | TDFn sig _ body -> emitTypedFn pool globs tags sig body
    | TDLet name sch e ->
      ty = match sch | MkScheme _ b -> emitLLVMType b
      -- Try to evaluate the RHS as a constant.
      value =
        match evalConst e
          | Some cv ->
            match constToLlvm ty cv
              | Some v -> v
              | None -> defaultLLVMValue ty
          | None ->
            -- String-literal RHS: emit as a pointer to pool string.
            match e
              | TEStr s _ ->
                if ty == "ptr"
                  match mapLookup strCmp s pool
                    | Some idx ->
                      totalLen = strLen s + 1
                      strConcat "getelementptr inbounds ([" (strConcat (intToStr totalLen) (strConcat " x i8], ptr @.str" (strConcat (intToStr idx) ", i64 0, i64 0)")))
                    | None -> defaultLLVMValue ty
                else defaultLLVMValue ty
              | _ -> defaultLLVMValue ty
      if ty == "void"
        strConcat "; let " (strConcat name " : void")
      else
        strConcat "@" (strConcat name (strConcat " = global " (strConcat ty (strConcat " " value))))
    | TDExternal sig _ ->
      match sig
        | MkTypedFnSig name params retTy ->
          retType = emitLLVMType retTy
          argTys = joinWith ", " (listMap (\p. match p | MkParam _ t -> emitLLVMType t) params)
          strConcat "declare " (strConcat retType (strConcat " @" (strConcat name (strConcat "(" (strConcat argTys ")")))))
    | TDOpaque name -> strConcat "; opaque type " name
    | TDType name _ _ -> strConcat "; type " (strConcat name " (opaque in LLVM backend)")
    | TDImport _ -> ""
    | TDTag _ -> ""
    | TDUnit _ -> ""

-- ---- Untyped-decl emitter (POC; unchanged from Phase 1) --------------------

emitDecl(d Decl)(strIdx Int) =
  match d
    | DFn name params retTy body ->
      retType = paramReturnType retTy
      paramStr = emitParams params
      initSt = MkEmitState 0 strIdx Leaf Leaf 0 Leaf 1
      res = emitExpr initSt body
      bodyInstrs = eerInstrs res
      retReg = eerReg res
      let (globs, _) = emitExprGlobs (MkEmitState 0 strIdx Leaf Leaf 0 Leaf 1) body
      globSection =
        if strLen globs == 0
          ""
        else strConcat globs "\n"
      bodySection =
        if strLen bodyInstrs == 0
          strConcat "  ret " (strConcat retType (strConcat " " retReg))
        else strConcat bodyInstrs (strConcat "\n  ret " (strConcat retType (strConcat " " retReg)))
      strConcat globSection (strConcat "define " (strConcat retType (strConcat " @" (strConcat name (strConcat "(" (strConcat paramStr (strConcat ") {\nentry:\n" (strConcat bodySection "\n}"))))))))
    | DType name _ _ ->
      strConcat "; type " name
    | DImport parts ->
      strConcat "; import " (joinWith "." parts)
    | DLet name body ->
      initSt = MkEmitState 0 strIdx Leaf Leaf 0 Leaf 1
      res = emitExpr initSt body
      reg = eerReg res
      let (globs, _) = emitExprGlobs (MkEmitState 0 strIdx Leaf Leaf 0 Leaf 1) body
      globSection =
        if strLen globs == 0
          ""
        else strConcat globs "\n"
      strConcat globSection (strConcat "@" (strConcat name (strConcat " = global i64 " reg)))
    | DExport inner -> emitDecl inner strIdx
    | DExternal name _ _ ->
      strConcat "; external: " name
    | DOpaque name ->
      strConcat "; opaque: " name

emitDecls(ds List[Decl])(strIdx Int) =
  match ds
    | [] -> ""
    | d :: rest ->
      first = emitDecl d strIdx
      remaining = emitDecls rest (strIdx + 1)
      if strLen remaining == 0
        first
      else strConcat first (strConcat "\n\n" remaining)

-- ---- Module emission -------------------------------------------------------

emitModulePath(parts List[Str]) =
  joinWith "." parts

emitModule(m Module) =
  match m
    | MkModule path decls ->
      pathStr = emitModulePath path
      header = strConcat "; module " pathStr
      prelude = "; ll-lang LLVM IR output\n; target triple: x86_64-unknown-linux-gnu\n"
      body = emitDecls decls 0
      strConcat prelude (strConcat header (strConcat "\n\n" body))

-- Uniquely-named alias so callers that import multiple codegens can pick
-- LLVM's emitter without bare-name shadowing.
emitModuleLlvm(m Module) = emitModule m

-- Phase 2: full typed-module emission pipeline.
--   Pre-pass: buildStringPool, collectNullaryGlobals
--   Emit pass: emitTypedDecl per decl, threaded through shared state
--
-- Output shape matches F# emitModule:
--   "; Generated by lllc (ll-lang LLVM backend)\n; Module: <name>\n\n"
--   + string decls + body
emitTypedDecls(pool RBMap[Str][Int])(globs RBMap[Str][Int])(tags RBMap[Str][Int])(ds List[TypedDecl]) =
  match ds
    | [] -> ""
    | d :: rest ->
      first = emitTypedDecl pool globs tags d
      remaining = emitTypedDecls pool globs tags rest
      if strLen first == 0
        remaining
      else if strLen remaining == 0
        first
      else strConcat first (strConcat "\n\n" remaining)

emitTypedModule(tm TypedModule) =
  pathStr = joinWith "." (typedModPath tm)
  decls = typedModDecls tm
  lits = buildStringPoolLits decls
  pool = buildStringPoolMap lits
  poolDecls = buildStringPoolDecls lits
  globs = collectNullaryGlobals decls
  let (tags, _) = seedCtorsDecls Leaf 1 decls
  header = strConcat "; Generated by lllc (ll-lang LLVM backend)\n; Module: " pathStr
  stringBlock =
    if strLen poolDecls == 0
      ""
    else strConcat poolDecls "\n\n"
  body = emitTypedDecls pool globs tags decls
  -- Prepend runtime block (ADT allocator + node_* declares).
  strConcat llvmRuntimeBlock (strConcat "\n" (strConcat header (strConcat "\n\n" (strConcat stringBlock (strConcat body "\n")))))

-- Render one module's body with shared ctor-tag table (no runtime block).
emitTypedModuleBody(tags RBMap[Str][Int])(tm TypedModule) =
  pathStr = joinWith "." (typedModPath tm)
  decls = typedModDecls tm
  lits = buildStringPoolLits decls
  pool = buildStringPoolMap lits
  poolDecls = buildStringPoolDecls lits
  globs = collectNullaryGlobals decls
  header = strConcat "; Module: " pathStr
  stringBlock =
    if strLen poolDecls == 0
      ""
    else strConcat poolDecls "\n\n"
  body = emitTypedDecls pool globs tags decls
  strConcat header (strConcat "\n\n" (strConcat stringBlock (strConcat body "\n")))

-- Walk a list of modules accumulating textual output.
emitTypedProjectBodies(tags RBMap[Str][Int])(tms List[TypedModule]) =
  match tms
    | [] -> ""
    | tm :: rest ->
      first = emitTypedModuleBody tags tm
      remaining = emitTypedProjectBodies tags rest
      if strLen remaining == 0
        first
      else strConcat first (strConcat "\n" remaining)

-- Project-scope emit: seed ctor tags across all modules first, then emit
-- each module. Runtime block is emitted once at the top.
emitTypedProject(tms List[TypedModule]) =
  let (tags, _) = seedCtorsModules tms
  runtimeHeader = strConcat llvmRuntimeBlock "\n"
  moduleBodies = emitTypedProjectBodies tags tms
  strConcat runtimeHeader moduleBodies

-- ---- Test helpers ----------------------------------------------------------

checkContains(label Str)(got Str)(needle Str) =
  if strContains needle got
    printfn (strConcat "OK " label)
  else
    printfn (strConcat "FAIL " (strConcat label (strConcat "\n  missing: " (strConcat needle (strConcat "\n  in: " got)))))

-- ---- Tests -----------------------------------------------------------------
