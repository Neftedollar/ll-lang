module Std.Json

import Std.Parsec

export JsonField = JField Str JsonValue

export JsonValue =
  | JNull
  | JBool Bool
  | JNum Str
  | JStr Str
  | JArr List[JsonValue]
  | JObj List[JsonField]

-- Kept for API compatibility with the previous Json module shape.
export Token =
  | TNull
  | TTrue
  | TFalse
  | TNum Str
  | TStr Str
  | TLBrace
  | TRBrace
  | TLBracket
  | TRBracket
  | TColon
  | TComma
  | TEOF

export ParseResult A = ParseOk A List[Token] | ParseErr Str

-- ---- Generic helpers --------------------------------------------------------

export kindOf(v JsonValue) =
  match v
    | JNull -> "null"
    | JBool _ -> "bool"
    | JNum _ -> "number"
    | JStr _ -> "string"
    | JArr _ -> "array"
    | JObj _ -> "object"

maybeStr(m Maybe[Str])(fallback Str) =
  match m
    | Some s -> s
    | None -> fallback

signStr(m Maybe[Str]) =
  match m
    | Some s -> s
    | None -> ""

posToStr(pos ParsePos) =
  match pos
    | MkParsePos _ l c -> strConcat (intToStr l) (strConcat ":" (intToStr c))

showParseError(e ParseError) =
  match e
    | MkParseError msg pos -> strConcat msg (strConcat " at " (posToStr pos))

jsonLexemeStr(p Parser[Str]) =
  parseBind parseSpaces (\ignoredLeftWs.
    parseBind p (\v.
      parseBind parseSpaces (\ignoredRightWs.
        parsePure v
      )
    )
  )

jsonLexemeChar(p Parser[Char]) =
  parseBind parseSpaces (\ignoredLeftWs.
    parseBind p (\v.
      parseBind parseSpaces (\ignoredRightWs.
        parsePure v
      )
    )
  )

jsonSym(ch Char) =
  jsonLexemeChar (parseChar ch)

-- ---- Number parser (RFC-style shape) ---------------------------------------
parseDigit19() =
  parseOneOf "123456789"

parseIntPartStr =
  parseOrElse
    (parseTry (
      parseBind (parseChar '0') (\ignoredZero.
        parseBind (parseOptional parsePeekChar) (\mc.
          match mc
            | Some c ->
              if charIsDigit c
                parseFail "leading zero in number"
              else parsePure "0"
            | None -> parsePure "0"
        )
      )
    ))
    (parseBind parseDigit19() (\d1.
      parseMap (\tailDigits.
        strFromChars (d1 :: tailDigits)
      ) (parseMany parseDigit)
    ))

parseFracPartReqStr =
  parseBind (parseChar '.') (\ignoredDot.
    parseMap (\digits.
      strConcat "." (strFromChars digits)
    ) (parseMany1 parseDigit)
  )

parseFracPartStr =
  parseOrElse (parseTry parseFracPartReqStr) (parsePure "")

parseSignPartStr =
  parseOrElse
    (parseMap (\c. strFromChars [c]) (parseOneOf "+-"))
    (parsePure "")

parseExpPartReqStr =
  parseBind (parseOneOf "eE") (\eChar.
    parseBind parseSignPartStr (\signPart.
      parseMap (\digits.
        strConcat (strFromChars [eChar]) (strConcat signPart (strFromChars digits))
      ) (parseMany1 parseDigit)
    )
  )

parseExpPartStr =
  parseOrElse (parseTry parseExpPartReqStr) (parsePure "")

parseMinusPartStr =
  parseOrElse
    (parseMap (\c. strFromChars [c]) (parseOneOf "-"))
    (parsePure "")

buildJsonNumberExp(minusPart Str)(intPart Str)(fracPart Str)(expPart Str) =
  parsePure (strConcat minusPart (strConcat intPart (strConcat fracPart expPart)))

buildJsonNumberFrac(minusPart Str)(intPart Str)(fracPart Str) =
  parseBind parseExpPartStr (\expPart.
    buildJsonNumberExp minusPart intPart fracPart expPart
  )

buildJsonNumberInt(minusPart Str)(intPart Str) =
  parseBind parseFracPartStr (\fracPart.
    buildJsonNumberFrac minusPart intPart fracPart
  )

buildJsonNumberMinus(minusPart Str) =
  parseBind parseIntPartStr (\intPart.
    buildJsonNumberInt minusPart intPart
  )

parseJsonNumberStr =
  jsonLexemeStr (
    parseBind parseMinusPartStr (\minusPart.
      buildJsonNumberMinus minusPart
    )
  )

parseJsonNumber =
  parseMap (\n. JNum n) parseJsonNumberStr

-- ---- JSON value parser ------------------------------------------------------

parseJsonNull =
  parseMap (\ignoredNull. JNull) (jsonLexemeStr (parseString "null"))

parseJsonBool =
  parseBind parseSpaces (\ignoredLeftWs.
    parseBind (parseOneOf "tf") (\head.
      if head == 't'
        parseBind (parseString "rue") (\ignoredTrueTail.
          parseBind parseSpaces (\ignoredRightWs.
            parsePure (JBool true)
          )
        )
      else
        parseBind (parseString "alse") (\ignoredFalseTail.
          parseBind parseSpaces (\ignoredRightWs.
            parsePure (JBool false)
          )
        )
    )
  )

parseJsonString =
  parseMap (\s. JStr s) (jsonLexemeStr parseQuotedString)

parseJsonField(dummy Int) =
  parseBind (jsonLexemeStr parseQuotedString) \k.
    parseBind (jsonSym ':') \ignoredColon.
      parseBind (parseJsonValue 0) \v.
        parsePure (JField k v)

parseJsonArray(dummy Int) =
  parseBind (jsonSym '[') \ignoredLBrack.
    parseBind (parseSepBy (parseJsonValue 0) (jsonSym ',')) \items.
      parseBind (jsonSym ']') \ignoredRBrack.
        parsePure (JArr items)

parseJsonObject(dummy Int) =
  parseBind (jsonSym '{') \ignoredLBrace.
    parseBind (parseSepBy (parseJsonField 0) (jsonSym ',')) \fields.
      parseBind (jsonSym '}') \ignoredRBrace.
        parsePure (JObj fields)

parseJsonValue(dummy Int) =
  parseOrElse
    (parseTry parseJsonNull)
    (parseOrElse
      (parseTry parseJsonBool)
      (parseOrElse
        (parseTry parseJsonNumber)
        (parseOrElse
          (parseTry parseJsonString)
          (parseOrElse (parseTry (parseJsonArray 0)) (parseJsonObject 0))
        )
      )
    )

parseJsonDocument(dummy Int) =
  parseBind parseSpaces \ignoredDocLeftWs.
    parseBind (parseJsonValue 0) \v.
      parseBind parseSpaces \ignoredDocRightWs.
        parseBind parseEof \ignoredEof.
          parsePure v

export parseJson(src Str) =
  match runParser (parseJsonDocument 0) src
    | Ok (v, _) -> ParseOk v []
    | Err e -> ParseErr (showParseError e)

-- Backward-compatible alias kept for old callers.
export parse(src Str) = parseJson src

-- ---- Equality and rendering -------------------------------------------------

eqJsonValueList(xs List[JsonValue])(ys List[JsonValue]) =
  match xs
    | x :: restX ->
      match ys
        | y :: restY ->
          if eqJsonValue x y
            eqJsonValueList restX restY
          else false
        | _ -> false
    | _ ->
      match ys
        | [] -> true
        | _ -> false

eqJsonField(f1 JsonField)(f2 JsonField) =
  match f1
    | JField k1 v1 ->
      match f2
        | JField k2 v2 ->
          if k1 == k2
            eqJsonValue v1 v2
          else false

eqJsonFieldList(xs List[JsonField])(ys List[JsonField]) =
  match xs
    | x :: restX ->
      match ys
        | y :: restY ->
          if eqJsonField x y
            eqJsonFieldList restX restY
          else false
        | _ -> false
    | _ ->
      match ys
        | [] -> true
        | _ -> false

eqJsonValue(v1 JsonValue)(v2 JsonValue) =
  match v1
    | JNull ->
      match v2
        | JNull -> true
        | _ -> false
    | JBool b1 ->
      match v2
        | JBool b2 -> b1 == b2
        | _ -> false
    | JNum n1 ->
      match v2
        | JNum n2 -> n1 == n2
        | _ -> false
    | JStr s1 ->
      match v2
        | JStr s2 -> s1 == s2
        | _ -> false
    | JArr xs1 ->
      match v2
        | JArr xs2 -> eqJsonValueList xs1 xs2
        | _ -> false
    | JObj fs1 ->
      match v2
        | JObj fs2 -> eqJsonFieldList fs1 fs2
        | _ -> false

escapeChar(c Char) =
  if c == '"'
    "\\\""
  else if c == '\\'
    "\\\\"
  else if c == '\n'
    "\\n"
  else if c == '\r'
    "\\r"
  else if c == '\t'
    "\\t"
  else if c == (intToChar 8)
    "\\b"
  else if c == (intToChar 12)
    "\\f"
  else strFromChars [c]

escapeChars(cs List[Char])(acc Str) =
  match cs
    | c :: rest -> escapeChars rest (strConcat acc (escapeChar c))
    | _ -> acc

renderString(s Str) =
  strConcat "\"" (strConcat (escapeChars (strChars s) "") "\"")

renderField(f JsonField) =
  match f
    | JField k v -> strConcat (renderString k) (strConcat ":" (renderJson v))

renderArrayTail(xs List[JsonValue]) =
  match xs
    | x :: rest -> strConcat "," (strConcat (renderJson x) (renderArrayTail rest))
    | _ -> ""

renderArray(xs List[JsonValue]) =
  match xs
    | x :: rest -> strConcat "[" (strConcat (renderJson x) (strConcat (renderArrayTail rest) "]"))
    | _ -> "[]"

renderObjectTail(fs List[JsonField]) =
  match fs
    | f :: rest -> strConcat "," (strConcat (renderField f) (renderObjectTail rest))
    | _ -> ""

renderObject(fs List[JsonField]) =
  match fs
    | f :: rest -> strConcat "{" (strConcat (renderField f) (strConcat (renderObjectTail rest) "}"))
    | _ -> "{}"

renderJson(v JsonValue) =
  match v
    | JNull -> "null"
    | JBool b ->
      if b
        "true"
      else "false"
    | JNum n -> n
    | JStr s -> renderString s
    | JArr xs -> renderArray xs
    | JObj fs -> renderObject fs

-- Canonical aliases expected by docs/examples.
export stringify(v JsonValue) = renderJson v
export equalJson(v1 JsonValue)(v2 JsonValue) = eqJsonValue v1 v2

-- ---- Smoke / regression runner ----------------------------------------------

export mkOk(name Str) = strConcat "OK " name
export mkFail(name Str)(msg Str) = strConcat (strConcat "FAIL " name) (strConcat " " msg)

export runOkCase(name Str)(src Str)(wantKind Str) =
  match parseJson src
    | ParseErr e -> mkFail name (strConcat "parse-error:" e)
    | ParseOk v _ ->
      got = kindOf v
      if got == wantKind
        mkOk name
      else mkFail name (strConcat "kind-mismatch:" got)

export runErrCase(name Str)(src Str) =
  match parseJson src
    | ParseErr _ -> mkOk name
    | ParseOk v _ -> mkFail name (strConcat "expected-error-got:" (kindOf v))

export runRoundtripCase(name Str)(src Str) =
  match parseJson src
    | ParseErr e -> mkFail name (strConcat "parse-error:" e)
    | ParseOk v _ ->
      rendered = renderJson v
      match parseJson rendered
        | ParseErr e2 -> mkFail name (strConcat "reparse-error:" e2)
        | ParseOk v2 _ ->
          if eqJsonValue v v2
            mkOk name
          else mkFail name "roundtrip-ast-mismatch"

-- ---- Self-tests ----------------------------------------------------------------

jsonPrint(result Str) = printfn result

main =
  -- 1-6: basic value kinds
  _ = jsonPrint (runOkCase "1 null" "null" "null")
  _ = jsonPrint (runOkCase "2 bool true" "true" "bool")
  _ = jsonPrint (runOkCase "3 bool false" "false" "bool")
  _ = jsonPrint (runOkCase "4 number" "42" "number")
  _ = jsonPrint (runOkCase "5 string" "\"hello\"" "string")
  _ = jsonPrint (runOkCase "6 array" "[1,2,3]" "array")
  _ = jsonPrint (runOkCase "7 object" "{\"k\":1}" "object")

  -- 8-10: round-trips
  _ = jsonPrint (runRoundtripCase "8 roundtrip null" "null")
  _ = jsonPrint (runRoundtripCase "9 roundtrip nested" "{\"a\":[1,true,null]}")
  _ = jsonPrint (runRoundtripCase "10 roundtrip string escapes" "\"a\\nb\"")

  -- 11-12: error cases
  _ = jsonPrint (runErrCase "11 err empty" "")
  _ = jsonPrint (runErrCase "12 err unclosed" "{\"k\":1")

  printfn "Done"
